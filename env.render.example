# ============================================================================
# .env.render - Configuration pour Render Gratuit
# Copier ces variables dans le Dashboard Render
# ============================================================================

# APP
APP_ENV=prod
APP_DEBUG=0

# APP_SECRET sera généré automatiquement par Render

# DATABASE - Sera auto-connecté par Render si vous utilisez render-free.yaml
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ============================================================================
# API ML CLOUD - Choisir UNE des options suivantes :
# ============================================================================

# Option 1 : HUGGING FACE (Recommandé - Gratuit)
# ============================================================================
EMOTION_API_TYPE=huggingface
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# URL de votre Space HF : https://username-emotion-api.hf.space
EMOTION_API_URL=https://username-emotion-api.hf.space

# Option 2 : REPLICATE (Alternative)
# ============================================================================
# EMOTION_API_TYPE=replicate
# REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxx

# Option 3 : AWS REKOGNITION (Payant)
# ============================================================================
# EMOTION_API_TYPE=aws-rekognition
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_DEFAULT_REGION=us-east-1

# ============================================================================
# SMTP - Pour les emails
# ============================================================================
MAILER_DSN=smtp://user:pass@smtp.gmail.com:587?encryption=tls

# ============================================================================
# LOGS & DEBUG
# ============================================================================
MONOLOG_HANDLER_LEVEL=notice
