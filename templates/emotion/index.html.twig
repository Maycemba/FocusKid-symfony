{% extends 'base-back.html.twig' %}

{% block title %}Gestion des émotions{% endblock %}

{% block stylesheets %}
<style>
.sort-link { color: inherit; text-decoration: none; }
.sort-link:hover { color: #4361ee; }
.sort-icon { font-size: 0.75rem; margin-left: 4px; }
.emotion-photo { width: 50px; height: 50px; object-fit: cover; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.12); }
.table-hover tbody tr:hover { background-color: rgba(67,97,238,0.05); }
.badge-emotion { background: linear-gradient(135deg,#4361ee,#7209b7); color:#fff; border-radius:20px; padding:4px 12px; font-size:0.78rem; }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid">

    {# Breadcrumb #}
    <div class="card bg-light-info shadow-none position-relative overflow-hidden mb-4">
        <div class="card-body px-4 py-3">
            <div class="row align-items-center">
                <div class="col-9">
                    <h4 class="fw-semibold mb-8">Émotions</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                            <li class="breadcrumb-item active">Gestion des émotions</li>
                        </ol>
                    </nav>
                </div>
                <div class="col-3 text-end">
                    {# ✅ getTotalItemCount() donne le nombre total toutes pages confondues #}
<span class="badge-emotion">{{ emotions.totalItemCount }} émotion(s)</span>
                </div>
            </div>
        </div>
    </div>

    {# Flash messages #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="ti ti-circle-check me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
            <h5 class="card-title fw-semibold mb-0">
                <i class="ti ti-mood-smile me-2 text-primary"></i>Liste des émotions
            </h5>

            {# Barre de recherche + tri #}
            <form method="GET" action="{{ path('app_emotion_index') }}" class="d-flex align-items-center gap-2 flex-wrap">
                <div class="input-group" style="width:260px;">
                    <span class="input-group-text"><i class="ti ti-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Rechercher une émotion…" value="{{ search }}">
                    {% if search %}
                        <a href="{{ path('app_emotion_index') }}" class="btn btn-outline-secondary" title="Effacer"><i class="ti ti-x"></i></a>
                    {% endif %}
                </div>

                {# Tri rapide #}
                <select name="sort" class="form-select" style="width:130px;" onchange="this.form.submit()">
                    <option value="id"  {% if sort == 'id'  %}selected{% endif %}>Tri par ID</option>
                    <option value="nom" {% if sort == 'nom' %}selected{% endif %}>Tri par Nom</option>
                </select>

                <select name="order" class="form-select" style="width:130px;" onchange="this.form.submit()">
                    <option value="ASC"  {% if order == 'ASC'  %}selected{% endif %}>↑ Croissant</option>
                    <option value="DESC" {% if order == 'DESC' %}selected{% endif %}>↓ Décroissant</option>
                </select>

                <button type="submit" class="btn btn-outline-primary"><i class="ti ti-filter me-1"></i>Filtrer</button>
            </form>

            <a href="{{ path('app_emotion_new') }}" class="btn btn-primary">
                <i class="ti ti-plus me-1"></i>Nouvelle émotion
            </a>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px;">
                                <a href="{{ path('app_emotion_index', {search: search, sort: 'id', order: (sort == 'id' and order == 'ASC') ? 'DESC' : 'ASC'}) }}" class="sort-link">
                                    # <i class="ti ti-arrows-sort sort-icon"></i>
                                </a>
                            </th>
                            <th>
                                <a href="{{ path('app_emotion_index', {search: search, sort: 'nom', order: (sort == 'nom' and order == 'ASC') ? 'DESC' : 'ASC'}) }}" class="sort-link">
                                    Nom <i class="ti ti-arrows-sort sort-icon"></i>
                                </a>
                            </th>
                            <th>Photo</th>
                            <th>Scénarios liés</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for emotion in emotions %}
                        <tr>
                            <td><span class="badge bg-light text-dark fw-bold">{{ emotion.id }}</span></td>
                            <td class="fw-semibold">{{ emotion.nom }}</td>
                            <td>
                                {% if emotion.photo %}
                                    {# ✅ Après — le data URI est déjà complet #}
<img src="{{ emotion.photo }}" class="emotion-photo" alt="{{ emotion.nom }}">
                                {% else %}
                                    <div class="d-flex align-items-center justify-content-center bg-light rounded" style="width:50px;height:50px;">
                                        <i class="ti ti-photo text-muted"></i>
                                    </div>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary rounded-pill">
                                    {{ emotion.scenarios|length }} scénario(s)
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <a href="{{ path('app_emotion_show', {'id': emotion.id}) }}" class="btn btn-sm btn-outline-info" title="Voir">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                    <a href="{{ path('app_emotion_edit', {'id': emotion.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                        <i class="ti ti-pencil"></i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger" title="Supprimer"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal{{ emotion.id }}">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </div>

                                {# Modal suppression #}
                                <div class="modal fade" id="deleteModal{{ emotion.id }}" tabindex="-1">
                                    <div class="modal-dialog modal-sm">
                                        <div class="modal-content">
                                            <div class="modal-header bg-danger text-white">
                                                <h6 class="modal-title"><i class="ti ti-alert-triangle me-2"></i>Confirmer</h6>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body text-center py-3">
                                                {% if emotion.photo %}
                                                    {# ✅ Après — le data URI est déjà complet #}
<img src="{{ emotion.photo }}" class="emotion-photo" alt="{{ emotion.nom }}">
                                                {% endif %}
                                                <p class="mb-0">Supprimer <strong>{{ emotion.nom }}</strong> ?</p>
                                                <small class="text-muted">Cette action est irréversible.</small>
                                            </div>
                                            <div class="modal-footer">
                                                <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                <form method="post" action="{{ path('app_emotion_delete', {'id': emotion.id}) }}" style="display:inline">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ emotion.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        <i class="ti ti-trash me-1"></i>Supprimer
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="ti ti-mood-sad fs-2 d-block mb-2"></i>
                                {% if search %}
                                    Aucune émotion trouvée pour « <strong>{{ search }}</strong> »
                                {% else %}
                                    Aucune émotion enregistrée
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                {{ knp_pagination_render(emotions) }}
            </div>
        </div>
    </div>

</div>
{% endblock %}
