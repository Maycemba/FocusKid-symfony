{# templates/emotion/_delete_form.html.twig #}
<form method="post" action="{{ path('app_emotion_delete', {'id': emotion.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette émotion ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ emotion.id) }}">
    <button type="submit" class="btn btn-danger">
        <i class="ti ti-trash"></i> Supprimer
    </button>
</form>