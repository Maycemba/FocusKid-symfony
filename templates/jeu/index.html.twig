{% extends 'base-back.html.twig' %}

{% block title %}Jeu index{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/jeu.css') }}">
{% endblock %}

{% block body %}
    <h1>Jeu index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Niveau</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for jeu in jeus %}
            <tr>
                <td>{{ jeu.id }}</td>
                <td>{{ jeu.titre }}</td>
                <td>{{ jeu.niveau }}</td>
                <td>
                    <a href="{{ path('app_jeu_show', {'id': jeu.id}) }}" class="btn btn-info btn-sm">show</a>
                    <a href="{{ path('app_jeu_edit', {'id': jeu.id}) }}" class="btn btn-warning btn-sm">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_jeu_new') }}" class="btn btn-primary">Create new</a>
{% endblock %}
