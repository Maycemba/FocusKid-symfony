{{ form_start(form) }}
    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_row(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Quiz Mathématiques'}}) }}
        </div>
        <div class="col-md-3 mb-3">
            {{ form_row(form.type, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="col-md-3 mb-3">
            {{ form_row(form.niveau, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="d-grid gap-2">
        <button class="btn btn-primary btn-lg">
            <i class="fas fa-save"></i> {{ button_label|default('Enregistrer et ajouter des questions') }}
        </button>
    </div>
{{ form_end(form) }}
