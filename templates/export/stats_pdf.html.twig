<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Rapport de performances - {{ enfant.username }}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            background: #ffffff;
            color: #333;
            line-height: 1.4;
            font-size: 12px;
        }
        .report {
            max-width: 1000px;
            margin: 0 auto;
            background: white;
        }
        
        /* Header */
        .header {
            background: #1a252f;
            color: white;
            padding: 20px 30px;
            text-align: center;
        }
        .header h1 {
            font-size: 20px;
            font-weight: 500;
            margin-bottom: 5px;
        }
        .header p {
            font-size: 11px;
            opacity: 0.7;
        }
        
        /* Child info */
        .child-info {
            background: #f8f9fa;
            padding: 12px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #e9ecef;
        }
        .child-name {
            font-size: 16px;
            font-weight: 600;
            color: #2c3e50;
        }
        .child-name span {
            background: #3498db;
            color: white;
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 10px;
            margin-left: 8px;
        }
        .report-date {
            color: #6c757d;
            font-size: 11px;
        }
        
        /* Stats Grid - KPI + Progression côte à côte */
        .stats-main-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            padding: 20px 30px;
            background: #ffffff;
        }
        
        /* KPI Cards - 2x2 grid */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }
        .kpi-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            border: 1px solid #e9ecef;
        }
        .kpi-value {
            font-size: 28px;
            font-weight: 700;
            color: #2c3e50;
        }
        .kpi-label {
            font-size: 11px;
            color: #6c757d;
            margin-top: 5px;
        }
        
        /* Progression Card - à côté des KPI */
        .progress-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            border: 1px solid #e9ecef;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .progress-title {
            font-size: 11px;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .progress-value {
            font-size: 36px;
            font-weight: 700;
            margin: 10px 0;
        }
        .progress-positive {
            color: #27ae60;
        }
        .progress-negative {
            color: #e74c3c;
        }
        .progress-message {
            font-size: 11px;
            color: #6c757d;
        }
        
        /* Section titles */
        .section {
            padding: 0 30px 20px 30px;
        }
        .section-title {
            font-size: 15px;
            font-weight: 600;
            color: #2c3e50;
            padding-bottom: 8px;
            margin-bottom: 15px;
            border-bottom: 2px solid #e9ecef;
        }
        
        /* Tableau */
        .table-wrapper {
            overflow-x: auto;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }
        th {
            background: #f8f9fa;
            color: #495057;
            padding: 8px 10px;
            text-align: left;
            font-weight: 600;
            border-bottom: 2px solid #dee2e6;
        }
        td {
            padding: 6px 10px;
            border-bottom: 1px solid #e9ecef;
        }
        .score-good {
            color: #27ae60;
            font-weight: 600;
        }
        .score-bad {
            color: #e74c3c;
        }
        .badge-success {
            background: #d4edda;
            color: #155724;
            padding: 2px 8px;
            border-radius: 20px;
            font-size: 10px;
            display: inline-block;
        }
        .badge-danger {
            background: #f8d7da;
            color: #721c24;
            padding: 2px 8px;
            border-radius: 20px;
            font-size: 10px;
            display: inline-block;
        }
        
        /* Synthesis grid */
        .synthesis-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: 15px;
        }
        .synthesis-item {
            background: #f8f9fa;
            padding: 12px;
            border-radius: 10px;
            text-align: center;
        }
        .synthesis-value {
            font-size: 20px;
            font-weight: 700;
            color: #2c3e50;
        }
        .synthesis-label {
            font-size: 10px;
            color: #6c757d;
            margin-top: 3px;
        }
        
        /* Footer */
        .footer {
            background: #f8f9fa;
            text-align: center;
            padding: 12px;
            font-size: 10px;
            color: #6c757d;
            border-top: 1px solid #e9ecef;
            margin-top: 15px;
        }
    </style>
</head>
<body>
    <div class="report">
        <!-- Header -->
        <div class="header">
            <h1>Rapport de performances</h1>
            <p>FocusKids - Suivi pedagogique personnalise</p>
        </div>
        
        <!-- Child info -->
        <div class="child-info">
            <div class="child-name">
                {{ enfant.username }}
                <span>Enfant</span>
            </div>
            <div class="report-date">
                Genere le {{ date|date('d/m/Y H:i') }}
            </div>
        </div>
        
        <!-- Stats: KPI + Progression côte à côte -->
        <div class="stats-main-grid">
            <!-- KPI Cards (2x2 grid) -->
            <div class="kpi-grid">
                <div class="kpi-card">
                    <div class="kpi-value">{{ totalExercices }}</div>
                    <div class="kpi-label">Exercices tentes</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-value">{{ scoreTotal }}</div>
                    <div class="kpi-label">Score total</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-value">{{ scoreMoyen }}</div>
                    <div class="kpi-label">Score moyen</div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-value">{{ tauxReussite }}%</div>
                    <div class="kpi-label">Taux de reussite</div>
                </div>
            </div>
            
            <!-- Progression Card -->
            <div class="progress-card">
                <div class="progress-title">Progression globale</div>
                <div class="progress-value {% if progression > 0 %}progress-positive{% elseif progression < 0 %}progress-negative{% endif %}">
                    {% if progression > 0 %}+{% endif %}{{ progression }} points
                </div>
                <div class="progress-message">
                    {% if progression > 20 %}
                        Excellente progression ! Continuez ainsi.
                    {% elseif progression > 0 %}
                        Bonne progression, encouragez l'enfant.
                    {% elseif progression == 0 %}
                        Progression stable.
                    {% else %}
                        Des efforts supplementaires sont necessaires.
                    {% endif %}
                </div>
            </div>
        </div>
        
        <!-- Exercise details -->
        <div class="section">
            <div class="section-title">Detail des exercices</div>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th style="width: 30%">Date</th>
                            <th style="width: 15%">Score</th>
                            <th style="width: 15%">Temps</th>
                            <th style="width: 40%">Resultat</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for r in reponses %}
                        <tr>
                            <td>{{ r.datePassage|date('d/m/Y H:i') }}</td>
                            <td class="{% if r.score >= 60 %}score-good{% elseif r.score <= 30 %}score-bad{% endif %}">
                                <strong>{{ r.score }}</strong>
                            </td>
                            <td>{{ r.tempsPasse }} sec</td>
                            <td>
                                {% if r.reussite %}
                                    <span class="badge-success">✓ Reussi</span>
                                {% else %}
                                    <span class="badge-danger">✗ Echoue</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- Synthesis -->
        <div class="section">
            <div class="section-title">Synthese</div>
            <div class="synthesis-grid">
                <div class="synthesis-item">
                    <div class="synthesis-value">{{ maxScore }}</div>
                    <div class="synthesis-label">Meilleur score</div>
                </div>
                <div class="synthesis-item">
                    <div class="synthesis-value">{{ tempsMoyen }} sec</div>
                    <div class="synthesis-label">Temps moyen</div>
                </div>
                <div class="synthesis-item">
                    <div class="synthesis-value">{{ reussis }}/{{ totalExercices }}</div>
                    <div class="synthesis-label">Exercices reussis</div>
                </div>
            </div>
        </div>
        
        <!-- Footer -->
        <div class="footer">
            <p>FocusKids - Plateforme educative pour enfants</p>
            <p>Rapport genere automatiquement</p>
        </div>
    </div>
</body>
</html>