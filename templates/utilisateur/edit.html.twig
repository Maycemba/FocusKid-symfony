{% extends 'base-back.html.twig' %}

{% block title %}Modifier — {{ utilisateur.username }}{% endblock %}

{% block body %}
<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-semibold mb-1">Modifier l'utilisateur</h4>
            <p class="text-muted mb-0">Modification de « {{ utilisateur.username }} »</p>
        </div>
        <a href="{{ path('app_utilisateur_index') }}" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i> Retour
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                   {% if errors is defined and errors|length > 0 %}
    <div class="alert alert-danger rounded-3">
        <ul class="mb-0">
            {% for e in errors %}
                <li>{{ e }}</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}

                    <form method="POST"
                          action="{{ path('app_utilisateur_edit', {'id': utilisateur.id}) }}">

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Nom d'utilisateur <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="username" class="form-control"
                                   value="{{ utilisateur.username }}" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Email <span class="text-danger">*</span>
                            </label>
                            <input type="email" name="email" class="form-control"
                                   value="{{ utilisateur.email }}" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Nouveau mot de passe
                                <small class="text-muted fw-normal">(laisser vide pour conserver l'actuel)</small>
                            </label>
                            <input type="password" name="password" class="form-control"
                                   placeholder="••••••••">
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Rôle</label>
                            <select name="role" class="form-select">
                                <option value="enfant" {{ utilisateur.role == 'enfant' ? 'selected' : '' }}>
                                    🎓 Enfant
                                </option>
                                <option value="parent" {{ utilisateur.role == 'parent' ? 'selected' : '' }}>
                                    👨‍👩‍👧 Parent
                                </option>
                                <option value="admin" {{ utilisateur.role == 'admin' ? 'selected' : '' }}>
                                    👑 Admin
                                </option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox"
                                       name="isActive" id="isActive"
                                       {{ utilisateur.isActive ? 'checked' : '' }}>
                                <label class="form-check-label fw-semibold" for="isActive">
                                    Compte actif
                                </label>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning px-4">
                                <i class="ti ti-pencil me-1"></i> Mettre à jour
                            </button>
                            <a href="{{ path('app_utilisateur_index') }}"
                               class="btn btn-outline-secondary px-4">
                                Annuler
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}