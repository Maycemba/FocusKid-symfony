{% extends 'base-back.html.twig' %}

{% block title %}Heatmap - {{ enfant.username }} - FocusKids{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .back-btn { background: #FF9800; color: white; border-radius: 25px; padding: 8px 20px; text-decoration: none; display: inline-block; }
        .back-btn:hover { background: #F57C00; color: white; }
        .heatmap-cell { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-size: 11px; border-radius: 5px; }
        .heatmap-jour { font-weight: bold; text-align: center; padding: 8px; }
        .heatmap-heure { font-weight: bold; text-align: center; padding: 8px; }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="{{ path('app_suivi_enfant_menu', {'id': enfant.id}) }}" class="back-btn">
                <i class="ti ti-arrow-left"></i> Retour au menu
            </a>
            <h2 class="fw-bold mt-3">
                <i class="ti ti-chart-pie"></i> Heatmap - {{ enfant.username }}
            </h2>
            <p class="text-muted">Performances par heure et par jour</p>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">🔥 Heatmap des performances</h5>
        </div>
        <div class="card-body table-responsive">
            <table class="table table-bordered text-center">
                <thead>
                    <tr>
                        <th>Jour/H</th>
                        {% for h in 0..23 %}
                            <th>{{ "%02d"|format(h) }}h</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% set jours = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'] %}
                    {% for jour in 1..7 %}
                        <tr>
                            <th>{{ jours[jour-1] }}</th>
                            {% for heure in 0..23 %}
                                {% set data = heatmapData[jour][heure] ?? {'count':0, 'success':0} %}
                                {% set taux = data.count > 0 ? (data.success / data.count * 100) : 0 %}
                                {% set bgColor = taux >= 80 ? '#4CAF50' : (taux >= 50 ? '#FF9800' : (taux > 0 ? '#F44336' : '#f0f0f0')) %}
                                <td style="background-color: {{ bgColor }}; color: {{ taux > 0 ? 'white' : '#666' }};">
                                    {% if data.count > 0 %}
                                        {{ taux|round }}%
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}