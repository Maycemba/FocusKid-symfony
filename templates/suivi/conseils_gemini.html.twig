{% extends 'base-back.html.twig' %}

{% block title %}Conseils IA Gemini - {{ enfant.username }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="{{ path('app_suivi_enfant_menu', {'id': enfant.id}) }}" class="btn btn-warning">
                ⬅️ Retour
            </a>
            <h2 class="fw-bold mt-3">
                <i class="ti ti-brain"></i> Conseils IA - {{ enfant.username }}
            </h2>
            <p class="text-muted">Généré par Google Gemini</p>
        </div>
        <button onclick="window.location.reload()" class="btn btn-primary">
            🔄 Regénérer
        </button>
    </div>
    
    <!-- Stats rapides -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h3>{{ stats.taux_reussite }}%</h3>
                    <small>Taux de réussite</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h3>{{ stats.score_moyen }}/100</h3>
                    <small>Score moyen</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <h3>{{ stats.temps_moyen }}s</h3>
                    <small>Temps moyen</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body text-center">
                    <h3>{{ stats.total }}</h3>
                    <small>Exercices tentés</small>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Conseils Gemini -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">🤖 Recommandations personnalisées (Gemini AI)</h5>
        </div>
        <div class="card-body">
            <div class="advice-content" style="white-space: pre-wrap; line-height: 1.8; font-size: 15px;">
                {{ advice|nl2br }}
            </div>
        </div>
    </div>
    
    <div class="mt-3 text-end">
        <button onclick="window.print()" class="btn btn-secondary">
            🖨️ Imprimer
        </button>
    </div>
</div>

<style>
    .advice-content {
        font-family: 'Segoe UI', Arial, sans-serif;
    }
    .advice-content h1, .advice-content h2, .advice-content h3 {
        color: #3498db;
        margin-top: 15px;
    }
    @media print {
        .btn, .btn-primary, .btn-warning, .btn-secondary { display: none; }
    }
</style>
{% endblock %}