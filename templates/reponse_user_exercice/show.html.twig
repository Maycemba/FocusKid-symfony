{% extends 'base.html.twig' %}

{% block title %}ReponseUserExercice{% endblock %}

{% block body %}
    <h1>ReponseUserExercice</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id_rep_user</th>
                <td>{{ reponse_user_exercice.idRepUser }}</td>
            </tr>
            <tr>
                <th>Reponse</th>
                <td>{{ reponse_user_exercice.reponse }}</td>
            </tr>
            <tr>
                <th>Est_correcte</th>
                <td>{{ reponse_user_exercice.estCorrecte ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Temps_reponse</th>
                <td>{{ reponse_user_exercice.tempsReponse }}</td>
            </tr>
            <tr>
                <th>Date_reponse</th>
                <td>{{ reponse_user_exercice.dateReponse ? reponse_user_exercice.dateReponse|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_reponse_user_exercice_index') }}">back to list</a>

    <a href="{{ path('app_reponse_user_exercice_edit', {'id_rep_user': reponse_user_exercice.id_rep_user}) }}">edit</a>

    {{ include('reponse_user_exercice/_delete_form.html.twig') }}
{% endblock %}
