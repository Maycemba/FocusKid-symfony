{% extends 'base-back.html.twig' %}

{% block title %}Détail - Émotion{% endblock %}

{% block body %}
<div class="container-fluid">

    <div class="card bg-light-info shadow-none position-relative overflow-hidden mb-4">
        <div class="card-body px-4 py-3">
            <h4 class="fw-semibold mb-8">Détail de l'émotion</h4>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-bordered">
                <tbody>
                    <tr><th>Nom</th><td>{{ emotion.nom }}</td></tr>
                    <tr>
                        <th>Photo</th>
                        <td>
                            {% if emotion.photo %}
                                <img src="data:image/png;base64,{{ emotion.photo }}"
                                     style="max-width:200px; border-radius:8px;">
                            {% else %}
                                <span class="text-muted">Aucune photo</span>
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="mt-3 d-flex gap-2">
                <a href="{{ path('app_emotion_index') }}" class="btn btn-secondary">← Retour</a>
                <a href="{{ path('app_emotion_edit', {'id': emotion.id}) }}" class="btn btn-warning">Modifier</a>
                <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">Supprimer</button>
            </div>
        </div>
    </div>

    {# Modal suppression #}
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmer la suppression</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">Supprimer <strong>{{ emotion.nom }}</strong> ?</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <form method="post" action="{{ path('app_emotion_delete', {'id': emotion.id}) }}" style="display:inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ emotion.id) }}">
                        <button type="submit" class="btn btn-danger">Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}