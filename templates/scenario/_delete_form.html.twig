<form method="post" action="{{ path('app_scenario_delete', {'id': scenario.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer ce scénario ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ scenario.id) }}">
    <button type="submit" class="btn btn-danger">
        <i class="ti ti-trash"></i> Supprimer
    </button>
</form>