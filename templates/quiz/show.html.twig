{% extends 'base.html.twig' %}

{% block title %}Quiz{% endblock %}

{% block body %}
    <h1>Quiz</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id_quiz</th>
                <td>{{ quiz.idQuiz }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ quiz.titre }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ quiz.description }}</td>
            </tr>
            <tr>
                <th>Difficulte</th>
                <td>{{ quiz.difficulte }}</td>
            </tr>
            <tr>
                <th>Points_total</th>
                <td>{{ quiz.pointsTotal }}</td>
            </tr>
            <tr>
                <th>Duree_totale</th>
                <td>{{ quiz.dureeTotale }}</td>
            </tr>
            <tr>
                <th>Est_actif</th>
                <td>{{ quiz.estActif ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_quiz_index') }}">back to list</a>

    <a href="{{ path('app_quiz_edit', {'id_quiz': quiz.id_quiz}) }}">edit</a>

    {{ include('quiz/_delete_form.html.twig') }}
{% endblock %}
