{% extends 'base.html.twig' %}

{% block title %}Quiz index{% endblock %}

{% block body %}
    <h1>Quiz index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id_quiz</th>
                <th>Titre</th>
                <th>Description</th>
                <th>Difficulte</th>
                <th>Points_total</th>
                <th>Duree_totale</th>
                <th>Est_actif</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for quiz in quizzes %}
            <tr>
                <td>{{ quiz.idQuiz }}</td>
                <td>{{ quiz.titre }}</td>
                <td>{{ quiz.description }}</td>
                <td>{{ quiz.difficulte }}</td>
                <td>{{ quiz.pointsTotal }}</td>
                <td>{{ quiz.dureeTotale }}</td>
                <td>{{ quiz.estActif ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_quiz_show', {'id_quiz': quiz.id_quiz}) }}">show</a>
                    <a href="{{ path('app_quiz_edit', {'id_quiz': quiz.id_quiz}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_quiz_new') }}">Create new</a>
{% endblock %}
