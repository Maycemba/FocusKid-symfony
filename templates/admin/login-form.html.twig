<form id="login-admin-form-ajax" method="post" action="{{ path('app_admin_login') }}" novalidate>{% if error %}
        <div class="alert alert-danger rounded-pill mb-4">
            <i class="fas fa-face-frown me-2"></i> {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <div class="mb-3">
        <div class="input-modern">
            <i class="fas fa-user-astronaut"></i>
            <input type="text" 
                   name="username" 
                   placeholder="Ton nom d'utilisateur"
                   value="{{ savedUsername }}"
                   required autofocus>
        </div>
    </div>

    <div class="mb-3">
        <div class="input-modern">
            <i class="fas fa-key"></i>
            <input type="password" 
                   name="password" 
                   placeholder="Ton mot de passe secret"
                   required>
        </div>
    </div>

    <!-- CAPTCHA -->
    <div class="mb-3">
        <div class="bg-light rounded-3 p-3">
            <div class="d-flex align-items-center gap-2 mb-2">
                <img id="captcha-img" 
                     src="{{ captchaUrl }}" 
                     alt="Code" 
                     style="height: 45px; width: 150px; object-fit: cover; border-radius: 12px; cursor: pointer;">
                <button type="button" 
                        class="btn btn-sm btn-outline-secondary rounded-circle captcha-refresh"
                        style="width: 45px; height: 45px;">
                    <i class="fas fa-arrows-rotate"></i>
                </button>
            </div>
            <div class="input-modern">
                <i class="fas fa-shield-heart"></i>
                <input type="text" 
                       name="captcha" 
                       placeholder="Code de sécurité"
                       maxlength="5"
                       style="text-transform: uppercase;"
                       required>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <label class="d-flex align-items-center gap-2">
            <input type="checkbox" name="remember_me" value="1" {{ rememberChecked ? 'checked' : '' }}>
            <small>Se souvenir de moi</small>
        </label>
        <a href="{{ path('app_forgot_password') }}" class="text-decoration-none small" style="color: var(--orange);">
            Mot de passe oublié ?
        </a>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold">
        🚀 Se connecter
    </button>
   
</form>

<script>
    // Rafraîchissement CAPTCHA
    document.querySelectorAll('.captcha-refresh').forEach(btn => {
        btn.addEventListener('click', function() {
            const img = this.closest('.bg-light').querySelector('img');
            img.src = '{{ path('app_captcha_image') }}?t=' + Date.now();
        });
    });
    const captchaImg = document.getElementById('captcha-img');
    if(captchaImg) {
        captchaImg.addEventListener('click', () => {
            captchaImg.src = '{{ path('app_captcha_image') }}?t=' + Date.now();
        });
    }
</script>