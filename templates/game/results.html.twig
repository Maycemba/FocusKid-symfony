{% extends 'base-front.html.twig' %}

{% block title %}Résultats - {{ jeu.titre }}{% endblock %}

{% block body %}
<div class="container-xxl py-5 mt-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 text-center">
                <div class="card border-0 shadow-lg p-5 bg-white wow zoomIn" style="border-radius: 30px;">
                    <h1 class="display-4 text-primary mb-4 lobster-font">Bravo !</h1>
                    <p class="fs-4 mb-4">Tu as terminé le jeu : <strong>{{ jeu.titre }}</strong></p>
                    
                    <div class="score-circle mx-auto mb-4">
                        <span class="score-number">{{ score }}</span>
                        <span class="score-total">/ {{ total }}</span>
                    </div>

                    <p class="mb-5 text-muted">
                        {% if score == total %}
                            Incroyable ! Tu as eu toutes les réponses justes ! 🌟
                        {% elseif score >= total / 2 %}
                            C'est un super score ! Continue comme ça ! 👍
                        {% else %}
                            Pas mal ! Tu peux encore t'améliorer, réessaie encore ! 💪
                        {% endif %}
                    </p>

                    <div class="d-grid gap-3">
                        <a href="{{ path('app_game_play', {id: jeu.id}) }}" class="btn btn-primary rounded-pill py-3 fs-5">
                            <i class="fas fa-redo me-2"></i> Rejouer
                        </a>
                        <a href="{{ path('app_games_index') }}" class="btn btn-outline-secondary rounded-pill py-3 fs-5">
                            <i class="fas fa-home me-2"></i> Retour aux jeux
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .lobster-font {
        font-family: 'Lobster Two', cursive;
    }

    .score-circle {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: #f0f9ff;
        border: 8px solid #00B1FF;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 20px rgba(0, 177, 255, 0.1);
    }

    .score-number {
        font-size: 3.5rem;
        font-weight: bold;
        color: #00B1FF;
        line-height: 1;
    }

    .score-total {
        font-size: 1.2rem;
        color: #555;
        font-weight: 600;
    }
</style>
{% endblock %}
