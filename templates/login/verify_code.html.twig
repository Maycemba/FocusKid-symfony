<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>FocusKid — Vérification du code</title>
    <link rel="stylesheet" href="{{ asset('base-back/assets/css/styles.min.css') }}"/>
    <style>
        body {
            min-height: 100vh; display: flex; align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            margin: 0;
        }
        .card-wrap {
            background: white; border-radius: 20px; padding: 48px 40px;
            width: 100%; max-width: 440px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        }
        .icon-box {
            width: 72px; height: 72px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-radius: 18px; display: flex; align-items: center;
            justify-content: center; margin: 0 auto 20px;
        }
        .icon-box i { font-size: 32px; color: white; }
        h1 { font-size: 24px; font-weight: 700; color: #2d3748; text-align: center; margin: 0 0 8px; }
        p.sub { text-align: center; color: #718096; font-size: 14px; margin: 0 0 28px; }
        .email-badge {
            background: #ebf4ff; border-radius: 8px; padding: 8px 14px;
            color: #3182ce; font-size: 13px; font-weight: 600;
            text-align: center; margin-bottom: 24px;
        }

        .form-label { font-weight: 600; font-size: 13px; color: #4a5568; display: block; margin-bottom: 6px; }
        .code-input {
            width: 100%; padding: 16px;
            border: 2px solid #e2e8f0; border-radius: 10px;
            font-size: 28px; font-weight: 700; color: #2d3748;
            text-align: center; letter-spacing: 12px;
            outline: none; margin-bottom: 20px; box-sizing: border-box;
        }
        .code-input:focus { border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,0.15); }
        .btn-submit {
            width: 100%; padding: 13px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border: none; border-radius: 10px; color: white;
            font-size: 15px; font-weight: 600; cursor: pointer;
        }
        .btn-submit:hover { opacity: 0.9; }
        .alert-error {
            background: #fff5f5; border: 1.5px solid #fed7d7;
            border-radius: 10px; color: #c53030;
            padding: 12px 16px; font-size: 13px; margin-bottom: 20px;
        }
        .back-link { text-align: center; margin-top: 20px; }
        .back-link a { color: #667eea; font-size: 13px; text-decoration: none; }
        .steps { display: flex; justify-content: center; gap: 8px; margin-bottom: 28px; }
        .step { width: 32px; height: 6px; border-radius: 3px; background: #e2e8f0; }
        .step.active { background: #667eea; }
    </style>
</head>
<body>
<div style="padding:16px;width:100%;max-width:440px">
    <div class="card-wrap">
        <div class="icon-box"><i class="ti ti-mail-check"></i></div>
        <h1>Vérification du code</h1>
        <p class="sub">Entrez le code à 6 chiffres envoyé à</p>

        <div class="email-badge">📧 {{ email }}</div>
        <div class="steps">
            <div class="step active"></div>
            <div class="step active"></div>
            <div class="step"></div>
        </div>

        {% if error %}
            <div class="alert-error"><i class="ti ti-alert-circle me-2"></i>{{ error }}</div>
        {% endif %}

        <form method="POST" action="{{ path('app_verify_code') }}">
            <label class="form-label">Code de vérification</label>
            <input type="text" name="code" class="code-input"
                   placeholder="000000" maxlength="6"
                   autocomplete="off" required autofocus>
            <button type="submit" class="btn-submit">
                Vérifier le code ✅
            </button>
        </form>

        <div class="back-link">
            <a href="{{ path('app_forgot_password') }}">← Renvoyer le code</a>
        </div>
    </div>
</div>
</body>
</html>