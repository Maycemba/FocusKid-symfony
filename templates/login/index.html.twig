<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>FocusKid — Connexion</title>
    <link rel="shortcut icon" type="image/png" href="{{ asset('assets/images/logos/favicon.png') }}"/>
    <link rel="stylesheet" href="{{ asset('base-back/assets/css/styles.min.css') }}"/>
    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            margin: 0;
        }
        .login-wrapper {
            width: 100%;
            max-width: 440px;
            padding: 16px;
        }
        .login-card {
            background: #fff;
            border-radius: 20px;
            padding: 48px 40px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        }
        .login-logo {
            width: 72px;
            height: 72px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }
        .login-logo i { font-size: 32px; color: white; }
        .login-title {
            font-size: 26px;
            font-weight: 700;
            color: #2d3748;
            text-align: center;
            margin: 0 0 6px;
        }
        .login-subtitle {
            text-align: center;
            color: #718096;
            font-size: 14px;
            margin: 0 0 32px;
        }
        .form-label {
            font-weight: 600;
            font-size: 13px;
            color: #4a5568;
            margin-bottom: 6px;
            display: block;
        }
        .input-wrap {
            position: relative;
            margin-bottom: 20px;
        }
        .input-wrap i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #a0aec0;
            font-size: 16px;
            pointer-events: none;
        }
        .input-wrap input {
            width: 100%;
            padding: 12px 16px 12px 42px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            font-size: 14px;
            color: #2d3748;
            transition: border-color 0.2s, box-shadow 0.2s;
            outline: none;
            box-sizing: border-box;
        }
        .input-wrap input:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102,126,234,0.15);
        }
        .remember-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
        }
        .remember-row input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: #667eea;
            cursor: pointer;
        }
        .remember-row label {
            font-size: 13px;
            color: #4a5568;
            cursor: pointer;
            margin: 0;
        }
        .btn-login {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.1s;
        }
        .btn-login:hover {
            opacity: 0.92;
            transform: translateY(-1px);
        }
        .alert-error {
            background: #fff5f5;
            border: 1.5px solid #fed7d7;
            border-radius: 10px;
            color: #c53030;
            padding: 12px 16px;
            font-size: 13px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .role-badges {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 28px;
        }
        .role-badge {
            background: #f7fafc;
            border: 1.5px solid #e2e8f0;
            border-radius: 20px;
            padding: 5px 14px;
            font-size: 12px;
            color: #718096;
        }
        .captcha-wrap {
            margin-bottom: 20px;
        }
        .captcha-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }
        .captcha-img {
            border-radius: 8px;
            border: 1.5px solid #e2e8f0;
            cursor: pointer;
            height: 50px;
            width: 160px;
            object-fit: cover;
        }
        .captcha-refresh {
            background: none;
            border: 1.5px solid #e2e8f0;
            border-radius: 8px;
            padding: 8px 10px;
            cursor: pointer;
            color: #667eea;
            font-size: 18px;
            transition: border-color 0.2s;
        }
        .captcha-refresh:hover { border-color: #667eea; }
        .captcha-hint {
            font-size: 11px;
            color: #a0aec0;
            margin-bottom: 6px;
        }
    </style>
</head>
<body>
<div class="login-wrapper">
    <div class="login-card">

        <div class="login-logo">
            <i class="ti ti-book-2"></i>
        </div>
        <h1 class="login-title">FocusKid</h1>
        <p class="login-subtitle">Connectez-vous à votre espace</p>

        {% if error %}
            <div class="alert-error">
                <i class="ti ti-alert-circle"></i>
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="POST" action="{{ path('app_login') }}" autocomplete="off">

            <label class="form-label">Nom d'utilisateur</label>
            <div class="input-wrap">
                <i class="ti ti-user"></i>
                <input type="text"
                    name="username"
                    placeholder="Entrez votre nom d'utilisateur"
                    value="{{ savedUsername }}"
                    autocomplete="off"
                    required
                    autofocus>
            </div>

            <label class="form-label">Mot de passe</label>
            <div class="input-wrap">
                        <i class="ti ti-lock"></i>
                        <input type="password"
                name="password"
                placeholder="Entrez votre mot de passe"
                value=""
                autocomplete="new-password"
                required>
            </div>

            <!-- CAPTCHA -->
            <div class="captcha-wrap">
                <label class="form-label">Code de sécurité</label>
                <div class="captcha-row">
                    <img id="captcha-img"
                         src="{{ path('app_captcha_image') }}"
                         alt="CAPTCHA"
                         class="captcha-img"
                         title="Cliquez pour rafraîchir">
                    <button type="button" class="captcha-refresh" id="captcha-refresh"
                            title="Nouveau code">&#x21bb;</button>
                </div>
                <p class="captcha-hint">Entrez les 5 caractères affichés (insensible à la casse)</p>
                <div class="input-wrap">
                    <i class="ti ti-shield-check"></i>
                    <input type="text"
                           name="captcha"
                           placeholder="Entrez le code affiché"
                           maxlength="5"
                           autocomplete="off"
                           required
                           style="text-transform:uppercase;letter-spacing:4px;font-weight:600">
                </div>
            </div>

            <!-- Remember Me checkbox -->
                    <div class="remember-row">
                <input type="checkbox"
                    name="remember_me"
                    id="remember_me"
                    value="1"
                    {{ rememberChecked ? 'checked' : '' }}>
                <label for="remember_me">Se souvenir de moi</label>
                <a href="{{ path('app_forgot_password') }}"
                style="margin-left:auto; font-size:13px; color:#667eea; text-decoration:none;">
                    Mot de passe oublié ?
                </a>
            </div>

            {% if lockoutSeconds > 0 %}
            <button type="submit" class="btn-login" disabled
                style="opacity:0.5;cursor:not-allowed;background:linear-gradient(135deg,#a0aec0,#718096);">
                <span id="lockout-label">⏳ Bloqué — éssayez dans <span id="countdown">{{ lockoutSeconds }}</span>s</span>
            </button>
            <script>
            (function() {
                var secs = {{ lockoutSeconds }};
                var el   = document.getElementById("countdown");
                var btn  = document.querySelector(".btn-login");
                var label = document.getElementById("lockout-label");
                var timer = setInterval(function() {
                    secs--;
                    if (secs <= 0) {
                        clearInterval(timer);
                        btn.disabled = false;
                        btn.style.opacity = "1";
                        btn.style.cursor  = "pointer";
                        btn.style.background = "linear-gradient(135deg,#667eea,#764ba2)";
                        label.innerHTML = "Se connecter &rarr;";
                    } else {
                        el.textContent = secs;
                    }
                }, 1000);
            })();
            </script>
            {% else %}
            <button type="submit" class="btn-login">
                Se connecter &rarr;
            </button>
            {% endif %}

        </form>

        <div class="role-badges">
            <span class="role-badge">👑 Admin</span>
            <span class="role-badge">🎓 Étudiant</span>
            <span class="role-badge">👨‍👩‍👧 Parent</span>
        </div>

    </div>
</div>
<script>
function refreshCaptcha() {
    var img = document.getElementById('captcha-img');
    img.src = '{{ path('app_captcha_image') }}?t=' + Date.now();
}
document.getElementById('captcha-refresh').addEventListener('click', refreshCaptcha);
document.getElementById('captcha-img').addEventListener('click', refreshCaptcha);
</script>
</body>
</html>