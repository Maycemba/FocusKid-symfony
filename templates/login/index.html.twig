{% extends 'base-front.html.twig' %}

{% block title %}FocusKid - L'aventure éducative commence ici{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --orange: #FF6B35;
        --blue: #4A90E2;
        --purple: #9B59B6;
        --green: #27AE60;
    }

    /* Hero Section Style Connexion */
    .hero-welcome {
        min-height: 90vh;
        background: linear-gradient(135deg, rgba(255,107,53,0.95), rgba(74,144,226,0.95)), url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="3" fill="white" opacity="0.3"/><circle cx="80" cy="40" r="2" fill="white" opacity="0.2"/><circle cx="50" cy="80" r="4" fill="white" opacity="0.25"/></svg>');
        background-size: cover;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .floating-elements {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        pointer-events: none;
    }

    .float-1, .float-2, .float-3 {
        position: absolute;
        animation: float 6s ease-in-out infinite;
    }

    .float-1 { top: 10%; left: 5%; font-size: 40px; animation-delay: 0s; }
    .float-2 { bottom: 15%; right: 8%; font-size: 50px; animation-delay: 2s; }
    .float-3 { top: 30%; right: 15%; font-size: 35px; animation-delay: 4s; }

    @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
    }

    /* Card de connexion fusionnée */
    .login-card-modern {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(10px);
        border-radius: 28px;
        padding: 40px 32px;
        box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
        border: 1px solid rgba(255,255,255,0.3);
        transition: transform 0.3s ease;
    }

    .login-card-modern:hover {
        transform: translateY(-5px);
    }

    /* Features améliorées */
    .feature-card {
        background: white;
        border-radius: 20px;
        padding: 30px 20px;
        transition: all 0.4s ease;
        cursor: pointer;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .feature-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }

    .feature-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        transition: transform 0.3s ease;
    }

    .feature-card:hover .feature-icon {
        transform: scale(1.1) rotate(5deg);
    }

    .feature-icon i {
        font-size: 30px;
        color: white;
    }

    /* Inputs style connexion */
    .input-modern {
        position: relative;
    }

    .input-modern i {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--orange);
        font-size: 18px;
    }

    .input-modern input {
        width: 100%;
        padding: 12px 16px 12px 48px;
        border: 2px solid #e5e7eb;
        border-radius: 16px;
        font-size: 15px;
        transition: all 0.3s;
        outline: none;
    }

    .input-modern input:focus {
        border-color: var(--orange);
        box-shadow: 0 0 0 3px rgba(255,107,53,0.1);
    }

    /* CTA Banner */
    .cta-banner {
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        border-radius: 30px;
        padding: 60px 40px;
        position: relative;
        overflow: hidden;
    }

    .cta-banner::before {
        content: '🎓';
        position: absolute;
        font-size: 150px;
        opacity: 0.1;
        bottom: -30px;
        right: -30px;
        transform: rotate(-15deg);
    }

    /* Stats animées */
    .stat-number {
        font-size: 48px;
        font-weight: 800;
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* Animation fade in */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fadeInUp {
        animation: fadeInUp 0.8s ease-out;
    }
</style>
{% endblock %}

{% block body %}
<!-- Hero Section Fusionnée -->
<div class="hero-welcome">
    <div class="floating-elements">
        <div class="float-1">🌟</div>
        <div class="float-2">🎨</div>
        <div class="float-3">📚</div>
    </div>
    
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- Colonne Texte -->
            <div class="col-lg-7 hero-content animate-fadeInUp">
                <div class="mb-4">
                    <span class="badge bg-white text-dark px-4 py-2 rounded-pill mb-3">
                        🎉 La nouvelle façon d'apprendre
                    </span>
                </div>
                <h1 class="display-3 fw-bold text-white mb-4">
                    Bienvenue dans l'aventure<br>
                    <span class="text-warning">FocusKid</span> ✨
                </h1>
                <p class="lead text-white-50 mb-4 fs-4">
                    Apprendre en s'amusant avec des exercices interactifs, des jeux éducatifs 
                    et un suivi personnalisé pour votre enfant.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="#" class="btn btn-light btn-lg rounded-pill px-5 py-3 fw-bold" 
                       style="box-shadow: 0 10px 20px rgba(0,0,0,0.2);">
                        <i class="fas fa-rocket me-2"></i> Commencer l'aventure
                    </a>
                    <a href="#" class="btn btn-outline-light btn-lg rounded-pill px-5 py-3">
                        <i class="fas fa-play-circle me-2"></i> Voir la démo
                    </a>
                </div>
                
                <!-- Mini stats -->
                <div class="row mt-5 g-3">
                    <div class="col-4">
                        <div class="text-white">
                            <h3 class="fw-bold mb-0">500+</h3>
                            <small>Exercices</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="text-white">
                            <h3 class="fw-bold mb-0">50+</h3>
                            <small>Jeux</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="text-white">
                            <h3 class="fw-bold mb-0">98%</h3>
                            <small>Satisfaits</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Colonne Connexion (Carte moderne) -->
            <div class="col-lg-5 animate-fadeInUp" style="animation-delay: 0.2s;">
                <div class="login-card-modern">
                    <div class="text-center mb-4">
                        <div class="mx-auto mb-3" style="width: 60px; height: 60px; background: linear-gradient(135deg, #FF6B35, #4A90E2); border-radius: 18px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-graduation-cap fa-2x text-white"></i>
                        </div>
                        <h2 class="h3 fw-bold mb-2">Déjà inscrit ?</h2>
                        <p class="text-muted">Connecte-toi à ton espace magique</p>
                    </div>

                    {% if error %}
                        <div class="alert alert-danger rounded-pill mb-4">
                            <i class="fas fa-face-frown me-2"></i> {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <form method="POST" action="{{ path('app_login') }}">
                        <div class="mb-3">
                            <div class="input-modern">
                                <i class="fas fa-user-astronaut"></i>
                                <input type="text" 
                                       name="username" 
                                       placeholder="Ton nom d'utilisateur"
                                       value="{{ savedUsername }}"
                                       required autofocus>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="input-modern">
                                <i class="fas fa-key"></i>
                                <input type="password" 
                                       name="password" 
                                       placeholder="Ton mot de passe secret"
                                       required>
                            </div>
                        </div>

                        <!-- CAPTCHA simplifié -->
                        <div class="mb-3">
                            <div class="bg-light rounded-3 p-3">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <img id="captcha-img" 
                                         src="{{ path('app_captcha_image') }}" 
                                         alt="Code" 
                                         style="height: 45px; width: 150px; object-fit: cover; border-radius: 12px; cursor: pointer;">
                                    <button type="button" 
                                            class="btn btn-sm btn-outline-secondary rounded-circle" 
                                            id="captcha-refresh"
                                            style="width: 45px; height: 45px;">
                                        <i class="fas fa-arrows-rotate"></i>
                                    </button>
                                </div>
                                <div class="input-modern">
                                    <i class="fas fa-shield-heart"></i>
                                    <input type="text" 
                                           name="captcha" 
                                           placeholder="Code de sécurité"
                                           maxlength="5"
                                           style="text-transform: uppercase;"
                                           required>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <label class="d-flex align-items-center gap-2">
                                <input type="checkbox" name="remember_me" value="1" {{ rememberChecked ? 'checked' : '' }}>
                                <small>Se souvenir de moi</small>
                            </label>
                            <a href="{{ path('app_forgot_password') }}" class="text-decoration-none small" style="color: var(--orange);">
                                Mot de passe oublié ?
                            </a>
                        </div>

                        {% if lockoutSeconds > 0 %}
                            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold" disabled>
                                <i class="fas fa-hourglass-half me-2"></i>
                                Attends <span id="countdown">{{ lockoutSeconds }}</span> sec
                            </button>
                            <script>
                                let secs = {{ lockoutSeconds }};
                                const timer = setInterval(() => {
                                    secs--;
                                    if(secs <= 0) {
                                        clearInterval(timer);
                                        document.querySelector('.btn-primary').disabled = false;
                                        document.querySelector('.btn-primary').innerHTML = '🚀 Se connecter <i class="fas fa-arrow-right ms-2"></i>';
                                    } else {
                                        document.getElementById('countdown').textContent = secs;
                                    }
                                }, 1000);
                            </script>
                        {% else %}
                            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold">
                                🚀 Se connecter
                            </button>
                        {% endif %}
                    </form>

                    <hr class="my-4">

                    <p class="text-center mb-0">
                        <small>Nouveau sur FocusKid ? 
                            <a href="{{ path('app_register') }}"  class="fw-bold text-decoration-none" style="color: var(--orange);">
                                Créer un compte gratuit
                            </a>
                        </small>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section Fonctionnalités -->
<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="display-5 fw-bold mb-3">Pourquoi les enfants <span style="background: linear-gradient(135deg, #FF6B35, #4A90E2); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">adorent FocusKid</span> ?</h2>
        <p class="lead text-muted">Une expérience d'apprentissage unique qui éveille la curiosité</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="feature-card text-center">
                <div class="feature-icon">
                    <i class="fas fa-puzzle-piece"></i>
                </div>
                <h4 class="fw-bold mb-3">Exercices ludiques</h4>
                <p class="text-muted">Des activités adaptées à chaque âge qui transforment l'apprentissage en jeu</p>
                <div class="mt-3">
                    <span class="badge bg-light text-dark">🎯 200+ exercices</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card text-center">
                <div class="feature-icon">
                    <i class="fas fa-gamepad"></i>
                </div>
                <h4 class="fw-bold mb-3">Jeux éducatifs</h4>
                <p class="text-muted">Développe la logique, la mémoire et la créativité en s'amusant</p>
                <div class="mt-3">
                    <span class="badge bg-light text-dark">🎮 50+ jeux</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card text-center">
                <div class="feature-icon">
                    <i class="fas fa-chart-simple"></i>
                </div>
                <h4 class="fw-bold mb-3">Suivi personnalisé</h4>
                <p class="text-muted">Tableau de bord parents pour suivre les progrès en temps réel</p>
                <div class="mt-3">
                    <span class="badge bg-light text-dark">📊 Rapports détaillés</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section Témoignages + Stats -->
<div class="container-fluid bg-light py-5">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <h2 class="display-5 fw-bold mb-4">
                    Ils nous font <span style="color: var(--orange);">confiance</span>
                </h2>
                <div class="mb-4">
                    <div class="d-flex gap-2 mb-3">
                        <i class="fas fa-star text-warning"></i>
                        <i class="fas fa-star text-warning"></i>
                        <i class="fas fa-star text-warning"></i>
                        <i class="fas fa-star text-warning"></i>
                        <i class="fas fa-star text-warning"></i>
                    </div>
                    <p class="fs-5 fst-italic">"Mon fils adore faire ses exercices sur FocusKid. Il progresse vraiment et prend plaisir à apprendre !"</p>
                    <div class="d-flex align-items-center gap-3">
                        <img src="https://randomuser.me/api/portraits/women/68.jpg" class="rounded-circle" width="50" height="50" alt="Parent">
                        <div>
                            <strong>Sophie Martin</strong><br>
                            <small class="text-muted">Maman de Léo, 8 ans</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="row g-4">
                    <div class="col-6">
                        <div class="bg-white p-4 rounded-4 text-center shadow-sm">
                            <div class="stat-number">1000+</div>
                            <p class="mb-0 text-muted">Enfants inscrits</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="bg-white p-4 rounded-4 text-center shadow-sm">
                            <div class="stat-number">98%</div>
                            <p class="mb-0 text-muted">Parents satisfaits</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="bg-white p-4 rounded-4 text-center shadow-sm">
                            <div class="stat-number">500+</div>
                            <p class="mb-0 text-muted">Exercices créés</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="bg-white p-4 rounded-4 text-center shadow-sm">
                            <div class="stat-number">4.9</div>
                            <p class="mb-0 text-muted">⭐ Note moyenne</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CTA Final -->
<div class="container py-5">
    <div class="cta-banner text-white text-center">
        <h2 class="display-5 fw-bold mb-3">Prêt à rejoindre l'aventure FocusKid ?</h2>
        <p class="lead mb-4">Inscris-toi gratuitement et découvre un monde où apprendre devient un jeu</p>
        <a  href="{{ path('app_register') }}" class="btn btn-light btn-lg rounded-pill px-5 py-3 fw-bold">
            <i class="fas fa-user-plus me-2"></i> Créer mon compte gratuitement
        </a>
        <p class="mt-3 mb-0 small">✨ Aucune carte bancaire requise - Gratuit pour toujours</p>
    </div>
</div>

<style>
    .btn-primary {
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        border: none;
        transition: all 0.3s;
    }
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(255,107,53,0.3);
    }
    .badge.bg-light.text-dark {
        background: #f3f4f6 !important;
        padding: 8px 16px;
    }
</style>
{% endblock %}

{% block javascripts %}
<script>
function refreshCaptcha() {
    const img = document.getElementById('captcha-img');
    img.src = '{{ path('app_captcha_image') }}?t=' + Date.now();
    img.style.transform = 'rotate(180deg)';
    setTimeout(() => img.style.transform = '', 300);
}

const refreshBtn = document.getElementById('captcha-refresh');
if(refreshBtn) {
    refreshBtn.addEventListener('click', refreshCaptcha);
    document.getElementById('captcha-img').addEventListener('click', refreshCaptcha);
}
</script>
{% endblock %}