{% extends 'base-front.html.twig' %}

{% block title %}FocusKid - Nouveau mot de passe{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --orange: #FF6B35;
        --blue: #4A90E2;
        --teal: #26C6DA;
        --green: #66BB6A;
        --purple: #9B59B6;
    }

    .reset-wrapper {
        min-height: calc(100vh - 300px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        background: linear-gradient(135deg, #FFF5F0 0%, #F0F7FF 100%);
    }

    .reset-card-modern {
        background: white;
        border-radius: 32px;
        padding: 48px 40px;
        box-shadow: 0 25px 50px -12px rgba(0,0,0,0.15);
        max-width: 520px;
        width: 100%;
        transition: transform 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .reset-card-modern:hover {
        transform: translateY(-5px);
    }

    .icon-animated {
        width: 90px;
        height: 90px;
        background: linear-gradient(135deg, var(--orange), var(--blue));
        border-radius: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
        animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
    }

    .icon-animated i {
        font-size: 45px;
        color: white;
    }

    .reset-title {
        font-size: 32px;
        font-weight: 800;
        text-align: center;
        background: linear-gradient(135deg, var(--orange), var(--blue));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 12px;
    }

    .reset-subtitle {
        text-align: center;
        color: #6B7280;
        font-size: 16px;
        margin-bottom: 32px;
        line-height: 1.5;
    }

    .steps-progress {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-bottom: 36px;
    }

    .step-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .step-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: #9CA3AF;
        transition: all 0.3s;
    }

    .step-circle.completed {
        background: var(--green);
        color: white;
    }

    .step-circle.active {
        background: linear-gradient(135deg, var(--orange), var(--blue));
        color: white;
        box-shadow: 0 5px 15px rgba(255,107,53,0.3);
    }

    .step-line {
        width: 50px;
        height: 3px;
        background: #e5e7eb;
        border-radius: 3px;
    }

    .step-line.active {
        background: linear-gradient(90deg, var(--orange), var(--blue));
    }

    .step-label {
        font-size: 11px;
        font-weight: 600;
        color: #9CA3AF;
    }

    .form-group {
        margin-bottom: 24px;
    }

    .form-label {
        font-weight: 700;
        font-size: 14px;
        color: #1F2937;
        margin-bottom: 8px;
        display: block;
    }

    .input-modern {
        position: relative;
    }

    .input-modern i {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--orange);
        font-size: 18px;
        pointer-events: none;
    }

    .input-modern input {
        width: 100%;
        padding: 14px 16px 14px 48px;
        border: 2px solid #e5e7eb;
        border-radius: 20px;
        font-size: 15px;
        transition: all 0.3s;
        outline: none;
        font-family: inherit;
    }

    .input-modern input:focus {
        border-color: var(--orange);
        box-shadow: 0 0 0 3px rgba(255,107,53,0.1);
    }

    .btn-gradient {
        width: 100%;
        padding: 16px;
        background: linear-gradient(135deg, var(--orange), var(--blue));
        border: none;
        border-radius: 30px;
        color: white;
        font-size: 18px;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .btn-gradient:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(255,107,53,0.3);
    }

    .alert-modern {
        border-radius: 20px;
        padding: 14px 18px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
        font-weight: 600;
        animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .alert-error-modern {
        background: #FEE2E2;
        border-left: 4px solid #EF4444;
        color: #B91C1C;
    }

    .password-criteria {
        background: #F0FDF4;
        border-radius: 16px;
        padding: 14px;
        margin-top: 12px;
        font-size: 12px;
    }

    .criteria-item {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
        color: #6B7280;
        transition: all 0.2s;
    }

    .criteria-item.valid {
        color: #10B981;
    }

    .criteria-item i {
        width: 16px;
        font-size: 12px;
    }

    .password-strength {
        margin-top: 8px;
        font-size: 12px;
        font-weight: 600;
    }

    .strength-weak { color: #EF4444; }
    .strength-medium { color: #F59E0B; }
    .strength-strong { color: #10B981; }

    .back-link {
        margin-top: 24px;
        text-align: center;
    }

    .back-link a {
        color: #6B7280;
        text-decoration: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.3s;
        font-size: 14px;
    }

    .back-link a:hover {
        color: var(--orange);
        transform: translateX(-4px);
    }
</style>
{% endblock %}

{% block body %}
<div class="reset-wrapper">
    <div class="reset-card-modern animate__animated animate__fadeInUp">
        
        <div class="icon-animated">
            <i class="fas fa-lock-check"></i>
        </div>

        <h1 class="reset-title">Nouveau mot de passe</h1>
        <p class="reset-subtitle">
            🌱 Choisis un mot de passe magique que tu n'oublieras pas !
        </p>

        <div class="steps-progress">
            <div class="step-item">
                <div class="step-circle completed">
                    <i class="fas fa-check"></i>
                </div>
                <div class="step-label">Email</div>
            </div>
            <div class="step-line active"></div>
            <div class="step-item">
                <div class="step-circle completed">
                    <i class="fas fa-check"></i>
                </div>
                <div class="step-label">Code</div>
            </div>
            <div class="step-line active"></div>
            <div class="step-item">
                <div class="step-circle active">3</div>
                <div class="step-label">Nouveau MDP</div>
            </div>
        </div>

        {% if error is defined and error %}
            <div class="alert-modern alert-error-modern">
                <i class="fas fa-face-sad-tear"></i>
                <span>{{ error }}</span>
            </div>
        {% endif %}

        <form method="POST" action="{{ path('app_reset_password') }}" id="resetForm">
            <input type="hidden" name="email" value="{{ email }}">
            <input type="hidden" name="code" value="{{ code }}">
            
            <div class="form-group">
                <label class="form-label">🔐 Nouveau mot de passe</label>
                <div class="input-modern">
                    <i class="fas fa-lock"></i>
                    <input type="password" 
                           name="password" 
                           id="password"
                           placeholder="••••••••"
                           minlength="4"
                           autocomplete="new-password" 
                           required>
                </div>
                <div class="password-strength" id="strengthText"></div>
            </div>

            <div class="form-group">
                <label class="form-label">✅ Confirmer ton mot de passe</label>
                <div class="input-modern">
                    <i class="fas fa-check-circle"></i>
                    <input type="password" 
                           name="confirm" 
                           id="confirm"
                           placeholder="Répète ton mot de passe"
                           autocomplete="new-password" 
                           required>
                </div>
                <div class="password-strength" id="matchText"></div>
            </div>

            <div class="password-criteria" id="criteriaBox">
                <div class="criteria-item" id="criteria-length">
                    <i class="fas fa-circle"></i> Au moins 4 caractères
                </div>
                <div class="criteria-item" id="criteria-letter">
                    <i class="fas fa-circle"></i> Au moins une lettre
                </div>
                <div class="criteria-item" id="criteria-number">
                    <i class="fas fa-circle"></i> Au moins un chiffre
                </div>
                <div class="criteria-item" id="criteria-match">
                    <i class="fas fa-circle"></i> Les mots de passe correspondent
                </div>
            </div>

            <button type="submit" class="btn-gradient" id="submitBtn">
                🦋 Réinitialiser <i class="fas fa-arrow-right"></i>
            </button>
        </form>

        <div class="back-link">
            <a href="{{ path('app_login') }}">
                <i class="fas fa-arrow-left"></