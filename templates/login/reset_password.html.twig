<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>FocusKid — Nouveau mot de passe</title>
    <link rel="stylesheet" href="{{ asset('base-back/assets/css/styles.min.css') }}"/>
    <style>
        body {
            min-height: 100vh; display: flex; align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            margin: 0;
        }
        .card-wrap {
            background: white; border-radius: 20px; padding: 48px 40px;
            width: 100%; max-width: 440px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
        }
        .icon-box {
            width: 72px; height: 72px;
            background: linear-gradient(135deg, #43a047, #1b5e20);
            border-radius: 18px; display: flex; align-items: center;
            justify-content: center; margin: 0 auto 20px;
        }
        .icon-box i { font-size: 32px; color: white; }
        h1 { font-size: 24px; font-weight: 700; color: #2d3748; text-align: center; margin: 0 0 8px; }
        p.sub { text-align: center; color: #718096; font-size: 14px; margin: 0 0 28px; }
        .form-label { font-weight: 600; font-size: 13px; color: #4a5568; display: block; margin-bottom: 6px; }
        .input-wrap { position: relative; margin-bottom: 16px; }
        .input-wrap i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #a0aec0; }
        .input-wrap input {
            width: 100%; padding: 12px 16px 12px 42px;
            border: 1.5px solid #e2e8f0; border-radius: 10px;
            font-size: 14px; outline: none; box-sizing: border-box;
        }
        .input-wrap input:focus { border-color: #43a047; box-shadow: 0 0 0 3px rgba(67,160,71,0.15); }
        .btn-submit {
            width: 100%; padding: 13px; margin-top: 8px;
            background: linear-gradient(135deg, #43a047, #1b5e20);
            border: none; border-radius: 10px; color: white;
            font-size: 15px; font-weight: 600; cursor: pointer;
        }
        .btn-submit:hover { opacity: 0.9; }
        .alert-error {
            background: #fff5f5; border: 1.5px solid #fed7d7;
            border-radius: 10px; color: #c53030;
            padding: 12px 16px; font-size: 13px; margin-bottom: 20px;
        }
        .steps { display: flex; justify-content: center; gap: 8px; margin-bottom: 28px; }
        .step { width: 32px; height: 6px; border-radius: 3px; background: #e2e8f0; }
        .step.active { background: #667eea; }
    </style>
</head>
<body>
<div style="padding:16px;width:100%;max-width:440px">
    <div class="card-wrap">
        <div class="icon-box"><i class="ti ti-lock-check"></i></div>
        <h1>Nouveau mot de passe</h1>
        <p class="sub">Choisissez un nouveau mot de passe sécurisé</p>

        <div class="steps">
            <div class="step active"></div>
            <div class="step active"></div>
            <div class="step active"></div>
        </div>

        {% if error %}
            <div class="alert-error"><i class="ti ti-alert-circle me-2"></i>{{ error }}</div>
        {% endif %}

        <form method="POST" action="{{ path('app_reset_password') }}">

            <label class="form-label">Nouveau mot de passe</label>
            <div class="input-wrap">
                <i class="ti ti-lock"></i>
                <input type="password" name="password"
                       placeholder="Minimum 4 caractères"
                       autocomplete="new-password" required autofocus>
            </div>

            <label class="form-label">Confirmer le mot de passe</label>
            <div class="input-wrap">
                <i class="ti ti-lock-check"></i>
                <input type="password" name="confirm"
                       placeholder="Répétez le mot de passe"
                       autocomplete="new-password" required>
            </div>

            <button type="submit" class="btn-submit">
                🔐 Réinitialiser le mot de passe
            </button>

        </form>
    </div>
</div>
</body>
</html>