{% extends 'base-back.html.twig' %}

{% block title %}Nouvelle session de calme - FocusKids{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .config-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
            border: 1px solid #e0e0e0;
        }
        .badge-type {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }
        .badge-musique { background: #9C27B0; color: white; }
        .badge-coloriage { background: #FF9800; color: white; }
        .badge-respiration { background: #4CAF50; color: white; }
        .badge-histoire { background: #2196F3; color: white; }
    </style>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="card-title text-white mb-0">
                            <i class="ti ti-meditation"></i> Créer une nouvelle session de calme
                        </h4>
                        <small class="text-white-50">Ajoutez une nouvelle session de relaxation pour les enfants</small>
                    </div>
                    <a href="{{ path('app_sessions_de_calme_index') }}" class="btn btn-light">
                        <i class="ti ti-arrow-left"></i> Retour à la liste
                    </a>
                </div>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'id': 'sessionForm'}}) }}
                    
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            {{ form_label(form.type_activite) }}
                            {{ form_widget(form.type_activite, {'attr': {'class': 'form-select', 'id': 'sessionType'}}) }}
                            {{ form_errors(form.type_activite) }}
                        </div>
                        
                        <div class="col-md-4 mb-3">
                            {{ form_label(form.declencheur) }}
                            {{ form_widget(form.declencheur, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.declencheur) }}
                        </div>
                        
                        <div class="col-md-4 mb-3">
                            {{ form_label(form.utilisateur) }}
                            {{ form_widget(form.utilisateur, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.utilisateur) }}
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            {{ form_label(form.duree_prevue) }}
                            {{ form_widget(form.duree_prevue, {'attr': {'class': 'form-control', 'placeholder': 'Durée prévue (minutes)'}}) }}
                            {{ form_errors(form.duree_prevue) }}
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            {{ form_label(form.duree_reelle) }}
                            {{ form_widget(form.duree_reelle, {'attr': {'class': 'form-control', 'placeholder': 'Durée réelle (minutes)'}}) }}
                            {{ form_errors(form.duree_reelle) }}
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            {{ form_label(form.horodatage) }}
                            {{ form_widget(form.horodatage, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.horodatage) }}
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            {{ form_label(form.feedback_enfant) }}
                            {{ form_widget(form.feedback_enfant, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.feedback_enfant) }}
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            {{ form_label(form.note_parent) }}
                            {{ form_widget(form.note_parent, {'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Note du parent...'}}) }}
                            {{ form_errors(form.note_parent) }}
                        </div>
                    </div>
                
                    <div class="row mt-4">
                        <div class="col-12 text-center">
                            <button type="submit" class="btn btn-primary px-5">
                                <i class="ti ti-device-floppy"></i> Enregistrer
                            </button>
                            <a href="{{ path('app_sessions_de_calme_index') }}" class="btn btn-secondary px-5 ms-2">
                                <i class="ti ti-x"></i> Annuler
                            </a>
                        </div>
                    </div>
                    
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<script>
    // Gestion du changement de type d'activité
    const typeSelect = document.getElementById('sessions_de_calme_type_activite');
    const configMusique = document.getElementById('configMusique');
    const configColoriage = document.getElementById('configColoriage');
    const configRespiration = document.getElementById('configRespiration');
    const configHistoire = document.getElementById('configHistoire');
    const typeBadge = document.getElementById('typeBadge');
    
    function updateConfigVisibility() {
        let selectedType = typeSelect.value;
        
        const badgeClass = {
            'musique': 'badge-musique',
            'coloriage': 'badge-coloriage',
            'respiration': 'badge-respiration',
            'histoire': 'badge-histoire'
        };
        typeBadge.textContent = selectedType;
        typeBadge.className = 'badge-type ms-2 ' + (badgeClass[selectedType] || 'badge-musique');
        
        // Cacher toutes les configs
        if(configMusique) configMusique.style.display = 'none';
        if(configColoriage) configColoriage.style.display = 'none';
        if(configRespiration) configRespiration.style.display = 'none';
        if(configHistoire) configHistoire.style.display = 'none';
        
        // Afficher la config correspondante
        if(selectedType === 'musique' && configMusique) {
            configMusique.style.display = 'block';
        } else if(selectedType === 'coloriage' && configColoriage) {
            configColoriage.style.display = 'block';
        } else if(selectedType === 'respiration' && configRespiration) {
            configRespiration.style.display = 'block';
        } else if(selectedType === 'histoire' && configHistoire) {
            configHistoire.style.display = 'block';
        }
    }
    
    // Gestion du volume
    const musiqueVolume = document.getElementById('musiqueVolume');
    const volumeValue = document.getElementById('volumeValue');
    if(musiqueVolume && volumeValue) {
        musiqueVolume.addEventListener('input', function() {
            volumeValue.textContent = this.value + '%';
        });
    }
    
    // Écouter le changement de type
    if(typeSelect) {
        typeSelect.addEventListener('change', updateConfigVisibility);
        updateConfigVisibility();
    }
    
    // Construction et sauvegarde du JSON avant soumission
    const form = document.getElementById('sessionForm');
    if(form) {
        form.addEventListener('submit', function(e) {
            const type = typeSelect.value;
            let configJson = {};
            
            if(type === 'musique') {
                configJson = {
                    type: 'musique',
                    musiqueType: document.getElementById('musiqueType')?.value || 'classique',
                    volume: parseInt(document.getElementById('musiqueVolume')?.value || 50),
                    url: document.getElementById('musiqueUrl')?.value || ''
                };
            } 
            else if(type === 'coloriage') {
                configJson = {
                    type: 'coloriage',
                    theme: document.getElementById('coloriageTheme')?.value || 'animaux',
                    difficulte: document.getElementById('coloriageDifficulte')?.value || 'facile'
                };
            } 
            else if(type === 'respiration') {
                configJson = {
                    type: 'respiration',
                    inspiration: parseInt(document.getElementById('respirationInspiration')?.value || 4),
                    expiration: parseInt(document.getElementById('respirationExpiration')?.value || 4),
                    pause: parseInt(document.getElementById('respirationPause')?.value || 2),
                    cycles: parseInt(document.getElementById('respirationCycles')?.value || 10),
                    musique: document.getElementById('respirationMusique')?.value || 'none'
                };
            } 
            else if(type === 'histoire') {
                configJson = {
                    type: 'histoire',
                    histoireType: document.getElementById('histoireType')?.value || 'aventure',
                    voix: document.getElementById('histoireVoix')?.value || 'femme',
                    texte: document.getElementById('histoireTexte')?.value || '',
                    musique: document.getElementById('histoireMusique')?.value || 'none'
                };
            }
            
            // Stocker la configuration dans un champ caché (vous devrez ajouter ce champ dans le formulaire)
            const configData = document.getElementById('configData');
            if(configData) {
                configData.value = JSON.stringify(configJson);
            }
            
            console.log('Configuration sauvegardée:', configJson);
        });
    }
</script>
{% endblock %}