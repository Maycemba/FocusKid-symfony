{% extends 'base-back.html.twig' %}

{% block title %}Nouvelle session de calme - FocusKids{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .form-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            border-left: 4px solid #4e73df;
        }
        .required-field:after {
            content: "*";
            color: red;
            margin-left: 5px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <div class="row">
        <div class="col-12">
            <!-- Navigation breadcrumb -->
            <nav aria-label="breadcrumb" class="mt-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_sessions_de_calme_index') }}">Sessions de calme</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Nouvelle session</li>
                </ol>
            </nav>
            
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="text-white mb-0">
                                <i class="ti ti-meditation"></i> Créer une nouvelle session
                            </h4>
                            <small class="text-white-50">Ajoutez une session de relaxation pour un enfant</small>
                        </div>
                        <div>
                            <a href="{{ path('app_sessions_de_calme_index') }}" class="btn btn-light">
                                <i class="ti ti-arrow-left"></i> Retour à la liste
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="card-body">
                    <!-- Formulaire -->
                    {{ include('sessions_de_calme/_form.html.twig', {'button_label': 'Créer la session'}) }}
                </div>
                
                <div class="card-footer text-muted">
                    <div class="row">
                        <div class="col-md-6">
                            <small><i class="ti ti-info-circle"></i> Les champs marqués d'un * sont obligatoires</small>
                        </div>
                        <div class="col-md-6 text-end">
                            <small><i class="ti ti-clock"></i> La durée est en minutes</small>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Informations supplémentaires -->
            <div class="card mt-4">
                <div class="card-header bg-info text-white">
                    <i class="ti ti-tips"></i> Conseils pour une session réussie
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="text-center">
                                <i class="ti ti-music" style="font-size: 2rem;"></i>
                                <h6>Musique relaxante</h6>
                                <small>Choisissez une musique douce et calme</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center">
                                <i class="ti ti-clock" style="font-size: 2rem;"></i>
                                <h6>Durée adaptée</h6>
                                <small>5-10 minutes pour les jeunes enfants</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center">
                                <i class="ti ti-heart" style="font-size: 2rem;"></i>
                                <h6>Ambiance calme</h6>
                                <small>Créez un environnement apaisant</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}