<form method="post" action="{{ path('app_sessions_de_calme_delete', {'id': sessions_de_calme.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette session ?');" style="display:inline-block;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ sessions_de_calme.id) }}">
    <button class="btn btn-sm btn-danger">
        <i class="ti ti-trash"></i>
    </button>
</form>