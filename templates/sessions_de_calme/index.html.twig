{% extends 'base-back.html.twig' %}

{% block title %}Sessions de calme - FocusKids{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 10px;
            padding: 20px;
            color: white;
            margin-bottom: 20px;
        }
        .badge-type {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        .badge-musique { background-color: #3498db; color: white; }
        .badge-coloriage { background-color: #e74c3c; color: white; }
        .badge-respiration { background-color: #2ecc71; color: white; }
        .badge-histoire { background-color: #f39c12; color: white; }
        .table-actions .btn {
            margin: 0 2px;
            padding: 4px 8px;
        }
        .search-filters {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 20px;
        }
        .filter-badge {
            background: white;
            border-radius: 20px;
            padding: 5px 12px;
            margin: 0 5px 5px 0;
            display: inline-block;
            font-size: 12px;
            border: 1px solid #dee2e6;
        }
        .filter-badge .remove-filter {
            margin-left: 5px;
            cursor: pointer;
            color: #dc3545;
        }
        .btn-clear-filters {
            font-size: 12px;
            padding: 4px 12px;
        }
        .pagination {
            margin-bottom: 0;
        }
        .page-link {
            color: #667eea;
        }
        .page-item.active .page-link {
            background-color: #667eea;
            border-color: #667eea;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="mt-4">
                    <i class="ti ti-meditation"></i> Sessions de calme
                </h1>
                <a href="{{ path('app_sessions_de_calme_new') }}" class="btn btn-primary btn-lg">
                    <i class="ti ti-plus"></i> Nouvelle session
                </a>
            </div>
            <ol class="breadcrumb mb-4">
                <li class="breadcrumb-item active">Gestion des sessions de relaxation</li>
            </ol>
        </div>
    </div>
    
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="text-white-50">Total sessions</h5>
                        <h2 class="text-white">{{ totalSessions|default(0) }}</h2>
                    </div>
                    <i class="ti ti-calendar-stats" style="font-size: 2.5rem;"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="text-white-50">Durée moyenne</h5>
                        <h2 class="text-white">{{ avgDuration|default(0) }} min</h2>
                    </div>
                    <i class="ti ti-clock" style="font-size: 2.5rem;"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="text-white-50">Satisfaction</h5>
                        <h2 class="text-white">{{ avgNote|default(0) }}/5</h2>
                    </div>
                    <i class="ti ti-star" style="font-size: 2.5rem;"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="text-white-50">Aujourd'hui</h5>
                        <h2 class="text-white">{{ todayCount|default(0) }}</h2>
                    </div>
                    <i class="ti ti-calendar" style="font-size: 2.5rem;"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="card mb-4">
        <div class="card-header">
            <i class="ti ti-table"></i> Liste des sessions
        </div>
 
        <div class="card-body">
            <!-- Formulaire de recherche et filtres -->
            <div class="search-filters">
                <form method="get" action="{{ path('app_sessions_de_calme_index') }}" id="filterForm">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Recherche</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-search"></i></span>
                                <input type="text" class="form-control" name="search" placeholder="Type, déclencheur, notes..." value="{{ searchTerm }}">
                            </div>
                        </div>
                        
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Type d'activité</label>
                            <select class="form-select" name="type">
                                <option value="">Tous</option>
                                <option value="musique" {% if typeFilter == 'musique' %}selected{% endif %}>Musique</option>
                                <option value="coloriage" {% if typeFilter == 'coloriage' %}selected{% endif %}>Coloriage</option>
                                <option value="respiration" {% if typeFilter == 'respiration' %}selected{% endif %}>Respiration</option>
                                <option value="histoire" {% if typeFilter == 'histoire' %}selected{% endif %}>Histoire</option>
                            </select>
                        </div>
                        
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Déclencheur</label>
                            <select class="form-select" name="declencheur">
                                <option value="">Tous</option>
                                <option value="enfant" {% if declencheurFilter == 'enfant' %}selected{% endif %}>Enfant</option>
                                <option value="parent" {% if declencheurFilter == 'parent' %}selected{% endif %}>Parent</option>
                            </select>
                        </div>
                        
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Date début</label>
                            <input type="date" class="form-control" name="date_from" value="{{ dateFrom }}">
                        </div>
                        
                        <div class="col-md-2 mb-3">
                            <label class="form-label">Date fin</label>
                            <input type="date" class="form-control" name="date_to" value="{{ dateTo }}">
                        </div>
                        
                        <div class="col-md-12 d-flex justify-content-between align-items-center">
                            <div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="ti ti-filter"></i> Appliquer les filtres
                                </button>
                                <button type="button" class="btn btn-secondary" onclick="resetFilters()">
                                    <i class="ti ti-refresh"></i> Réinitialiser
                                </button>
                            </div>
                            <div>
                                <span class="text-muted">{{ pagination.totalItemCount }} session(s) trouvée(s)</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Champ caché pour per_page -->
                    <input type="hidden" name="per_page" id="per_page_hidden" value="{{ perPage|default(10) }}">
                </form>
                
                <!-- Affichage des filtres actifs -->
                {% if searchTerm or typeFilter or declencheurFilter or dateFrom or dateTo %}
                <div class="mt-3 pt-3 border-top">
                    <strong>Filtres actifs :</strong>
                    {% if searchTerm %}
                        <span class="filter-badge">
                            Recherche: "{{ searchTerm }}"
                            <a href="#" onclick="removeFilter('search')" class="remove-filter">×</a>
                        </span>
                    {% endif %}
                    {% if typeFilter %}
                        <span class="filter-badge">
                            Type: {{ typeFilter }}
                            <a href="#" onclick="removeFilter('type')" class="remove-filter">×</a>
                        </span>
                    {% endif %}
                    {% if declencheurFilter %}
                        <span class="filter-badge">
                            Déclencheur: {{ declencheurFilter }}
                            <a href="#" onclick="removeFilter('declencheur')" class="remove-filter">×</a>
                        </span>
                    {% endif %}
                    {% if dateFrom %}
                        <span class="filter-badge">
                            Date début: {{ dateFrom }}
                            <a href="#" onclick="removeFilter('date_from')" class="remove-filter">×</a>
                        </span>
                    {% endif %}
                    {% if dateTo %}
                        <span class="filter-badge">
                            Date fin: {{ dateTo }}
                            <a href="#" onclick="removeFilter('date_to')" class="remove-filter">×</a>
                        </span>
                    {% endif %}
                    <a href="{{ path('app_sessions_de_calme_index') }}" class="btn btn-sm btn-outline-danger btn-clear-filters">
                        <i class="ti ti-trash"></i> Effacer tous
                    </a>
                </div>
                {% endif %}
            </div>
            
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Type d'activité</th>
                            <th>Déclencheur</th>
                            <th>Durée prévue</th>
                            <th>Durée réelle</th>
                            <th>Horodatage</th>
                            <th>Feedback enfant</th>
                            <th>Note parent</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for session in pagination %}
                        <tr>
                            <td>{{ session.id }}</td>
                            <td>
                                <span class="badge-type badge-{{ session.typeActivite|lower }}">
                                    {{ session.typeActivite }}
                                </span>
                            </td>
                            <td>{{ session.declencheur|default('-') }}</td>
                            <td>{{ session.dureePrevue|default(0) }} min</td>
                            <td>
                                {% set dureePrevue = session.dureePrevue|default(0) %}
                                {% set dureeReelle = session.dureeReelle|default(0) %}
                                {{ dureeReelle }} min
                                {% if dureeReelle > 0 and dureePrevue > 0 %}
                                    {% set difference = dureeReelle - dureePrevue %}
                                    {% if difference > 0 %}
                                        <span class="text-danger">(+{{ difference }})</span>
                                    {% elseif difference < 0 %}
                                        <span class="text-success">({{ difference }})</span>
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td>{{ session.horodatage ? session.horodatage|date('d/m/Y H:i') : '-' }}</td>
                            <td>
                                {% if session.feedbackEnfant %}
                                    <span class="badge bg-success">{{ session.feedbackEnfant }}/5</span>
                                {% else %}
                                    <span class="badge bg-secondary">Non renseigné</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if session.noteParent %}
                                    <span class="badge bg-info" 
                                          data-bs-toggle="tooltip" 
                                          data-bs-html="true" 
                                          title="{{ session.noteParent|nl2br|escape('html') }}">
                                        <i class="ti ti-message"></i> 
                                        {{ session.noteParent|length > 30 ? session.noteParent|slice(0, 30) ~ '...' : session.noteParent }}
                                    </span>
                                {% else %}
                                    <span class="badge bg-secondary">Non renseigné</span>
                                {% endif %}
                            </td>
                            <td class="table-actions">
                                <a href="{{ path('app_sessions_de_calme_show', {'id': session.id}) }}" class="btn btn-sm btn-info" title="Voir">
                                    <i class="ti ti-eye"></i>
                                </a>
                                <a href="{{ path('app_sessions_de_calme_edit', {'id': session.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                    <i class="ti ti-edit"></i>
                                </a>
                                {{ include('sessions_de_calme/_delete_form.html.twig', {'sessions_de_calme': session}) }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="text-center">
                                <div class="alert alert-info mb-0">
                                    <i class="ti ti-info-circle"></i> Aucune session trouvée avec les critères sélectionnés
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
{% if pagination.pageCount > 1 %}
<div class="d-flex justify-content-between align-items-center mt-4">
    <div>
        <span class="text-muted">
            Affichage de {{ pagination.currentPageNumber * pagination.itemNumberPerPage - pagination.itemNumberPerPage + 1 }} 
            à {{ min(pagination.currentPageNumber * pagination.itemNumberPerPage, pagination.totalItemCount) }} 
            sur {{ pagination.totalItemCount }} sessions
        </span>
    </div>
    <div>
        <nav aria-label="Page navigation">
            {{ knp_pagination_render(pagination) }}
        </nav>
    </div>
    <div>
        <select class="form-select form-select-sm" id="perPageSelect" style="width: auto;">
            <option value="10" {{ perPage == 10 ? 'selected' : '' }}>10 par page</option>
            <option value="25" {{ perPage == 25 ? 'selected' : '' }}>25 par page</option>
            <option value="50" {{ perPage == 50 ? 'selected' : '' }}>50 par page</option>
            <option value="100" {{ perPage == 100 ? 'selected' : '' }}>100 par page</option>
        </select>
    </div>
</div>
{% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// Activer les tooltips Bootstrap
var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
    return new bootstrap.Tooltip(tooltipTriggerEl)
})

function resetFilters() {
    window.location.href = "{{ path('app_sessions_de_calme_index') }}";
}

function removeFilter(filterName) {
    const url = new URL(window.location.href);
    url.searchParams.delete(filterName);
    url.searchParams.set('page', 1);
    window.location.href = url.toString();
}

// Soumission automatique du formulaire quand on change un select
document.querySelectorAll('select[name="type"], select[name="declencheur"]').forEach(select => {
    select.addEventListener('change', function() {
        document.getElementById('filterForm').submit();
    });
});

// Gestion du changement du nombre d'éléments par page
document.getElementById('perPageSelect')?.addEventListener('change', function() {
    const url = new URL(window.location.href);
    url.searchParams.set('per_page', this.value);
    url.searchParams.set('page', 1);
    window.location.href = url.toString();
});

// Mettre à jour le champ caché per_page quand le select change
document.getElementById('perPageSelect')?.addEventListener('change', function() {
    document.getElementById('per_page_hidden').value = this.value;
});
</script>
{% endblock %}