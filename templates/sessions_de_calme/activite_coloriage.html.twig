{% extends 'base-front.html.twig' %}

{% block title %}Session de calme — Studio Artistique{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@300;400;600&display=swap" rel="stylesheet">
<style>
  :root {
    --studio-bg: #fef3f0;
    --studio-panel: #ffffff;
    --studio-primary: #ff6b9d;
    --studio-secondary: #c56cf0;
    --studio-accent: #48dbfb;
    --studio-warm: #ffeaa7;
    --studio-ink: #2d3436;
    --studio-muted: #b2bec3;
    --studio-shadow: rgba(0,0,0,0.08);
    --radius: 20px;
  }

  .studio-wrapper {
    min-height: 100vh;
    background: var(--studio-bg);
    background-image:
      radial-gradient(circle at 10% 10%, rgba(255,107,157,0.07) 0%, transparent 40%),
      radial-gradient(circle at 90% 90%, rgba(197,108,240,0.07) 0%, transparent 40%);
    font-family: 'Nunito', sans-serif;
    padding: 24px 12px 80px;
    position: relative;
    overflow: hidden;
  }

  /* Floating decorative elements */
  .float-deco {
    position: fixed;
    pointer-events: none;
    z-index: 0;
    font-size: 2rem;
    animation: floatDeco 6s ease-in-out infinite;
    opacity: 0.15;
  }

  @keyframes floatDeco {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    33% { transform: translateY(-20px) rotate(5deg); }
    66% { transform: translateY(10px) rotate(-3deg); }
  }

  .studio-header {
    text-align: center;
    margin-bottom: 28px;
    position: relative;
    z-index: 2;
  }

  .studio-title {
    font-family: 'Fredoka One', cursive;
    font-size: clamp(2rem, 5vw, 3.2rem);
    background: linear-gradient(135deg, #ff6b9d, #c56cf0, #48dbfb);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 4px;
    filter: drop-shadow(0 2px 0 rgba(255,107,157,0.15));
  }

  .studio-subtitle {
    color: var(--studio-muted);
    font-size: 0.9rem;
  }

  /* Drawing selector */
  .drawing-selector {
    max-width: 1100px;
    margin: 0 auto 24px;
    background: var(--studio-panel);
    border-radius: var(--radius);
    padding: 20px 24px;
    box-shadow: 0 4px 24px var(--studio-shadow);
    position: relative;
    z-index: 2;
  }

  .selector-title {
    font-family: 'Fredoka One', cursive;
    font-size: 1.1rem;
    color: var(--studio-ink);
    margin-bottom: 14px;
  }

  .drawing-grid {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .drawing-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 12px 16px;
    border-radius: 14px;
    border: 2px solid #f0e6ff;
    background: #fafafa;
    cursor: pointer;
    transition: all 0.3s;
    min-width: 90px;
    gap: 6px;
  }

  .drawing-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(197,108,240,0.2);
    border-color: var(--studio-secondary);
  }

  .drawing-card.selected {
    border-color: var(--studio-primary);
    background: linear-gradient(135deg, rgba(255,107,157,0.08), rgba(197,108,240,0.08));
    box-shadow: 0 4px 16px rgba(255,107,157,0.2);
  }

  .drawing-card .emoji { font-size: 2rem; line-height: 1; }
  .drawing-card span { font-size: 0.78rem; color: var(--studio-ink); font-weight: 600; }

  /* Main studio layout */
  .studio-main {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 16px;
    position: relative;
    z-index: 2;
    align-items: start;
  }

  /* Canvas area */
  .canvas-area {
    background: var(--studio-panel);
    border-radius: var(--radius);
    padding: 16px;
    box-shadow: 0 4px 24px var(--studio-shadow);
    position: relative;
  }

  .canvas-toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .tool-btn {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 2px solid #f0e6ff;
    background: #fafafa;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    transition: all 0.2s;
    position: relative;
  }

  .tool-btn:hover { background: #f0e6ff; border-color: var(--studio-secondary); transform: scale(1.08); }
  .tool-btn.active {
    background: linear-gradient(135deg, var(--studio-primary), var(--studio-secondary));
    border-color: transparent;
    box-shadow: 0 3px 12px rgba(255,107,157,0.4);
  }

  .tool-tooltip {
    position: absolute;
    bottom: -28px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--studio-ink);
    color: white;
    font-size: 0.68rem;
    padding: 3px 8px;
    border-radius: 6px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
    z-index: 10;
  }

  .tool-btn:hover .tool-tooltip { opacity: 1; }

  .toolbar-sep {
    width: 1px;
    height: 32px;
    background: #f0e6ff;
    flex-shrink: 0;
  }

  .brush-slider {
    width: 80px;
    height: 4px;
    -webkit-appearance: none;
    background: linear-gradient(90deg, #ff6b9d, #c56cf0);
    border-radius: 4px;
    outline: none;
    cursor: pointer;
  }

  .brush-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: white;
    border: 2px solid var(--studio-primary);
    cursor: pointer;
  }

  .brush-preview {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--current-color, #ff6b9d);
    border: 2px solid white;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    flex-shrink: 0;
  }

  .canvas-container {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 2px 16px var(--studio-shadow);
    background: white;
    cursor: crosshair;
  }

  #mainCanvas {
    display: block;
    width: 100%;
    height: auto;
    touch-action: none;
  }

  /* Layer panel inside canvas area */
  .layer-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    padding: 10px 12px;
    background: #fafafa;
    border-radius: 12px;
    flex-wrap: wrap;
  }

  .layer-title {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--studio-ink);
    flex-shrink: 0;
  }

  .layer-chip {
    padding: 4px 12px;
    border-radius: 20px;
    border: 2px solid #f0e6ff;
    background: white;
    color: #888;
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.2s;
    font-family: 'Nunito', sans-serif;
  }

  .layer-chip.active {
    background: linear-gradient(135deg, var(--studio-primary), var(--studio-secondary));
    color: white;
    border-color: transparent;
    box-shadow: 0 2px 8px rgba(255,107,157,0.3);
  }

  .layer-opacity {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: #888;
    margin-left: auto;
  }

  .layer-opacity input {
    width: 60px;
    height: 3px;
    -webkit-appearance: none;
    background: linear-gradient(90deg, transparent, var(--studio-primary));
    border-radius: 3px;
    outline: none;
    cursor: pointer;
  }

  .layer-opacity input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 10px; height: 10px;
    border-radius: 50%;
    background: var(--studio-primary);
    cursor: pointer;
  }

  /* Canvas actions */
  .canvas-actions {
    display: flex;
    gap: 8px;
    margin-top: 10px;
    flex-wrap: wrap;
  }

  .action-btn {
    padding: 7px 16px;
    border-radius: 20px;
    border: 2px solid #f0e6ff;
    background: white;
    color: #888;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
    font-family: 'Nunito', sans-serif;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .action-btn:hover { border-color: var(--studio-primary); color: var(--studio-primary); }

  /* Right panel - tools */
  .right-panel {
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: sticky;
    top: 20px;
  }

  .panel-card {
    background: var(--studio-panel);
    border-radius: var(--radius);
    padding: 18px;
    box-shadow: 0 4px 24px var(--studio-shadow);
  }

  .panel-card-title {
    font-family: 'Fredoka One', cursive;
    font-size: 1rem;
    color: var(--studio-ink);
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Color wheel */
  #colorWheel {
    display: block;
    border-radius: 50%;
    cursor: crosshair;
    width: 180px;
    height: 180px;
    margin: 0 auto 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
  }

  .color-preview-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .color-big-preview {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 3px solid white;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    flex-shrink: 0;
    transition: background 0.2s;
  }

  .color-hex {
    font-size: 0.78rem;
    color: var(--studio-muted);
    font-family: monospace;
    flex: 1;
  }

  .lightness-slider {
    width: 100%;
    height: 10px;
    -webkit-appearance: none;
    border-radius: 6px;
    outline: none;
    cursor: pointer;
    margin-bottom: 6px;
  }

  .lightness-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: white;
    border: 2px solid #ddd;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0,0,0,0.2);
  }

  /* Recent colors */
  .recent-colors {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .recent-swatch {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    border: 2px solid white;
    box-shadow: 0 1px 4px rgba(0,0,0,0.12);
    cursor: pointer;
    transition: transform 0.2s;
  }

  .recent-swatch:hover { transform: scale(1.2); }

  /* Sticker bank */
  .sticker-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }

  .sticker-item {
    font-size: 1.4rem;
    text-align: center;
    padding: 6px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
    border: 2px solid transparent;
  }

  .sticker-item:hover {
    background: #f0e6ff;
    border-color: var(--studio-secondary);
    transform: scale(1.1);
  }

  /* Zoom controls */
  .zoom-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
  }

  .zoom-btn {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 2px solid #f0e6ff;
    background: white;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    font-family: 'Nunito', sans-serif;
  }

  .zoom-btn:hover { border-color: var(--studio-secondary); background: #f0e6ff; }

  .zoom-level {
    font-size: 0.78rem;
    color: var(--studio-muted);
    min-width: 40px;
    text-align: center;
  }

  /* Session & feedback */
  .session-strip {
    max-width: 1100px;
    margin: 16px auto 0;
    background: var(--studio-panel);
    border-radius: var(--radius);
    padding: 18px 24px;
    display: flex;
    align-items: center;
    gap: 20px;
    box-shadow: 0 4px 24px var(--studio-shadow);
    flex-wrap: wrap;
    position: relative;
    z-index: 2;
  }

  .session-timer-big {
    font-family: 'Fredoka One', cursive;
    font-size: 2rem;
    background: linear-gradient(135deg, var(--studio-primary), var(--studio-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    flex-shrink: 0;
  }

  .session-label {
    font-size: 0.75rem;
    color: var(--studio-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .session-btn {
    padding: 10px 24px;
    border-radius: 50px;
    border: none;
    cursor: pointer;
    font-family: 'Nunito', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .session-btn-start {
    background: linear-gradient(135deg, var(--studio-primary), var(--studio-secondary));
    color: white;
    box-shadow: 0 4px 16px rgba(255,107,157,0.4);
  }

  .session-btn-start:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(255,107,157,0.5); }

  .session-btn-stop {
    background: white;
    color: #e74c3c;
    border: 2px solid rgba(231,76,60,0.2);
  }

  .session-btn-stop:hover { background: rgba(231,76,60,0.05); }

  /* Feedback */
  .feedback-popup {
    display: none;
    max-width: 520px;
    margin: 24px auto 0;
    background: var(--studio-panel);
    border-radius: var(--radius);
    padding: 36px;
    box-shadow: 0 8px 48px rgba(255,107,157,0.15);
    text-align: center;
    animation: fadeUp 0.5s ease;
    position: relative;
    z-index: 2;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .feedback-popup h3 {
    font-family: 'Fredoka One', cursive;
    font-size: 1.8rem;
    color: var(--studio-ink);
    margin-bottom: 6px;
  }

  .feedback-popup p {
    color: var(--studio-muted);
    margin-bottom: 24px;
  }

  .star-row {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  .star-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 2rem;
    transition: transform 0.2s;
  }

  .star-btn.lit { filter: drop-shadow(0 0 6px rgba(255,107,157,0.6)); transform: scale(1.1); }
  .star-btn:hover { transform: scale(1.2); }

  .note-field {
    width: 100%;
    background: #fafafa;
    border: 2px solid #f0e6ff;
    border-radius: 12px;
    padding: 12px 16px;
    color: var(--studio-ink);
    font-family: 'Nunito', sans-serif;
    font-size: 0.9rem;
    resize: none;
    margin-bottom: 20px;
    outline: none;
    transition: border-color 0.3s;
  }

  .note-field:focus { border-color: var(--studio-primary); }

  .submit-btn {
    padding: 12px 36px;
    background: linear-gradient(135deg, var(--studio-primary), var(--studio-secondary));
    color: white;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    font-family: 'Nunito', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all 0.3s;
    box-shadow: 0 4px 16px rgba(255,107,157,0.35);
  }

  .submit-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(255,107,157,0.5); }

  @media (max-width: 768px) {
    .studio-main { grid-template-columns: 1fr; }
    .right-panel { position: static; flex-direction: row; flex-wrap: wrap; }
    .panel-card { flex: 1; min-width: 200px; }
  }
</style>
{% endblock %}

{% block body %}
<!-- Floating decorations -->
<div class="float-deco" style="top:8%; left:3%; animation-delay:0s">🎨</div>
<div class="float-deco" style="top:15%; right:4%; animation-delay:1.5s">✏️</div>
<div class="float-deco" style="bottom:20%; left:2%; animation-delay:3s">🖌️</div>
<div class="float-deco" style="bottom:10%; right:3%; animation-delay:0.8s">⭐</div>

<div class="studio-wrapper">
  <div class="studio-header">
    <h1 class="studio-title">🎨 Studio Artistique</h1>
    <p class="studio-subtitle">Ton espace créatif personnel</p>
  </div>

  <!-- Drawing selector -->
  <div class="drawing-selector">
    <div class="selector-title">🖼️ Choisis ton dessin</div>
    <div class="drawing-grid">
      <div class="drawing-card selected" data-type="blank" onclick="selectDrawing(this)">
        <span class="emoji">⬜</span>
        <span>Libre</span>
      </div>
      <div class="drawing-card" data-type="mandala" onclick="selectDrawing(this)">
        <span class="emoji">🌀</span>
        <span>Mandala</span>
      </div>
      <div class="drawing-card" data-type="butterfly" onclick="selectDrawing(this)">
        <span class="emoji">🦋</span>
        <span>Papillon</span>
      </div>
      <div class="drawing-card" data-type="unicorn" onclick="selectDrawing(this)">
        <span class="emoji">🦄</span>
        <span>Licorne</span>
      </div>
      <div class="drawing-card" data-type="star" onclick="selectDrawing(this)">
        <span class="emoji">⭐</span>
        <span>Étoiles</span>
      </div>
      <div class="drawing-card" data-type="flower" onclick="selectDrawing(this)">
        <span class="emoji">🌸</span>
        <span>Fleur</span>
      </div>
      <div class="drawing-card" data-type="house" onclick="selectDrawing(this)">
        <span class="emoji">🏡</span>
        <span>Maison</span>
      </div>
      <div class="drawing-card" data-type="cloud" onclick="selectDrawing(this)">
        <span class="emoji">☁️</span>
        <span>Nuage</span>
      </div>
    </div>
  </div>

  <!-- MAIN STUDIO -->
  <div class="studio-main">
    <!-- Canvas area (80%) -->
    <div class="canvas-area">
      <!-- Toolbar -->
      <div class="canvas-toolbar">
        <button class="tool-btn active" id="toolBrush" onclick="setTool('brush')" title="Pinceau">
          🖌️
          <div class="tool-tooltip">Pinceau</div>
        </button>
        <button class="tool-btn" id="toolPencil" onclick="setTool('pencil')">
          ✏️
          <div class="tool-tooltip">Crayon</div>
        </button>
        <button class="tool-btn" id="toolFill" onclick="setTool('fill')">
          🪣
          <div class="tool-tooltip">Pot de peinture</div>
        </button>
        <button class="tool-btn" id="toolEraser" onclick="setTool('eraser')">
          🧹
          <div class="tool-tooltip">Gomme</div>
        </button>
        <button class="tool-btn" id="toolSticker" onclick="setTool('sticker')">
          ⭐
          <div class="tool-tooltip">Stickers</div>
        </button>

        <div class="toolbar-sep"></div>

        <span style="font-size:0.75rem; color:#aaa; white-space:nowrap">Taille :</span>
        <input type="range" class="brush-slider" id="brushSize" min="2" max="40" value="10" oninput="updateBrushSize()">
        <div class="brush-preview" id="brushPreview"></div>

        <div class="toolbar-sep"></div>

        <button class="tool-btn" onclick="undoAction()" title="Annuler">↩️<div class="tool-tooltip">Annuler</div></button>
        <button class="tool-btn" onclick="redoAction()" title="Refaire">↪️<div class="tool-tooltip">Refaire</div></button>
      </div>

      <!-- Canvas -->
      <div class="canvas-container" id="canvasContainer">
        <canvas id="mainCanvas" width="700" height="560"></canvas>
      </div>

      <!-- Layer bar -->
      <div class="layer-bar">
        <span class="layer-title">📑 Calques :</span>
        <button class="layer-chip active" data-layer="0" onclick="switchLayer(0, this)">Fond</button>
        <button class="layer-chip" data-layer="1" onclick="switchLayer(1, this)">Détails</button>
        <button class="layer-chip" data-layer="2" onclick="switchLayer(2, this)">Déco</button>
        <div class="layer-opacity">
          <span>Opacité</span>
          <input type="range" min="10" max="100" value="100" id="opacitySlider" oninput="updateOpacity(this.value)">
          <span id="opacityVal">100%</span>
        </div>
      </div>

      <!-- Canvas actions -->
      <div class="canvas-actions">
        <button class="action-btn" onclick="clearCurrentLayer()">🗑️ Effacer calque</button>
        <button class="action-btn" onclick="clearAll()">❌ Tout effacer</button>
        <button class="action-btn" onclick="downloadDrawing()">⬇️ Télécharger</button>
        <button class="action-btn" onclick="toggleZoomIn()">🔍 Zoom +</button>
        <button class="action-btn" onclick="toggleZoomOut()">🔎 Zoom −</button>
      </div>
    </div>

    <!-- Right panel -->
    <div class="right-panel">
      <!-- Color wheel -->
      <div class="panel-card">
        <div class="panel-card-title">🎨 Couleur</div>
        <canvas id="colorWheel" width="180" height="180"></canvas>
        <div class="color-preview-row">
          <div class="color-big-preview" id="colorBigPreview" style="background:#ff6b9d"></div>
          <span class="color-hex" id="colorHex">#ff6b9d</span>
        </div>
        <input type="range" class="lightness-slider" id="lightnessSlider" min="0" max="100" value="50" oninput="updateLightness(this.value)">
        <div style="display:flex; justify-content:space-between; font-size:0.68rem; color:var(--studio-muted); margin-bottom:10px;">
          <span>Sombre</span><span>Lumineux</span>
        </div>
        <div class="recent-colors" id="recentColors"></div>
      </div>

      <!-- Sticker panel -->
      <div class="panel-card">
        <div class="panel-card-title">⭐ Stickers</div>
        <div class="sticker-grid" id="stickerGrid">
          {% for sticker in ['⭐','🌈','🦋','🌸','🎀','💫','🌙','☀️','🍀','🌺','🦄','💖','🎵','🐝','🌊','🦊'] %}
          <div class="sticker-item" data-sticker="{{ sticker }}" onclick="selectSticker('{{ sticker }}')">{{ sticker }}</div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <!-- Session strip -->
  <div class="session-strip">
    <div>
      <div class="session-timer-big" id="sessionTimer">00:00</div>
      <div class="session-label">Temps de créativité</div>
    </div>
    <button class="session-btn session-btn-start" id="btnStart" onclick="startSession()">▶ Commencer à colorier</button>
    <button class="session-btn session-btn-stop" id="btnStop" style="display:none" onclick="stopSession()">✓ Terminer la session</button>
  </div>

  <!-- Feedback -->
  <div class="feedback-popup" id="feedbackPopup">
    <h3>🌟 Bravo l'artiste !</h3>
    <p>As-tu aimé créer ton œuvre ?</p>
    <form method="post" action="{{ path('app_session_calme_save') }}">
      <input type="hidden" name="type_activite" value="coloriage">
      <input type="hidden" name="duree_reelle" id="fDuree">
      <input type="hidden" name="feedback_enfant" id="fFeedback">

      <div class="star-row">
        {% for i in 1..5 %}
        <button type="button" class="star-btn" data-val="{{ i }}" onclick="rateStar({{ i }})">⭐</button>
        {% endfor %}
      </div>

      <textarea class="note-field" name="note_parent" rows="3" placeholder="Montre ton chef-d'œuvre à tes parents ! 🎨"></textarea>

      <button type="submit" class="submit-btn">Sauvegarder mon chef-d'œuvre ✓</button>
    </form>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// ── STATE ─────────────────────────────────────────────────
const canvas = document.getElementById('mainCanvas');
const ctx = canvas.getContext('2d');
const W = 700, H = 560;

// Layer system (3 offscreen canvases)
const layers = [
  document.createElement('canvas'),
  document.createElement('canvas'),
  document.createElement('canvas')
];
layers.forEach(l => { l.width = W; l.height = H; });
const layerCtx = layers.map(l => l.getContext('2d'));

let currentLayer = 0;
let layerOpacity = [1, 1, 1];
let currentTool = 'brush';
let currentColor = '#ff6b9d';
let currentHue = 340;
let currentLightness = 50;
let brushSize = 10;
let drawing = false;
let prevX = 0, prevY = 0;
let selectedSticker = '⭐';
let zoomLevel = 1;
let undoStack = [[], [], []];
let redoStack = [[], [], []];
let sessionTimer, sessionStart;
let recentColors = [];

// ── INIT ──────────────────────────────────────────────────
function initCanvas() {
  layerCtx[0].fillStyle = '#ffffff';
  layerCtx[0].fillRect(0, 0, W, H);
  flattenLayers();
}

function flattenLayers() {
  ctx.clearRect(0, 0, W, H);
  layers.forEach((l, i) => {
    ctx.globalAlpha = layerOpacity[i];
    ctx.drawImage(l, 0, 0);
  });
  ctx.globalAlpha = 1;
}

// ── COLOR WHEEL ───────────────────────────────────────────
const wheel = document.getElementById('colorWheel');
const wCtx = wheel.getContext('2d');

function drawColorWheel() {
  const size = 180;
  const cx = size / 2, cy = size / 2, r = size / 2 - 2;
  wCtx.clearRect(0, 0, size, size);

  for (let angle = 0; angle < 360; angle++) {
    const rad = (angle - 90) * Math.PI / 180;
    const grad = wCtx.createRadialGradient(cx, cy, 0, cx, cy, r);
    grad.addColorStop(0, 'white');
    grad.addColorStop(0.5, `hsl(${angle}, 100%, 50%)`);
    grad.addColorStop(1, `hsl(${angle}, 100%, 10%)`);

    const x2 = cx + r * Math.cos(rad);
    const y2 = cy + r * Math.sin(rad);
    wCtx.beginPath();
    wCtx.moveTo(cx, cy);
    wCtx.lineTo(x2, y2);
    wCtx.strokeStyle = `hsl(${angle}, 100%, 50%)`;
    wCtx.lineWidth = 2;
    wCtx.stroke();
  }

  // Redraw with radial gradient overlay for brightness
  const radGrad = wCtx.createRadialGradient(cx, cy, 0, cx, cy, r);
  radGrad.addColorStop(0, 'rgba(255,255,255,0.6)');
  radGrad.addColorStop(1, 'rgba(0,0,0,0)');
  wCtx.beginPath();
  wCtx.arc(cx, cy, r, 0, Math.PI * 2);
  wCtx.fillStyle = radGrad;
  wCtx.fill();
}

wheel.addEventListener('click', e => {
  const rect = wheel.getBoundingClientRect();
  const x = e.clientX - rect.left;
  const y = e.clientY - rect.top;
  const px = wCtx.getImageData(x * (180 / rect.width), y * (180 / rect.height), 1, 1).data;
  const hex = rgbToHex(px[0], px[1], px[2]);
  setColor(hex);
});

function rgbToHex(r, g, b) {
  return '#' + [r, g, b].map(v => v.toString(16).padStart(2, '0')).join('');
}

function setColor(hex) {
  currentColor = hex;
  document.getElementById('colorBigPreview').style.background = hex;
  document.getElementById('colorHex').textContent = hex;
  document.getElementById('brushPreview').style.background = hex;

  if (!recentColors.includes(hex)) {
    recentColors.unshift(hex);
    if (recentColors.length > 8) recentColors.pop();
    updateRecentColors();
  }
}

function updateRecentColors() {
  const container = document.getElementById('recentColors');
  container.innerHTML = recentColors.map(c =>
    `<div class="recent-swatch" style="background:${c}" onclick="setColor('${c}')"></div>`
  ).join('');
}

function updateLightness(val) {
  document.getElementById('opacityVal') // not opacity, lightness
  const lightHex = `hsl(${currentHue}, 80%, ${val}%)`;
  setColor(hslToHex(currentHue, 80, parseInt(val)));
}

function hslToHex(h, s, l) {
  s /= 100; l /= 100;
  const a = s * Math.min(l, 1 - l);
  const f = n => {
    const k = (n + h / 30) % 12;
    const color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
    return Math.round(255 * color).toString(16).padStart(2, '0');
  };
  return `#${f(0)}${f(8)}${f(4)}`;
}

drawColorWheel();
setColor('#ff6b9d');

// ── DRAWING ───────────────────────────────────────────────
function getPos(e) {
  const rect = canvas.getBoundingClientRect();
  const scaleX = canvas.width / rect.width;
  const scaleY = canvas.height / rect.height;
  const src = e.touches ? e.touches[0] : e;
  return {
    x: (src.clientX - rect.left) * scaleX,
    y: (src.clientY - rect.top) * scaleY
  };
}

canvas.addEventListener('mousedown', startDraw);
canvas.addEventListener('mousemove', doDraw);
canvas.addEventListener('mouseup', endDraw);
canvas.addEventListener('mouseleave', endDraw);
canvas.addEventListener('touchstart', e => { e.preventDefault(); startDraw(e); }, { passive: false });
canvas.addEventListener('touchmove', e => { e.preventDefault(); doDraw(e); }, { passive: false });
canvas.addEventListener('touchend', e => { e.preventDefault(); endDraw(e); }, { passive: false });

function startDraw(e) {
  if (currentTool === 'sticker') {
    const pos = getPos(e);
    placeSticker(pos.x, pos.y);
    return;
  }
  if (currentTool === 'fill') {
    const pos = getPos(e);
    floodFill(Math.round(pos.x), Math.round(pos.y), currentColor);
    flattenLayers();
    return;
  }
  drawing = true;
  saveUndo();
  const pos = getPos(e);
  prevX = pos.x; prevY = pos.y;
  layerCtx[currentLayer].beginPath();
  layerCtx[currentLayer].moveTo(pos.x, pos.y);
}

function doDraw(e) {
  if (!drawing) return;
  const pos = getPos(e);

  const lc = layerCtx[currentLayer];
  lc.globalAlpha = layerOpacity[currentLayer];
  lc.lineWidth = currentTool === 'eraser' ? brushSize * 2 : brushSize;
  lc.lineCap = 'round';
  lc.lineJoin = 'round';
  lc.strokeStyle = currentTool === 'eraser' ? '#ffffff' : currentColor;

  if (currentTool === 'pencil') {
    lc.globalAlpha = 0.6;
    lc.lineWidth = Math.max(2, brushSize * 0.4);
  }

  lc.lineTo(pos.x, pos.y);
  lc.stroke();
  lc.beginPath();
  lc.moveTo(pos.x, pos.y);

  flattenLayers();
}

function endDraw() {
  drawing = false;
  layerCtx[currentLayer].beginPath();
}

// ── FLOOD FILL ────────────────────────────────────────────
function floodFill(startX, startY, fillColorHex) {
  const imgData = layerCtx[currentLayer].getImageData(0, 0, W, H);
  const data = imgData.data;

  function getIdx(x, y) { return (y * W + x) * 4; }

  const si = getIdx(startX, startY);
  const sr = data[si], sg = data[si+1], sb = data[si+2], sa = data[si+3];

  const fc = hexToRgb(fillColorHex);
  if (!fc) return;
  if (sr === fc.r && sg === fc.g && sb === fc.b) return;

  const tolerance = 30;

  function matches(idx) {
    return Math.abs(data[idx] - sr) <= tolerance &&
           Math.abs(data[idx+1] - sg) <= tolerance &&
           Math.abs(data[idx+2] - sb) <= tolerance &&
           Math.abs(data[idx+3] - sa) <= tolerance;
  }

  const stack = [[startX, startY]];
  const visited = new Uint8Array(W * H);

  while (stack.length > 0) {
    const [x, y] = stack.pop();
    if (x < 0 || x >= W || y < 0 || y >= H) continue;
    const vi = y * W + x;
    if (visited[vi]) continue;
    const idx = vi * 4;
    if (!matches(idx)) continue;

    visited[vi] = 1;
    data[idx] = fc.r;
    data[idx+1] = fc.g;
    data[idx+2] = fc.b;
    data[idx+3] = 255;

    stack.push([x+1,y],[x-1,y],[x,y+1],[x,y-1]);
  }

  layerCtx[currentLayer].putImageData(imgData, 0, 0);
}

function hexToRgb(hex) {
  const r = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
  return r ? { r: parseInt(r[1], 16), g: parseInt(r[2], 16), b: parseInt(r[3], 16) } : null;
}

// ── STICKER ───────────────────────────────────────────────
function selectSticker(emoji) {
  selectedSticker = emoji;
  setTool('sticker');
  document.querySelectorAll('.sticker-item').forEach(s => s.style.background = '');
  document.querySelector(`[data-sticker="${emoji}"]`).style.background = '#f0e6ff';
}

function placeSticker(x, y) {
  const lc = layerCtx[currentLayer];
  lc.font = `${brushSize * 3}px serif`;
  lc.textAlign = 'center';
  lc.textBaseline = 'middle';
  lc.fillText(selectedSticker, x, y);
  flattenLayers();
  saveUndo();
}

// ── TOOLS ─────────────────────────────────────────────────
function setTool(tool) {
  currentTool = tool;
  document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
  const map = { brush: 'toolBrush', pencil: 'toolPencil', fill: 'toolFill', eraser: 'toolEraser', sticker: 'toolSticker' };
  if (map[tool]) document.getElementById(map[tool]).classList.add('active');
  canvas.style.cursor = tool === 'fill' ? 'cell' : tool === 'sticker' ? 'copy' : 'crosshair';
}

function updateBrushSize() {
  brushSize = parseInt(document.getElementById('brushSize').value);
  const preview = document.getElementById('brushPreview');
  preview.style.width = Math.min(brushSize * 2, 40) + 'px';
  preview.style.height = Math.min(brushSize * 2, 40) + 'px';
}

// ── LAYERS ────────────────────────────────────────────────
function switchLayer(idx, btn) {
  currentLayer = idx;
  document.querySelectorAll('.layer-chip').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('opacitySlider').value = layerOpacity[idx] * 100;
  document.getElementById('opacityVal').textContent = Math.round(layerOpacity[idx] * 100) + '%';
}

function updateOpacity(val) {
  layerOpacity[currentLayer] = val / 100;
  document.getElementById('opacityVal').textContent = val + '%';
  flattenLayers();
}

function clearCurrentLayer() {
  if (confirm('Effacer ce calque ?')) {
    layerCtx[currentLayer].clearRect(0, 0, W, H);
    if (currentLayer === 0) {
      layerCtx[0].fillStyle = '#ffffff';
      layerCtx[0].fillRect(0, 0, W, H);
    }
    flattenLayers();
  }
}

function clearAll() {
  if (confirm('Tout effacer ?')) {
    layers.forEach((l, i) => {
      layerCtx[i].clearRect(0, 0, W, H);
    });
    layerCtx[0].fillStyle = '#ffffff';
    layerCtx[0].fillRect(0, 0, W, H);
    if (selectedDrawingType && selectedDrawingType !== 'blank') {
      drawTemplate(selectedDrawingType);
    }
    flattenLayers();
  }
}

// ── UNDO/REDO ─────────────────────────────────────────────
function saveUndo() {
  undoStack[currentLayer].push(layerCtx[currentLayer].getImageData(0, 0, W, H));
  if (undoStack[currentLayer].length > 20) undoStack[currentLayer].shift();
  redoStack[currentLayer] = [];
}

function undoAction() {
  if (undoStack[currentLayer].length > 0) {
    redoStack[currentLayer].push(layerCtx[currentLayer].getImageData(0, 0, W, H));
    const prev = undoStack[currentLayer].pop();
    layerCtx[currentLayer].putImageData(prev, 0, 0);
    flattenLayers();
  }
}

function redoAction() {
  if (redoStack[currentLayer].length > 0) {
    undoStack[currentLayer].push(layerCtx[currentLayer].getImageData(0, 0, W, H));
    const next = redoStack[currentLayer].pop();
    layerCtx[currentLayer].putImageData(next, 0, 0);
    flattenLayers();
  }
}

// ── ZOOM ──────────────────────────────────────────────────
function toggleZoomIn() {
  zoomLevel = Math.min(2, zoomLevel + 0.25);
  applyZoom();
}

function toggleZoomOut() {
  zoomLevel = Math.max(0.5, zoomLevel - 0.25);
  applyZoom();
}

function applyZoom() {
  canvas.style.transform = `scale(${zoomLevel})`;
  canvas.style.transformOrigin = 'top left';
}

// ── DRAWING TEMPLATES ─────────────────────────────────────
let selectedDrawingType = 'blank';

function selectDrawing(el) {
  document.querySelectorAll('.drawing-card').forEach(d => d.classList.remove('selected'));
  el.classList.add('selected');
  selectedDrawingType = el.dataset.type;
  clearAll();
  if (selectedDrawingType !== 'blank') drawTemplate(selectedDrawingType);
}

function drawTemplate(type) {
  const lc = layerCtx[0];
  lc.fillStyle = '#ffffff';
  lc.fillRect(0, 0, W, H);
  lc.strokeStyle = '#555';
  lc.lineWidth = 2;

  const cx = W / 2, cy = H / 2;

  if (type === 'mandala') {
    for (let r = 40; r <= 220; r += 40) {
      lc.beginPath();
      lc.arc(cx, cy, r, 0, Math.PI * 2);
      lc.stroke();
    }
    for (let i = 0; i < 12; i++) {
      const a = (i / 12) * Math.PI * 2;
      lc.beginPath();
      lc.moveTo(cx, cy);
      lc.lineTo(cx + 220 * Math.cos(a), cy + 220 * Math.sin(a));
      lc.stroke();
    }
    for (let r = 80; r <= 200; r += 40) {
      for (let i = 0; i < 12; i++) {
        const a = (i / 12) * Math.PI * 2;
        lc.beginPath();
        lc.arc(cx + r * Math.cos(a), cy + r * Math.sin(a), 14, 0, Math.PI * 2);
        lc.stroke();
      }
    }
  } else if (type === 'star') {
    drawStar(lc, cx, cy, 5, 200, 90);
    drawStar(lc, cx, cy, 5, 140, 90);
    drawStar(lc, cx, cy, 8, 90, 50);
  } else if (type === 'butterfly') {
    lc.beginPath();
    lc.ellipse(cx - 80, cy - 20, 90, 70, -0.3, 0, Math.PI * 2);
    lc.stroke();
    lc.beginPath();
    lc.ellipse(cx + 80, cy - 20, 90, 70, 0.3, 0, Math.PI * 2);
    lc.stroke();
    lc.beginPath();
    lc.ellipse(cx - 50, cy + 60, 50, 35, -0.5, 0, Math.PI * 2);
    lc.stroke();
    lc.beginPath();
    lc.ellipse(cx + 50, cy + 60, 50, 35, 0.5, 0, Math.PI * 2);
    lc.stroke();
    lc.beginPath();
    lc.moveTo(cx, cy - 80);
    lc.lineTo(cx, cy + 100);
    lc.stroke();
  } else if (type === 'flower') {
    for (let i = 0; i < 8; i++) {
      const a = (i / 8) * Math.PI * 2;
      lc.beginPath();
      lc.ellipse(cx + 80 * Math.cos(a), cy + 80 * Math.sin(a), 45, 30, a, 0, Math.PI * 2);
      lc.stroke();
    }
    lc.beginPath();
    lc.arc(cx, cy, 45, 0, Math.PI * 2);
    lc.stroke();
  } else if (type === 'cloud') {
    drawCloud(lc, cx, cy - 20, 160, 80);
    drawCloud(lc, cx - 180, cy + 80, 110, 55);
    drawCloud(lc, cx + 160, cy + 100, 90, 45);
    // Rain drops
    for (let i = 0; i < 10; i++) {
      const rx = cx - 60 + i * 13;
      lc.beginPath();
      lc.moveTo(rx, cy + 80);
      lc.lineTo(rx - 4, cy + 120);
      lc.stroke();
    }
  } else {
    // Simple house
    lc.beginPath();
    lc.rect(cx - 120, cy - 40, 240, 180);
    lc.stroke();
    lc.beginPath();
    lc.moveTo(cx - 140, cy - 40);
    lc.lineTo(cx, cy - 170);
    lc.lineTo(cx + 140, cy - 40);
    lc.closePath();
    lc.stroke();
    lc.beginPath();
    lc.rect(cx - 30, cy + 60, 60, 80);
    lc.stroke();
    lc.beginPath();
    lc.rect(cx - 80, cy - 10, 50, 50);
    lc.stroke();
    lc.beginPath();
    lc.rect(cx + 30, cy - 10, 50, 50);
    lc.stroke();
  }

  flattenLayers();
}

function drawStar(c, cx, cy, points, outer, inner) {
  c.beginPath();
  for (let i = 0; i < points * 2; i++) {
    const r = i % 2 === 0 ? outer : inner;
    const a = (i / (points * 2)) * Math.PI * 2 - Math.PI / 2;
    const x = cx + r * Math.cos(a), y = cy + r * Math.sin(a);
    i === 0 ? c.moveTo(x, y) : c.lineTo(x, y);
  }
  c.closePath();
  c.stroke();
}

function drawCloud(c, cx, cy, w, h) {
  c.beginPath();
  c.arc(cx - w * 0.3, cy + h * 0.1, h * 0.45, Math.PI * 0.6, Math.PI * 1.9);
  c.arc(cx - w * 0.05, cy - h * 0.1, h * 0.55, Math.PI * 1.1, Math.PI * 1.95);
  c.arc(cx + w * 0.2, cy - h * 0.05, h * 0.4, Math.PI * 1.15, Math.PI * 1.9);
  c.arc(cx + w * 0.4, cy + h * 0.1, h * 0.35, Math.PI * 1.1, Math.PI * 0.4);
  c.closePath();
  c.stroke();
}

// ── DOWNLOAD ──────────────────────────────────────────────
function downloadDrawing() {
  const link = document.createElement('a');
  link.download = 'mon-chef-oeuvre.png';
  link.href = canvas.toDataURL();
  link.click();
}

// ── SESSION ───────────────────────────────────────────────
function startSession() {
  sessionStart = Date.now();
  sessionTimer = setInterval(() => {
    const elapsed = Math.floor((Date.now() - sessionStart) / 1000);
    const m = Math.floor(elapsed / 60), s = elapsed % 60;
    document.getElementById('sessionTimer').textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
  }, 1000);
  document.getElementById('btnStart').style.display = 'none';
  document.getElementById('btnStop').style.display = 'flex';
}

function stopSession() {
  clearInterval(sessionTimer);
  const dur = Math.round((Date.now() - sessionStart) / 60000);
  document.getElementById('fDuree').value = dur || 1;
  document.getElementById('feedbackPopup').style.display = 'block';
  document.getElementById('feedbackPopup').scrollIntoView({ behavior: 'smooth' });
  document.getElementById('btnStop').style.display = 'none';
}

// ── STARS ─────────────────────────────────────────────────
function rateStar(val) {
  document.getElementById('fFeedback').value = val;
  document.querySelectorAll('.star-btn').forEach(s => {
    s.classList.toggle('lit', parseInt(s.dataset.val) <= val);
  });
}

// ── INIT ──────────────────────────────────────────────────
initCanvas();
</script>
{% endblock %}
