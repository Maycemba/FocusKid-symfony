</div>

{# ══════════════════════════════════════════════════
   CHATBOT FLOTTANT
══════════════════════════════════════════════════ #}
<button id="chatbot-toggle" title="Assistant pédagogique IA">
    🤖
    <span class="badge-notif" id="chatbot-notif">1</span>
</button>

<div id="chatbot-window">
    <div class="cb-header">
        <div class="cb-avatar">🎓</div>
        <div>
            <div class="cb-title">Assistant FocusKids</div>
            <div class="cb-subtitle">Idées pédagogiques IA • En ligne</div>
        </div>
        <button class="cb-close" id="chatbot-close" title="Fermer">✕</button>
    </div>
    <div class="cb-quick">
        <button data-q="Donne-moi 5 titres ultra-accrocheurs pour un enfant TDAH, courts et dynamiques avec un défi ou une aventure">💡 Titres TDAH</button>
        <button data-q="Écris 3 descriptions courtes et percutantes pour un enfant TDAH, 2-3 phrases max, parle-lui directement avec 'tu', donne envie tout de suite">📝 Descriptions</button>
        <button data-q="Propose 5 activités ludiques très courtes et stimulantes adaptées aux enfants TDAH, avec du mouvement ou du défi">🎮 Activités fun</button>
        <button data-q="Donne-moi un plan de séance en 5 étapes courtes adapté aux enfants TDAH avec des transitions rapides">📚 Plan rapide</button>
        <button data-q="Comment capter et garder l'attention d'un enfant TDAH pendant ce cours ? Donne des astuces concrètes">🧠 Astuces TDAH</button>
    </div>
    <div class="cb-messages" id="cb-messages">
        <div class="cb-msg bot">
            <div class="cb-msg-icon">🎓</div>
            <div class="cb-bubble">
                Bonjour ! Je suis votre assistant pédagogique spécialisé <strong>TDAH</strong>. 🧠⚡<br><br>
                Je génère des <strong>titres percutants, descriptions accrocheuses et activités dynamisantes</strong> pensées pour capter l'attention des enfants TDAH.<br><br>
