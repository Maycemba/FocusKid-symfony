{% extends 'base-back.html.twig' %}

{% block title %}Nouveau cours - FocusKids{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ── Badges statut ───────────────────────────────────── */
        .badge-type        { display:inline-block; padding:5px 15px; border-radius:20px; font-size:12px; font-weight:bold; }
        .badge-brouillon   { background:#FF9800; color:white; }
        .badge-publie      { background:#4CAF50; color:white; }
        .badge-archive     { background:#9E9E9E; color:white; }

        /* ── Bouton flottant ─────────────────────────────────── */
        #chatbot-toggle {
            position: fixed;
            bottom: 28px;
            right: 28px;
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            border: none;
            font-size: 24px;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(102,126,234,.55);
            z-index: 1050;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform .2s, box-shadow .2s;
        }
        #chatbot-toggle:hover { transform:scale(1.1); box-shadow:0 8px 26px rgba(102,126,234,.7); }
        #chatbot-toggle .badge-notif {
            position:absolute; top:4px; right:4px;
            background:#ff4757; color:#fff;
            border-radius:50%; width:16px; height:16px;
            font-size:10px; display:flex; align-items:center; justify-content:center;
        }

        /* ── Fenêtre chatbot ─────────────────────────────────── */
        #chatbot-window {
            position: fixed;
            bottom: 98px;
            right: 28px;
            width: 370px;
            max-height: 520px;
            background: #fff;
            border-radius: 18px;
            box-shadow: 0 12px 40px rgba(0,0,0,.18);
            display: flex;
            flex-direction: column;
            z-index: 1049;
            overflow: hidden;
            transform: scale(.85) translateY(30px);
            opacity: 0;
            pointer-events: none;
            transition: transform .25s cubic-bezier(.34,1.56,.64,1), opacity .2s;
        }
        #chatbot-window.open {
            transform: scale(1) translateY(0);
            opacity: 1;
            pointer-events: all;
        }

        /* Header */
        .cb-header {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .cb-header .cb-avatar {
            width: 36px; height: 36px; border-radius: 50%;
            background: rgba(255,255,255,.25);
            display:flex; align-items:center; justify-content:center;
            font-size:18px;
        }
        .cb-header .cb-title   { font-weight:700; font-size:15px; }
        .cb-header .cb-subtitle{ font-size:11px; opacity:.8; }
        .cb-header .cb-close   { margin-left:auto; background:none; border:none; color:#fff; font-size:20px; cursor:pointer; line-height:1; }

        /* Suggestions rapides */
        .cb-quick {
            padding: 10px 14px 0;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }
        .cb-quick button {
            font-size: 11.5px;
            padding: 5px 11px;
            border-radius: 20px;
            border: 1.5px solid #667eea;
            color: #667eea;
            background: #f0f0ff;
            cursor: pointer;
            transition: background .15s, color .15s;
            white-space: nowrap;
        }
        .cb-quick button:hover { background:#667eea; color:#fff; }

        /* Messages */
        .cb-messages {
            flex: 1;
            overflow-y: auto;
            padding: 14px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            scroll-behavior: smooth;
        }
        .cb-msg { display:flex; gap:8px; align-items:flex-start; }
        .cb-msg.bot .cb-bubble {
            background: #f0f0ff;
            border-radius: 4px 14px 14px 14px;
            color: #2d2d2d;
        }
        .cb-msg.user { flex-direction:row-reverse; }
        .cb-msg.user .cb-bubble {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            border-radius: 14px 4px 14px 14px;
        }
        .cb-bubble {
            padding: 10px 13px;
            font-size: 13.5px;
            line-height: 1.5;
            max-width: 265px;
            word-break: break-word;
        }
        .cb-bubble ul { margin:6px 0 0 16px; padding:0; }
        .cb-bubble li { margin-bottom:3px; }
        .cb-msg-icon {
            width:28px; height:28px; border-radius:50%;
            background:#667eea; color:#fff;
            display:flex; align-items:center; justify-content:center;
            font-size:14px; flex-shrink:0; margin-top:2px;
        }
        .cb-msg.user .cb-msg-icon { background:#764ba2; }

        /* Typing dots */
        .cb-typing { display:flex; gap:4px; padding:10px 13px; align-items:center; }
        .cb-typing span {
            width:7px; height:7px; border-radius:50%;
            background:#aaa; animation:bounce 1.2s infinite;
        }
        .cb-typing span:nth-child(2){ animation-delay:.2s; }
        .cb-typing span:nth-child(3){ animation-delay:.4s; }
        @keyframes bounce { 0%,60%,100%{transform:translateY(0)} 30%{transform:translateY(-7px)} }

        /* Input */
        .cb-input-row {
            display: flex;
            gap: 8px;
            padding: 12px 14px;
            border-top: 1px solid #eee;
        }
        .cb-input-row input {
            flex:1; border:1.5px solid #ddd; border-radius:22px;
            padding:9px 15px; font-size:13.5px; outline:none;
            transition:border-color .15s;
        }
        .cb-input-row input:focus { border-color:#667eea; }
        .cb-input-row button {
            width:38px; height:38px; border-radius:50%;
            background:linear-gradient(135deg,#667eea,#764ba2);
            border:none; color:#fff; font-size:16px;
            cursor:pointer; display:flex; align-items:center; justify-content:center;
            transition:transform .15s;
        }
        .cb-input-row button:hover { transform:scale(1.08); }
        .cb-input-row button:disabled { opacity:.5; cursor:not-allowed; transform:none; }
    </style>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="card-title text-white mb-0">
                            <i class="ti ti-plus"></i> Ajouter un nouveau cours
                        </h4>
                        <small class="text-white-50">Créez un cours puis passez à l'ajout des leçons</small>
                    </div>
                    <a href="{{ path('app_cour_index') }}" class="btn btn-light">
                        <i class="ti ti-arrow-left"></i> Retour à la liste
                    </a>
                </div>
            </div>

            <div class="card-body">
                {{ include('cour/_form.html.twig', {'button_label': 'Enregistrer le cours'}) }}
            </div>
        </div>
    </div>
</div>

{# ══════════════════════════════════════════════════
   CHATBOT FLOTTANT
══════════════════════════════════════════════════ #}

{# Bouton flottant #}
<button id="chatbot-toggle" title="Assistant pédagogique IA">
    🤖
    <span class="badge-notif" id="chatbot-notif">1</span>
</button>

{# Fenêtre chatbot #}
<div id="chatbot-window">
    <div class="cb-header">
        <div class="cb-avatar">🎓</div>
        <div>
            <div class="cb-title">Assistant FocusKids</div>
            <div class="cb-subtitle">Idées pédagogiques IA • En ligne</div>
        </div>
        <button class="cb-close" id="chatbot-close" title="Fermer">✕</button>
    </div>

    {# Suggestions rapides #}
    <div class="cb-quick">
        <button data-q="Suggère-moi un titre accrocheur">💡 Titre</button>
        <button data-q="Donne-moi des idées de description">📝 Description</button>
        <button data-q="Quels objectifs pédagogiques pour ce cours ?">🎯 Objectifs</button>
        <button data-q="Propose un plan de cours structuré">📚 Plan</button>
        <button data-q="Des activités ludiques adaptées au niveau ?">🎮 Activités</button>
    </div>

    <div class="cb-messages" id="cb-messages">
        {# Message de bienvenue #}
        <div class="cb-msg bot">
            <div class="cb-msg-icon">🎓</div>
            <div class="cb-bubble">
                Bonjour ! Je suis votre assistant pédagogique IA. 👋<br><br>
                Je peux vous aider à trouver des <strong>idées de titres, descriptions, objectifs et plans de cours</strong>.<br><br>
                Utilisez les boutons rapides ou posez-moi une question !
            </div>
        </div>
    </div>

    <div class="cb-input-row">
        <input type="text" id="cb-input" placeholder="Posez une question..." maxlength="400" />
        <button id="cb-send" title="Envoyer">➤</button>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    // ── Statut badge ──────────────────────────────────────────────
    (function () {
        const statutField = document.getElementById('cour_statut');
        const statutBadge = document.getElementById('statutBadge');
        const descriptionField = document.getElementById('cour_description');
        const charCount = document.getElementById('charCount');

        function updateBadge() {
            if (!statutField || !statutBadge) return;
            const value = (statutField.value || '').toLowerCase();
            statutBadge.className = 'badge-type';
            if (value.includes('publi'))      statutBadge.classList.add('badge-publie');
            else if (value === 'archive')     statutBadge.classList.add('badge-archive');
            else                              statutBadge.classList.add('badge-brouillon');
            statutBadge.textContent = (statutField.options[statutField.selectedIndex]?.text || 'BROUILLON').toUpperCase();
        }

        function updateCounter() {
            if (!descriptionField || !charCount) return;
            charCount.textContent = `${descriptionField.value.length}/500 caractères`;
        }

        if (statutField)      { statutField.addEventListener('change', updateBadge); updateBadge(); }
        if (descriptionField) { descriptionField.addEventListener('input', updateCounter); updateCounter(); }
    })();

    // ── Chatbot ───────────────────────────────────────────────────
    (function () {
        const toggle   = document.getElementById('chatbot-toggle');
        const win      = document.getElementById('chatbot-window');
        const closeBtn = document.getElementById('chatbot-close');
        const messages = document.getElementById('cb-messages');
        const input    = document.getElementById('cb-input');
        const sendBtn  = document.getElementById('cb-send');
        const notif    = document.getElementById('chatbot-notif');
        const quickBtns = document.querySelectorAll('.cb-quick button');
        const apiUrl   = '{{ path("chatbot_suggest") }}';

        let isOpen = false;

        // Ouvrir / fermer
        toggle.addEventListener('click', () => {
            isOpen = !isOpen;
            win.classList.toggle('open', isOpen);
            toggle.innerHTML = isOpen ? '✕' : '🤖';
            if (notif) notif.remove();
            if (isOpen) { setTimeout(() => input.focus(), 300); }
        });
        closeBtn.addEventListener('click', () => {
            isOpen = false;
            win.classList.remove('open');
            toggle.innerHTML = '🤖';
        });

        // Récupère le contexte du formulaire
        function getFormContext() {
            return {
                titre:       document.getElementById('cour_titre')?.value       || '',
                niveau:      document.getElementById('cour_niveau')?.value      || '',
                description: document.getElementById('cour_description')?.value || '',
                formateur:   document.getElementById('cour_formateur')?.value   || '',
            };
        }

        // Ajoute un message dans la fenêtre
        function addMessage(text, role) {
            const wrap = document.createElement('div');
            wrap.className = `cb-msg ${role}`;

            const icon = document.createElement('div');
            icon.className = 'cb-msg-icon';
            icon.textContent = role === 'bot' ? '🎓' : '👤';

            const bubble = document.createElement('div');
            bubble.className = 'cb-bubble';

            // Convertit les listes markdown simples
            const html = text
                .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                .replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>')
                .replace(/\*(.*?)\*/g,'<em>$1</em>')
                .replace(/^[-•]\s+(.+)$/gm,'<li>$1</li>')
                .replace(/(<li>.*<\/li>)/s, '<ul>$1</ul>')
                .replace(/\n/g,'<br>');
            bubble.innerHTML = html;

            wrap.appendChild(icon);
            wrap.appendChild(bubble);
            messages.appendChild(wrap);
            messages.scrollTop = messages.scrollHeight;
        }

        // Indicateur de frappe
        function addTyping() {
            const wrap = document.createElement('div');
            wrap.className = 'cb-msg bot';
            wrap.id = 'cb-typing-indicator';
            const icon = document.createElement('div');
            icon.className = 'cb-msg-icon'; icon.textContent = '🎓';
            const typing = document.createElement('div');
            typing.className = 'cb-typing';
            typing.innerHTML = '<span></span><span></span><span></span>';
            wrap.appendChild(icon); wrap.appendChild(typing);
            messages.appendChild(wrap);
            messages.scrollTop = messages.scrollHeight;
        }

        function removeTyping() {
            document.getElementById('cb-typing-indicator')?.remove();
        }

        // Envoi du message
        async function send(text) {
            const msg = (text || input.value).trim();
            if (!msg) return;

            input.value = '';
            sendBtn.disabled = true;
            addMessage(msg, 'user');
            addTyping();

            try {
                const res = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: msg, context: getFormContext() }),
                });
                const data = await res.json();
                removeTyping();

                if (data.error) {
                    addMessage('❌ Erreur : ' + data.error, 'bot');
                } else {
                    addMessage(data.reply, 'bot');
                }
            } catch (e) {
                removeTyping();
                addMessage('❌ Impossible de contacter l\'assistant. Vérifiez votre connexion.', 'bot');
            } finally {
                sendBtn.disabled = false;
                input.focus();
            }
        }

        // Événements
        sendBtn.addEventListener('click', () => send());
        input.addEventListener('keydown', e => { if (e.key === 'Enter') send(); });
        quickBtns.forEach(btn => btn.addEventListener('click', () => send(btn.dataset.q)));
    })();
    </script>
{% endblock %}
