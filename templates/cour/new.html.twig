{% extends 'base-front.html.twig' %}

{% block title %}Nouveau cours - FocusKids{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .config-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
            border: 1px solid #e0e0e0;
        }
        .badge-type {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }
        .badge-brouillon { background: #FF9800; color: white; }
        .badge-publie { background: #4CAF50; color: white; }
        .badge-archive { background: #9E9E9E; color: white; }
    </style>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="card-title text-white mb-0">
                            <i class="ti ti-book"></i> Créer un nouveau cours
                        </h4>
                        <small class="text-white-50">Ajoutez les informations principales du cours</small>
                    </div>
                    <a href="{{ path('app_cour_index') }}" class="btn btn-light">
                        <i class="ti ti-arrow-left"></i> Retour à la liste
                    </a>
                </div>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'id': 'courForm'}}) }}
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.titre, 'Titre du cours', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Alphabet et lecture'}}) }}
                            {{ form_errors(form.titre) }}
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            {{ form_label(form.niveau, 'Niveau', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.niveau, {'attr': {'class': 'form-control', 'placeholder': 'Ex: 1'}}) }}
                            {{ form_errors(form.niveau) }}
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            {{ form_label(form.statut, 'Statut', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.statut, {'attr': {'class': 'form-select', 'id': 'statutSelect'}}) }}
                            {{ form_errors(form.statut) }}
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.formateur, 'Formateur', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.formateur, {'attr': {'class': 'form-control', 'placeholder': 'Nom du formateur'}}) }}
                            {{ form_errors(form.formateur) }}
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Aperçu statut</label>
                            <div>
                                <span id="statutBadge" class="badge-type badge-brouillon">BROUILLON</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Décrivez le contenu du cours...', 'maxlength': 30}}) }}
                            {{ form_errors(form.description) }}
                            <small class="text-muted" id="charCount">0/30 caractères</small>
                        </div>
                    </div>
                    
                    <div class="row mt-4">
                        <div class="col-12 text-center">
                            <button type="submit" class="btn btn-primary px-5">
                                <i class="ti ti-device-floppy"></i> Créer le cours
                            </button>
                            <a href="{{ path('app_cour_index') }}" class="btn btn-secondary px-5 ms-2">
                                <i class="ti ti-x"></i> Annuler
                            </a>
                        </div>
                    </div>
                    
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Gestion du compteur de caractères
        const descriptionField = document.getElementById('cour_description');
        const charCountSpan = document.getElementById('charCount');
        
        if(descriptionField && charCountSpan) {
            function updateCharCount() {
                const length = descriptionField.value.length;
                charCountSpan.textContent = length + '/30 caractères';
                if(length > 25) {
                    charCountSpan.style.color = '#FF9800';
                } else if(length > 28) {
                    charCountSpan.style.color = '#F44336';
                } else {
                    charCountSpan.style.color = '#666';
                }
            }
            descriptionField.addEventListener('input', updateCharCount);
            updateCharCount();
        }
        
        // Gestion du badge de statut
        const statutSelect = document.getElementById('cour_statut');
        const statutBadge = document.getElementById('statutBadge');
        
        if(statutSelect && statutBadge) {
            function updateStatutBadge() {
                const statut = statutSelect.value;
                const statutText = statut ? statut.toUpperCase() : 'BROUILLON';
                
                let className = 'badge-brouillon';
                if(statutText.includes('PUBLIE')) {
                    className = 'badge-publie';
                } else if(statutText.includes('ARCHIVE')) {
                    className = 'badge-archive';
                }
                
                statutBadge.textContent = statutText;
                statutBadge.className = 'badge-type ' + className;
            }
            
            statutSelect.addEventListener('change', updateStatutBadge);
            updateStatutBadge();
        }
    </script>
{% endblock %}