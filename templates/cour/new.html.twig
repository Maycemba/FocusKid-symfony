{% extends 'base-back.html.twig' %}

{% block title %}Nouveau cours - FocusKids{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ── Badges statut ───────────────────────────────────── */
        .badge-type        { display:inline-block; padding:5px 15px; border-radius:20px; font-size:12px; font-weight:bold; }
        .badge-brouillon   { background:#FF9800; color:white; }
        .badge-publie      { background:#4CAF50; color:white; }
        .badge-archive     { background:#9E9E9E; color:white; }

        /* ── Bouton IA ───────────────────────────────────────── */
        #btn-generer-ia {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 10px 22px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 15px rgba(102,126,234,.4);
            transition: transform .2s, box-shadow .2s;
            margin-bottom: 1.2rem;
        }
        #btn-generer-ia:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(102,126,234,.55); }
        #btn-generer-ia:disabled { opacity: .6; cursor: not-allowed; transform: none; }

        /* ── Modal ───────────────────────────────────────────── */
        #ia-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.45);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }
        #ia-modal-overlay.open { display: flex; }

        #ia-modal {
            background: #fff;
            border-radius: 18px;
            width: 680px;
            max-width: 95vw;
            max-height: 85vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,.25);
            animation: popIn .25s cubic-bezier(.34,1.56,.64,1);
        }
        @keyframes popIn { from { transform: scale(.88); opacity: 0; } to { transform: scale(1); opacity: 1; } }

        .ia-modal-header {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            padding: 18px 22px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .ia-modal-header h5 { margin: 0; font-size: 17px; font-weight: 700; }
        .ia-modal-header p  { margin: 0; font-size: 12px; opacity: .8; }
        .ia-modal-close {
            margin-left: auto;
            background: rgba(255,255,255,.2);
            border: none;
            color: #fff;
            width: 32px; height: 32px;
            border-radius: 50%;
            font-size: 18px;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
        }
        .ia-modal-close:hover { background: rgba(255,255,255,.35); }

        .ia-modal-body {
            padding: 20px 22px;
            overflow-y: auto;
            flex: 1;
        }

        /* Sections suggestions */
        .ia-section { margin-bottom: 20px; }
        .ia-section-title {
            font-weight: 700;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #667eea;
            margin-bottom: 10px;
            padding-bottom: 6px;
            border-bottom: 2px solid #f0f0ff;
        }

        /* Cards de suggestion */
        .ia-card {
            border: 1.5px solid #e8e8f0;
            border-radius: 10px;
            padding: 12px 14px;
            margin-bottom: 8px;
            font-size: 14px;
            line-height: 1.55;
            cursor: pointer;
            transition: border-color .15s, background .15s, transform .1s;
            position: relative;
        }
        .ia-card:hover {
            border-color: #667eea;
            background: #f5f5ff;
            transform: translateX(3px);
        }
        .ia-card .ia-card-use {
            position: absolute;
            right: 12px; top: 50%;
            transform: translateY(-50%);
            background: #667eea;
            color: #fff;
            border: none;
            border-radius: 6px;
            padding: 4px 10px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            opacity: 0;
            transition: opacity .15s;
        }
        .ia-card:hover .ia-card-use { opacity: 1; }

        /* Loading spinner */
        .ia-loading {
            text-align: center;
            padding: 40px 20px;
            color: #667eea;
        }
        .ia-spinner {
            width: 40px; height: 40px;
            border: 4px solid #f0f0ff;
            border-top-color: #667eea;
            border-radius: 50%;
            animation: spin .8s linear infinite;
            margin: 0 auto 12px;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* ── Chatbot flottant ─────────────────────────────────── */
        #chatbot-toggle {
            position: fixed; bottom: 28px; right: 28px;
            width: 58px; height: 58px; border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff; border: none; font-size: 24px; cursor: pointer;
            box-shadow: 0 6px 20px rgba(102,126,234,.55);
            z-index: 1050; display: flex; align-items: center; justify-content: center;
            transition: transform .2s, box-shadow .2s;
        }
        #chatbot-toggle:hover { transform:scale(1.1); box-shadow:0 8px 26px rgba(102,126,234,.7); }
        #chatbot-toggle .badge-notif {
            position:absolute; top:4px; right:4px;
            background:#ff4757; color:#fff; border-radius:50%;
            width:16px; height:16px; font-size:10px;
            display:flex; align-items:center; justify-content:center;
        }
        #chatbot-window {
            position: fixed; bottom: 98px; right: 28px;
            width: 370px; max-height: 520px; background: #fff;
            border-radius: 18px; box-shadow: 0 12px 40px rgba(0,0,0,.18);
            display: flex; flex-direction: column; z-index: 1049; overflow: hidden;
            transform: scale(.85) translateY(30px); opacity: 0; pointer-events: none;
            transition: transform .25s cubic-bezier(.34,1.56,.64,1), opacity .2s;
        }
        #chatbot-window.open { transform: scale(1) translateY(0); opacity: 1; pointer-events: all; }
        .cb-header { background: linear-gradient(135deg,#667eea,#764ba2); color:#fff; padding:14px 18px; display:flex; align-items:center; gap:10px; }
        .cb-header .cb-avatar { width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,.25); display:flex; align-items:center; justify-content:center; font-size:18px; }
        .cb-header .cb-title   { font-weight:700; font-size:15px; }
        .cb-header .cb-subtitle{ font-size:11px; opacity:.8; }
        .cb-header .cb-close   { margin-left:auto; background:none; border:none; color:#fff; font-size:20px; cursor:pointer; }
        .cb-quick { padding:10px 14px 0; display:flex; flex-wrap:wrap; gap:6px; }
        .cb-quick button { font-size:11.5px; padding:5px 11px; border-radius:20px; border:1.5px solid #667eea; color:#667eea; background:#f0f0ff; cursor:pointer; transition:background .15s,color .15s; white-space:nowrap; }
        .cb-quick button:hover { background:#667eea; color:#fff; }
        .cb-messages { flex:1; overflow-y:auto; padding:14px; display:flex; flex-direction:column; gap:10px; scroll-behavior:smooth; }
        .cb-msg { display:flex; gap:8px; align-items:flex-start; }
        .cb-msg.bot .cb-bubble { background:#f0f0ff; border-radius:4px 14px 14px 14px; color:#2d2d2d; }
        .cb-msg.user { flex-direction:row-reverse; }
        .cb-msg.user .cb-bubble { background:linear-gradient(135deg,#667eea,#764ba2); color:#fff; border-radius:14px 4px 14px 14px; }
        .cb-bubble { padding:10px 13px; font-size:13.5px; line-height:1.5; max-width:265px; word-break:break-word; }
        .cb-msg-icon { width:28px; height:28px; border-radius:50%; background:#667eea; color:#fff; display:flex; align-items:center; justify-content:center; font-size:14px; flex-shrink:0; margin-top:2px; }
        .cb-msg.user .cb-msg-icon { background:#764ba2; }
        .cb-typing { display:flex; gap:4px; padding:10px 13px; align-items:center; }
        .cb-typing span { width:7px; height:7px; border-radius:50%; background:#aaa; animation:bounce 1.2s infinite; }
        .cb-typing span:nth-child(2){ animation-delay:.2s; }
        .cb-typing span:nth-child(3){ animation-delay:.4s; }
        @keyframes bounce { 0%,60%,100%{transform:translateY(0)} 30%{transform:translateY(-7px)} }
        .cb-input-row { display:flex; gap:8px; padding:12px 14px; border-top:1px solid #eee; }
        .cb-input-row input { flex:1; border:1.5px solid #ddd; border-radius:22px; padding:9px 15px; font-size:13.5px; outline:none; }
        .cb-input-row input:focus { border-color:#667eea; }
        .cb-input-row button { width:38px; height:38px; border-radius:50%; background:linear-gradient(135deg,#667eea,#764ba2); border:none; color:#fff; font-size:16px; cursor:pointer; display:flex; align-items:center; justify-content:center; }
        .cb-input-row button:disabled { opacity:.5; cursor:not-allowed; }
    </style>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="card-title text-white mb-0">
                            <i class="ti ti-plus"></i> Ajouter un nouveau cours
                        </h4>
                        <small class="text-white-50">Créez un cours puis passez à l'ajout des leçons</small>
