</div>

{# ══════════════════════════════════════════════════
   MODAL IA
══════════════════════════════════════════════════ #}
<div id="ia-modal-overlay">
    <div id="ia-modal">
        <div class="ia-modal-header">
            <div>
                <h5>✨ Suggestions IA pour votre cours</h5>
