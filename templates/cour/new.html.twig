{% extends 'base-back.html.twig' %}

{% block title %}Nouveau cours - FocusKids{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .config-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
            border: 1px solid #e0e0e0;
        }
        .badge-type {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }
        .badge-brouillon { background: #FF9800; color: white; }
        .badge-publie { background: #4CAF50; color: white; }
        .badge-archive { background: #9E9E9E; color: white; }
    </style>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="card-title text-white mb-0">
                            <i class="ti ti-plus"></i> Ajouter un nouveau cours
                        </h4>
                        <small class="text-white-50">Créez un cours puis passez a l'ajout des lecons</small>
                    </div>
                    <a href="{{ path('app_cour_index') }}" class="btn btn-light">
                        <i class="ti ti-arrow-left"></i> Retour a la liste
                    </a>
                </div>
            </div>

            <div class="card-body">
                {{ include('cour/_form.html.twig', {'button_label': 'Enregistrer le cours'}) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const statutField = document.getElementById('cour_statut');
            const statutBadge = document.getElementById('statutBadge');
            const descriptionField = document.getElementById('cour_description');
            const charCount = document.getElementById('charCount');

            function updateBadge() {
                if (!statutField || !statutBadge) {
                    return;
                }

                const value = (statutField.value || '').toLowerCase();
                statutBadge.className = 'badge-type';

                if (value === 'publie' || value === 'publiee' || value === 'publie') {
                    statutBadge.classList.add('badge-publie');
                } else if (value === 'archive') {
                    statutBadge.classList.add('badge-archive');
                } else {
                    statutBadge.classList.add('badge-brouillon');
                }

                statutBadge.textContent = (statutField.options[statutField.selectedIndex]?.text || 'BROUILLON').toUpperCase();
            }

            function updateCounter() {
                if (!descriptionField || !charCount) {
                    return;
                }

                charCount.textContent = `${descriptionField.value.length}/500 caracteres`;
            }

            if (statutField) {
                statutField.addEventListener('change', updateBadge);
                updateBadge();
            }

            if (descriptionField) {
                descriptionField.addEventListener('input', updateCounter);
                updateCounter();
            }
        })();
    </script>
{% endblock %}
