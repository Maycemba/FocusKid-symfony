</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    const apiUrl = '{{ path("chatbot_suggest") }}';

    // ── Utilitaire : récupère le contexte du formulaire ───────────
    function getFormContext() {
        return {
            titre:       document.getElementById('cour_titre')?.value       || '',
            niveau:      document.getElementById('cour_niveau')?.value      || '',
            description: document.getElementById('cour_description')?.value || '',
            formateur:   document.getElementById('cour_formateur')?.value   || '',
        };
    }

    // ── Utilitaire : markdown simple → HTML ──────────────────────
    function mdToHtml(text) {
        return text
            .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
            .replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>')
            .replace(/\*(.*?)\*/g,'<em>$1</em>')
            .replace(/^[*\-•+]\s+(.+)$/gm,'<li>$1</li>')
            .replace(/(<li>[\s\S]*?<\/li>)/g,'<ul>$1</ul>')
            .replace(/\n/g,'<br>');
    }

    // ══════════════════════════════════════════════════════════════
    // BOUTON IA + MODAL
    // ══════════════════════════════════════════════════════════════
    (function () {
        const btn     = document.getElementById('btn-generer-ia');
        const overlay = document.getElementById('ia-modal-overlay');
        const body    = document.getElementById('ia-modal-body');
        const closeBtn= document.getElementById('ia-modal-close');

        // Ouvrir la modal et lancer la génération
        btn.addEventListener('click', async () => {
            overlay.classList.add('open');
            body.innerHTML = `
                <div class="ia-loading">
                    <div class="ia-spinner"></div>
                    <p>L'IA génère vos suggestions...</p>
                </div>`;

            btn.disabled = true;

            const ctx = getFormContext();
            const niveau = ctx.niveau || 'non précisé';
            const titre  = ctx.titre  || 'sans titre';

            // Marqueurs ###SECTION### détectés côté JS sans risque de décalage d'index
            const prompt = `Tu es un expert en pédagogie pour enfants TDAH. Génère du contenu CAPTIVANT pour un cours intitulé "${titre}", niveau "${niveau}".

RÈGLES ABSOLUES :
- Titres : max 7 mots, verbe d'action ou défi. Ex: "Mission : bats le record !", "Le secret des nombres !".
- Descriptions : 2-3 phrases MAX, tutoiement direct ("tu"), ton énergique, mentionne une activité fun.
- JAMAIS de texte introductif. Commence DIRECTEMENT par ###TITRES###.

Réponds EXACTEMENT dans ce format (copie les marqueurs tels quels) :

###TITRES###
- [titre 1]
- [titre 2]
- [titre 3]
- [titre 4]
- [titre 5]

###DESCRIPTIONS###
- [description 1 : 2-3 phrases, tutoiement, ton dynamique]
- [description 2 : 2-3 phrases, tutoiement, ton dynamique]
- [description 3 : 2-3 phrases, tutoiement, ton dynamique]

###OBJECTIFS###
- [objectif 1]
- [objectif 2]
- [objectif 3]
- [objectif 4]
- [objectif 5]

###PLAN###
- [étape 1]
- [étape 2]
- [étape 3]
- [étape 4]
- [étape 5]

###ACTIVITES###
- [activité 1]
- [activité 2]
- [activité 3]
- [activité 4]`.trim();

            try {
                const res  = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: prompt, context: ctx }),
                });
                const data = await res.json();

                if (data.error) {
                    body.innerHTML = `<div class="alert alert-danger">❌ ${data.error}</div>`;
                } else {
                    afficherSuggestions(data.reply, ctx);
                }
            } catch (e) {
                body.innerHTML = `<div class="alert alert-danger">❌ Impossible de contacter l'IA.</div>`;
            } finally {
                btn.disabled = false;
            }
        });

        // Fermer la modal
        closeBtn.addEventListener('click', () => overlay.classList.remove('open'));
        overlay.addEventListener('click', e => { if (e.target === overlay) overlay.classList.remove('open'); });

        // ══════════════════════════════════════════════════════════
        // afficherSuggestions — parsing par marqueurs ###SECTION###
        // Robuste : le champ cible est lié au NOM du marqueur,
        // jamais à l'index → aucun risque de décalage.
        // ══════════════════════════════════════════════════════════
        function afficherSuggestions(texte, ctx) {

            // Mapping marqueur → champ HTML + label affiché
            const SECTIONS = {
                'TITRES':      { champ: 'cour_titre',        label: '💡 Titres accrocheurs TDAH' },
                'DESCRIPTIONS':{ champ: 'cour_description',  label: '📝 Descriptions engageantes' },
                'OBJECTIFS':   { champ: null,                label: '🎯 Objectifs pédagogiques' },
                'PLAN':        { champ: null,                label: '📚 Plan de séance' },
                'ACTIVITES':   { champ: null,                label: '🎮 Activités fun' },
            };

            // Découper le texte sur les marqueurs ###NOM###
            // Tout texte avant le premier marqueur est ignoré (intro du LLM)
            const regex = /###([A-ZÉÈÀÂÊÎÔÛÙÇ_]+)###/g;
            const positions = [];
            let match;
            while ((match = regex.exec(texte)) !== null) {
                positions.push({ nom: match[1], debut: match.index, fin: match.index + match[0].length });
            }

            let html = '';

            positions.forEach((pos, i) => {
                const cfg = SECTIONS[pos.nom];
                if (!cfg) return; // marqueur inconnu → ignorer

                // Contenu entre ce marqueur et le suivant (ou fin du texte)
                const contenuBrut = texte.slice(pos.fin, i + 1 < positions.length ? positions[i + 1].debut : undefined);

                // Extraire les items de liste (lignes commençant par -, *, •, +)
                const items = contenuBrut
                    .split('\n')
                    .map(l => l.replace(/^[\*\-•+]\s*/, '').trim())
                    .filter(l => l.length > 0);

                html += `<div class="ia-section">
                    <div class="ia-section-title">${cfg.label}</div>`;

                if (items.length > 0) {
                    items.forEach(item => {
                        const btnUse = cfg.champ
                            ? `<button class="ia-card-use" data-champ="${cfg.champ}" data-valeur="${item.replace(/"/g,'&quot;')}">Utiliser</button>`
                            : '';
                        html += `<div class="ia-card">${item}${btnUse}</div>`;
                    });
                } else {
                    html += `<div class="ia-card">${mdToHtml(contenuBrut.trim())}</div>`;
                }

                html += `</div>`;
            });

            // Fallback si aucun marqueur trouvé (LLM n'a pas suivi le format)
            if (!html) {
                html = `<div class="ia-card">${mdToHtml(texte)}</div>`;
            }

            body.innerHTML = html;

            // Boutons "Utiliser" → remplir le champ correspondant
            body.querySelectorAll('.ia-card-use').forEach(b => {
                b.addEventListener('click', e => {
                    e.stopPropagation();
                    const champ = b.dataset.champ;
                    const valeur = b.dataset.valeur;
                    const field = document.getElementById(champ);
                    if (field) {
                        field.value = valeur;
                        field.dispatchEvent(new Event('input'));
                        overlay.classList.remove('open');

                        // Flash visuel sur le champ rempli
                        field.style.transition = 'box-shadow .3s';
                        field.style.boxShadow = '0 0 0 3px rgba(102,126,234,.5)';
                        setTimeout(() => field.style.boxShadow = '', 1500);
                    }
                });
            });

            // Clic sur la card elle-même (sans bouton) → copier dans presse-papier
            body.querySelectorAll('.ia-card').forEach(card => {
                card.addEventListener('click', () => {
                    const texte = card.textContent.replace('Utiliser', '').trim();
                    navigator.clipboard?.writeText(texte);
                });
            });
        }
    })();

    // ══════════════════════════════════════════════════════════════
    // STATUT BADGE + COMPTEUR DESCRIPTION
    // ══════════════════════════════════════════════════════════════
    (function () {
        const statutField    = document.getElementById('cour_statut');
        const statutBadge    = document.getElementById('statutBadge');
        const descriptionField = document.getElementById('cour_description');
        const charCount      = document.getElementById('charCount');

        function updateBadge() {
            if (!statutField || !statutBadge) return;
            const value = (statutField.value || '').toLowerCase();
            statutBadge.className = 'badge-type';
            if (value.includes('publi'))  statutBadge.classList.add('badge-publie');
            else if (value === 'archive') statutBadge.classList.add('badge-archive');
            else                          statutBadge.classList.add('badge-brouillon');
            statutBadge.textContent = (statutField.options[statutField.selectedIndex]?.text || 'BROUILLON').toUpperCase();
        }

        function updateCounter() {
            if (!descriptionField || !charCount) return;
            charCount.textContent = `${descriptionField.value.length}/500 caractères`;
        }

        if (statutField)       { statutField.addEventListener('change', updateBadge); updateBadge(); }
        if (descriptionField)  { descriptionField.addEventListener('input', updateCounter); updateCounter(); }
    })();

    // ══════════════════════════════════════════════════════════════
    // CHATBOT FLOTTANT
    // ══════════════════════════════════════════════════════════════
    (function () {
        const toggle    = document.getElementById('chatbot-toggle');
        const win       = document.getElementById('chatbot-window');
        const closeBtn  = document.getElementById('chatbot-close');
        const messages  = document.getElementById('cb-messages');
        const input     = document.getElementById('cb-input');
        const sendBtn   = document.getElementById('cb-send');
        const notif     = document.getElementById('chatbot-notif');
        const quickBtns = document.querySelectorAll('.cb-quick button');
        let isOpen = false;

        toggle.addEventListener('click', () => {
            isOpen = !isOpen;
            win.classList.toggle('open', isOpen);
            toggle.innerHTML = isOpen ? '✕' : '🤖';
            if (notif) notif.remove();
            if (isOpen) setTimeout(() => input.focus(), 300);
        });
        closeBtn.addEventListener('click', () => {
            isOpen = false;
            win.classList.remove('open');
            toggle.innerHTML = '🤖';
        });

        function addMessage(text, role) {
            const wrap   = document.createElement('div');
            wrap.className = `cb-msg ${role}`;
            const icon   = document.createElement('div');
            icon.className = 'cb-msg-icon';
            icon.textContent = role === 'bot' ? '🎓' : '👤';
            const bubble = document.createElement('div');
            bubble.className = 'cb-bubble';
            bubble.innerHTML = text
                .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                .replace(/\*\*(.*?)\*\*/g,'<strong>$1</strong>')
                .replace(/^[-•]\s+(.+)$/gm,'<li>$1</li>')
                .replace(/(<li>[\s\S]*?<\/li>)/g,'<ul>$1</ul>')
                .replace(/\n/g,'<br>');
            wrap.appendChild(icon);
            wrap.appendChild(bubble);
            messages.appendChild(wrap);
            messages.scrollTop = messages.scrollHeight;
        }

        function addTyping() {
            const wrap = document.createElement('div');
            wrap.className = 'cb-msg bot';
            wrap.id = 'cb-typing-indicator';
            const icon = document.createElement('div');
            icon.className = 'cb-msg-icon'; icon.textContent = '🎓';
            const typing = document.createElement('div');
            typing.className = 'cb-typing';
            typing.innerHTML = '<span></span><span></span><span></span>';
            wrap.appendChild(icon); wrap.appendChild(typing);
            messages.appendChild(wrap);
            messages.scrollTop = messages.scrollHeight;
        }

        function removeTyping() { document.getElementById('cb-typing-indicator')?.remove(); }

        async function send(text) {
            const msg = (text || input.value).trim();
            if (!msg) return;
            input.value = '';
            sendBtn.disabled = true;
            addMessage(msg, 'user');
            addTyping();
            try {
                const res  = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: msg, context: getFormContext() }),
                });
                const data = await res.json();
                removeTyping();
                addMessage(data.error ? '❌ ' + data.error : data.reply, 'bot');
            } catch (e) {
                removeTyping();
                addMessage('❌ Impossible de contacter l\'assistant.', 'bot');
            } finally {
                sendBtn.disabled = false;
                input.focus();
            }
        }

        sendBtn.addEventListener('click', () => send());
        input.addEventListener('keydown', e => { if (e.key === 'Enter') send(); });
        quickBtns.forEach(btn => btn.addEventListener('click', () => send(btn.dataset.q)));
    })();
    </script>
{% endblock %}
