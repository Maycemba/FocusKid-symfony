{% extends 'base-back.html.twig' %}

{% block title %}Cour{% endblock %}

{% block body %}
    <h1>Cour</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id_cours</th>
                <td>{{ cour.idCours }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ cour.titre }}</td>
            </tr>
            <tr>
                <th>Niveau</th>
                <td>{{ cour.niveau }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ cour.description }}</td>
            </tr>
            <tr>
                <th>Formateur</th>
                <td>{{ cour.formateur }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ cour.statut }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_cour_index') }}">back to list</a>

    <a href="{{ path('app_cour_edit', {'id_cours': cour.id_cours}) }}">edit</a>

    {{ include('cour/_delete_form.html.twig') }}
{% endblock %}