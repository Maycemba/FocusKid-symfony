<form class="education-delete-form" method="post" action="{{ path('app_cour_delete', {'id_cours': cour.id_cours}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cour.id_cours) }}">
    <button class="education-btn-danger" type="submit">Supprimer le cours</button>
</form>
