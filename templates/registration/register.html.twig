{% extends 'base-front.html.twig' %}

{% block title %}Inscription - FocusKid | Rejoins l'aventure{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    :root {
        --orange: #FF6B35;
        --blue: #4A90E2;
        --purple: #9B59B6;
        --green: #27AE60;
    }

    /* Hero Section identique à l'index */
    .register-hero {
        min-height: 100vh;
        background: linear-gradient(135deg, rgba(255,107,53,0.95), rgba(74,144,226,0.95)), url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="3" fill="white" opacity="0.3"/><circle cx="80" cy="40" r="2" fill="white" opacity="0.2"/><circle cx="50" cy="80" r="4" fill="white" opacity="0.25"/></svg>');
        background-size: cover;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
        padding: 80px 0;
    }

    .floating-elements {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        pointer-events: none;
    }

    .float-1, .float-2, .float-3 {
        position: absolute;
        animation: float 6s ease-in-out infinite;
    }

    .float-1 { top: 10%; left: 5%; font-size: 40px; animation-delay: 0s; }
    .float-2 { bottom: 15%; right: 8%; font-size: 50px; animation-delay: 2s; }
    .float-3 { top: 30%; right: 15%; font-size: 35px; animation-delay: 4s; }

    @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
    }

    /* Card moderne identique à l'index */
    .register-card {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(10px);
        border-radius: 28px;
        padding: 40px 32px;
        box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
        border: 1px solid rgba(255,255,255,0.3);
        transition: transform 0.3s ease;
        animation: fadeInUp 0.6s ease-out;
    }

    .register-card:hover {
        transform: translateY(-5px);
    }

    .register-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .register-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        transition: transform 0.3s ease;
    }

    .register-card:hover .register-icon {
        transform: scale(1.1) rotate(5deg);
    }

    .register-icon i {
        font-size: 35px;
        color: white;
    }

    /* Input modern style identique à l'index */
    .input-modern {
        position: relative;
        margin-bottom: 20px;
    }

    .input-modern i {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--orange);
        font-size: 18px;
        z-index: 10;
    }

    .input-modern input,
    .input-modern select {
        width: 100%;
        padding: 12px 16px 12px 48px;
        border: 2px solid #e5e7eb;
        border-radius: 16px;
        font-size: 15px;
        transition: all 0.3s;
        outline: none;
        background: white;
    }

    .input-modern input:focus,
    .input-modern select:focus {
        border-color: var(--orange);
        box-shadow: 0 0 0 3px rgba(255,107,53,0.1);
    }

    .input-modern input.is-invalid {
        border-color: #dc3545;
    }

    /* Bouton identique à l'index */
    .btn-register {
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        border: none;
        padding: 14px;
        border-radius: 16px;
        font-weight: bold;
        font-size: 16px;
        transition: all 0.3s;
        width: 100%;
        color: white;
    }

    .btn-register:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(255,107,53,0.3);
    }

    /* Password strength */
    .password-strength {
        margin-top: 8px;
        height: 4px;
        border-radius: 2px;
        transition: all 0.3s;
    }

    .strength-weak { width: 33%; background: #dc3545; }
    .strength-medium { width: 66%; background: #ffc107; }
    .strength-strong { width: 100%; background: #28a745; }

    /* Animations */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fadeInUp {
        animation: fadeInUp 0.8s ease-out;
    }

    .alert-custom {
        border-radius: 16px;
        border: none;
        padding: 12px 20px;
    }

    .form-check-input:checked {
        background-color: var(--orange);
        border-color: var(--orange);
    }

    .form-check-label {
        margin-left: 8px;
        color: #6c757d;
    }

    /* Role choice group stylé */
    .role-choice-group {
        background: #f8f9fa;
        border-radius: 16px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .role-choice-group .form-check {
        margin-bottom: 10px;
        padding-left: 30px;
    }

    .role-choice-group .form-check:last-child {
        margin-bottom: 0;
    }

    .role-choice-group .form-check-input {
        margin-left: -25px;
        margin-top: 8px;
    }

    .role-choice-group .form-check-label {
        margin-left: 0;
        font-size: 16px;
        font-weight: 500;
        color: #333;
    }

    .role-choice-group .form-check-label small {
        display: block;
        font-size: 12px;
        color: #6c757d;
        font-weight: normal;
    }

    /* Row pour champ date */
    .row-custom {
        display: flex;
        gap: 15px;
        margin-bottom: 0;
    }

    .row-custom .input-modern {
        flex: 1;
    }
</style>
{% endblock %}

{% block body %}
<div class="register-hero">
    <div class="floating-elements">
        <div class="float-1">🌟</div>
        <div class="float-2">🎨</div>
        <div class="float-3">📚</div>
    </div>
    
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <div class="col-lg-6">
                <div class="register-card animate-fadeInUp">
                    <div class="register-header">
                        <div class="register-icon">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <h2 class="h3 fw-bold mb-2">Rejoins l'aventure FocusKid 🚀</h2>
                        <p class="text-muted">Crée ton compte gratuitement et commence à apprendre en t'amusant</p>
                    </div>

                    {% for flash_error in app.flashes('error') %}
                        <div class="alert alert-danger alert-custom mb-4">
                            <i class="fas fa-exclamation-circle me-2"></i> {{ flash_error }}
                        </div>
                    {% endfor %}

                    {% for flash_success in app.flashes('success') %}
                        <div class="alert alert-success alert-custom mb-4">
                            <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
                        </div>
                    {% endfor %}

                    {% if registrationForm.vars.errors|length > 0 %}
                        <div class="alert alert-danger alert-custom mb-4">
                            <strong>Erreurs du formulaire :</strong>
                            <ul class="mb-0 mt-2">
                                {% for error in registrationForm.vars.errors %}
                                    <li>{{ error.message }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate', 'method': 'POST'}}) }}
                    
                    <div class="input-modern">
                        <i class="fas fa-user-astronaut"></i>
                        {{ form_widget(registrationForm.username, {'attr': {'placeholder': 'Choisis ton pseudo *'}}) }}
                        {% if registrationForm.username.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {% for error in registrationForm.username.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div class="input-modern">
                        <i class="fas fa-envelope"></i>
                        {{ form_widget(registrationForm.email, {'attr': {'placeholder': 'Ton adresse email *'}}) }}
                        {% if registrationForm.email.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {% for error in registrationForm.email.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div class="row-custom">
                        <div class="input-modern">
                            <i class="fas fa-user"></i>
                            {{ form_widget(registrationForm.firstname, {'attr': {'placeholder': 'Prénom'}})}}
                        </div>
                        <div class="input-modern">
                            <i class="fas fa-user"></i>
                            {{ form_widget(registrationForm.lastname, {'attr': {'placeholder': 'Nom'}})}}
                        </div>
                    </div>

                    <!-- Champ Téléphone -->
                    <div class="input-modern">
                        <i class="fas fa-phone"></i>
                        {{ form_widget(registrationForm.phone, {'attr': {'placeholder': 'Téléphone (optionnel)'}})}}
                        {% if registrationForm.phone.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {% for error in registrationForm.phone.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Champ Date de naissance -->
                    <div class="input-modern">
                        <i class="fas fa-calendar-alt"></i>
                        {{ form_widget(registrationForm.birthdate, {'attr': {'placeholder': 'Date de naissance'}})}}
                        {% if registrationForm.birthdate.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {% for error in registrationForm.birthdate.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Choix du rôle -->
                    <div class="role-choice-group mb-4">
                        <label class="fw-bold mb-3 d-block">
                            <i class="fas fa-users me-2"></i> Quel type de compte souhaitez-vous créer ?
                        </label>
                        {{ form_widget(registrationForm.role) }}
                        {% if registrationForm.role.vars.errors|length > 0 %}
                            <div class="text-danger small mt-2">
                                {% for error in registrationForm.role.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                        <small class="text-muted d-block mt-2">
                            <i class="fas fa-info-circle me-1"></i> 
                            Les parents peuvent suivre les progrès de leurs enfants et créer plusieurs comptes enfants.
                        </small>
                    </div>

                    <!-- Mot de passe -->
                    <div class="input-modern">
                        <i class="fas fa-key"></i>
                        {{ form_widget(registrationForm.plainPassword.first, {'attr': {'placeholder': 'Mot de passe *', 'id': 'password'}})}}
                        {% if registrationForm.plainPassword.first.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {% for error in registrationForm.plainPassword.first.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Indicateur de force du mot de passe -->
                    <div class="password-strength mb-3" id="password-strength"></div>

                    <!-- Confirmation mot de passe -->
                    <div class="input-modern">
                        <i class="fas fa-check-circle"></i>
                        {{ form_widget(registrationForm.plainPassword.second, {'attr': {'placeholder': 'Confirme ton mot de passe *'}})}}
                        {% if registrationForm.plainPassword.second.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {% for error in registrationForm.plainPassword.second.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Conditions -->
                    <div class="mb-4 form-check">
                        {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}})}}
                        {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'form-check-label'}})}}
                        {% if registrationForm.agreeTerms.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {% for error in registrationForm.agreeTerms.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <button type="submit" class="btn-register">
                        <i class="fas fa-rocket me-2"></i> Créer mon compte gratuitement
                    </button>

                    {{ form_end(registrationForm) }}

                    <hr class="my-4">

                    <p class="text-center mb-0">
                        <small>Déjà un compte ? 
                            <a href="{{ path('app_login') }}" class="fw-bold text-decoration-none" style="color: var(--orange);">
                                Connecte-toi ici
                            </a>
                        </small>
                    </p>
                </div>
            </div>

            <!-- Colonne des avantages identique à l'index -->
            <div class="col-lg-5 offset-lg-1 d-none d-lg-block">
                <div class="text-white animate-fadeInUp" style="animation-delay: 0.2s;">
                    <h2 class="display-5 fw-bold mb-4">Pourquoi créer un compte ?</h2>
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="bg-white bg-opacity-20 rounded-circle p-2" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-trophy fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Suis tes progrès</h5>
                                <p class="mb-0 opacity-75">Gagne des badges et deviens expert</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="bg-white bg-opacity-20 rounded-circle p-2" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-chart-line fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Tableau de bord parent</h5>
                                <p class="mb-0 opacity-75">Visualise les résultats en temps réel</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="bg-white bg-opacity-20 rounded-circle p-2" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-infinity fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Accès illimité</h5>
                                <p class="mb-0 opacity-75">À tous les exercices et jeux éducatifs</p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 pt-3">
                        <div class="d-flex gap-2 mb-2">
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                        </div>
                        <p class="fst-italic fs-5">"Super application ! Mon fils a déjà appris énormément en quelques semaines."</p>
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-user-circle fa-2x"></i>
                            <div>
                                <strong>Thomas Dubois</strong><br>
                                <small>Papa de Maxime, 7 ans</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// Détection automatique de la force du mot de passe
const passwordInput = document.getElementById('password');
const strengthDiv = document.getElementById('password-strength');

if(passwordInput && strengthDiv) {
    passwordInput.addEventListener('input', function() {
        const password = this.value;
        let strength = 0;
        
        if(password.length >= 4) strength++;
        if(password.length >= 8) strength++;
        if(/[a-z]/.test(password)) strength++;
        if(/[A-Z]/.test(password)) strength++;
        if(/[0-9]/.test(password)) strength++;
        if(/[$@#&!]/.test(password)) strength++;
        
        strengthDiv.className = 'password-strength mb-3';
        if(password.length === 0) {
            strengthDiv.style.display = 'none';
        } else {
            strengthDiv.style.display = 'block';
            if(strength <= 2) {
                strengthDiv.classList.add('strength-weak');
            } else if(strength <= 4) {
                strengthDiv.classList.add('strength-medium');
            } else {
                strengthDiv.classList.add('strength-strong');
            }
        }
    });
}
</script>
{% endblock %}