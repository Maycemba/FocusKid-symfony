{% extends 'base-front.html.twig' %}

{% block title %}Inscription - FocusKid | Rejoins l'aventure{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* Styles pour les choix de rôle */
.role-choice-group {
    background: #f8f9fa;
    border-radius: 16px;
    padding: 15px;
    margin-bottom: 20px;
}

.role-choice-group .form-check {
    margin-bottom: 10px;
    padding-left: 30px;
}

.role-choice-group .form-check:last-child {
    margin-bottom: 0;
}

.role-choice-group .form-check-input {
    margin-left: -25px;
    margin-top: 8px;
}

.role-choice-group .form-check-label {
    margin-left: 0;
    font-size: 16px;
    font-weight: 500;
    color: #333;
}

.role-choice-group .form-check-label small {
    display: block;
    font-size: 12px;
    color: #6c757d;
    font-weight: normal;
}
    .register-hero {
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        padding: 80px 0;
    }

    .register-card {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 28px;
        padding: 40px;
        box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
        border: 1px solid rgba(255,255,255,0.3);
        animation: fadeInUp 0.6s ease-out;
    }

    .register-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .register-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .register-icon i {
        font-size: 35px;
        color: white;
    }

    .input-group-modern {
        position: relative;
        margin-bottom: 20px;
    }

    .input-group-modern i {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--orange);
        font-size: 18px;
        z-index: 10;
    }

    .input-group-modern input,
    .input-group-modern select {
        width: 100%;
        padding: 12px 16px 12px 48px;
        border: 2px solid #e5e7eb;
        border-radius: 16px;
        font-size: 15px;
        transition: all 0.3s;
        outline: none;
    }

    .input-group-modern input:focus,
    .input-group-modern select:focus {
        border-color: var(--orange);
        box-shadow: 0 0 0 3px rgba(255,107,53,0.1);
    }

    .input-group-modern input.is-invalid {
        border-color: #dc3545;
    }

    .btn-register {
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        border: none;
        padding: 14px;
        border-radius: 16px;
        font-weight: bold;
        font-size: 16px;
        transition: all 0.3s;
        width: 100%;
        color: white;
    }

    .btn-register:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(255,107,53,0.3);
    }

    .password-strength {
        margin-top: 8px;
        height: 4px;
        border-radius: 2px;
        transition: all 0.3s;
    }

    .strength-weak { width: 33%; background: #dc3545; }
    .strength-medium { width: 66%; background: #ffc107; }
    .strength-strong { width: 100%; background: #28a745; }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .alert-custom {
        border-radius: 16px;
        border: none;
        padding: 12px 20px;
    }

    .form-check-input:checked {
        background-color: var(--orange);
        border-color: var(--orange);
    }

    .form-check-label {
        margin-left: 8px;
        color: #6c757d;
    }
</style>
{% endblock %}

{% block body %}
<div class="register-hero">
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <div class="col-lg-6">
                <div class="register-card">
                    <div class="register-header">
                        <div class="register-icon">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <h2 class="h3 fw-bold mb-2">Rejoins l'aventure FocusKid 🚀</h2>
                        <p class="text-muted">Crée ton compte et commence à apprendre en t'amusant</p>
                    </div>

                    {% for flash_error in app.flashes('error') %}
                        <div class="alert alert-danger alert-custom mb-4">
                            <i class="fas fa-exclamation-circle me-2"></i> {{ flash_error }}
                        </div>
                    {% endfor %}

                    {% for flash_success in app.flashes('success') %}
                        <div class="alert alert-success alert-custom mb-4">
                            <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
                        </div>
                    {% endfor %}

                    {% if registrationForm.vars.errors|length > 0 %}
                        <div class="alert alert-danger alert-custom mb-4">
                            <strong>Erreurs du formulaire :</strong>
                            <ul class="mb-0 mt-2">
                                {% for error in registrationForm.vars.errors %}
                                    <li>{{ error.message }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate', 'method': 'POST'}}) }}
                    
                    <div class="input-group-modern">
                        <i class="fas fa-user-astronaut"></i>
                        {{ form_widget(registrationForm.username, {'attr': {'placeholder': 'Choisis ton pseudo *'}}) }}
                        {% if registrationForm.username.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {% for error in registrationForm.username.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div class="input-group-modern">
                        <i class="fas fa-envelope"></i>
                        {{ form_widget(registrationForm.email, {'attr': {'placeholder': 'Ton adresse email *'}}) }}
                        {% if registrationForm.email.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {% for error in registrationForm.email.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="input-group-modern">
                                <i class="fas fa-user"></i>
                                {{ form_widget(registrationForm.firstname, {'attr': {'placeholder': 'Prénom'}})}}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="input-group-modern">
                                <i class="fas fa-user"></i>
                                {{ form_widget(registrationForm.lastname, {'attr': {'placeholder': 'Nom'}})}}
                            </div>
                        </div>
                    </div>

                    <!-- Champ Téléphone -->
                    <div class="input-group-modern">
                        <i class="fas fa-phone"></i>
                        {{ form_widget(registrationForm.phone, {'attr': {'placeholder': 'Téléphone (optionnel)'}})}}
                        {% if registrationForm.phone.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {% for error in registrationForm.phone.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Champ Date de naissance -->
                    <div class="input-group-modern">
                        <i class="fas fa-calendar-alt"></i>
                        {{ form_widget(registrationForm.birthdate, {'attr': {'placeholder': 'Date de naissance'}})}}
                        {% if registrationForm.birthdate.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {% for error in registrationForm.birthdate.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                    <!-- ⭐ NOUVEAU : Choix du rôle -->
<div class="role-choice-group mb-4">
    <label class="fw-bold mb-3 d-block">
        <i class="fas fa-users me-2"></i> Quel type de compte souhaitez-vous créer ?
    </label>
    {{ form_widget(registrationForm.role) }}
    {% if registrationForm.role.vars.errors|length > 0 %}
        <div class="text-danger small mt-2">
            {% for error in registrationForm.role.vars.errors %}
                {{ error.message }}
            {% endfor %}
        </div>
    {% endif %}
    <small class="text-muted d-block mt-2">
        <i class="fas fa-info-circle me-1"></i> 
        Les parents peuvent suivre les progrès de leurs enfants et créer plusieurs comptes enfants.
    </small>
</div>

                    <!-- Mot de passe - UNE SEULE FOIS -->
                    <div class="input-group-modern">
                        <i class="fas fa-key"></i>
                        {{ form_widget(registrationForm.plainPassword.first, {'attr': {'placeholder': 'Mot de passe *', 'id': 'password'}})}}
                        {% if registrationForm.plainPassword.first.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {% for error in registrationForm.plainPassword.first.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Indicateur de force du mot de passe -->
                    <div class="password-strength mb-3" id="password-strength"></div>

                    <!-- Confirmation mot de passe -->
                    <div class="input-group-modern">
                        <i class="fas fa-check-circle"></i>
                        {{ form_widget(registrationForm.plainPassword.second, {'attr': {'placeholder': 'Confirme ton mot de passe *'}})}}
                        {% if registrationForm.plainPassword.second.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {% for error in registrationForm.plainPassword.second.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Conditions -->
                    <div class="mb-4 form-check">
                        {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}})}}
                        {{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'form-check-label'}})}}
                        {% if registrationForm.agreeTerms.vars.errors|length > 0 %}
                            <div class="text-danger small mt-1">
                                {% for error in registrationForm.agreeTerms.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
