                        {% endif %}
                    </div>

                    <button type="submit" class="btn-register">
                        <i class="fas fa-rocket me-2"></i> Créer mon compte
                    </button>

                    {{ form_end(registrationForm) }}

                    <hr class="my-4">

                    <p class="text-center mb-0">
                        <small>Déjà un compte ? 
                            <a href="{{ path('app_login') }}" class="fw-bold text-decoration-none" style="color: var(--orange);">
                                Connecte-toi ici
                            </a>
                        </small>
                    </p>
                </div>
            </div>

            <!-- Colonne des avantages -->
            <div class="col-lg-5 offset-lg-1 d-none d-lg-block">
                <div class="text-white">
                    <h2 class="display-5 fw-bold mb-4">Pourquoi créer un compte ?</h2>
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="bg-white bg-opacity-20 rounded-circle p-2" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-trophy fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Suis tes progrès</h5>
                                <p class="mb-0 opacity-75">Gagne des badges et deviens expert</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="bg-white bg-opacity-20 rounded-circle p-2" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-chart-line fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Tableau de bord parent</h5>
                                <p class="mb-0 opacity-75">Visualise les résultats en temps réel</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="bg-white bg-opacity-20 rounded-circle p-2" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-infinity fa-2x"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Accès illimité</h5>
                                <p class="mb-0 opacity-75">À tous les exercices et jeux éducatifs</p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 pt-3">
                        <div class="d-flex gap-2 mb-2">
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                        </div>
                        <p class="fst-italic fs-5">"Super application ! Mon fils a déjà appris énormément en quelques semaines."</p>
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-user-circle fa-2x"></i>
                            <div>
                                <strong>Thomas Dubois</strong><br>
                                <small>Papa de Maxime, 7 ans</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// Détection automatique de la force du mot de passe
const passwordInput = document.getElementById('password');
const strengthDiv = document.getElementById('password-strength');

if(passwordInput && strengthDiv) {
    passwordInput.addEventListener('input', function() {
        const password = this.value;
        let strength = 0;
        
        if(password.length >= 4) strength++;
        if(password.length >= 8) strength++;
        if(/[a-z]/.test(password)) strength++;
        if(/[A-Z]/.test(password)) strength++;
        if(/[0-9]/.test(password)) strength++;
        if(/[$@#&!]/.test(password)) strength++;
        
        strengthDiv.className = 'password-strength mb-3';
        if(password.length === 0) {
            strengthDiv.style.display = 'none';
        } else {
            strengthDiv.style.display = 'block';
            if(strength <= 2) {
                strengthDiv.classList.add('strength-weak');
            } else if(strength <= 4) {
                strengthDiv.classList.add('strength-medium');
            } else {
                strengthDiv.classList.add('strength-strong');
            }
        }
    });
}
</script>
{% endblock %}