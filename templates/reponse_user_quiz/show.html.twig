            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_reponse_user_quiz_index') }}">back to list</a>

    <a href="{{ path('app_reponse_user_quiz_edit', {'id_rep_user': reponse_user_quiz.id_rep_user}) }}">edit</a>

    {{ include('reponse_user_quiz/_delete_form.html.twig') }}
