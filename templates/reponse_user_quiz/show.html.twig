{% extends 'base.html.twig' %}

{% block title %}ReponseUserQuiz{% endblock %}

{% block body %}
    <h1>ReponseUserQuiz</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id_rep_user</th>
                <td>{{ reponse_user_quiz.idRepUser }}</td>
            </tr>
            <tr>
                <th>Est_correcte</th>
                <td>{{ reponse_user_quiz.estCorrecte ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Temps_reponse</th>
                <td>{{ reponse_user_quiz.tempsReponse }}</td>
            </tr>
            <tr>
                <th>Date_reponse</th>
