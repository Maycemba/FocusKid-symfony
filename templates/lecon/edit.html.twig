{% extends 'base-back.html.twig' %}

{% block title %}Modifier lecon - FocusKids{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="card-title text-white mb-0">
                            <i class="ti ti-edit"></i> Modifier la lecon
                        </h4>
                        <small class="text-white-50">Mettez a jour les informations principales de la lecon</small>
                    </div>
                    <a href="{{ path('app_lecon_index') }}" class="btn btn-light">
                        <i class="ti ti-arrow-left"></i> Retour a la liste
                    </a>
                </div>
            </div>

            <div class="card-body">
                {{ include('lecon/_form.html.twig', {'button_label': 'Mettre a jour la lecon'}) }}

                <div class="row mt-4">
                    <div class="col-12 text-center">
                        {{ include('lecon/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
