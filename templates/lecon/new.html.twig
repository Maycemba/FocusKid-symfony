{% extends 'base-back.html.twig' %}

{% block title %}Nouvelle lecon - FocusKids{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="card-title text-white mb-0">
                            <i class="ti ti-book"></i> Creer une nouvelle lecon
                        </h4>
                        <small class="text-white-50">Ajoutez les informations principales de la lecon</small>
                    </div>
                    <a href="{{ path('app_lecon_index') }}" class="btn btn-light">
                        <i class="ti ti-arrow-left"></i> Retour a la liste
                    </a>
                </div>
            </div>

            <div class="card-body">
                {% if cour %}
                    <div class="alert alert-info mb-4">
                        Cette lecon sera ajoutee au cours : <strong>{{ cour.titre }}</strong>
                    </div>
                {% endif %}

                {{ include('lecon/_form.html.twig', {'button_label': 'Creer la lecon'}) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
