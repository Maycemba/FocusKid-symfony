{{ form_start(form) }}
    <div class="education-form-grid">
        <div class="education-form-row">
            {{ form_label(form.titre_lecon) }}
            {{ form_widget(form.titre_lecon) }}
            {{ form_errors(form.titre_lecon) }}
        </div>

        <div class="education-form-row">
            {{ form_label(form.contenu) }}
            {{ form_widget(form.contenu) }}
            {{ form_errors(form.contenu) }}
        </div>

        <div class="education-form-row">
            {{ form_label(form.cour) }}
            {{ form_widget(form.cour) }}
            {{ form_errors(form.cour) }}
        </div>
    </div>

    {{ form_rest(form) }}

    <div class="education-form-actions">
        <button class="education-btn-primary" type="submit">{{ button_label|default('Enregistrer la lecon') }}</button>
    </div>
{{ form_end(form) }}
