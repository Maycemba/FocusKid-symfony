{{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_label(form.titre_lecon, 'Titre de la lecon', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.titre_lecon, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Les voyelles'}}) }}
            {{ form_errors(form.titre_lecon) }}
        </div>

        <div class="col-md-6 mb-3">
            {{ form_label(form.cour, 'Cours', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.cour, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.cour) }}
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 mb-3">
            {{ form_label(form.contenu, 'Contenu', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
            {{ form_widget(form.contenu, {'attr': {'class': 'form-control', 'rows': 6, 'placeholder': 'Saisissez le contenu de la lecon...'}}) }}
            {{ form_errors(form.contenu) }}
        </div>
    </div>

    {{ form_rest(form) }}

    <div class="row mt-4">
        <div class="col-12 text-center">
            <button class="btn btn-primary px-5" type="submit">
                <i class="ti ti-device-floppy"></i> {{ button_label|default('Enregistrer la lecon') }}
            </button>
        </div>
    </div>
{{ form_end(form) }}
