<form method="post"
     action="{{ path('app_lecon_delete', {'id_lecon': lecon.idLecon}) }}"

      onsubmit="return confirm('Voulez-vous vraiment supprimer cette lecon ?');"
      class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ lecon.idLecon) }}">
    <button class="btn btn-danger px-5" type="submit">
        <i class="ti ti-trash"></i> Supprimer
    </button>
</form>
