{% extends 'base-back.html.twig' %}

{% block title %}Détail - Humeur journalière{% endblock %}

{% block body %}
<div class="container-fluid">

    <div class="card bg-light-info shadow-none position-relative overflow-hidden mb-4">
        <div class="card-body px-4 py-3">
            <h4 class="fw-semibold mb-8">Détail de l'humeur journalière</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_humeur_journaliere_index') }}">Humeurs</a></li>
                    <li class="breadcrumb-item active">Détail #{{ humeur_journaliere.id }}</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th style="width:200px;">#</th>
                        <td>{{ humeur_journaliere.id }}</td>
                    </tr>
                    <tr>
                        <th>Émotion</th>
                        <td>
                            {% if humeur_journaliere.emotion %}
                                {{ humeur_journaliere.emotion.nom }}
                            {% else %}
                                <span class="text-muted fst-italic">Non définie</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Date et heure</th>
                        <td>
                            {% if humeur_journaliere.dateHeure %}
                                {{ humeur_journaliere.dateHeure|date('d/m/Y à H:i') }}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="mt-3">
                <a href="{{ path('app_humeur_journaliere_index') }}" class="btn btn-secondary">← Retour</a>
            </div>
        </div>
    </div>

</div>
{% endblock %}
