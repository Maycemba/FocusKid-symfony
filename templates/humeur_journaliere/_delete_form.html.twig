<form method="post" action="{{ path('app_humeur_journaliere_delete', {'id': humeur_journaliere.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cet enregistrement ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ humeur_journaliere.id) }}">
    <button type="submit" class="btn btn-danger">
        <i class="ti ti-trash"></i> Supprimer
    </button>
</form>