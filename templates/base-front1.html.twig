    <script>
        $(document).ready(function() {
            console.log('✅ Navigation AJAX initialisée');
            
            // Navbar scroll effect
            $(window).scroll(function() {
                if ($(this).scrollTop() > 50) {
                    $('.navbar').addClass('sticky');
                    $('.back-to-top').addClass('show');
                } else {
                    $('.navbar').removeClass('sticky');
                    $('.back-to-top').removeClass('show');
                }
            });
            
            $('.back-to-top').click(function(e) {
                e.preventDefault();
                $('html, body').animate({scrollTop: 0}, 500);
            });
            
            var contentDiv = $('#dynamic-content');
            var currentUrl = window.location.pathname;
            
            function loadContent(url) {
                if (!url) return;
                
                console.log('📥 Chargement:', url);
                
                $.ajax({
                    url: url,
                    type: 'GET',
                    dataType: 'html',
                    success: function(data) {
                        var newContent = $(data).find('#dynamic-content').html();
                        contentDiv.html(newContent || data);
                        
                        window.history.pushState({url: url}, '', url);
                        
                        var newTitle = $(data).filter('title').text();
                        if (newTitle) document.title = newTitle;
                        
                        $('.nav-link').removeClass('active');
                        $('.ajax-link[data-url="' + url + '"]').addClass('active');
                        
                        $('html, body').animate({scrollTop: 0}, 200);
                        
                        if (typeof WOW !== 'undefined') new WOW().init();
                        
                        console.log('✅ Contenu chargé');
                    },
                    error: function() {
                        window.location.href = url;
                    }
                });
            }
            
            $(document).on('click', '.ajax-link', function(e) {
                e.preventDefault();
                var url = $(this).data('url');
                if (url) loadContent(url);
            });
            
            $('#homeLink').on('click', function(e) {
                e.preventDefault();
                loadContent("{{ path('app_front_exercice_index') }}");
            });
            
            window.addEventListener('popstate', function(event) {
                if (event.state && event.state.url) loadContent(event.state.url);
            });
            
            $('.ajax-link').each(function() {
                if (currentUrl.includes($(this).data('url'))) {
                    $(this).addClass('active');
                }
            });
            
            console.log('✅ Liens AJAX:', $('.ajax-link').length);
        });
    </script>
    
