<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8">
    <title>{% block title %}FocusKid - Apprentissage ludique pour enfants{% endblock %}</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta name="description" content="Plateforme éducative pour enfants TDAH - Exercices, jeux et activités pédagogiques adaptés">
    <meta name="theme-color" content="#FF7043">

    <link href="{{ asset('base-front/img/logo.png') }}" rel="icon">

    <!-- Fonts : Baloo 2 (titres ludiques) + Nunito (texte enfant-friendly) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS Libs -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

    <link href="{{ asset('base-front/lib/animate/animate.min.css') }}" rel="stylesheet">
    <link href="{{ asset('base-front/lib/owlcarousel/assets/owl.carousel.min.css') }}" rel="stylesheet">
    <link href="{{ asset('base-front/css/style.css') }}" rel="stylesheet">

    <style>
        /* ====================================================
           FOCUSKID — BASE TEMPLATE TDAH-FRIENDLY
           Design : Playful & Calm — pensé pour les enfants
        ==================================================== */

        :root {
            /* Palette douce mais vivante */
            --orange:       #FF7043;
            --orange-light: #FFB74D;
            --blue:         #42A5F5;
            --blue-light:   #90CAF9;
            --green:        #66BB6A;
            --purple:       #AB47BC;
            --pink:         #F06292;
            --yellow:       #FFD54F;
            --teal:         #26C6DA;

            --bg:           #FFF8F0;
            --bg-card:      #FFFFFF;
            --text:         #3D2B1F;
            --text-soft:    #7B5E52;
            --border:       rgba(255,112,67,0.15);

            --gradient-main:   linear-gradient(135deg, var(--orange) 0%, var(--orange-light) 100%);
            --gradient-cool:   linear-gradient(135deg, var(--blue) 0%, var(--teal) 100%);
            --gradient-nature: linear-gradient(135deg, var(--green) 0%, var(--teal) 100%);
            --gradient-dream:  linear-gradient(135deg, var(--purple) 0%, var(--pink) 100%);

            --radius-xl:   28px;
            --radius-lg:   20px;
            --radius-md:   14px;
            --radius-pill: 50px;

            --shadow-soft:  0 8px 30px rgba(255,112,67,0.12);
            --shadow-card:  0 4px 20px rgba(0,0,0,0.06);
            --shadow-hover: 0 16px 48px rgba(255,112,67,0.22);

            --font-title: 'Baloo 2', cursive;
            --font-body:  'Nunito', sans-serif;

            --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
            --transition:  0.28s ease;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }

        body {
            font-family: var(--font-body);
            background: var(--bg);
            color: var(--text);
            font-size: 16px;
            line-height: 1.65;
            /* Fond doux, non distrayant */
            background-image:
                radial-gradient(circle at 15% 20%, rgba(255,112,67,0.06) 0%, transparent 50%),
                radial-gradient(circle at 85% 80%, rgba(66,165,245,0.06) 0%, transparent 50%),
                radial-gradient(circle at 50% 50%, rgba(102,187,106,0.04) 0%, transparent 60%);
            min-height: 100vh;
        }

        #page-wrapper { display: flex; flex-direction: column; min-height: 100vh; }

        /* Skip link accessibilité */
        .skip-link {
            position: absolute;
            top: -40px;
            left: 16px;
            background: var(--orange);
            color: white;
            padding: 8px 16px;
            border-radius: var(--radius-md);
            font-weight: 700;
            z-index: 9999;
            transition: top 0.2s;
            text-decoration: none;
        }
        .skip-link:focus { top: 12px; color: white; }

        /* ─────────────────────────────────────────
           BARRE DE FOCUS (progression session)
        ───────────────────────────────────────── */
        #focus-bar {
            height: 5px;
            background: linear-gradient(90deg, var(--orange), var(--orange-light), var(--green), var(--blue));
            background-size: 300% 100%;
            animation: focusBarMove 4s linear infinite;
            transform-origin: left;
            transform: scaleX(0);
            transition: transform 0.5s ease;
        }
        @keyframes focusBarMove {
            0%   { background-position: 0% 50%; }
            100% { background-position: 300% 50%; }
        }

        /* ─────────────────────────────────────────
           NAVBAR TDAH-FRIENDLY
           • Icônes emoji + labels courts
           • Couleurs différenciées par section
           • Hover animé, focus visible
        ───────────────────────────────────────── */
        .navbar {
            background: var(--bg-card) !important;
            box-shadow: 0 3px 20px rgba(0,0,0,0.07);
            padding: 0 !important;
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 3px solid var(--orange-light);
            transition: box-shadow var(--transition);
        }
        .navbar.scrolled {
            box-shadow: 0 8px 32px rgba(0,0,0,0.13);
        }

        .navbar-inner {
            display: flex;
            align-items: center;
            padding: 10px 24px;
            gap: 12px;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 20px;
            text-decoration: none;
            flex-shrink: 0;
        }
        .navbar-brand img {
            height: 80px;
            width: auto;
            filter: drop-shadow(0 2px 6px rgba(255,112,67,0.3));
        }
        .brand-name {
            font-family: var(--font-title);
            font-size: 35px;
            font-weight: 800;
            background: var(--gradient-main);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1;
        }

        .navbar-nav-wrap {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .nav-items {
            display: flex;
            align-items: center;
            gap: 6px;
            list-style: none;
            flex-wrap: wrap;
            justify-content: center;
        }

        .nav-item-custom a {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 3px;
            padding: 8px 14px;
            border-radius: var(--radius-md);
            text-decoration: none;
            color: var(--text-soft);
            font-family: var(--font-body);
            font-size: 20px;
            font-weight: 700;
            transition: all var(--transition);
            border: 2px solid transparent;
        }
        .nav-item-custom a .nav-icon {
            font-size: 20px;
            transition: transform var(--transition);
        }
        .nav-item-custom a:hover,
        .nav-item-custom a.active {
            background: rgba(255,112,67,0.08);
            color: var(--orange);
            border-color: rgba(255,112,67,0.25);
            transform: translateY(-2px);
        }
        .nav-item-custom a:hover .nav-icon,
        .nav-item-custom a.active .nav-icon {
            transform: scale(1.2) rotate(-6deg);
        }

        /* Couleurs distinctes par section */
        .nav-item-custom[data-color="blue"]   a:hover,
        .nav-item-custom[data-color="blue"]   a.active { color: var(--blue);   border-color: rgba(66,165,245,0.3);  background: rgba(66,165,245,0.08); }
        .nav-item-custom[data-color="green"]  a:hover,
        .nav-item-custom[data-color="green"]  a.active { color: var(--green);  border-color: rgba(102,187,106,0.3); background: rgba(102,187,106,0.08); }
        .nav-item-custom[data-color="purple"] a:hover,
        .nav-item-custom[data-color="purple"] a.active { color: var(--purple); border-color: rgba(171,71,188,0.3);  background: rgba(171,71,188,0.08); }
        .nav-item-custom[data-color="teal"]   a:hover,
        .nav-item-custom[data-color="teal"]   a.active { color: var(--teal);   border-color: rgba(38,198,218,0.3);  background: rgba(38,198,218,0.08); }
        .nav-item-custom[data-color="pink"]   a:hover,
        .nav-item-custom[data-color="pink"]   a.active { color: var(--pink);   border-color: rgba(240,98,146,0.3);  background: rgba(240,98,146,0.08); }
        .nav-item-custom[data-color="yellow"] a:hover,
        .nav-item-custom[data-color="yellow"] a.active { color: #E65100;       border-color: rgba(255,213,79,0.5);  background: rgba(255,213,79,0.1); }

        /* Bouton Compte */
        .btn-compte {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            border-radius: var(--radius-pill);
            background: var(--gradient-main);
            color: white !important;
            font-family: var(--font-body);
            font-weight: 700;
            font-size: 20px;
            text-decoration: none;
            box-shadow: var(--shadow-soft);
            transition: all var(--transition);
            flex-shrink: 0;
        }
        .btn-compte:hover {
            transform: translateY(-2px) scale(1.03);
            box-shadow: var(--shadow-hover);
            color: white !important;
        }

        /* Hamburger mobile */
        .navbar-toggle-btn {
            background: var(--bg);
            border: 2px solid var(--border);
            border-radius: var(--radius-md);
            width: 44px;
            height: 44px;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 5px;
            cursor: pointer;
            transition: all var(--transition);
            flex-shrink: 0;
        }
        .navbar-toggle-btn:hover { background: rgba(255,112,67,0.1); }
        .navbar-toggle-btn span {
            display: block;
            width: 22px;
            height: 2.5px;
            background: var(--orange);
            border-radius: 2px;
            transition: all 0.3s;
        }

        /* ─────────────────────────────────────────
           CONTENU DYNAMIQUE
        ───────────────────────────────────────── */
        #dynamic-content {
            flex: 1;
            min-height: 500px;
        }
        .page-fade-enter {
            animation: pageFadeIn 0.3s ease both;
        }
        @keyframes pageFadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ─────────────────────────────────────────
           COMPOSANTS GLOBAUX (cartes, boutons…)
        ───────────────────────────────────────── */

        /* Titres */
        h1, h2, h3, h4 { font-family: var(--font-title); }

        /* Cards génériques */
        .fk-card {
            background: var(--bg-card);
            border-radius: var(--radius-xl);
            padding: 24px;
            box-shadow: var(--shadow-card);
            border: 2px solid var(--border);
            transition: all var(--transition);
        }
        .fk-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
            border-color: rgba(255,112,67,0.3);
        }

        /* Stat cards */
        .stat-card {
            background: var(--bg-card);
            border-radius: var(--radius-xl);
            padding: 24px;
            text-align: center;
            box-shadow: var(--shadow-card);
            border: 2px solid var(--border);
            transition: all var(--transition);
            cursor: pointer;
        }
        .stat-card:hover {
            transform: translateY(-6px) scale(1.02);
            box-shadow: var(--shadow-hover);
        }
        .stat-number {
            font-family: var(--font-title);
            font-size: 40px;
            font-weight: 800;
            background: var(--gradient-main);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .stat-label {
            color: var(--text-soft);
            font-size: 14px;
            font-weight: 600;
            margin-top: 6px;
        }

        /* Badges types d'exercice */
        .badge-type {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 14px;
            border-radius: var(--radius-pill);
            font-size: 12px;
            font-weight: 700;
        }
        .badge-memoire   { background: linear-gradient(135deg, #CE93D8, #AB47BC); color: white; }
        .badge-attention { background: linear-gradient(135deg, #90CAF9, #42A5F5); color: white; }
        .badge-logique   { background: linear-gradient(135deg, #FFCC80, #FFA726); color: white; }
        .badge-chrono    { background: linear-gradient(135deg, #EF9A9A, #EF5350); color: white; }

        /* Cards exercice */
        .exercice-card {
            background: var(--bg-card);
            border-radius: var(--radius-xl);
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: var(--shadow-card);
            border: 2px solid var(--border);
            transition: all var(--transition);
            cursor: pointer;
            height: 100%;
            position: relative;
            overflow: hidden;
        }
        .exercice-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: var(--gradient-main);
            transform: scaleX(0);
            transition: transform var(--transition);
        }
        .exercice-card:hover::before { transform: scaleX(1); }
        .exercice-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-hover);
            border-color: rgba(255,112,67,0.25);
        }

        /* Étoiles */
        .etoiles { color: var(--yellow); font-size: 15px; }

        /* Empty state */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: var(--bg-card);
            border-radius: var(--radius-xl);
        }
        .empty-state .empty-icon {
            font-size: 64px;
            margin-bottom: 16px;
            display: block;
            animation: floatAnim 3s ease-in-out infinite;
        }
        @keyframes floatAnim {
            0%, 100% { transform: translateY(0); }
            50%       { transform: translateY(-12px); }
        }

        /* Filtres */
        .filter-section {
            background: var(--bg-card);
            border-radius: var(--radius-xl);
            padding: 20px 24px;
            margin-bottom: 24px;
            box-shadow: var(--shadow-card);
            border: 2px solid var(--border);
        }
        .btn-filter {
            background: var(--gradient-main);
            border: none;
            color: white;
            border-radius: var(--radius-pill);
            padding: 10px 24px;
            font-weight: 700;
            font-family: var(--font-body);
            transition: all var(--transition);
        }
        .btn-filter:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-soft);
            color: white;
        }

        /* Boutons globaux */
        .btn-fk {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 28px;
            border-radius: var(--radius-pill);
            font-family: var(--font-body);
            font-weight: 700;
            font-size: 15px;
            border: none;
            cursor: pointer;
            transition: all var(--transition);
            text-decoration: none;
        }
        .btn-fk-primary {
            background: var(--gradient-main);
            color: white;
            box-shadow: var(--shadow-soft);
        }
        .btn-fk-primary:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: var(--shadow-hover);
            color: white;
        }
        .btn-fk-outline {
            background: transparent;
            color: var(--orange);
            border: 2.5px solid var(--orange);
        }
        .btn-fk-outline:hover {
            background: var(--gradient-main);
            color: white;
            transform: translateY(-2px);
        }

        /* ─────────────────────────────────────────
           TOAST DE RÉCOMPENSE
           Encourage l'enfant TDAH après une action
        ───────────────────────────────────────── */
        #reward-toast {
            position: fixed;
            top: 80px;
            right: 20px;
            z-index: 9999;
            background: var(--bg-card);
            border-radius: var(--radius-xl);
            padding: 16px 20px;
            box-shadow: 0 12px 40px rgba(0,0,0,0.15);
            border-left: 5px solid var(--green);
            display: flex;
            align-items: center;
            gap: 12px;
            max-width: 300px;
            transform: translateX(130%);
            transition: transform 0.4s var(--ease-bounce);
            pointer-events: none;
        }
        #reward-toast.show { transform: translateX(0); }
        #reward-toast .reward-emoji { font-size: 32px; }
        #reward-toast .reward-text  { font-weight: 700; font-size: 14px; color: var(--text); }
        #reward-toast .reward-sub   { font-size: 12px; color: var(--text-soft); font-weight: 600; }

        /* ─────────────────────────────────────────
           FOOTER
        ───────────────────────────────────────── */
        .fk-footer {
            background: linear-gradient(135deg, #2D1B10 0%, #1A0F08 100%);
            color: rgba(255,255,255,0.6);
            margin-top: auto;
            position: relative;
            overflow: hidden;
        }
        .fk-footer::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: var(--gradient-main);
        }
        .fk-footer h3 {
            font-family: var(--font-title);
            color: white;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 18px;
        }
        .footer-link {
            display: block;
            color: rgba(255,255,255,0.55);
            text-decoration: none;
            padding: 4px 0;
            font-size: 14px;
            font-weight: 600;
            transition: all var(--transition);
        }
        .footer-link:hover { color: var(--orange-light); padding-left: 6px; }

        .social-btn {
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.08);
            border-radius: 50%;
            margin-right: 8px;
            transition: all var(--transition);
            color: white;
            text-decoration: none;
        }
        .social-btn:hover { background: var(--gradient-main); transform: translateY(-4px) scale(1.1); color: white; }

        .footer-contact-item {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
            font-size: 14px;
        }
        .footer-contact-item .icon-wrap {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(255,112,67,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: var(--orange-light);
            font-size: 13px;
        }

        .footer-newsletter { display: flex; }
        .footer-newsletter input {
            background: rgba(255,255,255,0.07);
            border: 1.5px solid rgba(255,255,255,0.15);
            border-right: none;
            color: white;
            border-radius: var(--radius-md) 0 0 var(--radius-md);
            padding: 10px 14px;
            font-family: var(--font-body);
            font-size: 14px;
            outline: none;
            flex: 1;
            transition: border-color var(--transition);
        }
        .footer-newsletter input::placeholder { color: rgba(255,255,255,0.3); }
        .footer-newsletter input:focus { border-color: var(--orange); }
        .footer-newsletter button {
            background: var(--gradient-main);
            border: none;
            color: white;
            padding: 10px 18px;
            border-radius: 0 var(--radius-md) var(--radius-md) 0;
            font-family: var(--font-body);
            font-weight: 700;
            cursor: pointer;
            transition: opacity var(--transition);
        }
        .footer-newsletter button:hover { opacity: 0.88; }
        .footer-divider { border-color: rgba(255,255,255,0.08); margin: 32px 0 20px; }
        .footer-copy { font-size: 13px; color: rgba(255,255,255,0.35); font-weight: 600; }

        /* ─────────────────────────────────────────
           BOUTON RETOUR EN HAUT
        ───────────────────────────────────────── */
        #back-to-top {
            position: fixed;
            bottom: 28px;
            right: 28px;
            width: 50px;
            height: 50px;
            background: var(--gradient-main);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 18px;
            box-shadow: var(--shadow-soft);
            opacity: 0;
            visibility: hidden;
            transition: all var(--transition);
            cursor: pointer;
            z-index: 998;
            text-decoration: none;
        }
        #back-to-top.show { opacity: 1; visibility: visible; }
        #back-to-top:hover { transform: translateY(-5px) scale(1.1); box-shadow: var(--shadow-hover); color: white; }

        /* ─────────────────────────────────────────
           ACCESSIBILITÉ
        ───────────────────────────────────────── */
        :focus-visible {
            outline: 3px solid var(--orange);
            outline-offset: 3px;
            border-radius: 6px;
        }

        /* ─────────────────────────────────────────
           RESPONSIVE MOBILE
        ───────────────────────────────────────── */
        @media (max-width: 992px) {
            .navbar-toggle-btn { display: flex; }
            .navbar-nav-wrap {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background: var(--bg-card);
                box-shadow: 0 8px 30px rgba(0,0,0,0.12);
                padding: 12px;
                z-index: 999;
                border-top: 2px solid var(--border);
            }
            .navbar-nav-wrap.open { display: flex; }
            .nav-items { flex-direction: column; align-items: stretch; width: 100%; gap: 4px; }
            .nav-item-custom a { flex-direction: row; justify-content: flex-start; gap: 12px; padding: 12px 16px; font-size: 15px; }
            .nav-item-custom a .nav-icon { font-size: 22px; }
            .brand-name { font-size: 22px; }
        }
        @media (max-width: 576px) {
            .btn-compte { display: none !important; }
        }

        /* Réduction des animations (accessibilité) */
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>
    <!-- Lien d'évitement clavier -->
    <a href="#dynamic-content" class="skip-link">Aller au contenu principal</a>

    <!-- Barre de progression de la session -->
    <div id="focus-bar" role="progressbar" aria-hidden="true"></div>

    <div id="page-wrapper">

        <!-- ═══════════════════════════════════
             NAVBAR
        ═══════════════════════════════════ -->
        <nav class="navbar" role="navigation" aria-label="Navigation principale">
            <div class="navbar-inner container-fluid">

                <!-- Logo -->
                <a href="#" id="homeLink" class="navbar-brand" aria-label="FocusKid - Accueil">
                    <img src="{{ asset('base-front/img/logo.png') }}" alt="Logo FocusKid">
                    <span class="brand-name">Focus<span style="color:var(--blue)">Kid</span></span>
                </a>

                <!-- Hamburger mobile -->
                <button class="navbar-toggle-btn" id="navToggle"
