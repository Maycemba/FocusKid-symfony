    <script>
    (function() {
        'use strict';

        /* ── Menu hamburger mobile ── */
        var navToggle = document.getElementById('navToggle');
        var navMenu   = document.getElementById('navMenu');
        if (navToggle && navMenu) {
            navToggle.addEventListener('click', function() {
                var isOpen = navMenu.classList.toggle('open');
                navToggle.setAttribute('aria-expanded', String(isOpen));
            });
            // Fermer si clic à l'extérieur
            document.addEventListener('click', function(e) {
                if (!navMenu.contains(e.target) && !navToggle.contains(e.target)) {
                    navMenu.classList.remove('open');
                    navToggle.setAttribute('aria-expanded', 'false');
                }
            });
        }

        /* ── Navbar scroll ── */
        var navbar    = document.querySelector('.navbar');
        var backToTop = document.getElementById('back-to-top');
        window.addEventListener('scroll', function() {
            var scrolled = window.scrollY > 60;
            if (navbar)    navbar.classList.toggle('scrolled', scrolled);
            if (backToTop) backToTop.classList.toggle('show', scrolled);
        }, { passive: true });

        /* ── Retour en haut ── */
        if (backToTop) {
            backToTop.addEventListener('click', function(e) {
                e.preventDefault();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }

        /* ── Navigation AJAX ── */
        var contentDiv = document.getElementById('dynamic-content');
        var currentUrl = window.location.pathname;

        function loadContent(url) {
            if (!url || url === '#') return;

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function(res) { return res.text(); })
                .then(function(html) {
                    var parser  = new DOMParser();
                    var doc     = parser.parseFromString(html, 'text/html');
                    var newMain = doc.getElementById('dynamic-content');

                    contentDiv.innerHTML = newMain ? newMain.innerHTML : html;

                    // Animation d'entrée
                    contentDiv.classList.remove('page-fade-enter');
                    void contentDiv.offsetWidth;
                    contentDiv.classList.add('page-fade-enter');

                    window.history.pushState({ url: url }, '', url);

                    var newTitle = doc.querySelector('title');
                    if (newTitle) document.title = newTitle.textContent;

                    // Mise à jour lien actif
                    document.querySelectorAll('.ajax-link').forEach(function(link) {
                        link.classList.toggle('active', link.dataset.url === url);
                    });

                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    if (typeof WOW !== 'undefined') new WOW().init();

                    // Fermeture menu mobile
                    if (navMenu)   navMenu.classList.remove('open');
                    if (navToggle) navToggle.setAttribute('aria-expanded', 'false');
                })
                .catch(function() { window.location.href = url; });
        }

        document.addEventListener('click', function(e) {
            var link = e.target.closest('.ajax-link');
            if (link) {
                e.preventDefault();
                var url = link.dataset.url;
                if (url) loadContent(url);
            }
        });

        var homeLink = document.getElementById('homeLink');
        if (homeLink) {
            homeLink.addEventListener('click', function(e) {
                e.preventDefault();
                loadContent("{{ path('app_index') }}");
            });
        }

        window.addEventListener('popstate', function(e) {
            if (e.state && e.state.url) loadContent(e.state.url);
        });

        document.querySelectorAll('.ajax-link').forEach(function(link) {
            if (link.dataset.url && currentUrl.includes(link.dataset.url)) {
                link.classList.add('active');
            }
        });

        /* ── Toast de récompense (API globale) ── */
        window.showReward = function(emoji, text, sub) {
            var toast = document.getElementById('reward-toast');
            if (!toast) return;
            toast.querySelector('.reward-emoji').textContent = emoji || '🌟';
            toast.querySelector('.reward-text').textContent  = text  || 'Super travail !';
            toast.querySelector('.reward-sub').textContent   = sub   || 'Continue comme ça 💪';
            toast.classList.add('show');
            setTimeout(function() { toast.classList.remove('show'); }, 3500);
        };

        /* ── Barre de focus animée ── */
        var focusBar = document.getElementById('focus-bar');
        if (focusBar) {
            var progress = 0;
            var timer = setInterval(function() {
                progress += Math.random() * 2.5 + 0.5;
                if (progress > 100) { progress = 100; clearInterval(timer); }
                focusBar.style.transform = 'scaleX(' + (progress / 100) + ')';
            }, 600);
        }

        console.log('✅ FocusKid — Interface TDAH-Friendly initialisée');
    })();
    </script>

