{% extends 'base-back.html.twig' %}

{% block title %}Détail du commentaire #{{ commentaire.id }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm">

        <div class="card-header bg-white">
            <h1 class="h4 mb-0">💬 Commentaire n°{{ commentaire.id }}</h1>
        </div>

        <div class="card-body">
            <dl class="row">

                <dt class="col-sm-4">Carnet lié</dt>
                <dd class="col-sm-8">
                    {% if commentaire.carnetEducatif %}
                        <a href="{{ path('admin_carnet_show', {id: commentaire.carnetEducatif.id}) }}">
                            📖 Carnet #{{ commentaire.carnetEducatif.id }}
                            — {{ commentaire.carnetEducatif.matiere }}
                        </a>
                    {% else %}
                        <span class="text-muted">Aucun carnet associé</span>
                    {% endif %}
                </dd>

                <dt class="col-sm-4">Type</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-primary">{{ commentaire.typeCommentaire }}</span>
                </dd>

                <dt class="col-sm-4">Date</dt>
                <dd class="col-sm-8">
                    {{ commentaire.dateCommentaire ? commentaire.dateCommentaire|date('d/m/Y H:i') : '—' }}
                </dd>

                <dt class="col-sm-4">Texte</dt>
                <dd class="col-sm-8">{{ commentaire.texteCommentaire }}</dd>

            </dl>
        </div>

        <div class="card-footer d-flex gap-2 flex-wrap">
            <a href="{{ path('admin_commentaire_index') }}" class="btn btn-secondary">← Retour</a>
            <a href="{{ path('admin_commentaire_edit', {id: commentaire.id}) }}" class="btn btn-warning">✏ Modifier</a>
            <form method="post"
                  action="{{ path('admin_commentaire_delete', {id: commentaire.id}) }}"
                  style="display:inline-block;"
                  onsubmit="return confirm('Supprimer définitivement ce commentaire ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commentaire.id) }}">
                <button type="submit" class="btn btn-danger">🗑 Supprimer</button>
            </form>
        </div>

    </div>
</div>
{% endblock %}