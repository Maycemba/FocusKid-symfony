{% extends 'base-back.html.twig' %}

{% block title %}Détail du carnet #{{ carnet.id }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h1 class="h4 mb-0">📖 Carnet n°{{ carnet.id }}</h1>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Matière</dt>
                <dd class="col-sm-8">{{ carnet.matiere }}</dd>

                <dt class="col-sm-4">Date d'étude</dt>
                <dd class="col-sm-8">{{ carnet.dateEtude ? carnet.dateEtude|date('d/m/Y') : '—' }}</dd>

                <dt class="col-sm-4">Heure début</dt>
                <dd class="col-sm-8">{{ carnet.heureDebut ? carnet.heureDebut|date('H:i') : '—' }}</dd>

                <dt class="col-sm-4">Heure fin</dt>
                <dd class="col-sm-8">{{ carnet.heureFin ? carnet.heureFin|date('H:i') : '—' }}</dd>

                <dt class="col-sm-4">Durée totale</dt>
                <dd class="col-sm-8">{{ carnet.dureeTotale ?? '—' }} min</dd>

                <dt class="col-sm-4">Lieu</dt>
                <dd class="col-sm-8">{{ carnet.lieu ?? 'Non précisé' }}</dd>

                <dt class="col-sm-4">Type d'activité</dt>
                <dd class="col-sm-8">{{ carnet.typeActivite ?? '—' }}</dd>

                <dt class="col-sm-4">Niveau de difficulté</dt>
                <dd class="col-sm-8">{{ carnet.niveauDifficulte ?? '—' }}</dd>

                <dt class="col-sm-4">Niveau de concentration</dt>
                <dd class="col-sm-8">
                    {% if carnet.niveauConcentration %}
                        {{ carnet.niveauConcentration }}/5
                        <div class="progress mt-1" style="height: 6px; max-width: 200px;">
                            <div class="progress-bar bg-success" style="width: {{ carnet.niveauConcentration * 20 }}%"></div>
                        </div>
                    {% else %}
                        —
                    {% endif %}
                </dd>

                <dt class="col-sm-4">Niveau d'agitation</dt>
                <dd class="col-sm-8">
                    {% if carnet.niveauAgitation %}
                        {{ carnet.niveauAgitation }}/5
                        <div class="progress mt-1" style="height: 6px; max-width: 200px;">
                            <div class="progress-bar bg-warning" style="width: {{ carnet.niveauAgitation * 20 }}%"></div>
                        </div>
                    {% else %}
                        —
                    {% endif %}
                </dd>

                <dt class="col-sm-4">Nombre d'interruptions</dt>
                <dd class="col-sm-8">{{ carnet.nombreInterruptions ?? '—' }}</dd>

                <dt class="col-sm-4">Temps avant perte de concentration</dt>
                <dd class="col-sm-8">{{ carnet.tempsAvantPerteConcentration ?? '—' }} min</dd>

                <dt class="col-sm-4">A travaillé seul</dt>
                <dd class="col-sm-8">
                    {% if carnet.travailleSeul %}
                        <span class="badge bg-success">Oui</span>
                    {% else %}
                        <span class="badge bg-secondary">Non</span>
                    {% endif %}
                </dd>

                <dt class="col-sm-4">A demandé de l'aide</dt>
                <dd class="col-sm-8">
                    {% if carnet.demandeAide %}
                        <span class="badge bg-info text-dark">Oui</span>
                    {% else %}
                        <span class="badge bg-secondary">Non</span>
                    {% endif %}
                </dd>

                <dt class="col-sm-4">Niveau d'autonomie</dt>
                <dd class="col-sm-8">{{ carnet.niveauAutonomie ?? '—' }}/5</dd>

                <dt class="col-sm-4">Travail terminé</dt>
                <dd class="col-sm-8">
                    {% if carnet.travailTermine %}
                        <span class="badge bg-success">✅ Oui</span>
                    {% else %}
                        <span class="badge bg-danger">⏳ Non</span>
                    {% endif %}
                </dd>

                <dt class="col-sm-4">Difficultés rencontrées</dt>
                <dd class="col-sm-8">{{ carnet.difficultes ?? 'Aucune' }}</dd>

                <dt class="col-sm-4">Points positifs</dt>
                <dd class="col-sm-8">{{ carnet.pointsPositifs ?? 'Aucun' }}</dd>

                <dt class="col-sm-4">Créé le</dt>
                <dd class="col-sm-8">{{ carnet.createdAt ? carnet.createdAt|date('d/m/Y H:i') : '—' }}</dd>

                <dt class="col-sm-4">Utilisateur</dt>
                <dd class="col-sm-8">{{ carnet.utilisateur ? carnet.utilisateur.email : 'N/A' }}</dd>
            </dl>
        </div>

        <div class="card-footer d-flex gap-2 flex-wrap">
            <a href="{{ path('admin_carnet_index') }}" class="btn btn-secondary">← Retour</a>
            <a href="{{ path('admin_carnet_edit', {id: carnet.id}) }}" class="btn btn-warning">✏ Modifier</a>
            <a href="{{ path('admin_commentaire_index', {carnet_id: carnet.id}) }}" class="btn btn-outline-primary">
                💬 Commentaires
            </a>
            <form method="post"
                  action="{{ path('admin_carnet_delete', {id: carnet.id}) }}"
                  style="display: inline-block;"
                  onsubmit="return confirm('Supprimer définitivement ce carnet ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ carnet.id) }}">
                <button type="submit" class="btn btn-danger">🗑 Supprimer</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}