{% extends 'base-back.html.twig' %}

{% block title %}Modifier le commentaire #{{ commentaire.id }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm">

        <div class="card-header bg-white">
            <h1 class="h4 mb-0">✏ Modification du commentaire n°{{ commentaire.id }}</h1>
        </div>

        <div class="card-body">
            {{ form_start(form) }}
                {{ form_widget(form) }}
                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">💾 Enregistrer</button>
                    <a href="{{ path('admin_commentaire_show', {id: commentaire.id}) }}"
                       class="btn btn-secondary">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>

    </div>
</div>
{% endblock %}