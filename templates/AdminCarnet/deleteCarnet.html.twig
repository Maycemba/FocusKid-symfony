{% extends 'base-back.html.twig' %}

{% block title %}Confirmation de suppression{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-danger text-white">
            <h3>⚠️ Confirmation de suppression</h3>
        </div>
        <div class="card-body">
            <p>Voulez-vous vraiment supprimer le carnet <strong>#{{ carnet.id }} – {{ carnet.matiere }}</strong> ?</p>
            <p>Cette action est irréversible.</p>
            <form method="post" action="{{ path('admin_carnet_delete', {id: carnet.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ carnet.id) }}">
                <button type="submit" class="btn btn-danger">🗑 Oui, supprimer</button>
                <a href="{{ path('admin_carnet_show', {id: carnet.id}) }}" class="btn btn-secondary">Annuler</a>
            </form>
        </div>
    </div>
</div>
{% endblock %}