{% extends 'base-front.html.twig' %}

{% block title %}Tableau Trello - Gestion des tâches{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ============================================
   STYLE COMPLET TRELLO MODERNE
   ============================================ */
   
:root {
  --trello-blue: #0079bf;
  --trello-green: #10b981;
  --trello-orange: #f59e0b;
  --trello-red: #ef4444;
  --trello-dark: #1f2937;
  --trello-gray: #6b7280;
  --trello-light: #f9fafb;
  --trello-white: #ffffff;
  --trello-border: #e5e7eb;
}

/* Page container */
.trello-page {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: calc(100vh - 70px);
  padding: 2rem;
}

.trello-header {
  background: rgba(255,255,255,0.98);
  backdrop-filter: blur(10px);
  border-radius: 24px;
  padding: 1rem 2rem;
  margin-bottom: 2rem;
  box-shadow: 0 8px 32px rgba(0,0,0,0.1);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  animation: slideDown 0.5s ease-out;
}

@keyframes slideDown {
  from {
    transform: translateY(-30px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.trello-header h1 {
  margin: 0;
  font-size: 1.8rem;
  font-weight: 800;
  background: linear-gradient(135deg, #667eea, #764ba2);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.trello-header h1 i {
  background: none;
  -webkit-text-fill-color: initial;
  font-size: 2rem;
}

/* Bouton retour */
.btn-back {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border: none;
  padding: 0.7rem 1.5rem;
  border-radius: 40px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.9rem;
  text-decoration: none;
  box-shadow: 0 4px 15px rgba(102,126,234,0.3);
}

.btn-back:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(102,126,234,0.4);
  color: white;
}

/* Flash message */
.flash-message {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 9999;
  animation: slideInRight 0.3s ease-out;
}

@keyframes slideInRight {
  from {
    transform: translateX(100%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

.alert-success {
  background: #10b981;
  color: white;
  padding: 1rem 1.5rem;
  border-radius: 12px;
  font-weight: 600;
  box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

/* Board - CENTRÉ */
.trello-board {
  display: flex;
  justify-content: center;
  gap: 1.8rem;
  align-items: flex-start;
  padding-bottom: 1rem;
  min-height: 65vh;
}

/* Colonnes */
.trello-column {
  min-width: 350px;
  width: 350px;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(10px);
  border-radius: 20px;
  display: flex;
  flex-direction: column;
  max-height: calc(100vh - 200px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.1);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.trello-column:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 40px rgba(0,0,0,0.15);
}

/* Couleurs spécifiques pour chaque colonne */
.trello-column[data-status="todo"] .column-header {
  background: linear-gradient(135deg, #3B82F6, #2563EB);
}
.trello-column[data-status="inprogress"] .column-header {
  background: linear-gradient(135deg, #F59E0B, #D97706);
}
.trello-column[data-status="done"] .column-header {
  background: linear-gradient(135deg, #10B981, #059669);
}

.column-header {
  padding: 1rem 1.2rem;
  border-radius: 20px 20px 0 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 700;
  position: sticky;
  top: 0;
  z-index: 10;
}

.column-header h3 {
  font-size: 1.1rem;
  margin: 0;
  display: flex;
  align-items: center;
  gap: 0.6rem;
  color: white;
}

.column-header h3 span {
  font-size: 1.3rem;
}

.badge-count {
  background: rgba(255,255,255,0.25);
  border-radius: 30px;
  padding: 0.2rem 0.7rem;
  font-size: 0.8rem;
  font-weight: 700;
  color: white;
}

/* Liste des tâches */
.task-list {
  padding: 0.8rem;
  min-height: 300px;
  flex: 1;
  overflow-y: auto;
}

/* Scrollbar personnalisée */
.task-list::-webkit-scrollbar {
  width: 6px;
}

.task-list::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 10px;
  margin: 10px 0;
}

.task-list::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 10px;
}

.task-list::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

/* Carte */
.task-card {
  background: white;
  border-radius: 14px;
  padding: 1rem;
  margin-bottom: 0.8rem;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  cursor: grab;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  border: 1px solid #f0f0f0;
}

.task-card:active {
  cursor: grabbing;
}

.task-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.1);
  border-color: #e0e7ff;
}

.task-card.dragging {
  opacity: 0.5;
  cursor: grabbing;
  transform: scale(0.98);
}

.task-list.drag-over {
  background: rgba(99,102,241,0.05);
  border-radius: 14px;
}

/* Checkbox et titre */
.task-checkbox {
  display: flex;
  align-items: flex-start;
  gap: 0.7rem;
  margin-bottom: 0.6rem;
}

.task-checkbox input[type="checkbox"] {
  width: 18px;
  height: 18px;
  margin-top: 2px;
  cursor: pointer;
  accent-color: #10b981;
  transition: transform 0.1s;
}

.task-checkbox input[type="checkbox"]:hover {
  transform: scale(1.1);
}

.task-title {
  font-weight: 700;
  font-size: 0.95rem;
  flex: 1;
  word-break: break-word;
  color: #1f2937;
  line-height: 1.4;
  transition: all 0.2s;
}

.task-title.completed {
  text-decoration: line-through;
  color: #9ca3af;
}

/* Description */
.task-description {
  font-size: 0.75rem;
  color: #6b7280;
  margin-top: 0.5rem;
  padding-left: 1.8rem;
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

/* Date */
.task-date {
  font-size: 0.7rem;
  margin-top: 0.6rem;
  padding-left: 1.8rem;
  display: flex;
  align-items: center;
  gap: 0.3rem;
  color: #6b7280;
}

.task-date.urgent {
  color: #ef4444;
  font-weight: 700;
}

/* Fichier joint */
.task-attachment {
  font-size: 0.7rem;
  margin-top: 0.6rem;
  padding-left: 1.8rem;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  flex-wrap: wrap;
}

.task-attachment a {
  color: #3b82f6;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  background: #eff6ff;
  padding: 0.2rem 0.6rem;
  border-radius: 20px;
  transition: all 0.2s;
}

.task-attachment a:hover {
  background: #dbeafe;
  text-decoration: none;
}

.delete-file-btn {
  background: none;
  border: none;
  color: #ef4444;
  cursor: pointer;
  font-size: 0.7rem;
  padding: 0.2rem 0.4rem;
  border-radius: 20px;
  transition: all 0.2s;
}

.delete-file-btn:hover {
  background: #fee2e2;
}

/* Actions */
.task-actions {
  display: flex;
  gap: 0.8rem;
  margin-top: 0.8rem;
  padding-left: 1.8rem;
  justify-content: flex-start;
}

.btn-edit, .btn-delete {
  background: none;
  border: none;
  font-size: 0.7rem;
  cursor: pointer;
  padding: 0.3rem 0.7rem;
  border-radius: 20px;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-weight: 600;
}

.btn-edit {
  color: #3b82f6;
  background: #eff6ff;
}

.btn-edit:hover {
  background: #dbeafe;
  transform: translateY(-1px);
}

.btn-delete {
  color: #ef4444;
  background: #fee2e2;
}

.btn-delete:hover {
  background: #fecaca;
  transform: translateY(-1px);
}

/* Bouton ajouter carte */
.btn-add-card {
  background: transparent;
  border: none;
  color: #6b7280;
  padding: 0.9rem;
  margin: 0.5rem;
  border-radius: 12px;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.2s;
  text-align: left;
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.85rem;
}

.btn-add-card:hover {
  background: rgba(0,0,0,0.05);
  color: #1f2937;
}

/* Modal */
.modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(4px);
  justify-content: center;
  align-items: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  background: white;
  border-radius: 28px;
  width: 90%;
  max-width: 550px;
  max-height: 90vh;
  overflow: hidden;
  animation: modalSlideUp 0.4s cubic-bezier(0.34, 1.2, 0.64, 1);
}

@keyframes modalSlideUp {
  from {
    transform: translateY(50px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.modal-header {
  padding: 1.2rem 1.8rem;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-header h3 {
  margin: 0;
  color: white;
  font-weight: 800;
  font-size: 1.2rem;
}

.modal-header .close-modal {
  background: none;
  border: none;
  font-size: 28px;
  cursor: pointer;
  color: white;
  opacity: 0.8;
  transition: opacity 0.2s;
}

.modal-header .close-modal:hover {
  opacity: 1;
}

.modal-body {
  padding: 1.8rem;
}

.form-group {
  margin-bottom: 1.3rem;
}

.form-group label {
  display: block;
  margin-bottom: 0.5rem;
  font-weight: 700;
  font-size: 0.85rem;
  color: #374151;
}

.form-control {
  width: 100%;
  padding: 0.7rem 1rem;
  border: 1.5px solid #e5e7eb;
  border-radius: 14px;
  font-family: inherit;
  font-size: 0.9rem;
  transition: all 0.2s;
}

.form-control:focus {
  outline: none;
  border-color: #6366f1;
  box-shadow: 0 0 0 3px rgba(99,102,241,0.1);
}

textarea.form-control {
  resize: vertical;
  min-height: 90px;
}

.modal-footer {
  padding: 1rem 1.8rem 1.8rem;
  display: flex;
  justify-content: flex-end;
  gap: 1rem;
}

.btn-primary {
  background: linear-gradient(135deg, #10b981, #059669);
  color: white;
  border: none;
  padding: 0.7rem 1.8rem;
  border-radius: 40px;
  cursor: pointer;
  font-weight: 700;
  transition: all 0.2s;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(16,185,129,0.4);
}

.btn-secondary {
  background: #f3f4f6;
  color: #374151;
  border: none;
  padding: 0.7rem 1.8rem;
  border-radius: 40px;
  cursor: pointer;
  font-weight: 700;
  transition: all 0.2s;
}

.btn-secondary:hover {
  background: #e5e7eb;
}

/* Toast notification */
.toast-notification {
  position: fixed;
  bottom: 30px;
  right: 30px;
  background: #1f2937;
  color: white;
  padding: 0.8rem 1.5rem;
  border-radius: 50px;
  font-size: 0.85rem;
  z-index: 9999;
  animation: toastSlide 0.3s ease-out;
  box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}

@keyframes toastSlide {
  from {
    transform: translateX(100%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

/* Responsive */
@media (max-width: 1200px) {
  .trello-board {
    justify-content: flex-start;
    overflow-x: auto;
  }
  
  .trello-column {
    min-width: 320px;
    width: 320px;
  }
}

@media (max-width: 768px) {
  .trello-page {
    padding: 1rem;
  }
  
  .trello-header {
    flex-direction: column;
    text-align: center;
    padding: 1rem;
  }
}
</style>
{% endblock %}

{% block body %}
<div class="trello-page">
  <div class="trello-header">
    <h1>
      <span>📋</span> Tableau de bord des tâches
    </h1>
    <a href="{{ path('app_carnet_educatif_index') }}" class="btn-back">
      ← Retour au tableau
    </a>
  </div>
  
  {# Affichage des flash messages #}
  {% for message in app.flashes('success') %}
    <div class="flash-message">
      <div class="alert-success">{{ message }}</div>
    </div>
  {% endfor %}
  
  <div class="trello-board" id="trelloBoard">
    
    {# COLONNE À FAIRE #}
    <div class="trello-column" data-status="todo">
      <div class="column-header">
        <h3>
          <span>📝</span> À faire
        </h3>
        <span class="badge-count">{{ tasksByStatus.todo|length }}</span>
      </div>
      <div class="task-list" data-status="todo" id="todo-list">
        {% for task in tasksByStatus.todo %}
          {% include 'carnet_educatif/_task_card.html.twig' with {task: task} %}
        {% endfor %}
      </div>
      <button class="btn-add-card" onclick="openTaskModal('todo')">
        + Ajouter une carte
      </button>
    </div>
    
    {# COLONNE EN COURS (CENTRÉE) #}
    <div class="trello-column" data-status="inprogress">
      <div class="column-header">
        <h3>
          <span>🔄</span> En cours
        </h3>
        <span class="badge-count">{{ tasksByStatus.inprogress|length }}</span>
      </div>
      <div class="task-list" data-status="inprogress" id="inprogress-list">
        {% for task in tasksByStatus.inprogress %}
          {% include 'carnet_educatif/_task_card.html.twig' with {task: task} %}
        {% endfor %}
      </div>
      <button class="btn-add-card" onclick="openTaskModal('inprogress')">
        + Ajouter une carte
      </button>
    </div>
    
    {# COLONNE TERMINÉ #}
    <div class="trello-column" data-status="done">
      <div class="column-header">
        <h3>
          <span>✅</span> Terminé
        </h3>
        <span class="badge-count">{{ tasksByStatus.done|length }}</span>
      </div>
      <div class="task-list" data-status="done" id="done-list">
        {% for task in tasksByStatus.done %}
          {% include 'carnet_educatif/_task_card.html.twig' with {task: task} %}
        {% endfor %}
      </div>
      <button class="btn-add-card" onclick="openTaskModal('done')">
        + Ajouter une carte
      </button>
    </div>
  </div>
</div>

{# MODAL AJOUTER TÂCHE #}
<div id="taskModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>✨ Ajouter une nouvelle tâche</h3>
      <button type="button" class="close-modal" onclick="closeTaskModal()">&times;</button>
    </div>
    <form method="post" action="{{ path('app_trello_new') }}" enctype="multipart/form-data" id="taskForm">
      <div class="modal-body">
        <div class="form-group">
          <label>Titre de la tâche *</label>
          <input type="text" name="title" class="form-control" required placeholder="votre tâche">
        </div>
        
        <div class="form-group">
          <label>Description</label>
          <textarea name="description" class="form-control" placeholder="Description détaillée..."></textarea>
        </div>
        
        <div class="form-group">
          <label>📅 Date d'échéance</label>
          <input type="date" name="dueDate" class="form-control">
        </div>
        
        <div class="form-group">
          <label>📎 Joindre un fichier</label>
          <input type="file" name="attachment" class="form-control" accept=".pdf,.jpg,.png,.docx,.txt,.xlsx,.zip">
          <small style="color: #6b7280; font-size: 0.7rem; display: block; margin-top: 0.3rem;">
            PDF, Images, Documents (max 5 Mo)
          </small>
        </div>
        
        <input type="hidden" name="status" id="modalStatus" value="todo">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" onclick="closeTaskModal()">Annuler</button>
        <button type="submit" class="btn-primary">Créer la tâche</button>
      </div>
    </form>
  </div>
</div>

<script>
// ============================================
// JAVASCRIPT COMPLET POUR LE TRELLO
// ============================================

let draggedCard = null;

// Initialisation au chargement
document.addEventListener('DOMContentLoaded', function() {
  initDragAndDrop();
  initAutoFlashDisappear();
});

// Initialiser le Drag & Drop
function initDragAndDrop() {
  const cards = document.querySelectorAll('.task-card');
  const lists = document.querySelectorAll('.task-list');
  
  cards.forEach(card => {
    card.setAttribute('draggable', 'true');
    
    card.addEventListener('dragstart', handleDragStart);
    card.addEventListener('dragend', handleDragEnd);
  });
  
  lists.forEach(list => {
    list.addEventListener('dragover', handleDragOver);
    list.addEventListener('dragleave', handleDragLeave);
    list.addEventListener('drop', handleDrop);
  });
}

function handleDragStart(e) {
  draggedCard = this;
  this.classList.add('dragging');
  e.dataTransfer.setData('text/plain', this.dataset.id);
  e.dataTransfer.effectAllowed = 'move';
}

function handleDragEnd(e) {
  this.classList.remove('dragging');
  draggedCard = null;
  
  document.querySelectorAll('.task-list').forEach(list => {
    list.classList.remove('drag-over');
  });
}

function handleDragOver(e) {
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
  this.classList.add('drag-over');
}

function handleDragLeave(e) {
  this.classList.remove('drag-over');
}

async function handleDrop(e) {
  e.preventDefault();
  this.classList.remove('drag-over');
  
  const taskId = e.dataTransfer.getData('text/plain');
  const newStatus = this.dataset.status;
  
  if (!draggedCard) return;
  
  const formData = new FormData();
  formData.append('status', newStatus);
  
  try {
    const response = await fetch(`/trello/task/move/${taskId}`, {
      method: 'POST',
      body: formData
    });
    
    if (response.ok) {
      showToast('✅ Tâche déplacée avec succès!');
      window.location.reload();
    } else {
      showToast('❌ Erreur lors du déplacement', 'error');
    }
  } catch (error) {
    console.error('Error:', error);
    showToast('❌ Erreur réseau', 'error');
  }
}

// Toggle checkbox
async function toggleCheck(taskId, checkbox) {
  try {
    const response = await fetch(`/trello/task/toggle/${taskId}`, {
      method: 'POST'
    });
    
    if (response.ok) {
      const data = await response.json();
      const titleSpan = checkbox.closest('.task-checkbox').querySelector('.task-title');
      if (data.checked) {
        titleSpan.classList.add('completed');
        showToast('✅ Tâche terminée!', 'success');
      } else {
        titleSpan.classList.remove('completed');
        showToast('↩️ Tâche réouverte', 'success');
      }
    }
  } catch (error) {
    console.error('Error:', error);
  }
}

// Supprimer un fichier
async function deleteFile(taskId, button) {
  if (confirm('Supprimer ce fichier joint ?')) {
    try {
      const response = await fetch(`/trello/task/delete-file/${taskId}`, {
        method: 'POST'
      });
      
      if (response.ok) {
        button.closest('.task-attachment').remove();
        showToast('📎 Fichier supprimé');
      }
    } catch (error) {
      console.error('Error:', error);
    }
  }
}

// Supprimer une tâche
async function deleteTask(taskId) {
  if (confirm('⚠️ Supprimer définitivement cette tâche ?')) {
    try {
      const response = await fetch(`/trello/task/delete/${taskId}`, {
        method: 'POST'
      });
      
      if (response.ok) {
        showToast('🗑️ Tâche supprimée');
        window.location.reload();
      }
    } catch (error) {
      console.error('Error:', error);
    }
  }
}

// Ouvrir modal
function openTaskModal(status = 'todo') {
  document.getElementById('modalStatus').value = status;
  document.getElementById('taskModal').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

// Fermer modal
function closeTaskModal() {
  document.getElementById('taskModal').style.display = 'none';
  document.body.style.overflow = 'auto';
}

// Toast notification
function showToast(message, type = 'success') {
  const toast = document.createElement('div');
  toast.className = 'toast-notification';
  toast.style.background = type === 'error' ? '#ef4444' : '#1f2937';
  toast.innerHTML = message;
  document.body.appendChild(toast);
  
  setTimeout(() => {
    toast.style.opacity = '0';
    toast.style.transition = 'opacity 0.3s';
    setTimeout(() => toast.remove(), 300);
  }, 3000);
}

// Auto flash disappear
function initAutoFlashDisappear() {
  setTimeout(() => {
    const flashes = document.querySelectorAll('.flash-message');
    flashes.forEach(flash => {
      flash.style.transition = 'opacity 0.5s';
      flash.style.opacity = '0';
      setTimeout(() => flash.remove(), 500);
    });
  }, 3000);
}

// Fermer modal en cliquant à l'extérieur
window.onclick = function(event) {
  const modal = document.getElementById('taskModal');
  if (event.target === modal) {
    closeTaskModal();
  }
}
</script>
{% endblock %}