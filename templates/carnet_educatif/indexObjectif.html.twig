{% extends 'base-front.html.twig' %}

{% block title %}Gestion des objectifs - FocusKid{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .objectif-card {
        transition: transform 0.2s;
        margin-bottom: 20px;
    }
    .objectif-card:hover {
        transform: translateY(-5px);
    }
    .progress-bar-custom {
        height: 8px;
        border-radius: 4px;
        background: #e8ecf5;
        overflow: hidden;
    }
    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #1CC88A, #4E73DF);
        border-radius: 4px;
        transition: width 0.3s;
    }
    .stat-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
    }
    .stat-en-cours { background: #e3f2fd; color: #1976d2; }
    .stat-atteint { background: #d4f7ec; color: #0a7a52; }
    .stat-non-atteint { background: #fdecea; color: #c0392b; }
    
    /* Style WhatsApp */
    .whatsapp-header {
        background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
        color: white;
        border-radius: 10px;
        padding: 15px 20px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .whatsapp-badge {
        background: rgba(255,255,255,0.2);
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 14px;
    }
    .whatsapp-badge i {
        margin-right: 5px;
    }
    .notification-toast {
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 9999;
        animation: slideIn 0.3s ease-out;
    }
    @keyframes slideIn {
        from {
            transform: translateX(100%);
            opacity: 0;
        }
        to {
            transform: translateX(0);
            opacity: 1;
        }
    }
    .btn-whatsapp {
        background-color: #25D366;
        color: white;
        border: none;
    }
    .btn-whatsapp:hover {
        background-color: #128C7E;
        color: white;
    }
</style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- En-tête avec WhatsApp -->
            <div class="whatsapp-header">
                <div>
                    <h1 class="mb-0">🎯 Gestion des objectifs</h1>
                    <small>Notifications automatiques par WhatsApp</small>
                </div>
                <div class="whatsapp-badge">
                    <i class="fab fa-whatsapp"></i> 
                    <strong>WhatsApp Actif</strong>
                </div>
            </div>
            
            <!-- Statistiques -->
            <div class="row mb-4" id="statsContainer">
                <div class="col-md-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h3 id="totalCount">0</h3>
                            <p class="text-muted">Total objectifs</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h3 id="encoursCount" class="text-primary">0</h3>
                            <p class="text-muted">En cours</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h3 id="atteintCount" class="text-success">0</h3>
                            <p class="text-muted">Atteints</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h3 id="nonAtteintCount" class="text-danger">0</h3>
                            <p class="text-muted">Non atteints</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Formulaire de création -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">➕ Créer un nouvel objectif</h5>
                </div>
                <div class="card-body">
                    <form id="objectifForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Description</label>
                                <input type="text" id="description" class="form-control" required 
                                       placeholder="Ex: Lire 15 min chaque jour">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Date début</label>
                                <input type="date" id="date_debut" class="form-control" required>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Date fin</label>
                                <input type="date" id="date_fin" class="form-control" required>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Créer l'objectif
                        </button>
                    </form>
                </div>
            </div>
            
            <!-- Liste des objectifs -->
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">📋 Liste des objectifs</h5>
                </div>
                <div class="card-body">
                    <div id="objectifsList"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Toast de notification -->
<div id="notificationToast" class="notification-toast" style="display: none;">
    <div class="card shadow-lg">
        <div class="card-body p-3">
            <div class="d-flex align-items-center">
                <div class="me-3" id="toastIcon"></div>
                <div>
                    <strong id="toastTitle"></strong>
                    <p class="mb-0 small" id="toastMessage"></p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // ================================
    // VOTRE NUMÉRO WHATSAPP
    // ================================
    const MON_NUMERO_WHATSAPP = '+21658397936';
    
    // ================================
    // Variables globales
    // ================================
    const aujourdhui = new Date().toISOString().split('T')[0];
    const dans7Jours = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000)
        .toISOString()
        .split('T')[0];

    // ================================
    // Initialisation des dates
    // ================================
    document.getElementById('date_debut').value = aujourdhui;
    document.getElementById('date_fin').value = dans7Jours;

    // ================================
    // Fonction d'affichage des notifications
    // ================================
    function showNotification(type, title, message) {
        const toast = document.getElementById('notificationToast');
        const icon = document.getElementById('toastIcon');
        const toastTitle = document.getElementById('toastTitle');
        const toastMessage = document.getElementById('toastMessage');
        
        toast.style.display = 'block';
        
        if (type === 'success') {
            icon.innerHTML = '<i class="fas fa-check-circle text-success fa-2x"></i>';
            toastTitle.textContent = title;
            toastTitle.style.color = '#28a745';
        } else if (type === 'error') {
            icon.innerHTML = '<i class="fas fa-times-circle text-danger fa-2x"></i>';
            toastTitle.textContent = title;
            toastTitle.style.color = '#dc3545';
        } else if (type === 'whatsapp') {
            icon.innerHTML = '<i class="fab fa-whatsapp text-success fa-2x"></i>';
            toastTitle.textContent = title;
            toastTitle.style.color = '#25D366';
        } else {
            icon.innerHTML = '<i class="fas fa-info-circle text-info fa-2x"></i>';
            toastTitle.textContent = title;
            toastTitle.style.color = '#17a2b8';
        }
        
        toastMessage.textContent = message;
        
        setTimeout(() => {
            toast.style.display = 'none';
        }, 5000);
    }

    // ================================
    // Création d'un objectif
    // ================================
    document.getElementById('objectifForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        const description = document.getElementById('description').value.trim();
        const dateDebut = document.getElementById('date_debut').value;
        const dateFin = document.getElementById('date_fin').value;
        const submitButton = this.querySelector('button[type="submit"]');

        if (!description || !dateDebut || !dateFin) {
            showNotification('error', 'Erreur', 'Veuillez remplir tous les champs.');
            return;
        }

        if (new Date(dateFin) < new Date(dateDebut)) {
            showNotification('error', 'Erreur', 'La date de fin doit être postérieure à la date de début.');
            return;
        }

        const originalText = submitButton.innerHTML;
        submitButton.disabled = true;
        submitButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Création...';

        try {
            const response = await fetch('/objectifs/api', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    description: description,
                    date_debut: dateDebut,
                    date_fin: dateFin
                })
            });

            const result = await response.json();

            if (response.ok && result.success) {
                showNotification('success', 'Succès !', result.message || 'Objectif créé avec succès !');

                document.getElementById('objectifForm').reset();
                document.getElementById('date_debut').value = aujourdhui;
                document.getElementById('date_fin').value = dans7Jours;

                await chargerObjectifs();
                await chargerStats();
            } else {
                showNotification('error', 'Erreur', result.error || (result.errors ? result.errors.join('\n') : 'Erreur lors de la création.'));
            }
        } catch (error) {
            console.error(error);
            showNotification('error', 'Erreur réseau', error.message);
        } finally {
            submitButton.disabled = false;
            submitButton.innerHTML = originalText;
        }
    });

    // ================================
    // Charger les statistiques
    // ================================
    async function chargerStats() {
        try {
            const response = await fetch('/objectifs/api/stats');
            const stats = await response.json();

            document.getElementById('totalCount').textContent = stats.total || 0;
            document.getElementById('encoursCount').textContent = stats.en_cours || 0;
            document.getElementById('atteintCount').textContent = stats.atteint || 0;
            document.getElementById('nonAtteintCount').textContent = stats.non_atteint || 0;
        } catch (error) {
            console.error('Erreur stats:', error);
        }
    }

    // ================================
    // Charger les objectifs
    // ================================
    async function chargerObjectifs() {
        try {
            const response = await fetch('/objectifs/api');
            const objectifs = await response.json();

            const container = document.getElementById('objectifsList');

            if (!Array.isArray(objectifs) || objectifs.length === 0) {
                container.innerHTML = `
                    <div class="alert alert-info text-center">
                        Aucun objectif pour le moment. Créez-en un !
                    </div>
                `;
                return;
            }

            container.innerHTML = objectifs.map(obj => `
                <div class="card objectif-card mb-3">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-4">
                                <h5>${escapeHtml(obj.description)}</h5>
                                <small class="text-muted">
                                    📅 ${obj.date_debut} → ${obj.date_fin}
                                </small>
                                ${obj.jours_restants > 0
                                    ? `<br><small>⏳ ${obj.jours_restants} jours restants</small>`
                                    : ''}
                            </div>

                            <div class="col-md-3">
                                <div class="progress mb-2">
                                    <div class="progress-bar"
                                         role="progressbar"
                                         style="width: ${obj.progression}%">
                                    </div>
                                </div>
                                <small>${obj.progression}%</small>
                            </div>

                            <div class="col-md-2">
                                <span class="badge bg-${getBadgeColor(obj.statut)}">
                                    ${obj.statut_label}
                                </span>
                            </div>

                            <div class="col-md-3 text-end">
                                ${obj.statut === 'EN_COURS' ? `
                                    <button class="btn btn-success btn-sm me-2"
                                            onclick="updateStatut(${obj.id}, 'ATTEINT', this)">
                                        ✅ Atteint
                                    </button>

                                    <button class="btn btn-danger btn-sm"
                                            onclick="updateStatut(${obj.id}, 'NON_ATTEINT', this)">
                                        ❌ Non atteint
                                    </button>
                                ` : `
                                    <button class="btn btn-outline-danger btn-sm"
                                            onclick="supprimerObjectif(${obj.id})">
                                        🗑️ Supprimer
                                    </button>
                                `}
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');
        } catch (error) {
            console.error('Erreur chargement:', error);
        }
    }

    // ================================
    // Mettre à jour le statut - VERSION CORRIGÉE
    // ================================
async function updateStatut(id, statut, button) {
    const originalText = button.innerHTML;
    button.disabled = true;
    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Mise à jour...';
    
    const statutLabel = statut === 'ATTEINT' ? '✅ ATTEINT' : '❌ NON ATTEINT';
    
    try {
        const response = await fetch(`/objectifs/api/${id}/statut`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ 
                statut: statut,
                numero_whatsapp: MON_NUMERO_WHATSAPP
            })
        });

        const result = await response.json();

        if (response.ok) {
            // Afficher le faux message WhatsApp
            if (result.whatsapp_html) {
                // Ajouter le faux WhatsApp à la page
                const div = document.createElement('div');
                div.innerHTML = result.whatsapp_html;
                document.body.appendChild(div.firstChild);
                
                // Disparaître après 8 secondes
                setTimeout(() => {
                    const whatsappDiv = document.querySelector('[style*="position: fixed; bottom: 20px; right: 20px"]');
                    if (whatsappDiv) {
                        whatsappDiv.remove();
                    }
                }, 8000);
            }
            
            // Notification de succès
            showNotification('success', statutLabel, 'Statut mis à jour avec succès !');
            
            await chargerObjectifs();
            await chargerStats();
        } else {
            showNotification('error', 'Erreur', result.error || 'Erreur lors de la mise à jour');
        }
    } catch (error) {
        console.error(error);
        showNotification('error', 'Erreur réseau', error.message);
    } finally {
        button.disabled = false;
        button.innerHTML = originalText;
    }
}

    // ================================
    // Supprimer un objectif
    // ================================
    async function supprimerObjectif(id) {
        if (!confirm('⚠️ Supprimer définitivement cet objectif ?')) {
            return;
        }

        try {
            const response = await fetch(`/objectifs/api/${id}`, {
                method: 'DELETE'
            });

            const result = await response.json();

            if (response.ok) {
                showNotification('success', 'Supprimé', result.message || 'Objectif supprimé.');
                await chargerObjectifs();
                await chargerStats();
            } else {
                showNotification('error', 'Erreur', result.error || 'Erreur lors de la suppression.');
            }
        } catch (error) {
            showNotification('error', 'Erreur réseau', error.message);
        }
    }

    // ================================
    // Fonctions utilitaires
    // ================================
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function getBadgeColor(statut) {
        switch (statut) {
            case 'ATTEINT':
                return 'success';
            case 'NON_ATTEINT':
                return 'danger';
            default:
                return 'primary';
        }
    }

    // ================================
    // Chargement initial - VERSION CORRIGÉE
    // ================================
    document.addEventListener('DOMContentLoaded', async () => {
        if (MON_NUMERO_WHATSAPP) {
            console.log('✅ WhatsApp configuré pour:', MON_NUMERO_WHATSAPP);
            showNotification('success', 'WhatsApp prêt', 
                `Notifications envoyées au ${MON_NUMERO_WHATSAPP}`);
        } else {
            console.warn('⚠️ WhatsApp non configuré');
        }
        
        await chargerObjectifs();
        await chargerStats();

        setInterval(async () => {
            await chargerObjectifs();
            await chargerStats();
        }, 30000);
    });
</script>
{% endblock %}