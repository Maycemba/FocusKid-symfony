{% extends 'base-front.html.twig' %}

{% block title %}Mes statistiques éducatives{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .stats-hero {
        background: linear-gradient(135deg, #f8faff 0%, #eef2ff 100%);
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-bottom: 2px solid #e8ecf5;
    }
    .stats-card {
        background: white;
        border-radius: 28px;
        padding: 1.8rem;
        text-align: center;
        box-shadow: 0 12px 30px rgba(0,0,0,0.05);
        transition: 0.2s;
        border: 1px solid #eef2f8;
        height: 100%;
    }
    .stats-card .number {
        font-size: 3rem;
        font-weight: 800;
        color: #1e2a5e;
        line-height: 1.2;
    }
    .stats-card .label {
        font-size: 1rem;
        color: #6c7a91;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.5rem;
    }
    .stats-card .icon {
        font-size: 2.8rem;
        margin-bottom: 0.8rem;
    }
    .chart-container {
        background: white;
        border-radius: 28px;
        padding: 1.5rem;
        box-shadow: 0 12px 30px rgba(0,0,0,0.05);
        border: 1px solid #eef2f8;
    }
    .btn-back {
        background: #eef2ff;
        color: #4e73df;
        border-radius: 999px;
        padding: 0.6rem 1.5rem;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    .btn-back:hover {
        background: #e2e8fe;
        color: #2c4bc0;
    }
</style>
{% endblock %}

{% block body %}
<div class="stats-hero">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="display-6 fw-bold" style="color: #1e2a5e;">📊 Tableau de bord</h1>
                <p class="text-muted">Vue d'ensemble de votre activité éducative</p>
            </div>
            <a href="{{ path('app_carnet_educatif_index') }}" class="btn-back">
                ← Retour aux carnets
            </a>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4 justify-content-center mb-5">
        <div class="col-md-5">
            <div class="stats-card">
                <div class="icon">📚</div>
                <div class="number">{{ total_carnets|default(0) }}</div>
                <div class="label">Carnets créés</div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="stats-card">
                <div class="icon">💬</div>
                <div class="number">{{ total_commentaires|default(0) }}</div>
                <div class="label">Commentaires postés</div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="chart-container">
                <canvas id="statsChart" width="400" height="300" style="max-height: 350px;"></canvas>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('statsChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Carnets', 'Commentaires'],
                datasets: [{
                    label: 'Nombre total',
                    data: [{{ total_carnets|default(0) }}, {{ total_commentaires|default(0) }}],
                    backgroundColor: ['#1CC88A', '#4E73DF'],
                    borderRadius: 12,
                    barPercentage: 0.6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { position: 'top' },
                    tooltip: { callbacks: { label: (ctx) => `${ctx.dataset.label}: ${ctx.raw}` } }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1, precision: 0 },
                        title: { display: true, text: 'Effectif' }
                    }
                }
            }
        });
    });
</script>
{% endblock %}