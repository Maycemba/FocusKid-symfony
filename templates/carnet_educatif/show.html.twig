.show-hero::after{content:'';position:absolute;width:130px;height:130px;bottom:-40px;left:-30px;border-radius:50%;background:radial-gradient(circle,rgba(78,115,223,.13) 0%,transparent 70%);animation:float 5s ease-in-out infinite reverse}

