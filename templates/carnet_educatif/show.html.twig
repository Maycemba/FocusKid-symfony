.btn-comment{display:inline-flex;align-items:center;gap:.4rem;padding:.6rem 1.4rem;border-radius:999px;font-size:.9rem;font-weight:800;font-family:'Nunito',sans-serif;text-decoration:none;background:var(--info-light);color:#1484c0;border:1.5px solid rgba(58,190,249,.3);transition:all .2s}
