{# templates/carnet_educatif/show.html.twig #}
{% extends 'base-front.html.twig' %}

{% block title %}Détail du carnet #{{ carnet_educatif.id }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ===== Styles pour la page show ===== */
@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Baloo+2:wght@600;700;800&display=swap');

:root {
  --primary: #1CC88A;
  --primary-light: #d4f7ec;
  --primary-dark: #0eae70;
  --secondary: #4E73DF;
  --secondary-light: #e8edfd;
  --accent: #F6C90E;
  --accent-light: #fef9d7;
  --danger: #e74c3c;
  --danger-light: #fdecea;
  --warning: #F39C12;
  --warning-light: #fef3e0;
  --info: #3ABEF9;
  --info-light: #e7f7ff;
  --success: #1CC88A;
  --success-light: #d4f7ec;
  --text: #2d3561;
  --muted: #8590a5;
  --surface: #f8faff;
  --border: #e8ecf5;
  --ia-gradient-start: #667eea;
  --ia-gradient-end: #764ba2;
}

body {
  font-family: 'Nunito', sans-serif;
  color: var(--text);
  background: #fff;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideLeft {
  from { opacity: 0; transform: translateX(-16px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes float {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-7px); }
}

@keyframes pulse-ring {
  0%,100% { box-shadow: 0 8px 24px rgba(28,200,138,.3); }
  50% { box-shadow: 0 8px 36px rgba(28,200,138,.55); }
}

@keyframes pulse-ia {
  0%,100% { box-shadow: 0 4px 15px rgba(102,126,234,.3); }
  50% { box-shadow: 0 8px 30px rgba(102,126,234,.6); }
}

/* Hero banner */
.show-hero {
  background: linear-gradient(135deg, #f0fdf9 0%, #eef2ff 100%);
  border-bottom: 2px solid var(--border);
  padding: 2.5rem 0 2rem;
  position: relative;
  overflow: hidden;
}

.show-hero::before {
  content: '';
  position: absolute;
  width: 200px;
  height: 200px;
  top: -60px;
  right: -50px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(28,200,138,.15) 0%, transparent 70%);
  animation: float 4s ease-in-out infinite;
}

.show-hero::after {
  content: '';
  position: absolute;
  width: 130px;
  height: 130px;
  bottom: -40px;
  left: -30px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(78,115,223,.13) 0%, transparent 70%);
  animation: float 5s ease-in-out infinite reverse;
}

.hero-icon-lg {
  width: 60px;
  height: 60px;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.8rem;
  box-shadow: 0 10px 28px rgba(28,200,138,.4);
  animation: pulse-ring 2.5s ease infinite;
  flex-shrink: 0;
}

.show-title {
  font-family: 'Baloo 2', cursive;
  font-size: 2rem;
  font-weight: 800;
  margin: 0;
}

.show-meta {
  font-size: .88rem;
  color: var(--muted);
  margin-top: .2rem;
}

/* Section cards */
.section-card {
  background: #fff;
  border: 1.5px solid var(--border);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(78,115,223,.07);
  margin-bottom: 1.5rem;
  animation: fadeUp .5s ease both;
}

.section-head {
  display: flex;
  align-items: center;
  gap: .65rem;
  padding: 1.1rem 1.5rem;
  background: var(--surface);
  border-bottom: 1.5px solid var(--border);
}

.section-head .s-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  flex-shrink: 0;
}

.section-head .s-title {
  font-family: 'Baloo 2', cursive;
  font-size: 1rem;
  font-weight: 700;
  margin: 0;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 0;
}

.info-item {
  padding: 1rem 1.5rem;
  border-bottom: 1px solid var(--border);
  border-right: 1px solid var(--border);
  animation: slideLeft .4s ease both;
  transition: background .2s;
}

.info-item:hover {
  background: var(--surface);
}

.info-label {
  font-size: .72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--muted);
  margin-bottom: .3rem;
}

.info-value {
  font-size: .95rem;
  font-weight: 700;
  color: var(--text);
}

.badge-yes {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .22rem .75rem;
  border-radius: 999px;
  font-size: .82rem;
  font-weight: 800;
  background: var(--primary-light);
  color: #0a7a52;
  border: 1.5px solid rgba(28,200,138,.3);
}

.badge-no {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .22rem .75rem;
  border-radius: 999px;
  font-size: .82rem;
  font-weight: 800;
  background: var(--danger-light);
  color: #c0392b;
  border: 1.5px solid rgba(231,76,60,.25);
}

.text-card {
  background: #fff;
  border: 1.5px solid var(--border);
  border-radius: 20px;
  padding: 1.5rem;
  animation: fadeUp .5s ease both;
  box-shadow: 0 4px 20px rgba(78,115,223,.07);
}

.text-card-label {
  font-size: .72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--muted);
  margin-bottom: .6rem;
  display: flex;
  align-items: center;
  gap: .4rem;
}

.text-card-body {
  font-size: .95rem;
  line-height: 1.75;
  color: var(--text);
}

/* Action bar */
.action-bar {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: 20px;
  padding: 1.25rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  animation: fadeUp .5s ease both;
}

/* ===== STYLES POUR TOUS LES BOUTONS ===== */
.btn-back, .btn-edit, .btn-comment, .btn-delete, .btn-pdf, .btn-ia {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  padding: .6rem 1.4rem;
  border-radius: 999px;
  font-size: .9rem;
  font-weight: 800;
  font-family: 'Nunito', sans-serif;
  text-decoration: none;
  transition: all .2s;
  border: 1.5px solid transparent;
}

.btn-back {
  background: #fff;
  color: var(--muted);
  border-color: var(--border);
}
.btn-back:hover {
  background: var(--surface);
  color: var(--text);
  transform: translateX(-3px);
}

.btn-edit {
  background: var(--warning-light);
  color: #9a6200;
  border-color: rgba(243,156,18,.3);
}
.btn-edit:hover {
  background: #fde8b0;
  transform: translateY(-2px);
}

.btn-comment {
  background: var(--info-light);
  color: #1484c0;
  border-color: rgba(58,190,249,.3);
}
.btn-comment:hover {
  background: #ccecff;
  transform: translateY(-2px);
}

.btn-delete {
  background: var(--danger-light);
  color: var(--danger);
  border-color: rgba(231,76,60,.25);
  cursor: pointer;
}
.btn-delete:hover {
  background: #fbc8c5;
  transform: translateY(-2px);
}

/* Bouton PDF */
.btn-pdf {
  background: var(--info-light);
  color: #1484c0;
  border-color: rgba(58,190,249,.3);
}
.btn-pdf:hover {
  animation: bounce-pdf 0.4s ease;
  background: #1484c0;
  color: white;
  border-color: #1484c0;
}

/* Bouton IA */
.btn-ia {
  background: linear-gradient(135deg, var(--ia-gradient-start), var(--ia-gradient-end));
  color: white;
  animation: pulse-ia 2s ease infinite;
  cursor: pointer;
}
.btn-ia:hover {
  transform: translateY(-2px);
  background: linear-gradient(135deg, #5a67d8, #6b46a0);
  animation: none;
}

@keyframes bounce-pdf {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}

/* Section commentaires */
.comments-section {
  background: #fff;
  border: 1.5px solid var(--border);
  border-radius: 20px;
  overflow: hidden;
  margin-bottom: 1.5rem;
  animation: fadeUp .5s ease both;
}

.comments-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.1rem 1.5rem;
  background: var(--surface);
  border-bottom: 1.5px solid var(--border);
}

.comments-title {
  display: flex;
  align-items: center;
  gap: .65rem;
}

.comments-title .s-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  background: var(--primary-light);
  color: var(--primary-dark);
}

.comments-title .s-title {
  font-family: 'Baloo 2', cursive;
  font-size: 1rem;
  font-weight: 700;
  margin: 0;
}

.btn-add-comment {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  padding: .5rem 1.2rem;
  border-radius: 999px;
  font-size: .85rem;
  font-weight: 700;
  background: var(--success-light);
  color: #0a7a52;
  border: 1.5px solid rgba(28,200,138,.3);
  text-decoration: none;
  transition: all .2s;
}
.btn-add-comment:hover {
  background: var(--primary);
  color: white;
  transform: translateY(-2px);
}

.comment-item {
  padding: 1.2rem 1.5rem;
  border-bottom: 1px solid var(--border);
  transition: background .2s;
}
.comment-item:hover {
  background: var(--surface);
}
.comment-item:last-child {
  border-bottom: none;
}

.comment-date {
  font-size: .7rem;
  color: var(--muted);
  margin-bottom: .4rem;
  display: flex;
  align-items: center;
  gap: .5rem;
  flex-wrap: wrap;
}

.comment-type {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .15rem .6rem;
  border-radius: 999px;
  font-size: .7rem;
  font-weight: 700;
}

.comment-type.observation { background: #e8edfd; color: #4E73DF; }
.comment-type.probleme { background: #fdecea; color: #e74c3c; }
.comment-type.suggestion { background: #fef9d7; color: #b87c00; }
.comment-type.amelioration { background: #d4f7ec; color: #0a7a52; }

.comment-text {
  font-size: .9rem;
  line-height: 1.5;
  color: var(--text);
  margin-bottom: .6rem;
}

.empty-comments {
  text-align: center;
  padding: 2rem;
  color: var(--muted);
  font-size: .9rem;
}

/* Style du modal IA */
.ia-modal-header {
  background: linear-gradient(135deg, var(--ia-gradient-start), var(--ia-gradient-end));
  color: white;
}

.ia-conseil-content {
  max-height: 500px;
  overflow-y: auto;
  padding: 5px;
}

.ia-conseil-text {
  background: #f8f9fa;
  border-radius: 12px;
  padding: 20px;
  line-height: 1.8;
}

.ia-conseil-text strong {
  color: var(--ia-gradient-start);
}

@media (max-width: 600px) {
  .info-grid {
    grid-template-columns: 1fr 1fr;
  }
  .action-bar {
    flex-direction: column;
  }
  .comments-header {
    flex-direction: column;
    gap: 1rem;
    align-items: stretch;
    text-align: center;
  }
  .btn-add-comment {
    justify-content: center;
  }
}
</style>
{% endblock %}

{% block body %}
<div class="show-hero">
  <div class="container">
    <div class="d-flex align-items-center gap-3">
      <div class="hero-icon-lg">📘</div>
      <div>
        <div class="show-title">Carnet #{{ carnet_educatif.id }}</div>
        <div class="show-meta">Session du {{ carnet_educatif.dateEtude ? carnet_educatif.dateEtude|date('d/m/Y') : '—' }}</div>
      </div>
    </div>
  </div>
</div>

<div class="container py-4">
  <div class="row g-4">
    <div class="col-12">
      <div class="section-card">
        <div class="section-head">
          <div class="s-icon" style="background:var(--primary-light);color:var(--primary-dark);">📋</div>
          <div class="s-title">Informations générales</div>
        </div>
        <div class="info-grid">
          <div class="info-item"><div class="info-label">Matière</div><div class="info-value">{{ carnet_educatif.matiere }}</div></div>
          <div class="info-item"><div class="info-label">Lieu</div><div class="info-value">{{ carnet_educatif.lieu }}</div></div>
          <div class="info-item"><div class="info-label">Type d'activité</div><div class="info-value">{{ carnet_educatif.typeActivite }}</div></div>
          <div class="info-item"><div class="info-label">Durée totale</div><div class="info-value">{{ carnet_educatif.dureeTotale }} min</div></div>
          <div class="info-item"><div class="info-label">Heure début</div><div class="info-value">{{ carnet_educatif.heureDebut ? carnet_educatif.heureDebut|date('H:i') : '—' }}</div></div>
          <div class="info-item"><div class="info-label">Heure fin</div><div class="info-value">{{ carnet_educatif.heureFin ? carnet_educatif.heureFin|date('H:i') : '—' }}</div></div>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="section-card">
        <div class="section-head">
          <div class="s-icon" style="background:var(--warning-light);color:var(--warning);">🎯</div>
          <div class="s-title">Évaluation cognitive</div>
        </div>
        <div class="info-grid">
          <div class="info-item"><div class="info-label">Niveau de difficulté</div><div class="info-value">{{ carnet_educatif.niveauDifficulte }}</div></div>
          <div class="info-item"><div class="info-label">Concentration</div><div class="info-value">{{ carnet_educatif.niveauConcentration }}/5</div></div>
          <div class="info-item"><div class="info-label">Agitation</div><div class="info-value">{{ carnet_educatif.niveauAgitation }}/5</div></div>
          <div class="info-item"><div class="info-label">Autonomie</div><div class="info-value">{{ carnet_educatif.niveauAutonomie }}/5</div></div>
          <div class="info-item"><div class="info-label">Interruptions</div><div class="info-value">{{ carnet_educatif.nombreInterruptions }}</div></div>
          <div class="info-item"><div class="info-label">Temps avant perte de concentration</div><div class="info-value">{{ carnet_educatif.tempsAvantPerteConcentration }} sec</div></div>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="section-card">
        <div class="section-head">
          <div class="s-icon" style="background:var(--accent-light);color:#b87c00;">⚙️</div>
          <div class="s-title">Travail & autonomie</div>
        </div>
        <div class="info-grid">
          <div class="info-item"><div class="info-label">Travail terminé</div><div class="info-value">{{ carnet_educatif.travailTermine ? '<span class="badge-yes">✅ Terminé</span>'|raw : '<span class="badge-no">⏳ Non terminé</span>'|raw }}</div></div>
          <div class="info-item"><div class="info-label">A travaillé seul</div><div class="info-value">{{ carnet_educatif.travailleSeul ? 'Oui' : 'Non' }}</div></div>
          <div class="info-item"><div class="info-label">A demandé de l'aide</div><div class="info-value">{{ carnet_educatif.demandeAide ? 'Oui' : 'Non' }}</div></div>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="text-card">
        <div class="text-card-label">📝 Difficultés rencontrées</div>
        <div class="text-card-body">{{ carnet_educatif.difficultes ?: '—' }}</div>
      </div>
    </div>

    <div class="col-12">
      <div class="text-card">
        <div class="text-card-label">✨ Points positifs</div>
        <div class="text-card-body">{{ carnet_educatif.pointsPositifs ?: '—' }}</div>
      </div>
    </div>

    <!-- SECTION COMMENTAIRES -->
    <div class="col-12">
      <div class="comments-section">
        <div class="comments-header">
          <div class="comments-title">
            <div class="s-icon">💬</div>
            <div class="s-title">Commentaires</div>
          </div>
          <a href="{{ path('app_commentaire_new', {'carnetId': carnet_educatif.id}) }}" class="btn-add-comment">
            ✨ Ajouter un commentaire
          </a>
        </div>
        
        {% if carnet_educatif.commentaires is defined and carnet_educatif.commentaires|length > 0 %}
          {% for commentaire in carnet_educatif.commentaires %}
            <div class="comment-item">
              <div class="comment-date">
                {{ commentaire.dateCommentaire ? commentaire.dateCommentaire|date('d/m/Y à H:i') : '—' }}
                <span class="comment-type {{ commentaire.typeCommentaire|lower|replace({'é':'e','è':'e'}) }}">
                  {% if commentaire.typeCommentaire == 'Observation' %}🔍
                  {% elseif commentaire.typeCommentaire == 'Problème' %}⚠️
                  {% elseif commentaire.typeCommentaire == 'Suggestion' %}💡
                  {% elseif commentaire.typeCommentaire == 'Amélioration' %}✨
                  {% endif %}
                  {{ commentaire.typeCommentaire }}
                </span>
              </div>
              <div class="comment-text">{{ commentaire.texteCommentaire }}</div>
            </div>
          {% endfor %}
        {% else %}
          <div class="empty-comments">
            💭 Aucun commentaire pour le moment. Soyez le premier à laisser un avis !
          </div>
        {% endif %}
      </div>
    </div>

    <!-- BARRE D'ACTIONS AVEC BOUTON IA -->
    <div class="action-bar">
      <a href="{{ path('app_carnet_educatif_index') }}" class="btn-back">← Retour à la liste</a>
      <div class="d-flex gap-2 flex-wrap">
        <!-- BOUTON IA PERSONNALISÉ -->
        <button type="button" class="btn-ia" data-bs-toggle="modal" data-bs-target="#iaModal" data-carnet-id="{{ carnet_educatif.id }}">
          🤖 Conseil IA personnalisé
        </button>
        
        <a href="{{ path('app_carnet_educatif_pdf', {'id': carnet_educatif.id}) }}" class="btn-pdf" target="_blank">📄 Télécharger PDF</a>
        <a href="{{ path('app_carnet_educatif_edit', {'id': carnet_educatif.id}) }}" class="btn-edit">✏️ Modifier</a>
        <button type="button" class="btn-delete" data-bs-toggle="modal" data-bs-target="#deleteModal">🗑️ Supprimer</button>
      </div>
    </div>
  </div>
</div>

<!-- MODAL IA POUR LE CONSEIL PERSONNALISÉ -->
<div class="modal fade" id="iaModal" tabindex="-1" aria-labelledby="iaModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header ia-modal-header">
        <h5 class="modal-title" id="iaModalLabel">
          <i class="fas fa-robot me-2"></i>
          🤖 Conseil IA personnalisé
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="iaModalBody">
        <div class="text-center py-4">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Chargement...</span>
          </div>
          <p class="mt-3">🧠 Analyse du carnet en cours...</p>
          <p class="text-muted small">Examen des objectifs, émotions et données pédagogiques</p>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
        <button type="button" class="btn btn-primary" onclick="imprimerConseil()">
          <i class="fas fa-print me-1"></i> Imprimer
        </button>
      </div>
    </div>
  </div>
</div>

<!-- MODAL DE CONFIRMATION DE SUPPRESSION -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteModalLabel">Confirmer la suppression</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Êtes-vous sûr de vouloir supprimer le carnet #{{ carnet_educatif.id }} ? Cette action est irréversible.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
        <form method="post" action="{{ path('app_carnet_educatif_delete', {'id': carnet_educatif.id}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ carnet_educatif.id) }}">
          <button type="submit" class="btn btn-danger">Supprimer définitivement</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
// Fonction pour imprimer le conseil
function imprimerConseil() {
  const conseilHTML = document.getElementById('iaModalBody').innerHTML;
  const printWindow = window.open('', '_blank');
  printWindow.document.write(`
    <!DOCTYPE html>
    <html>
    <head>
      <title>Conseil IA - FocusKid</title>
      <style>
        body { font-family: Arial, sans-serif; padding: 40px; line-height: 1.6; }
        .conseil { background: #f5f5f5; padding: 20px; border-radius: 10px; }
        h1 { color: #4E73DF; }
        .footer { margin-top: 30px; text-align: center; color: #999; font-size: 12px; }
      </style>
    </head>
    <body>
      <h1>🤖 FocusKid - Conseil IA personnalisé</h1>
      <div class="conseil">${document.querySelector('#iaModalBody .ia-conseil-text')?.innerHTML || conseilHTML}</div>
      <div class="footer">Généré le ${new Date().toLocaleString()}</div>
    </body>
    </html>
  `);
  printWindow.document.close();
  printWindow.print();
}

// Script pour le bouton IA
document.addEventListener('DOMContentLoaded', function() {
  const btnIA = document.querySelector('.btn-ia');
  const modalBody = document.getElementById('iaModalBody');
  
  if (btnIA) {
    btnIA.addEventListener('click', async function() {
      const carnetId = this.dataset.carnetId;
      
      // Réinitialiser le contenu du modal avec le chargement
      modalBody.innerHTML = `
        <div class="text-center py-4">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Chargement...</span>
          </div>
          <p class="mt-3">🧠 Analyse du carnet #${carnetId}...</p>
          <p class="text-muted small">Examen des objectifs, émotions et données pédagogiques</p>
        </div>
      `;
      
      try {
        const response = await fetch(`/carnet/conseil/generer/${carnetId}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          }
        });
        
        const data = await response.json();
        
        if (data.success) {
          // Formater le conseil (remplacer **texte** par <strong>texte</strong>)
          let conseilHtml = data.conseil;
          conseilHtml = conseilHtml.replace(/\n/g, '<br>');
          conseilHtml = conseilHtml.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
          
          modalBody.innerHTML = `
            <div class="ia-conseil-content">
              <div class="alert alert-success">
                <i class="fas fa-lightbulb me-2"></i>
                <strong>Conseil généré spécialement pour ce carnet</strong>
              </div>
              <div class="ia-conseil-text">
                ${conseilHtml}
              </div>
              <hr>
              <div class="text-muted small text-end">
                <i class="fas fa-calendar-alt me-1"></i>
                Généré le ${data.date}
              </div>
            </div>
          `;
        } else {
          modalBody.innerHTML = `
            <div class="alert alert-danger">
              <i class="fas fa-exclamation-triangle me-2"></i>
              ${data.error || 'Erreur lors de la génération du conseil'}
            </div>
          `;
        }
      } catch (error) {
        modalBody.innerHTML = `
          <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Erreur réseau : ${error.message}
          </div>
        `;
      }
    });
  }
});
</script>
{% endblock %}