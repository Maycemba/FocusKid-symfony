.btn-delete{display:inline-flex;align-items:center;gap:.4rem;padding:.6rem 1.4rem;border-radius:999px;font-size:.9rem;font-weight:800;font-family:'Nunito',sans-serif;cursor:pointer;background:var(--danger-light);color:var(--danger);border:1.5px solid rgba(231,76,60,.25);transition:all .2s}
