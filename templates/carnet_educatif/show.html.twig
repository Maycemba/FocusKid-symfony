{# templates/carnet_educatif/show.html.twig #}
{% extends 'base-front.html.twig' %}

{% block title %}Détail du carnet #{{ carnet_educatif.id }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ===== Styles complémentaires pour la page show ===== */
@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Baloo+2:wght@600;700;800&display=swap');

:root {
  --primary: #1CC88A;
  --primary-light: #d4f7ec;
  --primary-dark: #0eae70;
  --secondary: #4E73DF;
  --secondary-light: #e8edfd;
  --accent: #F6C90E;
  --accent-light: #fef9d7;
  --danger: #e74c3c;
  --danger-light: #fdecea;
  --warning: #F39C12;
  --warning-light: #fef3e0;
  --info: #3ABEF9;
  --info-light: #e7f7ff;
  --text: #2d3561;
  --muted: #8590a5;
  --surface: #f8faff;
  --border: #e8ecf5;
}

body {
  font-family: 'Nunito', sans-serif;
  color: var(--text);
  background: #fff;
}

/* Animation */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideLeft {
  from { opacity: 0; transform: translateX(-16px); }
  to { opacity: 1; transform: translateX(0); }
}

/* Hero banner */
.show-hero {
  background: linear-gradient(135deg, #f0fdf9 0%, #eef2ff 100%);
  border-bottom: 2px solid var(--border);
  padding: 2.5rem 0 2rem;
  position: relative;
  overflow: hidden;
}

.show-hero::before {
  content: '';
  position: absolute;
  width: 200px;
  height: 200px;
  top: -60px;
  right: -50px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(28,200,138,.15) 0%, transparent 70%);
  animation: float 4s ease-in-out infinite;
}

.show-hero::after {
  content: '';
  position: absolute;
  width: 130px;
  height: 130px;
  bottom: -40px;
  left: -30px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(78,115,223,.13) 0%, transparent 70%);
  animation: float 5s ease-in-out infinite reverse;
}

.hero-icon-lg {
  width: 60px;
  height: 60px;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.8rem;
  box-shadow: 0 10px 28px rgba(28,200,138,.4);
  animation: pulse-ring 2.5s ease infinite;
  flex-shrink: 0;
}

@keyframes pulse-ring {
  0%,100% { box-shadow: 0 8px 24px rgba(28,200,138,.3); }
  50% { box-shadow: 0 8px 36px rgba(28,200,138,.55); }
}

@keyframes float {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-7px); }
}

.show-title {
  font-family: 'Baloo 2', cursive;
  font-size: 2rem;
  font-weight: 800;
  margin: 0;
}

.show-meta {
  font-size: .88rem;
  color: var(--muted);
  margin-top: .2rem;
}

/* Section cards */
.section-card {
  background: #fff;
  border: 1.5px solid var(--border);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(78,115,223,.07);
  margin-bottom: 1.5rem;
  animation: fadeUp .5s ease both;
}

.section-head {
  display: flex;
  align-items: center;
  gap: .65rem;
  padding: 1.1rem 1.5rem;
  background: var(--surface);
  border-bottom: 1.5px solid var(--border);
}

.section-head .s-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  flex-shrink: 0;
}

.section-head .s-title {
  font-family: 'Baloo 2', cursive;
  font-size: 1rem;
  font-weight: 700;
  margin: 0;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 0;
}

.info-item {
  padding: 1rem 1.5rem;
  border-bottom: 1px solid var(--border);
  border-right: 1px solid var(--border);
  animation: slideLeft .4s ease both;
  transition: background .2s;
}

.info-item:hover {
  background: var(--surface);
}

.info-label {
  font-size: .72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--muted);
  margin-bottom: .3rem;
}

.info-value {
  font-size: .95rem;
  font-weight: 700;
  color: var(--text);
}

/* Badges */
.badge-yes {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .22rem .75rem;
  border-radius: 999px;
  font-size: .82rem;
  font-weight: 800;
  background: var(--primary-light);
  color: #0a7a52;
  border: 1.5px solid rgba(28,200,138,.3);
}

.badge-no {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .22rem .75rem;
  border-radius: 999px;
  font-size: .82rem;
  font-weight: 800;
  background: var(--danger-light);
  color: #c0392b;
  border: 1.5px solid rgba(231,76,60,.25);
}

/* Text cards */
.text-card {
  background: #fff;
  border: 1.5px solid var(--border);
  border-radius: 20px;
  padding: 1.5rem;
  animation: fadeUp .5s ease both;
  box-shadow: 0 4px 20px rgba(78,115,223,.07);
}

.text-card-label {
  font-size: .72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--muted);
  margin-bottom: .6rem;
  display: flex;
  align-items: center;
  gap: .4rem;
}

.text-card-body {
  font-size: .95rem;
  line-height: 1.75;
  color: var(--text);
}

/* Action bar */
.action-bar {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: 20px;
  padding: 1.25rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  animation: fadeUp .5s ease both;
}

.btn-back {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  padding: .6rem 1.4rem;
  border-radius: 999px;
  font-size: .9rem;
  font-weight: 800;
  font-family: 'Nunito', sans-serif;
  text-decoration: none;
  background: #fff;
  color: var(--muted);
  border: 1.5px solid var(--border);
  transition: all .2s;
}

.btn-back:hover {
  background: var(--surface);
  color: var(--text);
  transform: translateX(-3px);
}

.btn-edit {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  padding: .6rem 1.4rem;
  border-radius: 999px;
  font-size: .9rem;
  font-weight: 800;
  font-family: 'Nunito', sans-serif;
  text-decoration: none;
  background: var(--warning-light);
  color: #9a6200;
  border: 1.5px solid rgba(243,156,18,.3);
  transition: all .2s;
}

.btn-edit:hover {
  background: #fde8b0;
  transform: translateY(-2px);
}

.btn-comment {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  padding: .6rem 1.4rem;
  border-radius: 999px;
  font-size: .9rem;
  font-weight: 800;
  font-family: 'Nunito', sans-serif;
  text-decoration: none;
  background: var(--info-light);
  color: #1484c0;
  border: 1.5px solid rgba(58,190,249,.3);
  transition: all .2s;
}

.btn-comment:hover {
  background: #ccecff;
  transform: translateY(-2px);
}

.btn-delete {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  padding: .6rem 1.4rem;
  border-radius: 999px;
  font-size: .9rem;
  font-weight: 800;
  font-family: 'Nunito', sans-serif;
  cursor: pointer;
  background: var(--danger-light);
  color: var(--danger);
  border: 1.5px solid rgba(231,76,60,.25);
  transition: all .2s;
}

.btn-delete:hover {
  background: #fbc8c5;
  transform: translateY(-2px);
}

.created-note {
  font-size: .8rem;
  color: var(--muted);
  font-style: italic;
}

@media (max-width: 600px) {
  .info-grid {
    grid-template-columns: 1fr 1fr;
  }
}
</style>
{% endblock %}

{% block body %}
<div class="show-hero">
  <div class="container">
    <div class="d-flex align-items-center gap-3 flex-wrap">
      <div class="hero-icon-lg">📖</div>
      <div>
        <div class="show-title">Carnet n°{{ carnet_educatif.id }}</div>
        <div class="show-meta">
          {{ carnet_educatif.dateEtude|date('d/m/Y') }} · {{ carnet_educatif.matiere }} · 
          {{ carnet_educatif.dureeTotale }} min
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container py-4">
  <div class="row g-4">

    {# ───── SECTION : INFORMATIONS GÉNÉRALES ───── #}
    <div class="col-12">
      <div class="section-card" style="animation-delay:.05s">
        <div class="section-head">
          <div class="s-icon" style="background:var(--primary-light);color:#0a7a52">🗓</div>
          <div class="s-title">Informations de session</div>
        </div>
        <div class="info-grid">
          <div class="info-item"><div class="info-label">Date d'étude</div><div class="info-value">{{ carnet_educatif.dateEtude|date('d/m/Y') }}</div></div>
          <div class="info-item"><div class="info-label">Heure début</div><div class="info-value">{{ carnet_educatif.heureDebut|date('H:i') }}</div></div>
          <div class="info-item"><div class="info-label">Heure fin</div><div class="info-value">{{ carnet_educatif.heureFin|date('H:i') }}</div></div>
          <div class="info-item"><div class="info-label">Durée totale</div><div class="info-value">⏱ {{ carnet_educatif.dureeTotale }} min</div></div>
          <div class="info-item"><div class="info-label">Lieu</div><div class="info-value">📍 {{ carnet_educatif.lieu }}</div></div>
          <div class="info-item"><div class="info-label">Matière</div><div class="info-value">📚 {{ carnet_educatif.matiere }}</div></div>
          <div class="info-item"><div class="info-label">Type d'activité</div><div class="info-value">{{ carnet_educatif.typeActivite }}</div></div>
          <div class="info-item"><div class="info-label">Niveau difficulté</div><div class="info-value">🎯 {{ carnet_educatif.niveauDifficulte }}</div></div>
        </div>
      </div>
    </div>

    {# ───── SECTION : COMPORTEMENT ET CONCENTRATION ───── #}
    <div class="col-12">
      <div class="section-card" style="animation-delay:.15s">
        <div class="section-head">
          <div class="s-icon" style="background:var(--secondary-light);color:var(--secondary)">🧠</div>
          <div class="s-title">Comportement & concentration</div>
        </div>
        <div class="info-grid">
          <div class="info-item"><div class="info-label">Concentration</div><div class="info-value">{{ carnet_educatif.niveauConcentration }}/5</div></div>
          <div class="info-item"><div class="info-label">Agitation</div><div class="info-value">{{ carnet_educatif.niveauAgitation }}/5</div></div>
          <div class="info-item"><div class="info-label">Nombre d'interruptions</div><div class="info-value">⚡ {{ carnet_educatif.nombreInterruptions }}</div></div>
          <div class="info-item"><div class="info-label">Temps avant perte de concentration</div><div class="info-value">{{ carnet_educatif.tempsAvantPerteConcentration ?? '—' }} s</div></div>
          <div class="info-item">
            <div class="info-label">Travaille seul</div>
            <div class="info-value">{% if carnet_educatif.travailleSeul %}<span class="badge-yes">✓ Oui</span>{% else %}<span class="badge-no">✗ Non</span>{% endif %}</div>
          </div>
          <div class="info-item">
            <div class="info-label">Demande aide</div>
            <div class="info-value">{% if carnet_educatif.demandeAide %}<span class="badge-yes">✓ Oui</span>{% else %}<span class="badge-no">✗ Non</span>{% endif %}</div>
          </div>
          <div class="info-item"><div class="info-label">Autonomie</div><div class="info-value">🚀 {{ carnet_educatif.niveauAutonomie }}/5</div></div>
          <div class="info-item">
            <div class="info-label">Travail terminé</div>
            <div class="info-value">{% if carnet_educatif.travailTermine %}<span class="badge-yes">✅ Terminé</span>{% else %}<span class="badge-no">⏳ Non terminé</span>{% endif %}</div>
          </div>
        </div>
      </div>
    </div>

    {# ───── SECTION : DIFFICULTÉS ET POINTS POSITIFS ───── #}
    <div class="col-md-6">
      <div class="text-card" style="animation-delay:.3s">
        <div class="text-card-label">📝 Difficultés rencontrées</div>
        <div class="text-card-body">{{ carnet_educatif.difficultes ?: 'Aucune difficulté signalée.' }}</div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="text-card" style="animation-delay:.35s">
        <div class="text-card-label">⭐ Points positifs</div>
        <div class="text-card-body">{{ carnet_educatif.pointsPositifs ?: 'Aucun point noté.' }}</div>
      </div>
    </div>

    {# ───── SECTION : ACTIONS ───── #}
    <div class="col-12">
      <div class="action-bar" style="animation-delay:.4s">
        <div class="created-note">📅 Créé le {{ carnet_educatif.createdAt|date('d/m/Y à H:i') }}</div>
        <div class="d-flex gap-2 flex-wrap">
          <a href="{{ path('app_carnet_educatif_index') }}" class="btn-back">← Retour</a>
          <a href="{{ path('app_carnet_educatif_edit', {'id': carnet_educatif.id}) }}" class="btn-edit">✏️ Modifier</a>
          <a href="{{ path('app_commentaire_new', {'carnetId': carnet_educatif.id}) }}" class="btn-comment">💬 Commenter</a>
          <a href="{{ path('app_carnet_educatif_pdf', {'id': carnet_educatif.id}) }}" class="btn-pdf" style="
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .6rem 1.4rem;
    border-radius: 999px;
    font-size: .9rem;
    font-weight: 800;
    font-family: 'Nunito', sans-serif;
    text-decoration: none;
    background: #fff;
    color: #dc3545;
    border: 1.5px solid #dc3545;
    transition: all .2s;
">📄 PDF</a>
          {# Formulaire de suppression (avec CSRF) #}
          <form method="post" action="{{ path('app_carnet_educatif_delete', {'id': carnet_educatif.id}) }}"
                onsubmit="return confirm('Supprimer définitivement ce carnet ?');" class="d-inline">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ carnet_educatif.id) }}">
            <button type="submit" class="btn-delete">🗑️ Supprimer</button>
          </form>
        </div>
      </div>
    </div>

  </div>
</div>
{% endblock %}