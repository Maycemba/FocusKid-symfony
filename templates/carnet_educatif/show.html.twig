.info-item:hover{background:var(--surface)}
.info-label{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:.3rem}
.info-value{font-size:.95rem;font-weight:700;color:var(--text)}

