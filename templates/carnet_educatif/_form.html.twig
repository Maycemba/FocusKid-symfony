{{ form_start(form, {'attr': {'class': 'carnet-form'}}) }}

<div class="row g-4">
    <div class="col-md-6">
        <div class="mb-3">{{ form_row(form.date_etude) }}</div>
        <div class="mb-3">{{ form_row(form.heure_debut) }}</div>
        <div class="mb-3">{{ form_row(form.heure_fin) }}</div>
        <div class="mb-3">{{ form_row(form.duree_totale) }}</div>
        <div class="mb-3">{{ form_row(form.lieu) }}</div>
        <div class="mb-3">{{ form_row(form.matiere) }}</div>
        <div class="mb-3">{{ form_row(form.type_activite) }}</div>
        <div class="mb-3">{{ form_row(form.niveau_difficulte) }}</div>
    </div>
    <div class="col-md-6">
        <div class="mb-3">{{ form_row(form.niveau_concentration) }}</div>
        <div class="mb-3">{{ form_row(form.niveau_agitation) }}</div>
        <div class="mb-3">{{ form_row(form.nombre_interruptions) }}</div>
        <div class="mb-3">{{ form_row(form.temps_avant_perte_concentration) }}</div>
        
        <div class="form-check mb-2">{{ form_row(form.travaille_seul) }}</div>
        <div class="form-check mb-2">{{ form_row(form.demande_aide) }}</div>
        <div class="mb-3">{{ form_row(form.niveau_autonomie) }}</div>
        <div class="form-check mb-2">{{ form_row(form.travail_termine) }}</div>
    </div>
</div>

<div class="mb-3">{{ form_row(form.difficultes) }}</div>
<div class="mb-3">{{ form_row(form.points_positifs) }}</div>

<div class="d-grid gap-2 mt-4">
    <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">{{ button_label|default('💾 Enregistrer le carnet') }}</button>
</div>

{{ form_end(form) }}

<script>
    // Attendre que tout le DOM soit chargé
    document.addEventListener('DOMContentLoaded', function() {
        // Récupérer les IDs réels générés par Symfony
        const debutField = document.getElementById('{{ form.heure_debut.vars.id }}');
        const finField = document.getElementById('{{ form.heure_fin.vars.id }}');
        const dureeField = document.getElementById('{{ form.duree_totale.vars.id }}');

        console.log('Début ID:', '{{ form.heure_debut.vars.id }}');
        console.log('Fin ID:', '{{ form.heure_fin.vars.id }}');
        console.log('Durée ID:', '{{ form.duree_totale.vars.id }}');

        function calculerDuree() {
            let debut = debutField.value;
            let fin = finField.value;
            if (debut && fin) {
                // Les inputs type="time" renvoient toujours "HH:MM" (24h)
                let [h1, m1] = debut.split(':');
                let [h2, m2] = fin.split(':');
                let minutes1 = parseInt(h1) * 60 + parseInt(m1);
                let minutes2 = parseInt(h2) * 60 + parseInt(m2);
                let diff = minutes2 - minutes1;
                if (diff < 0) diff = 0;
                dureeField.value = diff;
                console.log('Durée calculée :', diff);
            } else {
                dureeField.value = '';
            }
        }

        if (debutField && finField && dureeField) {
            debutField.addEventListener('input', calculerDuree);
            debutField.addEventListener('change', calculerDuree);
            finField.addEventListener('input', calculerDuree);
            finField.addEventListener('change', calculerDuree);
            calculerDuree(); // initial
        } else {
            console.error('Un des champs est introuvable');
        }
    });
</script>