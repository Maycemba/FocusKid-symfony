<form method="post" action="{{ path('app_carnet_educatif_delete', {'id': carnet_educatif.id}) }}"
      onsubmit="return confirm('Supprimer définitivement ce carnet ?');" class="d-inline">
  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ carnet_educatif.id) }}">
  <button type="submit" class="btn-custom btn-danger" style="
    display:inline-flex;align-items:center;gap:.4rem;
    padding:.55rem 1.25rem;border-radius:10px;font-size:.9rem;font-weight:600;
    font-family:'Outfit',sans-serif;cursor:pointer;transition:all .2s;border:1px solid rgba(248,113,113,.3);
    background:rgba(248,113,113,.1);color:#f87171;">
    🗑️ Supprimer
  </button>
</form>