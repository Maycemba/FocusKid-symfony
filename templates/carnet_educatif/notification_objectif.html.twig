{# templates/carnet_educatif/notification_objectif.html.twig #}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Notification objectif</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background: linear-gradient(135deg, #1CC88A 0%, #4E73DF 100%); color: white; padding: 20px; text-align: center; border-radius: 10px; }
        .content { background: #f8faff; padding: 20px; border-radius: 10px; margin-top: 20px; }
        .success { color: #1CC88A; font-size: 24px; }
        .warning { color: #F39C12; font-size: 24px; }
        .info { color: #4E73DF; }
        .footer { margin-top: 20px; text-align: center; font-size: 12px; color: #999; }
        .badge { display: inline-block; padding: 5px 10px; border-radius: 5px; font-weight: bold; }
        .badge-success { background: #d4f7ec; color: #0a7a52; }
        .badge-danger { background: #fdecea; color: #c0392b; }
        .badge-info { background: #e3f2fd; color: #1976d2; }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>📋 FocusKid</h1>
        <p>Suivi éducatif personnalisé</p>
    </div>
    
    <div class="content">
        {% if est_atteint %}
            <div class="success">🎉 Félicitations !</div>
            <h2>Objectif atteint avec succès</h2>
            <p>Bravo ! L'objectif "<strong>{{ objectif.description }}</strong>" a été atteint.</p>
        {% elseif est_non_atteint %}
            <div class="warning">⚠️ Objectif non atteint</div>
            <h2>Continuez vos efforts</h2>
            <p>L'objectif "<strong>{{ objectif.description }}</strong>" n'a pas été atteint.</p>
            <p>Ne vous découragez pas ! Chaque petit progrès compte.</p>
        {% else %}
            <div class="info">📝 Mise à jour de l'objectif</div>
            <h2>Suivi en temps réel</h2>
            <p>L'objectif "<strong>{{ objectif.description }}</strong>" a été mis à jour.</p>
        {% endif %}
        
        {% if info_temporelle %}
            <p class="info">{{ info_temporelle }}</p>
        {% endif %}
        
        <div style="margin-top: 20px; padding: 15px; background: white; border-radius: 8px;">
            <p><strong>📅 Période :</strong> {{ objectif.dateDebut|date('d/m/Y') }} → {{ objectif.dateFin|date('d/m/Y') }}</p>
            <p><strong>📊 Durée totale :</strong> {{ objectif.dureeTotale }} jours</p>
            <p><strong>🏷️ Statut :</strong> 
                <span class="badge 
                    {% if est_atteint %}badge-success
                    {% elseif est_non_atteint %}badge-danger
                    {% else %}badge-info{% endif %}">
                    {{ objectif.statutLabel }}
                </span>
            </p>
        </div>
    </div>
    
    <div class="footer">
        <p>Document généré automatiquement par <strong>FocusKid</strong></p>
        <p>{{ 'now'|date('d/m/Y H:i') }}</p>
    </div>
</div>
</body>
</html>