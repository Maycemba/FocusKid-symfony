<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Carnet éducatif FocusKid</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Helvetica', 'Arial', sans-serif;
            background: #4a7c2f;
            padding: 20px;
            font-size: 11px;
            color: #333;
        }

        /* ── Conteneur principal ── */
        .pdf-container {
            max-width: 750px;
            margin: 0 auto;
            background: white;
            padding: 25px;
            border-radius: 15px;
        }

        /* ── En-tête ── */
        .header {
            text-align: center;
            background: #2d5016;
            color: white;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 20px;
        }
        .header-title {
            font-size: 22px;
            font-weight: bold;
        }
        .header-sub {
            font-size: 10px;
            margin-top: 5px;
            opacity: 0.9;
        }
        .header-badge {
            background: #7ab648;
            display: inline-block;
            padding: 4px 15px;
            border-radius: 20px;
            margin-top: 10px;
            font-size: 9px;
        }

        /* ── Titres de sections ── */
        .section-title {
            font-size: 12px;
            font-weight: bold;
            margin: 15px 0 8px 0;
            padding: 8px 14px;
            border-radius: 8px;
            color: white;
            display: table;
            width: 100%;
        }
        .section-title span {
            display: table-cell;
            vertical-align: middle;
        }
        .section-title .s-icon {
            width: 24px;
        }
        .title-green  { background: #2d5016; }
        .title-blue   { background: #2a6490; }
        .title-gold   { background: #b86b20; }
        .title-purple { background: #7c3d8a; }
        .title-pink   { background: #c0385a; }

        /* ── Fleurs décoratives ── */
        .flowers {
            text-align: center;
            font-size: 12px;
            margin: 6px 0 10px 0;
            color: #8bc34a;
        }

        /* ── Grille ── */
        .grid {
            display: table;
            width: 100%;
            border-spacing: 0;
        }
        .grid-row {
            display: table-row;
        }
        .grid-cell {
            display: table-cell;
            padding: 0 6px 10px 0;
            vertical-align: top;
        }
        .grid-cell:last-child { padding-right: 0; }
        .col-3 { width: 33.33%; }
        .col-2 { width: 50%; }

        /* ── Carte ── */
        .card {
            background: #f8fdf4;
            border: 1px solid #c8e6a5;
            border-radius: 10px;
            padding: 10px 12px;
            height: 100%;
        }
        .card-label {
            font-size: 8px;
            text-transform: uppercase;
            color: #7ab648;
            font-weight: bold;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }
        .card-value {
            font-size: 13px;
            font-weight: bold;
            color: #2d5016;
        }
        .card-sub {
            font-size: 9px;
            color: #999;
            margin-top: 2px;
        }

        /* ── Score avec barre ── */
        .score-wrap { display: table; width: 100%; }
        .score-num  { display: table-cell; vertical-align: middle; }
        .score-bar  { display: table-cell; vertical-align: middle; padding-left: 8px; width: 100%; }

        .score-value {
            font-size: 18px;
            font-weight: bold;
            color: #4a7c2f;
            line-height: 1;
        }
        .score-max {
            font-size: 9px;
            color: #999;
        }

        /* ── Barres de progression ── */
        .progress-bar {
            background: #e0e0e0;
            border-radius: 6px;
            height: 6px;
            overflow: hidden;
        }
        .progress-fill {
            height: 6px;
            border-radius: 6px;
        }
        .fill-green  { background: #4a7c2f; }
        .fill-orange { background: #e8a020; }
        .fill-blue   { background: #4eaad4; }

        /* ── Badges ── */
        .badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 15px;
            font-size: 10px;
            font-weight: bold;
        }
        .badge-yes {
            background: #d4f5e2;
            color: #2d5016;
            border: 1px solid #7ab648;
        }
        .badge-no {
            background: #fde8ec;
            color: #c0385a;
            border: 1px solid #e87090;
        }

        /* ── Niveau de difficulté ── */
        .difficulty {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 10px;
            font-weight: bold;
        }
        .diff-easy   { background: #e8f5e0; color: #4a7c2f; }
        .diff-medium { background: #fef5e0; color: #e8a020; }
        .diff-hard   { background: #fde8ec; color: #e8637a; }

        /* ── Blocs de texte ── */
        .text-block {
            background: #fefdf8;
            border-left: 3px solid #7ab648;
            padding: 12px;
            font-size: 11px;
            line-height: 1.5;
            color: #4a5a3a;
            min-height: 48px;
        }
        .text-block.pink {
            border-left-color: #e8637a;
            background: #fff8fa;
        }
        .text-block.empty {
            color: #aaa;
            font-style: italic;
        }

        /* ── Séparateur ── */
        hr {
            margin: 12px 0;
            border: none;
            border-top: 1px solid #c8e6a5;
        }

        /* ── Récapitulatif rapide ── */
        .recap-row {
            display: table;
            width: 100%;
            background: #f0f8e8;
            border: 1px solid #c4dea0;
            border-radius: 10px;
            padding: 10px 14px;
            margin: 4px 0 12px 0;
        }
        .recap-item {
            display: table-cell;
            text-align: center;
            vertical-align: middle;
            padding: 0 8px;
            border-right: 1px solid #c4dea0;
        }
        .recap-item:last-child { border-right: none; }
        .recap-num   { font-size: 18px; font-weight: bold; color: #2d5016; }
        .recap-label { font-size: 8px; color: #6a8a4a; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }

        /* ── Pied de page ── */
        .footer {
            text-align: center;
            margin-top: 20px;
            padding: 12px;
            background: #2d5016;
            border-radius: 10px;
            color: #c8e6a5;
            font-size: 8px;
        }
        .footer-flowers {
            font-size: 11px;
            margin-bottom: 5px;
        }

        .no-break { page-break-inside: avoid; }
    </style>
</head>
<body>

<div class="pdf-container">

    <!-- ════════════════════════════════
         EN-TÊTE
    ════════════════════════════════ -->
    <div class="header no-break">
        <div class="header-title">📗 FocusKid — Carnet Éducatif</div>
        <div class="header-sub">✦ Suivi pédagogique personnalisé ✦</div>
        <div class="header-badge">
            Généré le {{ 'now'|date('d/m/Y à H:i') }}
        </div>
    </div>

    <!-- ════════════════════════════════
         SECTION 1 — INFORMATIONS DE SESSION
    ════════════════════════════════ -->
    <div class="section-title title-green no-break">
        <span class="s-icon">🌿</span>
        <span>Informations de session</span>
    </div>
    <div class="flowers no-break">🌸 🌼 🌺 🌻</div>

    <div class="grid no-break">
        <div class="grid-row">
            <div class="grid-cell col-3">
                <div class="card">
                    <div class="card-label">📅 Date</div>
                    <div class="card-value">
                        {{ carnet_educatif.dateEtude ? carnet_educatif.dateEtude|date('d/m/Y') : '—' }}
                    </div>
                </div>
            </div>
            <div class="grid-cell col-3">
                <div class="card">
                    <div class="card-label">🕐 Heure début</div>
                    <div class="card-value">
                        {{ carnet_educatif.heureDebut ? carnet_educatif.heureDebut|date('H:i') : '—' }}
                    </div>
                </div>
            </div>
            <div class="grid-cell col-3">
                <div class="card">
                    <div class="card-label">🕔 Heure fin</div>
                    <div class="card-value">
                        {{ carnet_educatif.heureFin ? carnet_educatif.heureFin|date('H:i') : '—' }}
                    </div>
                </div>
            </div>
        </div>
        <div class="grid-row">
            <div class="grid-cell col-3">
                <div class="card">
                    <div class="card-label">⏱️ Durée totale</div>
                    <div class="card-value">{{ carnet_educatif.dureeTotale }}</div>
                    <div class="card-sub">minutes</div>
                </div>
            </div>
            <div class="grid-cell col-3">
                <div class="card">
                    <div class="card-label">📍 Lieu</div>
                    <div class="card-value">{{ carnet_educatif.lieu ?: '—' }}</div>
                </div>
            </div>
            <div class="grid-cell col-3">
                <div class="card">
                    <div class="card-label">🎨 Type d'activité</div>
                    <div class="card-value">{{ carnet_educatif.typeActivite ?: '—' }}</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════
         SECTION 2 — ÉVALUATION COGNITIVE
    ════════════════════════════════ -->
    <div class="section-title title-blue no-break">
        <span class="s-icon">🧠</span>
        <span>Évaluation cognitive</span>
    </div>

    <div class="grid no-break">
        <div class="grid-row">
            <div class="grid-cell col-3">
                <div class="card">
                    <div class="card-label">🎯 Concentration</div>
                    <div class="score-wrap">
                        <div class="score-num">
                            <span class="score-value" style="color:#2d5016;">{{ carnet_educatif.niveauConcentration }}</span>
                            <span class="score-max">/10</span>
                        </div>
                        <div class="score-bar">
                            <div class="progress-bar">
                                <div class="progress-fill fill-green" style="width:{{ carnet_educatif.niveauConcentration * 10 }}%;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="grid-cell col-3">
                <div class="card">
                    <div class="card-label">⚡ Agitation</div>
                    <div class="score-wrap">
                        <div class="score-num">
                            <span class="score-value" style="color:#e8a020;">{{ carnet_educatif.niveauAgitation }}</span>
                            <span class="score-max">/10</span>
                        </div>
                        <div class="score-bar">
                            <div class="progress-bar">
                                <div class="progress-fill fill-orange" style="width:{{ carnet_educatif.niveauAgitation * 10 }}%;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="grid-cell col-3">
                <div class="card">
                    <div class="card-label">🌟 Autonomie</div>
                    <div class="score-wrap">
                        <div class="score-num">
                            <span class="score-value" style="color:#4eaad4;">{{ carnet_educatif.niveauAutonomie }}</span>
                            <span class="score-max">/10</span>
                        </div>
                        <div class="score-bar">
                            <div class="progress-bar">
                                <div class="progress-fill fill-blue" style="width:{{ carnet_educatif.niveauAutonomie * 10 }}%;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="grid-row">
            <div class="grid-cell col-3">
                <div class="card">
                    <div class="card-label">📖 Matière</div>
                    <div class="card-value">{{ carnet_educatif.matiere ?: '—' }}</div>
                </div>
            </div>
            <div class="grid-cell col-3">
                <div class="card">
                    <div class="card-label">🎓 Niveau de difficulté</div>
                    <div style="margin-top:6px;">
                        {% if carnet_educatif.niveauDifficulte == 'Facile' %}
                            <span class="difficulty diff-easy">🟢 Facile</span>
                        {% elseif carnet_educatif.niveauDifficulte == 'Moyen' %}
                            <span class="difficulty diff-medium">🟡 Moyen</span>
                        {% elseif carnet_educatif.niveauDifficulte == 'Difficile' %}
                            <span class="difficulty diff-hard">🔴 Difficile</span>
                        {% else %}
                            <span class="card-value">{{ carnet_educatif.niveauDifficulte ?: '—' }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="grid-cell col-3">
                <div class="card">
                    <div class="card-label">🔔 Interruptions</div>
                    <div class="card-value">{{ carnet_educatif.nombreInterruptions ?: '0' }}</div>
                    <div class="card-sub">fois durant la session</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════
         SECTION 3 — TRAVAIL & AUTONOMIE
    ════════════════════════════════ -->
    <div class="section-title title-gold no-break">
        <span class="s-icon">⚙️</span>
        <span>Travail &amp; autonomie</span>
    </div>

    <div class="grid no-break">
        <div class="grid-row">
            <div class="grid-cell col-3">
                <div class="card">
                    <div class="card-label">✅ Travail terminé</div>
                    <div style="margin-top:6px;">
                        <span class="badge {{ carnet_educatif.travailTermine ? 'badge-yes' : 'badge-no' }}">
                            {{ carnet_educatif.travailTermine ? '✔ Terminé' : '✘ Non terminé' }}
                        </span>
                    </div>
                </div>
            </div>
            <div class="grid-cell col-3">
                <div class="card">
                    <div class="card-label">🧑 A travaillé seul</div>
                    <div style="margin-top:6px;">
                        <span class="badge {{ carnet_educatif.travailleSeul ? 'badge-yes' : 'badge-no' }}">
                            {{ carnet_educatif.travailleSeul ? '✔ Oui' : '✘ Non' }}
                        </span>
                    </div>
                </div>
            </div>
            <div class="grid-cell col-3">
                <div class="card">
                    <div class="card-label">🤝 A demandé de l'aide</div>
                    <div style="margin-top:6px;">
                        <span class="badge {{ carnet_educatif.demandeAide ? 'badge-yes' : 'badge-no' }}">
                            {{ carnet_educatif.demandeAide ? '✔ Oui' : '✘ Non' }}
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════
         SECTION 4 — DIFFICULTÉS
    ════════════════════════════════ -->
    <div class="section-title title-purple no-break">
        <span class="s-icon">📝</span>
        <span>Difficultés rencontrées</span>
    </div>
    {% if carnet_educatif.difficultes %}
        <div class="text-block no-break">{{ carnet_educatif.difficultes }}</div>
    {% else %}
        <div class="text-block empty no-break">Aucune difficulté signalée pour cette session. Excellent travail !</div>
    {% endif %}

    <!-- ════════════════════════════════
         SECTION 5 — POINTS POSITIFS
    ════════════════════════════════ -->
    <div class="section-title title-pink no-break">
        <span class="s-icon">⭐</span>
        <span>Points positifs</span>
    </div>
    {% if carnet_educatif.pointsPositifs %}
        <div class="text-block pink no-break">{{ carnet_educatif.pointsPositifs }}</div>
    {% else %}
        <div class="text-block pink empty no-break">Aucun point positif noté pour cette session.</div>
    {% endif %}

    <hr class="no-break">

    <!-- ════════════════════════════════
         RÉCAPITULATIF RAPIDE
    ════════════════════════════════ -->
    <div class="recap-row no-break">
        <div class="recap-item">
            <div class="recap-num">{{ carnet_educatif.niveauConcentration }}/10</div>
            <div class="recap-label">🎯 Concentration</div>
        </div>
        <div class="recap-item">
            <div class="recap-num">{{ carnet_educatif.niveauAgitation }}/10</div>
            <div class="recap-label">⚡ Agitation</div>
        </div>
        <div class="recap-item">
            <div class="recap-num">{{ carnet_educatif.niveauAutonomie }}/10</div>
            <div class="recap-label">🌟 Autonomie</div>
        </div>
        <div class="recap-item">
            <div class="recap-num">{{ carnet_educatif.dureeTotale }} min</div>
            <div class="recap-label">⏱️ Durée</div>
        </div>
        <div class="recap-item">
            <div class="recap-num">{{ carnet_educatif.nombreInterruptions ?: '0' }}</div>
            <div class="recap-label">🔔 Interruptions</div>
        </div>
    </div>

    <!-- ════════════════════════════════
         PIED DE PAGE
    ════════════════════════════════ -->
    <div class="footer no-break">
        <div class="footer-flowers">🌿 🌸 🍃 🌻 🌼</div>
        FocusKid — Suivi éducatif personnalisé — Document généré automatiquement
    </div>

</div>

</body>
</html>