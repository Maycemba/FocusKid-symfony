{% extends 'base-back.html.twig' %}

{% block title %}Modifier le carnet #{{ carnet_educatif.id }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-gradient-warning text-dark rounded-top-4">
                    <h3 class="mb-0">✏️ Modifier le carnet n°{{ carnet_educatif.id }}</h3>
                </div>
                <div class="card-body p-4">
                    {{ include('carnet_educatif/_form.html.twig', {'button_label': '💾 Mettre à jour'}) }}
                </div>
                <div class="card-footer bg-light d-flex justify-content-between">
                    <a href="{{ path('app_carnet_educatif_index') }}" class="btn btn-outline-secondary">← Retour</a>
                    {{ include('carnet_educatif/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}