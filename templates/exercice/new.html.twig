{% extends 'base-back.html.twig' %}

{% block title %}Nouvel exercice - FocusKids{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .config-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
            border: 1px solid #e0e0e0;
        }
        .question-row, .sequence-row, .defi-row {
            background: white;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #e0e0e0;
        }
        .badge-type {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }
        .badge-memoire { background: #9C27B0; color: white; }
        .badge-attention { background: #2196F3; color: white; }
        .badge-logique { background: #FF9800; color: white; }
        .badge-chrono { background: #F44336; color: white; }
        .type-config {
            display: none;
        }
        .type-config.active {
            display: block;
        }
        .day-btn {
            min-width: 50px;
            cursor: pointer;
        }
        .day-btn.active {
            background-color: #FF9800 !important;
            border-color: #FF9800 !important;
            color: white !important;
        }
        .form-label {
            font-weight: 600;
            margin-bottom: 8px;
        }
        .form-field {
            border-radius: 10px;
            padding: 10px 15px;
        }
        .switch-small {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 24px;
            margin-left: 10px;
        }
        .switch-small input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        .switch-small .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: .3s;
            border-radius: 24px;
        }
        .switch-small .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .3s;
            border-radius: 50%;
        }
        .switch-small input:checked + .slider {
            background-color: #f44336;
        }
        .switch-small input:checked + .slider:before {
            transform: translateX(26px);
        }
        .switch-label {
            display: inline-flex;
            align-items: center;
        }
        /* Style pour les prédictions */
        .predictions-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            padding: 20px;
            margin-top: 20px;
            color: white;
        }
        .predictions-card h6 {
            color: white;
            margin-bottom: 15px;
        }
        .prediction-item {
            background: rgba(255,255,255,0.2);
            border-radius: 10px;
            padding: 10px 15px;
            margin-bottom: 10px;
            transition: all 0.3s;
        }
        .prediction-item:hover {
            background: rgba(255,255,255,0.3);
            transform: translateX(5px);
        }
        .badge-prediction-success {
            background: #4CAF50;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
        }
        .badge-prediction-danger {
            background: #F44336;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
        }
        .badge-prediction-warning {
            background: #FF9800;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
        }
        .loading-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 1s ease-in-out infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="card-title text-white mb-0">
                            <i class="ti ti-plus"></i> Créer un nouvel exercice
                        </h4>
                        <small class="text-white-50">Ajoutez un nouveau contenu pédagogique</small>
                    </div>
                    <a href="{{ path('app_exercice_index') }}" class="btn btn-light">
                        <i class="ti ti-arrow-left"></i> Retour
                    </a>
                </div>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'id': 'exerciceForm', 'novalidate': 'novalidate'}}) }}
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.titre, '📝 Titre', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.titre, {'attr': {'class': 'form-control form-field', 'id': 'exercice_titre'}}) }}
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            {{ form_label(form.type, '🎯 Type', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.type, {'attr': {'class': 'form-select form-field', 'id': 'exercice_type'}}) }}
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            {{ form_label(form.difficulte, '⭐ Difficulté', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.difficulte, {'attr': {'class': 'form-select form-field', 'id': 'exercice_difficulte'}}) }}
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            {{ form_label(form.consigne, '📖 Consigne', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.consigne, {'attr': {'class': 'form-control form-field', 'rows': 3}}) }}
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            {{ form_label(form.duree, '⏱️ Durée (secondes)', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.duree, {'attr': {'class': 'form-control form-field'}}) }}
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            <div class="form-check form-switch mt-4">
                                {{ form_widget(form.actif, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(form.actif, '✅ Actif', {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            <div class="switch-label mt-4">
                                <span>📦 Archivé</span>
                                <label class="switch-small">
                                    {{ form_widget(form.archive, {'attr': {'class': 'form-check-input'}}) }}
                                    <span class="slider"></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-12 mb-3">
                            <button type="button" id="generateIABtn" class="btn btn-warning">
                                <i class="ti ti-brain"></i> 🤖 Générer avec IA
                            </button>
                            <div id="iaLoading" style="display: none; margin-top: 10px;" class="text-muted">
                                <i class="ti ti-loader"></i> Génération en cours...
                            </div>
                        </div>
                    </div>
                    
                    <div class="config-section">
                        <h5 class="mb-3">
                            <i class="ti ti-settings"></i> ⚙️ Configuration de l'exercice
                            <span id="typeBadge" class="badge-type badge-memoire ms-2">MÉMOIRE</span>
                        </h5>
                        
                        <div id="configMemoire" class="type-config">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">🎨 Thème</label>
                                    <select id="memoireTheme" class="form-select form-field">
                                        <option value="animaux">Animaux 🐶🐱🐭</option>
                                        <option value="fruits">Fruits 🍎🍊🍌</option>
                                        <option value="chiffres">Chiffres 1️⃣2️⃣3️⃣</option>
                                    </select>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">📏 Taille grille</label>
                                    <select id="memoireTaille" class="form-select form-field">
                                        <option value="4x4">4x4</option>
                                        <option value="6x6">6x6</option>
                                    </select>
                                </div>
                                <div class="col-md-2 mb-3">
                                    <label class="form-label">⏱️ Temps (s)</label>
                                    <input type="number" id="memoireTemps" class="form-control form-field" value="3">
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">⭐ Points/paire</label>
                                    <input type="number" id="memoirePoints" class="form-control form-field" value="10">
                                </div>
                            </div>
                        </div>
                        
                        <div id="configAttention" class="type-config">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">🎯 Type</label>
                                    <select id="attentionSousType" class="form-select form-field">
                                        <option value="intrus">Trouver l'intrus</option>
                                        <option value="differences">Trouver les différences</option>
                                    </select>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">⏱️ Temps/question</label>
                                    <input type="number" id="attentionTemps" class="form-control form-field" value="10">
                                </div>
                            </div>
                            <div class="mt-3">
                                <label class="form-label">📝 Questions</label>
                                <div id="attentionQuestionsContainer"></div>
                                <button type="button" class="btn btn-sm btn-primary mt-2" onclick="addAttentionQuestionRow()">
                                    <i class="ti ti-plus"></i> Ajouter question
                                </button>
                            </div>
                        </div>
                        
                        <div id="configLogique" class="type-config">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">🧠 Type</label>
                                    <select id="logiqueSousType" class="form-select form-field">
                                        <option value="numerique">Suite numérique</option>
                                        <option value="visuelle">Suite visuelle</option>
                                    </select>
                                </div>
                            </div>
                            <div class="mt-3">
                                <label class="form-label">📝 Séquences</label>
                                <div id="logiqueSequencesContainer"></div>
                                <button type="button" class="btn btn-sm btn-primary mt-2" onclick="addLogiqueSequenceRow()">
                                    <i class="ti ti-plus"></i> Ajouter séquence
                                </button>
                            </div>
                        </div>
                        
                        <div id="configChrono" class="type-config">
                            <div class="row">
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">⏱️ Durée totale</label>
                                    <input type="number" id="chronoDuree" class="form-control form-field" value="60">
                                </div>
                            </div>
                            <div class="mt-3">
                                <label class="form-label">📝 Défis</label>
                                <div id="chronoDefisContainer"></div>
                                <button type="button" class="btn btn-sm btn-primary mt-2" onclick="addChronoDefiRow()">
                                    <i class="ti ti-plus"></i> Ajouter défi
                                </button>
                            </div>
                        </div>
                    </div>
                    
                   <div class="config-section mt-3">
    <h5 class="mb-3"><i class="ti ti-users"></i> 👶 Enfants concernés</h5>
    <div class="row">
        <div class="col-md-12">
            <div class="form-check mb-2">
                {{ form_widget(form.pour_tous_enfants, {'attr': {'class': 'form-check-input', 'id': 'tousEnfantsRadio'}}) }}
                <label class="form-check-label" for="tousEnfantsRadio">👥 Tous les enfants</label>
            </div>
            <div class="form-check mb-2">
                <input type="radio" id="selectionEnfantsRadio" name="enfantsGroup" class="form-check-input">
                <label class="form-check-label" for="selectionEnfantsRadio">🎯 Choisir des enfants spécifiques</label>
            </div>
            <div id="enfantsSelectionDiv" style="display: none; margin-top: 15px;">
                <label class="form-label">Sélectionnez les enfants</label>
                <select name="exercice[enfantsSelectionnes][]" id="exercice_enfantsSelectionnes" class="form-select form-field" size="5" multiple>
                    {% for enfant in enfants %}
                        <option value="{{ enfant.id }}">{{ enfant.username }} ({{ enfant.email }})</option>
                    {% else %}
                        <option disabled>Aucun enfant trouvé dans la base</option>
                    {% endfor %}
                </select>
                {% if enfants|length == 0 %}
                    <div class="alert alert-warning mt-2">
                        ⚠️ Aucun enfant n'a été trouvé dans la base de données. 
                        Assurez-vous qu'il existe des utilisateurs avec le rôle 'enfant'.
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
                    
                    <!-- 🔥 SECTION DES PRÉDICTIONS EN TEMPS RÉEL -->
                    <div id="predictionsPreview" class="predictions-card" style="display: none;">
                        <h6><i class="ti ti-chart-bar"></i> 🔮 Prédictions en temps réel</h6>
                        <p class="small" style="color: rgba(255,255,255,0.8); margin-bottom: 10px;">
                            Basé sur l'historique de chaque enfant
                        </p>
                        <div id="predictionsList">
                            <div class="text-center py-3">
                                <div class="loading-spinner"></div>
                                <p class="mt-2 mb-0">Chargement des prédictions...</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="config-section mt-3">
                        <h5 class="mb-3"><i class="ti ti-calendar"></i> 📅 Jours d'assignation</h5>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="btn-group flex-wrap" role="group">
                                    <label class="btn btn-outline-secondary day-btn">
                                        <input type="checkbox" name="jours[]" value="Lundi" class="btn-check planning-day"> L
                                    </label>
                                    <label class="btn btn-outline-secondary day-btn">
                                        <input type="checkbox" name="jours[]" value="Mardi" class="btn-check planning-day"> M
                                    </label>
                                    <label class="btn btn-outline-secondary day-btn">
                                        <input type="checkbox" name="jours[]" value="Mercredi" class="btn-check planning-day"> M
                                    </label>
                                    <label class="btn btn-outline-secondary day-btn">
                                        <input type="checkbox" name="jours[]" value="Jeudi" class="btn-check planning-day"> J
                                    </label>
                                    <label class="btn btn-outline-secondary day-btn">
                                        <input type="checkbox" name="jours[]" value="Vendredi" class="btn-check planning-day"> V
                                    </label>
                                    <label class="btn btn-outline-secondary day-btn">
                                        <input type="checkbox" name="jours[]" value="Samedi" class="btn-check planning-day"> S
                                    </label>
                                    <label class="btn btn-outline-secondary day-btn">
                                        <input type="checkbox" name="jours[]" value="Dimanche" class="btn-check planning-day"> D
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Champ caché pour les jours -->
                    <input type="hidden" id="joursHidden" name="jours" value="">
                    
                    <!-- Champ caché pour le JSON -->
                    <input type="hidden" id="contenuJson" name="exercice[contenu]" value="{}">
                    
                    <div class="row mt-4">
                        <div class="col-12 text-center">
                            <button type="submit" class="btn btn-primary px-5">
                                <i class="ti ti-device-floppy"></i> Enregistrer
                            </button>
                            <a href="{{ path('app_exercice_index') }}" class="btn btn-secondary px-5 ms-2">
                                <i class="ti ti-x"></i> Annuler
                            </a>
                        </div>
                    </div>
                    
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<script>
    // ========== FONCTIONS POUR AJOUTER DES LIGNES ==========
    
    function addAttentionQuestionRow(images = '', intrus = '', reponse = '') {
        const container = document.getElementById('attentionQuestionsContainer');
        if(!container) return;
        const div = document.createElement('div');
        div.className = 'question-row row mb-2';
        div.innerHTML = `
            <div class="col-md-5"><input type="text" class="form-control" placeholder="Images (ex: 🐶,🐱,🐭)" value="${escapeHtml(images)}"></div>
            <div class="col-md-4"><input type="text" class="form-control" placeholder="Intrus" value="${escapeHtml(intrus)}"></div>
            <div class="col-md-2"><input type="text" class="form-control" placeholder="Réponse" value="${escapeHtml(reponse)}"></div>
            <div class="col-md-1"><button type="button" class="btn btn-danger btn-sm" onclick="this.closest('.question-row').remove()">🗑️</button></div>
        `;
        container.appendChild(div);
    }
    
    function addLogiqueSequenceRow(serie = '', reponse = '', regle = '') {
        const container = document.getElementById('logiqueSequencesContainer');
        if(!container) return;
        const div = document.createElement('div');
        div.className = 'sequence-row row mb-2';
        div.innerHTML = `
            <div class="col-md-5"><input type="text" class="form-control" placeholder="Série (ex: 2,4,6,8,?)" value="${escapeHtml(serie)}"></div>
            <div class="col-md-4"><input type="text" class="form-control" placeholder="Réponse" value="${escapeHtml(reponse)}"></div>
            <div class="col-md-2"><input type="text" class="form-control" placeholder="Règle" value="${escapeHtml(regle)}"></div>
            <div class="col-md-1"><button type="button" class="btn btn-danger btn-sm" onclick="this.closest('.sequence-row').remove()">🗑️</button></div>
        `;
        container.appendChild(div);
    }
    
    function addChronoDefiRow(question = '', reponse = '', points = 10) {
        const container = document.getElementById('chronoDefisContainer');
        if(!container) return;
        const div = document.createElement('div');
        div.className = 'defi-row row mb-2';
        div.innerHTML = `
            <div class="col-md-6"><input type="text" class="form-control" placeholder="Question" value="${escapeHtml(question)}"></div>
            <div class="col-md-4"><input type="text" class="form-control" placeholder="Réponse" value="${escapeHtml(reponse)}"></div>
            <div class="col-md-1"><input type="number" class="form-control" placeholder="Points" value="${points}"></div>
            <div class="col-md-1"><button type="button" class="btn btn-danger btn-sm" onclick="this.closest('.defi-row').remove()">🗑️</button></div>
        `;
        container.appendChild(div);
    }
    
    function escapeHtml(str) {
        if(!str) return '';
        return str.replace(/[&<>]/g, function(m) {
            if(m === '&') return '&amp;';
            if(m === '<') return '&lt;';
            if(m === '>') return '&gt;';
            return m;
        });
    }
    
    // ========== CHANGEMENT DE TYPE D'EXERCICE ==========
    
    function changeExerciceType() {
        const typeSelect = document.getElementById('exercice_type');
        const typeBadge = document.getElementById('typeBadge');
        const configs = ['configMemoire', 'configAttention', 'configLogique', 'configChrono'];
        
        console.log("🔄 Changement de type vers:", typeSelect.value);
        
        configs.forEach(c => { 
            const el = document.getElementById(c); 
            if(el) el.classList.remove('active');
        });
        
        const selectedType = typeSelect.value;
        
        const badgeClass = {
            'MÉMOIRE': 'badge-memoire',
            'ATTENTION': 'badge-attention',
            'LOGIQUE': 'badge-logique',
            'CHRONO': 'badge-chrono'
        };
        
        typeBadge.textContent = selectedType;
        typeBadge.className = 'badge-type ms-2 ' + (badgeClass[selectedType] || 'badge-memoire');
        
        let configId = 'configMemoire';
        switch(selectedType) {
            case 'MÉMOIRE': configId = 'configMemoire'; break;
            case 'ATTENTION': configId = 'configAttention'; break;
            case 'LOGIQUE': configId = 'configLogique'; break;
            case 'CHRONO': configId = 'configChrono'; break;
        }
        
        const configEl = document.getElementById(configId);
        if(configEl) configEl.classList.add('active');
        
        // 🔥 Recharger les prédictions si des enfants sont sélectionnés
        loadPredictions();
    }
    
    // ========== 🔥 PRÉDICTIONS EN TEMPS RÉEL ==========
    
    async function loadPredictions() {
        const enfantsSelect = document.getElementById('exercice_enfantsSelectionnes');
        const predictionsDiv = document.getElementById('predictionsPreview');
        const predictionsList = document.getElementById('predictionsList');
        
        if (!enfantsSelect) return;
        
        const selectedOptions = Array.from(enfantsSelect.selectedOptions);
        
        // Vérifier si des enfants sont sélectionnés et si le formulaire est valide
        if (selectedOptions.length === 0) {
            predictionsDiv.style.display = 'none';
            return;
        }
        
        const difficulte = document.getElementById('exercice_difficulte')?.value || 3;
        const type = document.getElementById('exercice_type')?.value || 'MÉMOIRE';
        
        const typeCode = {
            'MÉMOIRE': 1,
            'ATTENTION': 2,
            'LOGIQUE': 3,
            'CHRONO': 4
        }[type] || 1;
        
        // Afficher la section des prédictions avec loader
        predictionsDiv.style.display = 'block';
        predictionsList.innerHTML = '<div class="text-center py-3"><div class="loading-spinner"></div><p class="mt-2 mb-0">Chargement des prédictions...</p></div>';
        
        const predictions = [];
        
        for (const option of selectedOptions) {
            const enfantId = option.value;
            const enfantNom = option.text;
            
            try {
                // Appeler l'API Symfony pour les stats
                const statsResponse = await fetch(`/exercice/api/enfant-stats/${enfantId}`);
                const stats = await statsResponse.json();
                
                // Appeler l'API Python pour la prédiction
                const predResponse = await fetch('http://localhost:5000/predict', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        difficulte: parseInt(difficulte),
                        type_exercice: typeCode,
                        score_moyen: stats.score_moyen,
                        temps_moyen: stats.temps_moyen
                    })
                });
                const pred = await predResponse.json();
                
                predictions.push({
                    nom: enfantNom,
                    id: enfantId,
                    reussite: pred.reussite_predite === 1,
                    probabilite: pred.probabilite_reussite.toFixed(1),
                    score_moyen: stats.score_moyen,
                    temps_moyen: stats.temps_moyen,
                    nb_exercices: stats.nb_exercices
                });
            } catch (error) {
                console.error('Erreur pour enfant', enfantId, error);
                predictions.push({
                    nom: enfantNom,
                    id: enfantId,
                    reussite: false,
                    probabilite: '?',
                    error: true
                });
            }
        }
        
        // Afficher les résultats
        let html = '<div class="row">';
        for (const pred of predictions) {
            let badgeClass = 'badge-prediction-warning';
            let badgeIcon = '⚠️';
            let badgeText = 'Incertain';
            
            if (!pred.error) {
                if (pred.reussite && pred.probabilite >= 70) {
                    badgeClass = 'badge-prediction-success';
                    badgeIcon = '✅';
                    badgeText = `Réussite (${pred.probabilite}%)`;
                } else if (!pred.reussite && pred.probabilite <= 30) {
                    badgeClass = 'badge-prediction-danger';
                    badgeIcon = '❌';
                    badgeText = `Échec (${100-pred.probabilite}% risque)`;
                } else {
                    badgeClass = 'badge-prediction-warning';
                    badgeIcon = '⚠️';
                    badgeText = `Incertain (${pred.probabilite}%)`;
                }
            } else {
                badgeText = 'Erreur chargement';
                badgeIcon = '⚠️';
            }
            
            const bgColor = pred.reussite ? '#4CAF50' : '#F44336';
            const progressWidth = pred.reussite ? pred.probabilite : (100 - pred.probabilite);
            
            html += `
                <div class="col-md-12 mb-2">
                    <div class="prediction-item">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <strong>${escapeHtml(pred.nom)}</strong>
                                ${!pred.error ? `<small class="ms-2" style="opacity:0.7;">📊 ${pred.score_moyen}/20 | ⏱️ ${pred.temps_moyen}s | 📚 ${pred.nb_exercices} exos</small>` : ''}
                            </div>
                            <span class="${badgeClass}">
                                ${badgeIcon} ${badgeText}
                            </span>
                        </div>
                        ${!pred.error ? `
                        <div class="progress" style="height: 5px;">
                            <div class="progress-bar" role="progressbar" 
                                 style="width: ${progressWidth}%; background-color: ${bgColor};" 
                                 aria-valuenow="${progressWidth}" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        ` : ''}
                    </div>
                </div>
            `;
        }
        html += '</div>';
        
        predictionsList.innerHTML = html;
    }
    
    // ========== AJOUTER DES EXEMPLES PAR DÉFAUT ==========
    
    function addDefaultExamples() {
        addChronoDefiRow('6 × 7 = ?', '42', 15);
        addChronoDefiRow('40 + 38 = ?', '78', 15);
        addChronoDefiRow('45 - 4 = ?', '41', 17);
        addChronoDefiRow('Quel est le plus grand océan ?', 'Pacifique', 11);
        addChronoDefiRow('49 - 24 = ?', '25', 11);
        
        addAttentionQuestionRow('🐶,🐱,🐭,🐹,🐰,🦊', '🦊', '🦊');
        addAttentionQuestionRow('🍎,🍎,🍎,🍎,🍏', '🍏', '🍏');
        
        addLogiqueSequenceRow('2, 4, 6, 8, ?', '10', '+2');
        addLogiqueSequenceRow('5, 10, 15, 20, ?', '25', '+5');
    }
    
    // ========== INITIALISATION ==========
    
    document.addEventListener('DOMContentLoaded', function() {
        console.log("DOM chargé, initialisation...");
        
        addDefaultExamples();
        
        const typeSelect = document.getElementById('exercice_type');
        if(typeSelect) {
            typeSelect.addEventListener('change', changeExerciceType);
            changeExerciceType();
        }
        
        // Gestion enfants
        const tousEnfantsRadio = document.getElementById('tousEnfantsRadio');
        const selectionEnfantsRadio = document.getElementById('selectionEnfantsRadio');
        const enfantsDiv = document.getElementById('enfantsSelectionDiv');
        const pourTousEnfants = document.getElementById('exercice_pour_tous_enfants');
        
        function toggleEnfantsSelection() {
            if (pourTousEnfants && pourTousEnfants.checked) {
                enfantsDiv.style.display = 'none';
                if (selectionEnfantsRadio) selectionEnfantsRadio.checked = false;
                if (tousEnfantsRadio) tousEnfantsRadio.checked = true;
                document.getElementById('predictionsPreview').style.display = 'none';
            } else {
                enfantsDiv.style.display = 'block';
                if (tousEnfantsRadio) tousEnfantsRadio.checked = false;
                if (selectionEnfantsRadio) selectionEnfantsRadio.checked = true;
                loadPredictions();
            }
        }
        
        if (pourTousEnfants) {
            pourTousEnfants.addEventListener('change', toggleEnfantsSelection);
            toggleEnfantsSelection();
        }
        
        if (selectionEnfantsRadio) {
            selectionEnfantsRadio.addEventListener('change', function() {
                if (this.checked && pourTousEnfants) {
                    pourTousEnfants.checked = false;
                    enfantsDiv.style.display = 'block';
                    loadPredictions();
                }
            });
        }
        
        if (tousEnfantsRadio) {
            tousEnfantsRadio.addEventListener('change', function() {
                if (this.checked && pourTousEnfants) {
                    pourTousEnfants.checked = true;
                    enfantsDiv.style.display = 'none';
                    document.getElementById('predictionsPreview').style.display = 'none';
                }
            });
        }
        
        // 🔥 Écouter les changements sur la sélection des enfants
        const enfantsSelect = document.getElementById('exercice_enfantsSelectionnes');
        if (enfantsSelect) {
            enfantsSelect.addEventListener('change', loadPredictions);
        }
        
        // 🔥 Écouter les changements de difficulté
        const difficulteSelect = document.getElementById('exercice_difficulte');
        if (difficulteSelect) {
            difficulteSelect.addEventListener('change', loadPredictions);
        }
        
        // Jours d'assignation
        const dayBtns = document.querySelectorAll('.day-btn');
        dayBtns.forEach(btn => {
            const checkbox = btn.querySelector('.planning-day');
            if(checkbox) {
                checkbox.addEventListener('change', function() {
                    if(this.checked) btn.classList.add('active');
                    else btn.classList.remove('active');
                });
            }
        });
        
        // SOUMISSION DU FORMULAIRE
        const form = document.getElementById('exerciceForm');
        if (form) {
            form.addEventListener('submit', function(e) {
                const type = document.getElementById('exercice_type').value;
                let configJson = {};
                
                if (type === 'CHRONO') {
                    let defis = [];
                    const rows = document.querySelectorAll('#chronoDefisContainer .defi-row');
                    rows.forEach(row => {
                        const inputs = row.querySelectorAll('input');
                        const question = inputs[0]?.value || '';
                        const reponse = inputs[1]?.value || '';
                        const points = parseInt(inputs[2]?.value || 10);
                        if (question.trim()) {
                            defis.push({ question, reponse, points });
                        }
                    });
                    configJson = {
                        dureeTotale: parseInt(document.getElementById('chronoDuree')?.value || 60),
                        defis: defis
                    };
                }
                else if (type === 'ATTENTION') {
                    let questions = [];
                    document.querySelectorAll('#attentionQuestionsContainer .question-row').forEach(row => {
                        let inputs = row.querySelectorAll('input');
                        if (inputs[0] && inputs[0].value) {
                            questions.push({
                                images: inputs[0].value,
                                intrus: inputs[1]?.value || '',
                                reponse: inputs[2]?.value || inputs[1]?.value || ''
                            });
                        }
                    });
                    configJson = {
                        sousType: document.getElementById('attentionSousType')?.value || 'intrus',
                        questions: questions,
                        tempsParQuestion: parseInt(document.getElementById('attentionTemps')?.value || 10)
                    };
                }
                else if (type === 'LOGIQUE') {
                    let sequences = [];
                    document.querySelectorAll('#logiqueSequencesContainer .sequence-row').forEach(row => {
                        let inputs = row.querySelectorAll('input');
                        if (inputs[0] && inputs[0].value) {
                            sequences.push({
                                serie: inputs[0].value,
                                reponse: inputs[1]?.value || '',
                                regle: inputs[2]?.value || ''
                            });
                        }
                    });
                    configJson = {
                        sousType: document.getElementById('logiqueSousType')?.value || 'numerique',
                        sequences: sequences
                    };
                }
                else if (type === 'MÉMOIRE') {
                    configJson = {
                        theme: document.getElementById('memoireTheme')?.value || 'animaux',
                        taille: document.getElementById('memoireTaille')?.value || '4x4',
                        tempsAffichage: parseInt(document.getElementById('memoireTemps')?.value || 3),
                        pointsParPaire: parseInt(document.getElementById('memoirePoints')?.value || 10)
                    };
                }
                
                // Récupérer les jours
                const jours = [];
                document.querySelectorAll('.planning-day:checked').forEach(cb => {
                    jours.push(cb.value);
                });
                
                const joursHidden = document.getElementById('joursHidden');
                if (joursHidden) {
                    joursHidden.value = jours.join(',');
                }
                
                // Mettre à jour le champ caché du JSON
                const contenuField = document.getElementById('contenuJson');
                if (contenuField) {
                    contenuField.value = JSON.stringify(configJson);
                    console.log("✅ JSON envoyé:", contenuField.value);
                }
            });
        }
    });
    
    // ========== GÉNÉRATION IA ==========
    
    const generateBtn = document.getElementById('generateIABtn');
    const iaLoading = document.getElementById('iaLoading');
    if(generateBtn) {
        generateBtn.addEventListener('click', function() {
            const titre = document.getElementById('exercice_titre').value;
            const type = document.getElementById('exercice_type').value;
            if(!titre) { alert('Veuillez saisir un titre d\'abord'); return; }
            generateBtn.disabled = true;
            iaLoading.style.display = 'block';
            fetch('/exercice/api/generer-exercice-ia', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ titre: titre, type: type, nbQuestions: 5 })
            })
            .then(response => response.json())
            .then(data => {
                if(data.success) {
                    if(type === 'ATTENTION' && data.contenu.questions) {
                        const container = document.getElementById('attentionQuestionsContainer');
                        container.innerHTML = '';
                        data.contenu.questions.forEach(q => addAttentionQuestionRow(q.images, q.intrus, q.reponse));
                    } else if(type === 'LOGIQUE' && data.contenu.sequences) {
                        const container = document.getElementById('logiqueSequencesContainer');
                        container.innerHTML = '';
                        data.contenu.sequences.forEach(s => addLogiqueSequenceRow(s.serie, s.reponse, s.regle));
                    } else if(type === 'CHRONO' && data.contenu.defis) {
                        const container = document.getElementById('chronoDefisContainer');
                        container.innerHTML = '';
                        data.contenu.defis.forEach(d => addChronoDefiRow(d.question, d.reponse, d.points));
                    }
                    alert('✅ Exercice généré avec succès !');
                } else { alert('Erreur: ' + (data.error || 'Génération échouée')); }
            })
            .catch(error => { console.error('Erreur:', error); alert('Erreur lors de la génération IA'); })
            .finally(() => { generateBtn.disabled = false; iaLoading.style.display = 'none'; });
        });
    }
</script>
{% endblock %}