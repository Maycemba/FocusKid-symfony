{% extends 'base-back.html.twig' %}

{% block title %}Modifier l'exercice - FocusKids{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .config-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
            border: 1px solid #e0e0e0;
        }
        .question-row, .sequence-row, .defi-row {
            background: white;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #e0e0e0;
        }
        .badge-type {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }
        .badge-memoire { background: #9C27B0; color: white; }
        .badge-attention { background: #2196F3; color: white; }
        .badge-logique { background: #FF9800; color: white; }
        .badge-chrono { background: #F44336; color: white; }
        .type-config {
            display: none;
        }
        .type-config.active {
            display: block;
        }
        .error-message {
            color: #e74c3c;
            font-size: 12px;
            margin-top: 5px;
        }
        .is-invalid {
            border-color: #e74c3c !important;
        }
        .alert-error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 20px;
        }
        .form-control.is-invalid, .form-select.is-invalid {
            border-color: #e74c3c;
            background-image: none;
        }
        .day-btn {
            min-width: 50px;
            transition: all 0.3s;
        }
        .day-btn.active {
            background-color: #FF9800 !important;
            border-color: #FF9800 !important;
            color: white !important;
        }
        .form-label {
            font-weight: 600;
            margin-bottom: 8px;
        }
        .form-field {
            border-radius: 10px;
            padding: 10px 15px;
        }
        .switch-small {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 24px;
            margin-left: 10px;
        }
        .switch-small input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        .switch-small .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: .3s;
            border-radius: 24px;
        }
        .switch-small .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .3s;
            border-radius: 50%;
        }
        .switch-small input:checked + .slider {
            background-color: #f44336;
        }
        .switch-small input:checked + .slider:before {
            transform: translateX(26px);
        }
        .switch-label {
            display: inline-flex;
            align-items: center;
        }
        .btn-ia {
            background: linear-gradient(135deg, #9C27B0, #E1BEE7);
            color: white;
            border: none;
            border-radius: 25px;
            padding: 10px 25px;
            font-weight: bold;
            transition: all 0.3s;
            margin-bottom: 15px;
        }
        .btn-ia:hover {
            transform: scale(1.02);
            box-shadow: 0 4px 15px rgba(156, 39, 176, 0.4);
        }
        .ia-loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid #9C27B0;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-left: 10px;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="card-title text-white mb-0">
                            <i class="ti ti-edit"></i> Modifier l'exercice
                        </h4>
                        <small class="text-white-50">Modifiez les informations de l'exercice</small>
                    </div>
                    <a href="{{ path('app_exercice_index') }}" class="btn btn-light">
                        <i class="ti ti-arrow-left"></i> Retour
                    </a>
                </div>
            </div>
            <div class="card-body">
                {% if form_errors(form) %}
                    <div class="alert-error">
                        <strong><i class="ti ti-alert-circle"></i> Veuillez corriger les erreurs suivantes :</strong>
                        {{ form_errors(form) }}
                    </div>
                {% endif %}

                {{ form_start(form, {'attr': {'id': 'exerciceForm', 'novalidate': 'novalidate'}}) }}
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.titre, '📝 Titre', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.titre, {'attr': {'class': 'form-control form-field', 'id': 'exercice_titre'}}) }}
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            {{ form_label(form.type, '🎯 Type', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.type, {'attr': {'class': 'form-select form-field', 'id': 'exercice_type'}}) }}
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            {{ form_label(form.difficulte, '⭐ Difficulté', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.difficulte, {'attr': {'class': 'form-select form-field'}}) }}
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            {{ form_label(form.consigne, '📖 Consigne', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.consigne, {'attr': {'class': 'form-control form-field', 'rows': 3}}) }}
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            {{ form_label(form.duree, '⏱️ Durée (secondes)', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.duree, {'attr': {'class': 'form-control form-field'}}) }}
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            <div class="form-check form-switch mt-4">
                                {{ form_widget(form.actif, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(form.actif, '✅ Actif', {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            <div class="switch-label mt-4">
                                <span>📦 Archivé</span>
                                <label class="switch-small">
                                    {{ form_widget(form.archive, {'attr': {'class': 'form-check-input'}}) }}
                                    <span class="slider"></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mt-3 mb-2">
                        <div class="col-12">
                            <button type="button" id="generateIABtn" class="btn-ia">
                                <i class="ti ti-brain"></i> 🤖 Régénérer avec IA
                            </button>
                            <span id="iaLoading" style="display: none; margin-left: 15px;">
                                <span class="ia-loading"></span> Génération en cours...
                            </span>
                        </div>
                    </div>
                    
                    <div class="config-section">
                        <h5 class="mb-3">
                            <i class="ti ti-settings"></i> ⚙️ Configuration de l'exercice
                            <span id="typeBadge" class="badge-type badge-memoire ms-2">{{ exercice.type }}</span>
                        </h5>
                        
                        <div id="configMemoire" class="type-config">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">🎨 Thème</label>
                                    <select id="memoireTheme" class="form-select form-field">
                                        <option value="animaux">Animaux 🐶🐱🐭</option>
                                        <option value="fruits">Fruits 🍎🍊🍌</option>
                                        <option value="chiffres">Chiffres 1️⃣2️⃣3️⃣</option>
                                        <option value="formes">Formes ⬛🟢🔺</option>
                                    </select>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">📏 Taille grille</label>
                                    <select id="memoireTaille" class="form-select form-field">
                                        <option value="4x4">4x4</option>
                                        <option value="6x6">6x6</option>
                                    </select>
                                </div>
                                <div class="col-md-2 mb-3">
                                    <label class="form-label">⏱️ Temps (s)</label>
                                    <input type="number" id="memoireTemps" class="form-control form-field" value="3">
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">⭐ Points/paire</label>
                                    <input type="number" id="memoirePoints" class="form-control form-field" value="10">
                                </div>
                            </div>
                        </div>
                        
                        <div id="configAttention" class="type-config">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">🎯 Type</label>
                                    <select id="attentionSousType" class="form-select form-field">
                                        <option value="intrus">Trouver l'intrus</option>
                                        <option value="differences">Trouver les différences</option>
                                    </select>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">⏱️ Temps/question</label>
                                    <input type="number" id="attentionTemps" class="form-control form-field" value="10">
                                </div>
                            </div>
                            <div class="mt-3">
                                <label class="form-label">📝 Questions</label>
                                <div id="attentionQuestionsContainer"></div>
                                <button type="button" class="btn btn-sm btn-primary mt-2" onclick="addAttentionQuestionRow()">
                                    <i class="ti ti-plus"></i> Ajouter question
                                </button>
                            </div>
                        </div>
                        
                        <div id="configLogique" class="type-config">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">🧠 Type</label>
                                    <select id="logiqueSousType" class="form-select form-field">
                                        <option value="numerique">Suite numérique</option>
                                        <option value="visuelle">Suite visuelle</option>
                                    </select>
                                </div>
                            </div>
                            <div class="mt-3">
                                <label class="form-label">📝 Séquences</label>
                                <div id="logiqueSequencesContainer"></div>
                                <button type="button" class="btn btn-sm btn-primary mt-2" onclick="addLogiqueSequenceRow()">
                                    <i class="ti ti-plus"></i> Ajouter séquence
                                </button>
                            </div>
                        </div>
                        
                        <div id="configChrono" class="type-config">
                            <div class="row">
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">⏱️ Durée totale</label>
                                    <input type="number" id="chronoDuree" class="form-control form-field" value="60">
                                </div>
                            </div>
                            <div class="mt-3">
                                <label class="form-label">📝 Défis</label>
                                <div id="chronoDefisContainer"></div>
                                <button type="button" class="btn btn-sm btn-primary mt-2" onclick="addChronoDefiRow()">
                                    <i class="ti ti-plus"></i> Ajouter défi
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <div class="config-section mt-3">
                        <h5 class="mb-3"><i class="ti ti-users"></i> 👶 Enfants concernés</h5>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-check mb-2">
                                    {{ form_widget(form.pour_tous_enfants, {'attr': {'class': 'form-check-input', 'id': 'tousEnfantsRadio'}}) }}
                                    <label class="form-check-label" for="tousEnfantsRadio">👥 Tous les enfants</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input type="radio" id="selectionEnfantsRadio" name="enfantsGroup" class="form-check-input">
                                    <label class="form-check-label" for="selectionEnfantsRadio">🎯 Choisir des enfants spécifiques</label>
                                </div>
                                <div id="enfantsSelectionDiv" style="display: none; margin-top: 15px;">
                                    {{ form_label(form.enfantsSelectionnes, 'Sélectionnez les enfants', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.enfantsSelectionnes, {'attr': {'class': 'form-select form-field', 'size': 5}}) }}
                                    <small class="text-muted">Maintenez Ctrl (ou Cmd) pour sélectionner plusieurs enfants</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="config-section mt-3">
                        <h5 class="mb-3"><i class="ti ti-calendar"></i> 📅 Jours d'assignation</h5>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="btn-group flex-wrap" role="group">
                                    <label class="btn btn-outline-secondary day-btn"><input type="checkbox" value="Lundi" class="btn-check planning-day"> L</label>
                                    <label class="btn btn-outline-secondary day-btn"><input type="checkbox" value="Mardi" class="btn-check planning-day"> M</label>
                                    <label class="btn btn-outline-secondary day-btn"><input type="checkbox" value="Mercredi" class="btn-check planning-day"> M</label>
                                    <label class="btn btn-outline-secondary day-btn"><input type="checkbox" value="Jeudi" class="btn-check planning-day"> J</label>
                                    <label class="btn btn-outline-secondary day-btn"><input type="checkbox" value="Vendredi" class="btn-check planning-day"> V</label>
                                    <label class="btn btn-outline-secondary day-btn"><input type="checkbox" value="Samedi" class="btn-check planning-day"> S</label>
                                    <label class="btn btn-outline-secondary day-btn"><input type="checkbox" value="Dimanche" class="btn-check planning-day"> D</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <input type="hidden" id="contenuJson" name="exercice[contenu]" value="{{ exercice.contenu|default('{}') }}">
                    
                    <div class="row mt-4">
                        <div class="col-12 text-center">
                            <button type="submit" class="btn btn-primary px-5">
                                <i class="ti ti-device-floppy"></i> Mettre à jour
                            </button>
                            <a href="{{ path('app_exercice_index') }}" class="btn btn-secondary px-5 ms-2">
                                <i class="ti ti-x"></i> Annuler
                            </a>
                            <button type="button" class="btn btn-danger px-5 ms-2" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                <i class="ti ti-trash"></i> Supprimer
                            </button>
                        </div>
                    </div>
                    
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Voulez-vous vraiment supprimer l'exercice <strong>{{ exercice.titre }}</strong> ?</p>
                <p class="text-muted small">Cette action est irréversible.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                {{ include('exercice/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>

<script>
    function addAttentionQuestionRow(images = '', intrus = '', reponse = '') {
        const container = document.getElementById('attentionQuestionsContainer');
        if(!container) return;
        const div = document.createElement('div');
        div.className = 'question-row row mb-2';
        div.innerHTML = `
            <div class="col-md-5"><input type="text" class="form-control" placeholder="Images (ex: 🐶,🐱,🐭)" value="${escapeHtml(images)}"></div>
            <div class="col-md-4"><input type="text" class="form-control" placeholder="Intrus" value="${escapeHtml(intrus)}"></div>
            <div class="col-md-2"><input type="text" class="form-control" placeholder="Réponse" value="${escapeHtml(reponse)}"></div>
            <div class="col-md-1"><button type="button" class="btn btn-danger btn-sm" onclick="this.closest('.question-row').remove()">🗑️</button></div>
        `;
        container.appendChild(div);
    }
    
    function addLogiqueSequenceRow(serie = '', reponse = '', regle = '') {
        const container = document.getElementById('logiqueSequencesContainer');
        if(!container) return;
        const div = document.createElement('div');
        div.className = 'sequence-row row mb-2';
        div.innerHTML = `
            <div class="col-md-5"><input type="text" class="form-control" placeholder="Série (ex: 2,4,6,8,?)" value="${escapeHtml(serie)}"></div>
            <div class="col-md-4"><input type="text" class="form-control" placeholder="Réponse" value="${escapeHtml(reponse)}"></div>
            <div class="col-md-2"><input type="text" class="form-control" placeholder="Règle" value="${escapeHtml(regle)}"></div>
            <div class="col-md-1"><button type="button" class="btn btn-danger btn-sm" onclick="this.closest('.sequence-row').remove()">🗑️</button></div>
        `;
        container.appendChild(div);
    }
    
    function addChronoDefiRow(question = '', reponse = '', points = 10) {
        const container = document.getElementById('chronoDefisContainer');
        if(!container) return;
        const div = document.createElement('div');
        div.className = 'defi-row row mb-2';
        div.innerHTML = `
            <div class="col-md-6"><input type="text" class="form-control" placeholder="Question" value="${escapeHtml(question)}"></div>
            <div class="col-md-4"><input type="text" class="form-control" placeholder="Réponse" value="${escapeHtml(reponse)}"></div>
            <div class="col-md-1"><input type="number" class="form-control" placeholder="Points" value="${points}"></div>
            <div class="col-md-1"><button type="button" class="btn btn-danger btn-sm" onclick="this.closest('.defi-row').remove()">🗑️</button></div>
        `;
        container.appendChild(div);
    }
    
    function escapeHtml(str) {
        if(!str) return '';
        return str.replace(/[&<>]/g, function(m) {
            if(m === '&') return '&amp;';
            if(m === '<') return '&lt;';
            if(m === '>') return '&gt;';
            return m;
        });
    }
    
    function changeExerciceType() {
        const typeSelect = document.getElementById('exercice_type');
        const typeBadge = document.getElementById('typeBadge');
        const configs = ['configMemoire', 'configAttention', 'configLogique', 'configChrono'];
        
        configs.forEach(c => { 
            const el = document.getElementById(c); 
            if(el) el.classList.remove('active'); 
        });
        
        const selectedType = typeSelect.value;
        const badgeClass = {
            'MÉMOIRE': 'badge-memoire',
            'ATTENTION': 'badge-attention',
            'LOGIQUE': 'badge-logique',
            'CHRONO': 'badge-chrono'
        };
        
        typeBadge.textContent = selectedType;
        typeBadge.className = 'badge-type ms-2 ' + (badgeClass[selectedType] || 'badge-memoire');
        
        const configId = {
            'MÉMOIRE': 'configMemoire',
            'ATTENTION': 'configAttention',
            'LOGIQUE': 'configLogique',
            'CHRONO': 'configChrono'
        }[selectedType];
        
        if(configId) document.getElementById(configId).classList.add('active');
    }
    
    function showCurrentConfig() {
        const currentType = document.getElementById('exercice_type').value;
        const configId = {
            'MÉMOIRE': 'configMemoire',
            'ATTENTION': 'configAttention',
            'LOGIQUE': 'configLogique',
            'CHRONO': 'configChrono'
        }[currentType];
        
        // Cacher toutes les configs
        const configs = ['configMemoire', 'configAttention', 'configLogique', 'configChrono'];
        configs.forEach(c => { 
            const el = document.getElementById(c); 
            if(el) el.classList.remove('active'); 
        });
        
        // Afficher la bonne config
        if(configId) {
            const el = document.getElementById(configId);
            if(el) {
                el.classList.add('active');
                console.log("✅ Configuration affichée:", configId);
            }
        }
    }
    
    function loadExistingConfiguration() {
        const contenuJson = document.getElementById('contenuJson');
        if(!contenuJson || !contenuJson.value || contenuJson.value === '{}') {
            showCurrentConfig();
            return;
        }
        
        try {
            const config = JSON.parse(contenuJson.value);
            const type = document.getElementById('exercice_type').value;
            
            if(type === 'MÉMOIRE') {
                if(config.theme) document.getElementById('memoireTheme').value = config.theme;
                if(config.taille) document.getElementById('memoireTaille').value = config.taille;
                if(config.tempsAffichage) document.getElementById('memoireTemps').value = config.tempsAffichage;
                if(config.pointsParPaire) document.getElementById('memoirePoints').value = config.pointsParPaire;
            }
            else if(type === 'ATTENTION') {
                if(config.sousType) document.getElementById('attentionSousType').value = config.sousType;
                if(config.tempsParQuestion) document.getElementById('attentionTemps').value = config.tempsParQuestion;
                
                const container = document.getElementById('attentionQuestionsContainer');
                if(container && config.questions && config.questions.length > 0) {
                    container.innerHTML = '';
                    config.questions.forEach(q => {
                        addAttentionQuestionRow(q.images || '', q.intrus || '', q.reponse || '');
                    });
                }
            }
            else if(type === 'LOGIQUE') {
                if(config.sousType) document.getElementById('logiqueSousType').value = config.sousType;
                
                const container = document.getElementById('logiqueSequencesContainer');
                if(container && config.sequences && config.sequences.length > 0) {
                    container.innerHTML = '';
                    config.sequences.forEach(seq => {
                        addLogiqueSequenceRow(seq.serie || seq.debut || '', seq.reponse || '', seq.regle || '');
                    });
                }
            }
            else if(type === 'CHRONO') {
                if(config.dureeTotale) document.getElementById('chronoDuree').value = config.dureeTotale;
                
                const container = document.getElementById('chronoDefisContainer');
                if(container && config.defis && config.defis.length > 0) {
                    container.innerHTML = '';
                    config.defis.forEach(defi => {
                        addChronoDefiRow(defi.question || '', defi.reponse || '', defi.points || 10);
                    });
                }
            }
            
            if(config.jours && config.jours.length > 0) {
                document.querySelectorAll('.planning-day').forEach(cb => {
                    cb.checked = config.jours.includes(cb.value);
                });
                document.querySelectorAll('.day-btn').forEach(btn => {
                    const cb = btn.querySelector('.planning-day');
                    if(cb && cb.checked) btn.classList.add('active');
                });
            }
            
            showCurrentConfig();
            
        } catch(e) {
            console.error('Erreur chargement configuration:', e);
            showCurrentConfig();
        }
    }
    
    function remplirConfigurationIA(type, config) {
        if (type === 'MÉMOIRE') {
            if(config.theme) document.getElementById('memoireTheme').value = config.theme;
            if(config.taille) document.getElementById('memoireTaille').value = config.taille;
            if(config.tempsAffichage) document.getElementById('memoireTemps').value = config.tempsAffichage;
            if(config.pointsParPaire) document.getElementById('memoirePoints').value = config.pointsParPaire;
        }
        else if (type === 'ATTENTION') {
            if(config.sousType) document.getElementById('attentionSousType').value = config.sousType;
            if(config.tempsParQuestion) document.getElementById('attentionTemps').value = config.tempsParQuestion;
            if(config.questions && config.questions.length > 0) {
                const container = document.getElementById('attentionQuestionsContainer');
                container.innerHTML = '';
                config.questions.forEach(q => addAttentionQuestionRow(q.images || '', q.intrus || '', ''));
            }
        }
        else if (type === 'LOGIQUE') {
            if(config.sousType) document.getElementById('logiqueSousType').value = config.sousType;
            if(config.sequences && config.sequences.length > 0) {
                const container = document.getElementById('logiqueSequencesContainer');
                container.innerHTML = '';
                config.sequences.forEach(seq => addLogiqueSequenceRow(seq.debut || '', seq.reponse || '', seq.regle || ''));
            }
        }
        else if (type === 'CHRONO') {
            if(config.dureeTotale) document.getElementById('chronoDuree').value = config.dureeTotale;
            if(config.defis && config.defis.length > 0) {
                const container = document.getElementById('chronoDefisContainer');
                container.innerHTML = '';
                config.defis.forEach(defi => addChronoDefiRow(defi.question || '', defi.reponse || '', defi.points || 10));
            }
        }
        showCurrentConfig();
    }
    
    // Fonction d'initialisation principale
    function initEditPage() {
        console.log("🚀 Initialisation page édition");
        
        const typeSelect = document.getElementById('exercice_type');
        if(typeSelect) {
            typeSelect.addEventListener('change', function() {
                changeExerciceType();
            });
        }
        
        // Charger la configuration
        loadExistingConfiguration();
        
        // Mettre à jour le badge
        const currentType = document.getElementById('exercice_type').value;
        const typeBadge = document.getElementById('typeBadge');
        const badgeClass = {
            'MÉMOIRE': 'badge-memoire',
            'ATTENTION': 'badge-attention',
            'LOGIQUE': 'badge-logique',
            'CHRONO': 'badge-chrono'
        };
        typeBadge.textContent = currentType;
        typeBadge.className = 'badge-type ms-2 ' + (badgeClass[currentType] || 'badge-memoire');
        
        // Gestion enfants
        const tousEnfantsRadio = document.getElementById('tousEnfantsRadio');
        const selectionEnfantsRadio = document.getElementById('selectionEnfantsRadio');
        const enfantsDiv = document.getElementById('enfantsSelectionDiv');
        const pourTousEnfants = document.getElementById('exercice_pour_tous_enfants');
        
        function toggleEnfantsSelection() {
            if (pourTousEnfants && pourTousEnfants.checked) {
                enfantsDiv.style.display = 'none';
                if (selectionEnfantsRadio) selectionEnfantsRadio.checked = false;
                if (tousEnfantsRadio) tousEnfantsRadio.checked = true;
            } else {
                enfantsDiv.style.display = 'block';
                if (tousEnfantsRadio) tousEnfantsRadio.checked = false;
                if (selectionEnfantsRadio) selectionEnfantsRadio.checked = true;
            }
        }
        
        if (pourTousEnfants) {
            pourTousEnfants.addEventListener('change', toggleEnfantsSelection);
            toggleEnfantsSelection();
        }
        if (selectionEnfantsRadio) {
            selectionEnfantsRadio.addEventListener('change', function() {
                if (this.checked && pourTousEnfants) {
                    pourTousEnfants.checked = false;
                    enfantsDiv.style.display = 'block';
                }
            });
        }
        if (tousEnfantsRadio) {
            tousEnfantsRadio.addEventListener('change', function() {
                if (this.checked && pourTousEnfants) {
                    pourTousEnfants.checked = true;
                    enfantsDiv.style.display = 'none';
                }
            });
        }
        
        // Jours d'assignation
        const dayBtns = document.querySelectorAll('.day-btn');
        dayBtns.forEach(btn => {
            const checkbox = btn.querySelector('.planning-day');
            if (checkbox) {
                checkbox.addEventListener('change', function() {
                    if (this.checked) btn.classList.add('active');
                    else btn.classList.remove('active');
                });
            }
        });
        
        // Génération IA
        const generateBtn = document.getElementById('generateIABtn');
        const iaLoading = document.getElementById('iaLoading');
        
        if (generateBtn) {
            generateBtn.addEventListener('click', function() {
                const titre = document.getElementById('exercice_titre').value;
                const type = document.getElementById('exercice_type').value;
                if (!titre) { alert('Veuillez saisir un titre d\'abord'); return; }
                
                generateBtn.disabled = true;
                generateBtn.style.opacity = '0.6';
                iaLoading.style.display = 'inline-block';
                
                fetch('/exercice/api/generer-exercice-ia', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ titre: titre, type: type, nbQuestions: 5 })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        remplirConfigurationIA(type, data.contenu);
                        alert('✅ Configuration régénérée avec succès !');
                    } else {
                        alert('Erreur: ' + (data.error || 'Génération échouée'));
                    }
                })
                .catch(error => { console.error('Erreur:', error); alert('Erreur lors de la génération IA'); })
                .finally(() => {
                    generateBtn.disabled = false;
                    generateBtn.style.opacity = '1';
                    iaLoading.style.display = 'none';
                });
            });
        }
        
        // Soumission du formulaire
        const form = document.getElementById('exerciceForm');
        if(form) {
            form.addEventListener('submit', function(e) {
                const type = document.getElementById('exercice_type').value;
                let configJson = {};
                
                if(type === 'MÉMOIRE') {
                    configJson = {
                        theme: document.getElementById('memoireTheme')?.value || 'animaux',
                        taille: document.getElementById('memoireTaille')?.value || '4x4',
                        tempsAffichage: parseInt(document.getElementById('memoireTemps')?.value || 3),
                        pointsParPaire: parseInt(document.getElementById('memoirePoints')?.value || 10)
                    };
                } 
                else if(type === 'ATTENTION') {
                    let questions = [];
                    document.querySelectorAll('#attentionQuestionsContainer .question-row').forEach(row => {
                        let inputs = row.querySelectorAll('input');
                        if(inputs[0] && inputs[0].value) {
                            questions.push({
                                images: inputs[0].value,
                                intrus: inputs[1]?.value || '',
                                reponse: inputs[2]?.value || inputs[1]?.value || ''
                            });
                        }
                    });
                    configJson = {
                        sousType: document.getElementById('attentionSousType')?.value || 'intrus',
                        questions: questions,
                        tempsParQuestion: parseInt(document.getElementById('attentionTemps')?.value || 10)
                    };
                } 
                else if(type === 'LOGIQUE') {
                    let sequences = [];
                    document.querySelectorAll('#logiqueSequencesContainer .sequence-row').forEach(row => {
                        let inputs = row.querySelectorAll('input');
                        if(inputs[0] && inputs[0].value) {
                            sequences.push({
                                serie: inputs[0].value,
                                reponse: inputs[1]?.value || '',
                                regle: inputs[2]?.value || ''
                            });
                        }
                    });
                    configJson = {
                        sousType: document.getElementById('logiqueSousType')?.value || 'numerique',
                        sequences: sequences
                    };
                } 
                else if(type === 'CHRONO') {
                    let defis = [];
                    document.querySelectorAll('#chronoDefisContainer .defi-row').forEach(row => {
                        let inputs = row.querySelectorAll('input');
                        if(inputs[0] && inputs[0].value) {
                            defis.push({
                                question: inputs[0].value,
                                reponse: inputs[1]?.value || '',
                                points: parseInt(inputs[2]?.value || 10)
                            });
                        }
                    });
                    configJson = {
                        dureeTotale: parseInt(document.getElementById('chronoDuree')?.value || 60),
                        defis: defis
                    };
                }
                
                const jours = [];
                document.querySelectorAll('.planning-day:checked').forEach(cb => {
                    jours.push(cb.value);
                });
                if(jours.length > 0) {
                    configJson.jours = jours;
                }
                
                document.getElementById('contenuJson').value = JSON.stringify(configJson);
                console.log('JSON sauvegardé:', configJson);
            });
        }
    }
    
    // Exécuter quand le DOM est prêt
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initEditPage);
    } else {
        // DOM déjà chargé, exécuter directement
        initEditPage();
    }
    
    // Forcer un dernier affichage après 500ms (sécurité)
    setTimeout(function() {
        if (document.getElementById('exercice_type')) {
            showCurrentConfig();
            console.log("🔁 Rafraîchissement sécurité de la configuration");
        }
    }, 500);
</script>
{% endblock %}