{% extends 'base-back.html.twig' %}

{% block title %}Modifier l'exercice - FocusKids{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .config-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-top: 20px;
            border: 1px solid #e0e0e0;
        }
        .question-row, .sequence-row, .defi-row {
            background: white;
            border-radius: 8px;
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #e0e0e0;
        }
        .badge-type {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }
        .badge-memoire { background: #9C27B0; color: white; }
        .badge-attention { background: #2196F3; color: white; }
        .badge-logique { background: #FF9800; color: white; }
        .badge-chrono { background: #F44336; color: white; }
        .type-config {
            display: none;
        }
        .type-config.active {
            display: block;
        }
        .card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
    </style>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header text-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="card-title text-white mb-0">
                            <i class="ti ti-edit"></i> Modifier l'exercice
                        </h4>
                        <small class="text-white-50">Modifiez les informations de l'exercice</small>
                    </div>
                    <a href="{{ path('app_exercice_index') }}" class="btn btn-light">
                        <i class="ti ti-arrow-left"></i> Retour à la liste
                    </a>
                </div>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'id': 'exerciceForm'}}) }}
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.titre) }}
                            {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Exercice de mémoire - Les animaux'}}) }}
                            {{ form_errors(form.titre) }}
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            {{ form_label(form.type) }}
                            {{ form_widget(form.type, {'attr': {'class': 'form-select', 'id': 'exercice_type'}}) }}
                            {{ form_errors(form.type) }}
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            {{ form_label(form.difficulte) }}
                            {{ form_widget(form.difficulte, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.difficulte) }}
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            {{ form_label(form.consigne) }}
                            {{ form_widget(form.consigne, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                            {{ form_errors(form.consigne) }}
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            {{ form_label(form.duree) }}
                            {{ form_widget(form.duree, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.duree) }}
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            <div class="form-check form-switch mt-4">
                                {{ form_widget(form.pour_tous_enfants, {'attr': {'class': 'form-check-input', 'id': 'pourTousEnfants'}}) }}
                                {{ form_label(form.pour_tous_enfants, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            <div class="form-check form-switch mt-4">
                                {{ form_widget(form.actif, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(form.actif, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                        </div>
                        
                        <div class="col-md-3 mb-3">
                            <div class="form-check form-switch mt-4">
                                {{ form_widget(form.archive, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(form.archive, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                        </div>
                    </div>
                    
                    <!-- Section Configuration -->
                    <div class="config-section">
                        <h5 class="mb-3">
                            <i class="ti ti-settings"></i> Configuration de l'exercice
                            <span id="typeBadge" class="badge-type badge-memoire ms-2">{{ exercice.type }}</span>
                        </h5>
                        
                        <!-- CONFIGURATION MÉMOIRE -->
                        <div id="configMemoire" class="type-config">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold">🎨 Thème</label>
                                    <select class="form-select" id="memoireTheme">
                                        <option value="animaux">Animaux 🐶🐱🐭</option>
                                        <option value="fruits">Fruits 🍎🍊🍌</option>
                                        <option value="chiffres">Chiffres 1️⃣2️⃣3️⃣</option>
                                        <option value="formes">Formes ⬛🟢🔺</option>
                                    </select>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label fw-semibold">📏 Taille grille</label>
                                    <select class="form-select" id="memoireTaille">
                                        <option value="4x4">4x4</option>
                                        <option value="6x6">6x6</option>
                                    </select>
                                </div>
                                <div class="col-md-2 mb-3">
                                    <label class="form-label fw-semibold">⏱️ Temps (s)</label>
                                    <input type="number" class="form-control" id="memoireTemps" value="3">
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label fw-semibold">⭐ Points/paire</label>
                                    <input type="number" class="form-control" id="memoirePoints" value="10">
                                </div>
                            </div>
                        </div>
                        
                        <!-- CONFIGURATION ATTENTION -->
                        <div id="configAttention" class="type-config">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold">🎯 Type</label>
                                    <select class="form-select" id="attentionSousType">
                                        <option value="intrus">Trouver l'intrus</option>
                                        <option value="differences">Trouver les différences</option>
                                    </select>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label fw-semibold">⏱️ Temps/question</label>
                                    <input type="number" class="form-control" id="attentionTemps" value="10">
                                </div>
                            </div>
                            <div class="mt-3">
                                <label class="form-label fw-semibold">📝 Questions</label>
                                <div id="attentionQuestionsContainer"></div>
                                <button type="button" class="btn btn-sm btn-primary mt-2" onclick="addAttentionQuestionRow()">
                                    <i class="ti ti-plus"></i> Ajouter question
                                </button>
                            </div>
                        </div>
                        
                        <!-- CONFIGURATION LOGIQUE -->
                        <div id="configLogique" class="type-config">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold">🧠 Type</label>
                                    <select class="form-select" id="logiqueSousType">
                                        <option value="numerique">Suite numérique</option>
                                        <option value="visuelle">Suite visuelle</option>
                                    </select>
                                </div>
                            </div>
                            <div class="mt-3">
                                <label class="form-label fw-semibold">📝 Séquences</label>
                                <div id="logiqueSequencesContainer"></div>
                                <button type="button" class="btn btn-sm btn-primary mt-2" onclick="addLogiqueSequenceRow()">
                                    <i class="ti ti-plus"></i> Ajouter séquence
                                </button>
                            </div>
                        </div>
                        
                        <!-- CONFIGURATION CHRONO -->
                        <div id="configChrono" class="type-config">
                            <div class="row">
                                <div class="col-md-3 mb-3">
                                    <label class="form-label fw-semibold">⏱️ Durée totale</label>
                                    <input type="number" class="form-control" id="chronoDuree" value="60">
                                </div>
                            </div>
                            <div class="mt-3">
                                <label class="form-label fw-semibold">📝 Défis</label>
                                <div id="chronoDefisContainer"></div>
                                <button type="button" class="btn btn-sm btn-primary mt-2" onclick="addChronoDefiRow()">
                                    <i class="ti ti-plus"></i> Ajouter défi
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Planification jours -->
                    <div class="config-section mt-3">
                        <h5 class="mb-3"><i class="ti ti-calendar"></i> Jours de la semaine</h5>
                        <div class="row">
                            <div class="col-md-12">
                                <label class="btn btn-outline-secondary me-2 mb-2">
                                    <input type="checkbox" value="Lundi" class="planning-day"> Lundi
                                </label>
                                <label class="btn btn-outline-secondary me-2 mb-2">
                                    <input type="checkbox" value="Mardi" class="planning-day"> Mardi
                                </label>
                                <label class="btn btn-outline-secondary me-2 mb-2">
                                    <input type="checkbox" value="Mercredi" class="planning-day"> Mercredi
                                </label>
                                <label class="btn btn-outline-secondary me-2 mb-2">
                                    <input type="checkbox" value="Jeudi" class="planning-day"> Jeudi
                                </label>
                                <label class="btn btn-outline-secondary me-2 mb-2">
                                    <input type="checkbox" value="Vendredi" class="planning-day"> Vendredi
                                </label>
                                <label class="btn btn-outline-secondary me-2 mb-2">
                                    <input type="checkbox" value="Samedi" class="planning-day"> Samedi
                                </label>
                                <label class="btn btn-outline-secondary me-2 mb-2">
                                    <input type="checkbox" value="Dimanche" class="planning-day"> Dimanche
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    {{ form_widget(form.contenu, {'attr': {'id': 'contenuJson'}}) }}
                    {{ form_widget(form.cree_par) }}
                    {{ form_widget(form.date_creation) }}
                    {{ form_widget(form.complete) }}
                    
                    <div class="row mt-4">
                        <div class="col-12 text-center">
                            <button type="submit" class="btn btn-primary px-5">
                                <i class="ti ti-device-floppy"></i> Mettre à jour
                            </button>
                            <a href="{{ path('app_exercice_index') }}" class="btn btn-secondary px-5 ms-2">
                                <i class="ti ti-x"></i> Annuler
                            </a>
                            <button type="button" class="btn btn-danger px-5 ms-2" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                <i class="ti ti-trash"></i> Supprimer
                            </button>
                        </div>
                    </div>
                    
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<!-- Modal Suppression -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Voulez-vous vraiment supprimer l'exercice <strong>{{ exercice.titre }}</strong> ?</p>
                <p class="text-muted small">Cette action est irréversible.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                {{ include('exercice/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>

<script>
    // Fonctions pour ajouter des lignes
    function addAttentionQuestionRow(images = '', intrus = '', reponse = '') {
        const container = document.getElementById('attentionQuestionsContainer');
        if(!container) return;
        
        const div = document.createElement('div');
        div.className = 'question-row row mb-2';
        div.innerHTML = `
            <div class="col-md-5">
                <input type="text" class="form-control" placeholder="Images (ex: 🐶,🐱,🐭)" value="${escapeHtml(images)}">
            </div>
            <div class="col-md-4">
                <input type="text" class="form-control" placeholder="Intrus" value="${escapeHtml(intrus)}">
            </div>
            <div class="col-md-2">
                <input type="text" class="form-control" placeholder="Réponse" value="${escapeHtml(reponse)}">
            </div>
            <div class="col-md-1">
                <button type="button" class="btn btn-danger btn-sm" onclick="this.closest('.question-row').remove()">🗑️</button>
            </div>
        `;
        container.appendChild(div);
    }
    
    function addLogiqueSequenceRow(serie = '', reponse = '', regle = '') {
        const container = document.getElementById('logiqueSequencesContainer');
        if(!container) return;
        
        const div = document.createElement('div');
        div.className = 'sequence-row row mb-2';
        div.innerHTML = `
            <div class="col-md-5">
                <input type="text" class="form-control" placeholder="Série (ex: 2,4,6,8,?)" value="${escapeHtml(serie)}">
            </div>
            <div class="col-md-4">
                <input type="text" class="form-control" placeholder="Réponse" value="${escapeHtml(reponse)}">
            </div>
            <div class="col-md-2">
                <input type="text" class="form-control" placeholder="Règle" value="${escapeHtml(regle)}">
            </div>
            <div class="col-md-1">
                <button type="button" class="btn btn-danger btn-sm" onclick="this.closest('.sequence-row').remove()">🗑️</button>
            </div>
        `;
        container.appendChild(div);
    }
    
    function addChronoDefiRow(question = '', reponse = '', points = 10) {
        const container = document.getElementById('chronoDefisContainer');
        if(!container) return;
        
        const div = document.createElement('div');
        div.className = 'defi-row row mb-2';
        div.innerHTML = `
            <div class="col-md-6">
                <input type="text" class="form-control" placeholder="Question" value="${escapeHtml(question)}">
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control" placeholder="Réponse" value="${escapeHtml(reponse)}">
            </div>
            <div class="col-md-2">
                <input type="number" class="form-control" placeholder="Points" value="${points}">
            </div>
            <div class="col-md-1">
                <button type="button" class="btn btn-danger btn-sm" onclick="this.closest('.defi-row').remove()">🗑️</button>
            </div>
        `;
        container.appendChild(div);
    }
    
    function escapeHtml(str) {
        if(!str) return '';
        return str.replace(/[&<>]/g, function(m) {
            if(m === '&') return '&amp;';
            if(m === '<') return '&lt;';
            if(m === '>') return '&gt;';
            return m;
        }).replace(/[\uD800-\uDBFF][\uDC00-\uDFFF]/g, function(c) {
            return c;
        });
    }
    
    // Changer la configuration selon le type
    function changeExerciceType() {
        const typeSelect = document.getElementById('exercice_type');
        const typeBadge = document.getElementById('typeBadge');
        const configMemoire = document.getElementById('configMemoire');
        const configAttention = document.getElementById('configAttention');
        const configLogique = document.getElementById('configLogique');
        const configChrono = document.getElementById('configChrono');
        
        if(!typeSelect) return;
        
        const selectedType = typeSelect.value;
        
        // Changer le badge
        const badgeClass = {
            'MÉMOIRE': 'badge-memoire',
            'ATTENTION': 'badge-attention',
            'LOGIQUE': 'badge-logique',
            'CHRONO': 'badge-chrono'
        };
        typeBadge.textContent = selectedType;
        typeBadge.className = 'badge-type ms-2 ' + (badgeClass[selectedType] || 'badge-memoire');
        
        // Cacher toutes les configs
        if(configMemoire) configMemoire.classList.remove('active');
        if(configAttention) configAttention.classList.remove('active');
        if(configLogique) configLogique.classList.remove('active');
        if(configChrono) configChrono.classList.remove('active');
        
        // Afficher la config correspondante
        if(selectedType === 'MÉMOIRE' && configMemoire) {
            configMemoire.classList.add('active');
        } else if(selectedType === 'ATTENTION' && configAttention) {
            configAttention.classList.add('active');
        } else if(selectedType === 'LOGIQUE' && configLogique) {
            configLogique.classList.add('active');
        } else if(selectedType === 'CHRONO' && configChrono) {
            configChrono.classList.add('active');
        }
    }
    
    // Charger les données existantes dans la configuration
    function loadExistingConfiguration() {
        const contenuJson = document.getElementById('contenuJson');
        if(!contenuJson || !contenuJson.value) return;
        
        try {
            const config = JSON.parse(contenuJson.value);
            const type = document.getElementById('exercice_type').value;
            
            if(type === 'MÉMOIRE') {
                if(config.theme) document.getElementById('memoireTheme').value = config.theme;
                if(config.taille) document.getElementById('memoireTaille').value = config.taille;
                if(config.tempsAffichage) document.getElementById('memoireTemps').value = config.tempsAffichage;
                if(config.pointsParPaire) document.getElementById('memoirePoints').value = config.pointsParPaire;
            }
            else if(type === 'ATTENTION') {
                if(config.sousType) document.getElementById('attentionSousType').value = config.sousType;
                if(config.tempsParQuestion) document.getElementById('attentionTemps').value = config.tempsParQuestion;
                
                if(config.questions && config.questions.length > 0) {
                    const container = document.getElementById('attentionQuestionsContainer');
                    container.innerHTML = '';
                    config.questions.forEach(q => {
                        addAttentionQuestionRow(q.images || '', q.intrus || '', q.reponse || '');
                    });
                }
            }
            else if(type === 'LOGIQUE') {
                if(config.sousType) document.getElementById('logiqueSousType').value = config.sousType;
                
                if(config.sequences && config.sequences.length > 0) {
                    const container = document.getElementById('logiqueSequencesContainer');
                    container.innerHTML = '';
                    config.sequences.forEach(seq => {
                        addLogiqueSequenceRow(seq.serie || seq.debut || '', seq.reponse || '', seq.regle || '');
                    });
                }
            }
            else if(type === 'CHRONO') {
                if(config.dureeTotale) document.getElementById('chronoDuree').value = config.dureeTotale;
                
                if(config.defis && config.defis.length > 0) {
                    const container = document.getElementById('chronoDefisContainer');
                    container.innerHTML = '';
                    config.defis.forEach(defi => {
                        addChronoDefiRow(defi.question || '', defi.reponse || '', defi.points || 10);
                    });
                }
            }
            
            // Charger les jours
            if(config.jours && config.jours.length > 0) {
                document.querySelectorAll('.planning-day').forEach(cb => {
                    cb.checked = config.jours.includes(cb.value);
                });
            }
        } catch(e) {
            console.error('Erreur chargement configuration:', e);
        }
    }
    
    // Initialisation au chargement
    document.addEventListener('DOMContentLoaded', function() {
        // Ajouter l'écouteur d'événement sur le select
        const typeSelect = document.getElementById('exercice_type');
        if(typeSelect) {
            typeSelect.addEventListener('change', changeExerciceType);
            changeExerciceType();
        }
        
        // Charger les données existantes
        loadExistingConfiguration();
        
        // Construction du JSON avant soumission
        const form = document.getElementById('exerciceForm');
        if(form) {
            form.addEventListener('submit', function(e) {
                const type = document.getElementById('exercice_type').value;
                let configJson = {};
                
                if(type === 'MÉMOIRE') {
                    configJson = {
                        theme: document.getElementById('memoireTheme')?.value || 'animaux',
                        taille: document.getElementById('memoireTaille')?.value || '4x4',
                        tempsAffichage: parseInt(document.getElementById('memoireTemps')?.value || 3),
                        pointsParPaire: parseInt(document.getElementById('memoirePoints')?.value || 10)
                    };
                } 
                else if(type === 'ATTENTION') {
                    let questions = [];
                    document.querySelectorAll('#attentionQuestionsContainer .question-row').forEach(row => {
                        let inputs = row.querySelectorAll('input');
                        if(inputs[0] && inputs[0].value) {
                            questions.push({
                                images: inputs[0].value,
                                intrus: inputs[1]?.value || '',
                                reponse: inputs[2]?.value || inputs[1]?.value || ''
                            });
                        }
                    });
                    configJson = {
                        sousType: document.getElementById('attentionSousType')?.value || 'intrus',
                        questions: questions,
                        tempsParQuestion: parseInt(document.getElementById('attentionTemps')?.value || 10)
                    };
                } 
                else if(type === 'LOGIQUE') {
                    let sequences = [];
                    document.querySelectorAll('#logiqueSequencesContainer .sequence-row').forEach(row => {
                        let inputs = row.querySelectorAll('input');
                        if(inputs[0] && inputs[0].value) {
                            sequences.push({
                                debut: inputs[0].value,
                                reponse: inputs[1]?.value || '',
                                regle: inputs[2]?.value || ''
                            });
                        }
                    });
                    configJson = {
                        sousType: document.getElementById('logiqueSousType')?.value || 'numerique',
                        sequences: sequences
                    };
                } 
                else if(type === 'CHRONO') {
                    let defis = [];
                    document.querySelectorAll('#chronoDefisContainer .defi-row').forEach(row => {
                        let inputs = row.querySelectorAll('input');
                        if(inputs[0] && inputs[0].value) {
                            defis.push({
                                question: inputs[0].value,
                                reponse: inputs[1]?.value || '',
                                points: parseInt(inputs[2]?.value || 10)
                            });
                        }
                    });
                    configJson = {
                        dureeTotale: parseInt(document.getElementById('chronoDuree')?.value || 60),
                        defis: defis
                    };
                }
                
                // Ajouter les jours
                const jours = [];
                document.querySelectorAll('.planning-day:checked').forEach(cb => {
                    jours.push(cb.value);
                });
                if(jours.length > 0) {
                    configJson.jours = jours;
                }
                
                document.getElementById('contenuJson').value = JSON.stringify(configJson);
                console.log('JSON sauvegardé:', configJson);
            });
        }
    });
</script>
{% endblock %}