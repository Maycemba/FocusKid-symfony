{% extends 'base-front.html.twig' %}

{% block title %}Mes commentaires{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="display-5 fw-bold mb-4">💬 Commentaires</h1>

    <div class="row">
        {% for commentaire in commentaires %}
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm border-0 rounded-4 hover-lift transition-all">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="badge bg-info rounded-pill px-3 py-2">
                                {{ commentaire.typeCommentaire|capitalize }}
                            </span>
                            <small class="text-muted">{{ commentaire.dateCommentaire|date('d/m/Y H:i') }}</small>
                        </div>
                        <p class="mt-3">{{ commentaire.texteCommentaire|slice(0, 100) }}{% if commentaire.texteCommentaire|length > 100 %}...{% endif %}</p>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                {% if commentaire.carnetEducatif %}
                                    Carnet #{{ commentaire.carnetEducatif.id }}
                                {% else %}
                                    Carnet supprimé
                                {% endif %}
                            </small>
                            <div>
                                {% if commentaire.carnetEducatif %}
                                    {# Lien vers la page de détail du commentaire (show) #}
                                    <a href="{{ path('app_commentaire_show', {'id': commentaire.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
                                {% endif %}
                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <div class="alert alert-info">Aucun commentaire trouvé.</div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}