{% extends 'base-front.html.twig' %}

{% block title %}Mes commentaires{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    :root {
        --primary: #FF6B35;
        --primary-dark: #E55A2B;
        --secondary: #4A90E2;
        --success: #2ECC71;
        --warning: #F39C12;
        --info: #3498DB;
        --danger: #E74C3C;
        --dark: #2C3E50;
        --light: #F8F9FA;
        --gradient: linear-gradient(135deg, #FF6B35 0%, #4A90E2 100%);
        --gradient-green: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        --gradient-purple: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --text: #2d3561;
        --muted: #8590a5;
        --border: #e8ecf5;
    }

    .page-header {
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        border-bottom: 2px solid var(--border);
        padding: 2.5rem 0 2rem;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }

    .page-header::before {
        content: '';
        position: absolute;
        width: 220px;
        height: 220px;
        top: -70px;
        right: -60px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
        animation: float 4s ease-in-out infinite;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }

    .page-title {
        font-family: 'Inter', sans-serif;
        font-size: 2rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 0;
        color: white;
    }

    .page-icon {
        width: 50px;
        height: 50px;
        background: rgba(255,255,255,0.2);
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        backdrop-filter: blur(10px);
    }

    .page-subtitle {
        color: rgba(255,255,255,0.9);
        margin-top: 0.5rem;
    }

    .filter-card {
        background: white;
        border-radius: 20px;
        border: 1px solid var(--border);
        transition: all 0.3s;
    }

    .filter-card:hover {
        box-shadow: 0 8px 32px rgba(0,0,0,0.08);
    }

    .form-label {
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--dark);
        margin-bottom: 0.5rem;
    }

    .form-control, .form-select {
        border: 1.5px solid var(--border);
        border-radius: 12px;
        padding: 0.7rem 1rem;
        transition: all 0.2s;
    }

    .form-control:focus, .form-select:focus {
        border-color: #FF6B35;
        box-shadow: 0 0 0 3px rgba(255,107,53,0.1);
        outline: none;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        color: white;
        border: none;
        border-radius: 50px;
        padding: 0.7rem 1.5rem;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255,107,53,0.4);
        color: white;
    }

    .btn-outline-custom {
        background: transparent;
        border: 1.5px solid var(--border);
        border-radius: 50px;
        padding: 0.7rem 1.5rem;
        font-weight: 600;
        color: var(--dark);
        transition: all 0.3s;
    }

    .btn-outline-custom:hover {
        border-color: #FF6B35;
        color: #FF6B35;
    }

    .comment-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 20px;
        transition: all 0.3s;
        height: 100%;
    }

    .comment-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }

    .badge-type {
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        color: white;
        padding: 0.4rem 1rem;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .comment-text {
        color: var(--dark);
        line-height: 1.6;
        font-size: 0.9rem;
    }

    .btn-sm-view {
        background: var(--border);
        color: var(--dark);
        border: none;
        border-radius: 10px;
        padding: 0.35rem 1rem;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s;
    }

    .btn-sm-view:hover {
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        color: white;
        transform: translateY(-2px);
    }

    .back-link {
        background: rgba(255,255,255,0.2);
        color: white;
        border-radius: 50px;
        padding: 0.6rem 1.5rem;
        transition: all 0.3s;
    }

    .back-link:hover {
        background: rgba(255,255,255,0.3);
        color: white;
        transform: translateY(-2px);
    }

    @media (max-width: 768px) {
        .page-title { font-size: 1.5rem; }
        .page-icon { width: 40px; height: 40px; font-size: 1.1rem; }
    }
</style>
{% endblock %}

{% block body %}
<div class="page-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <div class="page-title">
                    <div class="page-icon">💬</div>
                    Mes Commentaires
                </div>
                <p class="page-subtitle">Tous vos retours et observations</p>
            </div>
            <a href="{{ path('app_carnet_educatif_index') }}" class="back-link text-decoration-none">
                ← Retour aux carnets
            </a>
        </div>
    </div>
</div>

<div class="container py-4">
    {# Barre de filtre #}
    <div class="filter-card card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <form method="get" action="{{ path('app_commentaire_index') }}" class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">🔍 RECHERCHE</label>
                    <input type="text" name="search" class="form-control" placeholder="Texte du commentaire..." value="{{ search|default('') }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label">🏷️ TYPE</label>
                    <select name="type" class="form-select">
                        <option value="">Tous</option>
                        {% for t in types|default([]) %}
                            <option value="{{ t }}" {% if selected_type|default('') == t %}selected{% endif %}>{{ t }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary-custom w-100">Filtrer</button>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <a href="{{ path('app_commentaire_index') }}" class="btn btn-outline-custom w-100 text-center">Réinitialiser</a>
                </div>
            </form>
        </div>
    </div>

    {# Liste des commentaires #}
    <div class="row g-4">
        {% for commentaire in commentaires %}
            <div class="col-md-6 col-lg-4">
                <div class="comment-card card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge-type">{{ commentaire.typeCommentaire|capitalize }}</span>
                            <small class="text-muted">
                                <i class="far fa-calendar-alt me-1"></i>{{ commentaire.dateCommentaire|date('d/m/Y H:i') }}
                            </small>
                        </div>
                        <p class="comment-text mb-3">
                            {{ commentaire.texteCommentaire|slice(0, 120) }}{% if commentaire.texteCommentaire|length > 120 %}...{% endif %}
                        </p>
                        <hr class="my-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i class="fas fa-book me-1"></i>
                                {% if commentaire.carnetEducatif %}
                                    Carnet du {{ commentaire.carnetEducatif.dateEtude|date('d/m/Y') }}
                                {% else %}
                                    Carnet supprimé
                                {% endif %}
                            </small>
                            {% if commentaire.carnetEducatif %}
                                <a href="{{ path('app_commentaire_show', {'id': commentaire.id}) }}" class="btn-sm-view text-decoration-none">
                                    <i class="fas fa-eye me-1"></i> Voir
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <div class="alert alert-info rounded-4">Aucun commentaire trouvé pour ces critères.</div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}