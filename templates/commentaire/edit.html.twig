{# templates/commentaire/edit.html.twig #}
{% extends 'base-front.html.twig' %}

{% block title %}Modifier le commentaire{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h4>✏️ Modifier le commentaire</h4>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        {{ form_errors(form) }}
                        {{ form_row(form.date_seule) }}
                        {{ form_row(form.heure_seule) }}
                        {{ form_row(form.texte_commentaire) }}
                        {{ form_row(form.type_commentaire) }}
                        <button type="submit" class="btn btn-primary">Mettre à jour</button>
                        <a href="{{ path('app_commentaire_show', {'id': commentaire.id}) }}" class="btn btn-secondary">Annuler</a>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}