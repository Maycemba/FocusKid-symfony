{# templates/stress/index.html.twig #}
{% extends 'base-front1.html.twig' %}

{% block title %}Détection des émotions - FocusKid{% endblock %}

{% block body %}
<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
            <h1 class="mb-3">🧠 Comment te sens-tu ?</h1>
            <p>Regarde la caméra, l'IA va détecter ton émotion et t'aider à mieux comprendre ce que tu ressens</p>
        </div>

        <div class="row g-4">
            <!-- WEBCAM PANEL -->
            <div class="col-lg-8 wow fadeInUp" data-wow-delay="0.1s">
                <div class="bg-light rounded p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="mb-0"><i class="fas fa-video me-2 text-primary"></i> Webcam</h3>
                        <span id="api-badge" class="badge bg-secondary">
                            <span id="api-dot" class="me-1"></span>
                            <span id="api-status-text">Connexion...</span>
                        </span>
                    </div>
                    <div class="video-wrapper position-relative" style="background: #000; border-radius: 12px; overflow: hidden;">
                        <video id="video" autoplay muted playsinline style="width:100%; transform: scaleX(-1);"></video>
                        <canvas id="overlay-canvas" style="position: absolute; top:0; left:0; width:100%; height:100%; pointer-events: none;"></canvas>
                        <canvas id="hidden-canvas" style="display:none;" width="640" height="480"></canvas>
                    </div>
                    <div class="webcam-controls mt-3 d-flex gap-2">
                        <button class="btn btn-primary rounded-pill py-2 px-4" id="btn-start">
                            <i class="fas fa-play me-2"></i> Démarrer la caméra
                        </button>
                        <button class="btn btn-secondary rounded-pill py-2 px-4" id="btn-stop" disabled>
                            <i class="fas fa-stop me-2"></i> Arrêter
                        </button>
                    </div>
                    <div id="offline-warning" class="alert alert-warning mt-3" style="display: none;">
                        ⚠️ L'API Python est hors ligne. Lancez : <code>python python_ai/api.py</code>
                    </div>
                </div>
            </div>

            <!-- RÉSULTAT ÉMOTION -->
            <div class="col-lg-4 wow fadeInUp" data-wow-delay="0.2s">
                <div class="bg-light rounded p-4 h-100">
                    <div class="text-center mb-3">
                        <div class="emotion-icon" style="font-size: 4rem;" id="emotion-icon">😐</div>
                        <h2 class="mb-2 emotion-label" id="emotion-label" style="text-transform: capitalize;">–</h2>
                        <p class="text-muted mb-0" id="emotion-conf">Confiance : –</p>
                        <p class="small text-muted mt-1" id="last-update">--:--:--</p>
                    </div>

                    <!-- Stress gauge -->
                    <div class="stress-section mt-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="mb-0"><i class="fas fa-heartbeat text-danger me-2"></i> Niveau de stress</h5>
                            <span id="stress-value" class="fw-bold fs-4" style="color: var(--primary);">–</span>
                        </div>
                        <div class="gauge-track bg-white rounded-pill" style="height: 12px; overflow: hidden;">
                            <div id="stress-bar" style="height:100%; width:0%; background: var(--primary); transition: width 0.4s;"></div>
                        </div>
                        <p class="small text-muted mt-2 text-center" id="stress-desc">–</p>
                    </div>

                    <!-- Probabilités -->
                    <div class="probs-section mt-4" id="probs-section">
                        <h5 class="mb-3"><i class="fas fa-chart-pie me-2 text-info"></i> Probabilités</h5>
                        <!-- dynamique -->
                    </div>
                </div>
            </div>

            <!-- HISTORIQUE -->
            <div class="col-12 wow fadeInUp" data-wow-delay="0.3s">
                <div class="bg-light rounded p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="mb-0"><i class="fas fa-history me-2 text-warning"></i> Historique des émotions</h3>
                        <button id="btn-clear" class="btn btn-sm btn-outline-secondary rounded-pill">
                            <i class="fas fa-trash-alt me-1"></i> Effacer
                        </button>
                    </div>
                    <div class="history-list" id="history-list" style="max-height: 200px; overflow-y: auto;">
                        <div class="text-center text-muted py-3">Aucune mesure encore</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Message de bienvenue -->
        <div class="row mt-5">
            <div class="col-12 text-center">
                <div class="bg-light rounded p-4">
                    <h4 class="text-primary mb-2">✨ L'IA prend soin de toi ✨</h4>
                    <p class="mb-0">La caméra analyse ton visage pour mieux comprendre tes émotions. Tes données restent sur ton appareil !</p>
                </div>
            </div>
        </div>

        
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .video-wrapper {
        background: #000;
        border-radius: 12px;
        overflow: hidden;
    }
    .video-wrapper video {
        display: block;
    }
    .history-list::-webkit-scrollbar {
        width: 5px;
    }
    .history-list::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }
    .history-list::-webkit-scrollbar-thumb {
        background: var(--primary);
        border-radius: 10px;
    }
    .prob-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
    }
    .prob-name {
        width: 80px;
        font-size: 0.8rem;
        text-transform: capitalize;
    }
    .prob-track {
        flex: 1;
        background: #e9ecef;
        border-radius: 10px;
        height: 8px;
        overflow: hidden;
    }
    .prob-fill {
        height: 100%;
        border-radius: 10px;
        width: 0%;
        transition: width 0.3s ease;
    }
    .prob-pct {
        width: 45px;
        text-align: right;
        font-size: 0.75rem;
    }
    #api-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: #ef4444;
        transition: background-color 0.3s;
    }
    #api-dot.online {
        background-color: #22c55e;
        box-shadow: 0 0 5px #22c55e;
    }
    .result {
        display: none;
        padding: 10px;
        border-radius: 8px;
        margin-top: 10px;
    }
    .result.success {
        display: block;
        background-color: #d1fae5;
        color: #065f46;
    }
    .result.error {
        display: block;
        background-color: #fee2e2;
        color: #991b1b;
    }
    .result.warning {
        display: block;
        background-color: #fef3c7;
        color: #92400e;
    }
    .btn.listening {
        background-color: #dc2626 !important;
        animation: pulse 1.5s infinite;
    }
    @keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.7; }
        100% { opacity: 1; }
    }
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    // ==================== API CONNECTION STATUS ====================
    const apiDot = document.getElementById('api-dot');
    const apiStatusText = document.getElementById('api-status-text');
    const offlineWarning = document.getElementById('offline-warning');
    
    async function checkApiStatus() {
        try {
            const response = await fetch('http://localhost:5001/health', { 
                method: 'GET',
                mode: 'cors',
                cache: 'no-cache'
            });
            if (response.ok) {
                apiDot.classList.add('online');
                apiStatusText.textContent = 'IA connectée';
                offlineWarning.style.display = 'none';
                return true;
            } else {
                throw new Error('API not ready');
            }
        } catch (error) {
            apiDot.classList.remove('online');
            apiStatusText.textContent = 'IA hors ligne';
            offlineWarning.style.display = 'block';
            return false;
        }
    }
    
    // ==================== CAMERA ====================
    const video = document.getElementById('video');
    const startBtn = document.getElementById('btn-start');
    const stopBtn = document.getElementById('btn-stop');
    const overlayCanvas = document.getElementById('overlay-canvas');
    const hiddenCanvas = document.getElementById('hidden-canvas');
    const captureCanvas = document.createElement('canvas');
    captureCanvas.width = 640;
    captureCanvas.height = 480;
    
    let stream = null;
    let animationId = null;
    let isActive = false;
    let lastCaptureTime = 0;
    const CAPTURE_INTERVAL = 1500; // ms
    
    // UI Elements
    const emotionIcon = document.getElementById('emotion-icon');
    const emotionLabel = document.getElementById('emotion-label');
    const emotionConf = document.getElementById('emotion-conf');
    const lastUpdateSpan = document.getElementById('last-update');
    const stressValueSpan = document.getElementById('stress-value');
    const stressBar = document.getElementById('stress-bar');
    const stressDescSpan = document.getElementById('stress-desc');
    const probsSection = document.getElementById('probs-section');
    const historyList = document.getElementById('history-list');
    const clearBtn = document.getElementById('btn-clear');
    
    let history = [];
    
    // Emotion to icon mapping
    const emotionIcons = {
        happy: '😊',
        sad: '😢',
        angry: '😠',
        fear: '😨',
        surprise: '😲',
        neutral: '😐'
    };
    
    // Calculate stress level (inverse of happiness)
    function calculateStress(emotion, probabilities) {
        if (emotion === 'happy') return Math.max(0, Math.min(100, 20 + (1 - (probabilities.happy || 0)) * 50));
        if (emotion === 'angry') return 85 + Math.random() * 10;
        if (emotion === 'fear') return 80 + Math.random() * 10;
        if (emotion === 'sad') return 70 + Math.random() * 10;
        if (emotion === 'surprise') return 55 + Math.random() * 15;
        return 45 + Math.random() * 20;
    }
    
    function getStressDescription(stress) {
        if (stress < 30) return '😌 Très calme - Tu es serein(e) !';
        if (stress < 50) return '🙂 Relaxé - Tout va bien';
        if (stress < 70) return '🤔 Légère tension - Une petite pause serait bien';
        if (stress < 85) return '😐 Stress modéré - Respire un grand coup';
        return '😰 Stress élevé - Prends du temps pour toi';
    }
    
    function updateUI(data) {
        if (!data || !data.emotion) return;
        
        const emotion = data.emotion;
        const confidence = Math.round((data.confidence || 0.8) * 100);
        const probs = data.probabilities || {};
        
        // Update main display
        emotionIcon.textContent = emotionIcons[emotion] || '😐';
        emotionLabel.textContent = emotion;
        emotionConf.textContent = `Confiance : ${confidence}%`;
        lastUpdateSpan.textContent = new Date().toLocaleTimeString();
        
        // Stress
        let stress = calculateStress(emotion, probs);
        stress = Math.min(100, Math.max(0, Math.round(stress)));
        stressValueSpan.textContent = `${stress}%`;
        stressBar.style.width = `${stress}%`;
        if (stress > 70) {
            stressBar.style.background = '#dc2626';
        } else if (stress > 40) {
            stressBar.style.background = '#f59e0b';
        } else {
            stressBar.style.background = 'var(--primary)';
        }
        stressDescSpan.textContent = getStressDescription(stress);
        
        // Update probabilities
        updateProbabilities(probs);
        
        // Add to history
        addToHistory(emotion, confidence, stress);
    }
    
    function updateProbabilities(probs) {
        const emotions = ['happy', 'sad', 'angry', 'fear', 'surprise', 'neutral'];
        probsSection.innerHTML = '<h5 class="mb-3"><i class="fas fa-chart-pie me-2 text-info"></i> Probabilités</h5>';
        
        for (const emotion of emotions) {
            const prob = probs[emotion] || 0;
            const percent = Math.round(prob * 100);
            let color = '#6c63ff';
            if (emotion === 'happy') color = '#10b981';
            else if (emotion === 'sad') color = '#3b82f6';
            else if (emotion === 'angry') color = '#ef4444';
            else if (emotion === 'fear') color = '#8b5cf6';
            else if (emotion === 'surprise') color = '#f59e0b';
            
            const row = document.createElement('div');
            row.className = 'prob-row';
            row.innerHTML = `
                <span class="prob-name">${emotionIcons[emotion]} ${emotion}</span>
                <div class="prob-track"><div class="prob-fill" style="width: ${percent}%; background: ${color};"></div></div>
                <span class="prob-pct">${percent}%</span>
            `;
            probsSection.appendChild(row);
        }
    }
    
    function addToHistory(emotion, confidence, stress) {
        const now = new Date();
        const timeStr = now.toLocaleTimeString().slice(0,5);
        
        history.unshift({ time: timeStr, emotion, confidence, stress });
        if (history.length > 20) history.pop();
        
        renderHistory();
    }
    
    function renderHistory() {
        if (history.length === 0) {
            historyList.innerHTML = '<div class="text-center text-muted py-3">Aucune mesure encore</div>';
            return;
        }
        
        historyList.innerHTML = history.map(item => `
            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <span class="text-muted small" style="width: 60px;">${item.time}</span>
                <span class="flex-grow-1">${emotionIcons[item.emotion]} ${item.emotion}</span>
                <span class="badge bg-secondary">${item.confidence}%</span>
                <span class="ms-2 small">Stress: ${item.stress}%</span>
            </div>
        `).join('');
    }
    
    clearBtn.addEventListener('click', () => {
        history = [];
        renderHistory();
    });
    
    async function captureAndAnalyze() {
        if (!isActive) return;
        
        const ctx = hiddenCanvas.getContext('2d');
        ctx.drawImage(video, 0, 0, 640, 480);
        
        const imageData = hiddenCanvas.toDataURL('image/jpeg', 0.8);
        
        try {
            const response = await fetch('http://localhost:5001/predict', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ image: imageData })
            });
            
            if (response.ok) {
                const result = await response.json();
                updateUI(result);
            }
        } catch (error) {
            console.log('API error:', error);
        }
        
        scheduleNextCapture();
    }
    
    function scheduleNextCapture() {
        if (!isActive) return;
        const now = Date.now();
        const timeSince = now - lastCaptureTime;
        const delay = Math.max(0, CAPTURE_INTERVAL - timeSince);
        setTimeout(() => {
            if (isActive) {
                lastCaptureTime = Date.now();
                captureAndAnalyze();
            }
        }, delay);
    }
    
    function startCaptureLoop() {
        if (!isActive) return;
        lastCaptureTime = Date.now();
        captureAndAnalyze();
    }
    
    async function startCamera() {
        try {
            stream = await navigator.mediaDevices.getUserMedia({ video: true });
            video.srcObject = stream;
            await video.play();
            
            isActive = true;
            startBtn.disabled = true;
            stopBtn.disabled = false;
            
            const resizeCanvas = () => {
                const rect = video.getBoundingClientRect();
                overlayCanvas.width = rect.width;
                overlayCanvas.height = rect.height;
                overlayCanvas.style.width = `${rect.width}px`;
                overlayCanvas.style.height = `${rect.height}px`;
            };
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);
            
            startCaptureLoop();
        } catch (error) {
            console.error('Camera error:', error);
            alert('Impossible d\'accéder à la caméra');
            isActive = false;
            startBtn.disabled = false;
            stopBtn.disabled = true;
        }
    }
    
    function stopCamera() {
        isActive = false;
        if (stream) {
            stream.getTracks().forEach(track => track.stop());
            stream = null;
        }
        video.srcObject = null;
        startBtn.disabled = false;
        stopBtn.disabled = true;
        emotionIcon.textContent = '😐';
        emotionLabel.textContent = '–';
        emotionConf.textContent = 'Confiance : –';
        stressValueSpan.textContent = '–';
        stressBar.style.width = '0%';
        stressDescSpan.textContent = '–';
        probsSection.innerHTML = '<h5 class="mb-3"><i class="fas fa-chart-pie me-2 text-info"></i> Probabilités</h5><div class="text-muted text-center">Attendez...</div>';
    }
    
    startBtn.addEventListener('click', startCamera);
    stopBtn.addEventListener('click', stopCamera);
    
    // Check API status periodically
    checkApiStatus();
    setInterval(checkApiStatus, 5000);
    
    // ==================== VOICE COMMANDS ====================
    const micBtn = document.getElementById('micBtn');
    const statusDiv = document.getElementById('status');
    const resultDiv = document.getElementById('result');
    
    const routes = {
        coloriage: '{{ path('app_session_calme_activite', {type: 'coloriage'}) }}',
        histoire: '{{ path('app_session_calme_activite', {type: 'histoire'}) }}',
        respiration: '{{ path('app_session_calme_activite', {type: 'respiration'}) }}',
        musique: '{{ path('app_session_calme_activite', {type: 'musique'}) }}'
    };
    
    const keywords = {
        coloriage: ['coloriage', 'colorier', 'dessin', 'colorie', 'coloring'],
        histoire: ['histoire', 'raconter', 'conte', 'story', 'lecture', 'raconte'],
        respiration: ['respiration', 'respirer', 'calme', 'relaxation', 'meditation', 'méditation', 'souffle'],
        musique: ['musique', 'musical', 'chanson', 'son', 'melodie', 'mélodie', 'music']
    };
    
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    let recognition = null;
    let redirectTimeout = null;
    
    function showResult(message, type = 'info') {
        if (!resultDiv) return;
        resultDiv.style.display = 'block';
        resultDiv.innerHTML = message;
        resultDiv.className = `result ${type}`;
        setTimeout(() => {
            if (resultDiv && resultDiv.style.display === 'block' && !resultDiv.innerHTML.includes('Redirection')) {
                resultDiv.style.display = 'none';
            }
        }, 5000);
    }
    
    function redirectTo(activity, route) {
        const messages = {
            coloriage: '🎨 Ouverture de la session coloriage. Bon amusement !',
            histoire: '📖 Ouverture de la session histoire. Préparez-vous à écouter !',
            respiration: '🧘 Ouverture de la session respiration. Inspirez, expirez...',
            musique: '🎵 Ouverture de la session musique. Laissez-vous emporter par les sons !'
        };
        
        showResult(`${messages[activity]}<br>🔄 Redirection dans 2 secondes...`, 'success');
        if (statusDiv) statusDiv.innerHTML = `Redirection vers ${activity}...`;
        
        if (redirectTimeout) clearTimeout(redirectTimeout);
        redirectTimeout = setTimeout(() => {
            window.location.href = route;
        }, 2000);
    }
    
    function processCommand(commande) {
        commande = commande.toLowerCase();
        for (const [activity, words] of Object.entries(keywords)) {
            for (const word of words) {
                if (commande.includes(word)) {
                    redirectTo(activity, routes[activity]);
                    return;
                }
            }
        }
        showResult(`❌ Je n'ai pas compris "${commande}". Essayez : coloriage, histoire, respiration ou musique`, 'error');
        if (statusDiv) statusDiv.innerHTML = 'Prêt - Cliquez pour réessayer';
    }
    
    if (micBtn) {
        if (!SpeechRecognition) {
            if (statusDiv) statusDiv.innerHTML = '❌ Reconnaissance vocale non supportée';
            if (micBtn) micBtn.disabled = true;
        } else {
            micBtn.onclick = function() {
                if (recognition) {
                    recognition.stop();
                    micBtn.classList.remove('listening');
                    if (statusDiv) statusDiv.innerHTML = 'Reconnaissance arrêtée';
                    recognition = null;
                    return;
                }
                
                recognition = new SpeechRecognition();
                recognition.lang = 'fr-FR';
                recognition.continuous = false;
                recognition.interimResults = false;
                
                recognition.onstart = function() {
                    micBtn.classList.add('listening');
                    if (statusDiv) statusDiv.innerHTML = '🎤 Écoute... Parlez maintenant !';
                    if (resultDiv) resultDiv.style.display = 'none';
                };
                
                recognition.onresult = function(event) {
                    const commande = event.results[0][0].transcript;
                    const confiance = Math.round(event.results[0][0].confidence * 100);
                    if (statusDiv) statusDiv.innerHTML = `Commande reconnue : "${commande}" (${confiance}%) - Traitement...`;
                    processCommand(commande);
                };
                
                recognition.onerror = function(event) {
                    let msg = '';
                    switch(event.error) {
                        case 'no-speech':
                            msg = 'Aucune parole détectée. Réessayez.';
                            break;
                        case 'not-allowed':
                            msg = 'Permission microphone refusée.';
                            break;
                        default:
                            msg = `Erreur: ${event.error}`;
                    }
                    showResult(`❌ ${msg}`, 'error');
                    if (statusDiv) statusDiv.innerHTML = 'Cliquez pour réessayer';
                    micBtn.classList.remove('listening');
                    recognition = null;
                };
                
                recognition.onend = function() {
                    micBtn.classList.remove('listening');
                    if (statusDiv && statusDiv.innerHTML !== 'Redirection...') {
                        statusDiv.innerHTML = 'Prêt - Cliquez pour parler';
                    }
                    recognition = null;
                };
                
                recognition.start();
            };
        }
    }
</script>
{% endblock %}
