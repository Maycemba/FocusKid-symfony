    <!-- Loader AJAX -->
    <div id="ajaxLoader" style="display: none;">
        <div class="loader-spinner"></div>
        <p class="loader-text">Chargement en cours...</p>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.8/dist/iconify-icon.min.js"></script>

    <script>
        // Navigation AJAX pure JavaScript (pas besoin de jQuery)
        (function() {
            console.log('🔧 Initialisation navigation AJAX');
            
            var contentDiv = document.getElementById('dynamic-content');
            var loader = document.getElementById('ajaxLoader');
            var currentUrl = window.location.pathname;

            function isSharedStylesheet(node) {
                if (!node || node.tagName !== 'LINK') {
                    return false;
                }

                var href = node.getAttribute('href') || '';
                return href.indexOf('base-back/assets/css/styles.min.css') !== -1;
            }

            function clearDynamicStyles() {
                var existing = document.querySelectorAll('[data-dynamic-page-style="1"]');
                for (var i = 0; i < existing.length; i++) {
                    existing[i].remove();
                }
            }

            function syncPageStyles(sourceDoc) {
                if (!sourceDoc || !sourceDoc.head) {
                    return;
                }

                clearDynamicStyles();

                var nodes = sourceDoc.head.querySelectorAll('style, link[rel="stylesheet"]');
                for (var i = 0; i < nodes.length; i++) {
                    var node = nodes[i];
                    if (isSharedStylesheet(node)) {
                        continue;
                    }

                    var clone = node.cloneNode(true);
                    clone.setAttribute('data-dynamic-page-style', '1');
                    document.head.appendChild(clone);
                }
            }

            syncPageStyles(document);
            
            function showLoader() {
                if (loader) loader.style.display = 'block';
                if (contentDiv) contentDiv.style.opacity = '0.5';
            }
            
            function hideLoader() {
                if (loader) loader.style.display = 'none';
                if (contentDiv) contentDiv.style.opacity = '1';
            }
            
            function loadContent(url) {
                if (!url) return;
                console.log('📥 Chargement AJAX:', url);
                showLoader();
                
                fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function(response) {
                    if (!response.ok) throw new Error('Erreur ' + response.status);
                    return response.text();
                })
                .then(function(html) {
                    var tempDoc = new DOMParser().parseFromString(html, 'text/html');
                    var newContent = tempDoc.querySelector('#dynamic-content');

                    syncPageStyles(tempDoc);
                    
                    if (newContent) {
                        contentDiv.innerHTML = newContent.innerHTML;
                    } else {
                        contentDiv.innerHTML = html;
                    }
                    
                    // Mettre à jour l'URL
                    window.history.pushState({url: url}, '', url);
                    
                    // Mettre à jour le titre
                    var newTitle = tempDoc.querySelector('title');
                    if (newTitle) document.title = newTitle.textContent;
                    
                    // Mettre à jour le menu actif
                    var allLinks = document.querySelectorAll('.ajax-link');
                    for (var i = 0; i < allLinks.length; i++) {
                        allLinks[i].classList.remove('active');
                    }
                    var activeLink = document.querySelector('.ajax-link[data-url="' + url + '"]');
                    if (activeLink) activeLink.classList.add('active');
                    
                    console.log('✅ Contenu chargé:', url);
                    hideLoader();
                })
                .catch(function(error) {
                    console.error('❌ Erreur AJAX:', error);
                    window.location.href = url;
                });
            }
            
            // Capturer les clics sur les liens AJAX
            var links = document.querySelectorAll('.ajax-link');
            console.log('Liens AJAX trouvés:', links.length);
            
            for (var i = 0; i < links.length; i++) {
                links[i].addEventListener('click', function(e) {
                    e.preventDefault();
                    var url = this.getAttribute('data-url');
                    if (url) loadContent(url);
                });
            }
            
            // Lien home
            var homeLink = document.getElementById('homeLink');
            if (homeLink) {
                homeLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    var url = "{{ path('app_exercice_index') }}";
                    loadContent(url);
                });
            }
            
            // Bouton retour navigateur
            window.addEventListener('popstate', function(event) {
                if (event.state && event.state.url) {
                    loadContent(event.state.url);
                }
            });
            
            // Activer le menu actif au chargement
            var currentLinks = document.querySelectorAll('.ajax-link');
            for (var i = 0; i < currentLinks.length; i++) {
                var linkUrl = currentLinks[i].getAttribute('data-url');
                if (linkUrl && currentUrl.includes(linkUrl)) {
                    currentLinks[i].classList.add('active');
                }
            }
        })();
    </script>

