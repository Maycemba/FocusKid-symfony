            display: flex;
            align-items: center;
            gap: 10px;
        }
        .top-bar-avatar {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #1a1a8b, #4a4adb);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 16px;
        }
        .top-bar-username {
            font-weight: 700;
            color: #1a1a8b;
            font-size: 15px;
        }
        .btn-logout {
            background: #ef5350;
            color: white;
            border: none;
            border-radius: 20px;
            padding: 7px 18px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: opacity 0.2s;
        }
        .btn-logout:hover { opacity: 0.88; color: white; }

        /* ── SIDEBAR ── */
        .sidebar {
            position: fixed;
            top: 64px;
            left: 0;
            bottom: 0;
            width: 90px;
            background: linear-gradient(to bottom,
                rgba(197, 239, 197, 0.95),
