<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}FocusKids Admin - Dashboard{% endblock %}</title>
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="{{ asset('base-back/assets/images/logos/favicon.png') }}">
    <link rel="shortcut icon" type="image/png" href="{{ asset('assets/images/logos/logo.png') }}" />
    <link rel="stylesheet" href="{{ asset('base-back/assets/css/styles.min.css') }}" />
    {% block stylesheets %}{% endblock %}
    <style>
        /* Style pour minimiser le logo */
        .brand-logo img {
            height: 60px !important;
            width: auto !important;
            max-width: 150px !important;
            object-fit: contain;
        }
        .brand-logo a {
            display: flex;
            align-items: center;
            text-decoration: none;
        }
        .brand-logo span {
            font-size: 18px;
            font-weight: bold;
            margin-left: 8px;
        }
        /* Cacher le header (app-header) */
        .app-header {
            display: none !important;
        }
        /* Ajuster le body-wrapper pour qu'il prenne toute la place */
        .body-wrapper {
            margin-top: 0 !important;
            padding-top: 0 !important;
        }
        
        /* Loader AJAX */
        #ajaxLoader {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 9999;
            background: rgba(0, 0, 0, 0.9);
            padding: 25px 40px;
            border-radius: 15px;
            text-align: center;
            display: none;
            box-shadow: 0 0 30px rgba(0,0,0,0.3);
        }
        .loader-spinner {
            width: 50px;
            height: 50px;
            border: 5px solid #f3f3f3;
            border-top: 5px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 15px auto;
        }
        .loader-text {
            color: white;
            font-size: 14px;
            margin: 0;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        /* Animation transition contenu */
        #dynamic-content {
            min-height: 400px;
            transition: opacity 0.2s;
        }
        
        /* Lien actif dans le menu */
        .sidebar-link.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white !important;
            border-radius: 10px;
        }
        .sidebar-link.active iconify-icon {
            color: white !important;
        }
        
        .sidebar-link {
            cursor: pointer;
        }
    </style>
</head>

<body>
  
    <div class="page-wrapper" id="main-wrapper" data-layout="vertical" data-navbarbg="skin6" data-sidebartype="full"
        data-sidebar-position="fixed" data-header-position="fixed">

        <div class="app-topstrip bg-dark py-3 px-4 w-100 d-lg-flex align-items-center justify-content-between">
            <div class="text-white">
                <small>🌟 FocusKids - Plateforme éducative pour enfants</small>
            </div>
            <div class="text-white-50">
                <small>📅 {{ 'now'|date('d/m/Y') }}</small>
            </div>
        </div>

        <aside class="left-sidebar">
            <div>
                <div class="brand-logo d-flex align-items-center justify-content-between px-3 py-2">
                    <a class="text-nowrap logo-img d-flex align-items-center" href="#" id="homeLink">
                        <img src="{{ asset('base-back/assets/images/logos/logo.png') }}" alt="FocusKids" />
                        <span class="fw-bold text-primary">FocusKids</span>
                    </a>
                    <div class="close-btn d-xl-none d-block sidebartoggler cursor-pointer" id="sidebarCollapse">
                        <i class="ti ti-x fs-8"></i>
                    </div>
                </div>
                
                <nav class="sidebar-nav scroll-sidebar" data-simplebar="">
                    <ul id="sidebarnav">
                        <!-- Dashboard -->
                        <li class="nav-small-cap">
                            <iconify-icon icon="solar:menu-dots-linear" class="nav-small-cap-icon fs-4"></iconify-icon>
                            <span class="hide-menu">Navigation</span>
                        </li>
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link primary-hover-bg ajax-link" data-url="{{ path('app_exercice_index') }}">
                                <iconify-icon icon="solar:home-2-line-duotone"></iconify-icon>
                                <span class="hide-menu">Tableau de bord</span>
                            </a>
                        </li>
                        
                        <!-- Module 1: EXERCICES -->
                        <li class="nav-small-cap">
                            <iconify-icon icon="solar:menu-dots-linear" class="nav-small-cap-icon fs-4"></iconify-icon>
                            <span class="hide-menu">Gestion Pédagogique</span>
                        </li>
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link primary-hover-bg ajax-link" data-url="{{ path('app_exercice_index') }}">
                                <iconify-icon icon="solar:notebook-bookmark-line-duotone"></iconify-icon>
                                <span class="hide-menu">Exercices</span>
                            </a>
                        </li>
                        
                        <!-- Module 2: JEUX -->
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link primary-hover-bg ajax-link" data-url="{{ path('app_jeu_index') }}">
                                <iconify-icon icon="solar:gamepad-line-duotone"></iconify-icon>
                                <span class="hide-menu">Jeux</span>
                            </a>
                        </li>
                        
                        <!-- Module 3: SESSIONS DE CALME -->
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link primary-hover-bg ajax-link" data-url="{{ path('app_sessions_de_calme_index') }}">
                                <iconify-icon icon="solar:meditation-line-duotone"></iconify-icon>
                                <span class="hide-menu">Session calme</span>
                            </a>
                        </li>
                        
                        <!-- Module 4: COURS / LEÇONS -->
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link primary-hover-bg ajax-link" data-url="{{ path('app_cour_index') }}">
                                <iconify-icon icon="solar:notebook-line-duotone"></iconify-icon>
                                <span class="hide-menu">Cours</span>
                            </a>
                        </li>
                        
                        <!-- Module 5: CARNET ÉDUCATIF -->
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link primary-hover-bg ajax-link" data-url="{{ path('admin_carnet_index') }}">
                                <iconify-icon icon="solar:diploma-line-duotone"></iconify-icon>
                                <span class="hide-menu">Carnet éducatif</span>
                            </a>
                        </li>
                        
                        <!-- Module 6: ÉMOTIONS -->
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link primary-hover-bg ajax-link" data-url="{{ path('app_emotion_index') }}">
                                <iconify-icon icon="solar:emoji-funny-square-line-duotone"></iconify-icon>
                                <span class="hide-menu">Émotions</span>
                            </a>
                        </li>
                        
                        <!-- Module 7: SCÉNARIOS -->
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link primary-hover-bg ajax-link" data-url="{{ path('app_scenario_index') }}">
                                <iconify-icon icon="solar:clapperboard-line-duotone"></iconify-icon>
                                <span class="hide-menu">Scénarios</span>
                            </a>
                        </li>
                        
                        <!-- Module 8: HUMEUR JOURNALIÈRE -->
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link primary-hover-bg ajax-link" data-url="{{ path('app_humeur_journaliere_index') }}">
                                <iconify-icon icon="solar:smile-circle-line-duotone"></iconify-icon>
                                <span class="hide-menu">Humeur journalière</span>
                            </a>
                        </li>
                        
                        <!-- Module 9: UTILISATEURS -->
                        <li class="nav-small-cap">
                            <iconify-icon icon="solar:menu-dots-linear" class="nav-small-cap-icon fs-4"></iconify-icon>
                            <span class="hide-menu">Administration</span>
                        </li>
                        <li class="sidebar-item">
                            <a href="#" class="sidebar-link primary-hover-bg ajax-link" data-url="{{ path('app_utilisateur_index') }}">
                                <iconify-icon icon="solar:users-group-rounded-line-duotone"></iconify-icon>
