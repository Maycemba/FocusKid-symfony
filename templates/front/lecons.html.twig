{% extends 'base-front.html.twig' %}

{% block title %}{{ cour.titre }} - Leçons{% endblock %}

{% block body %}

<!-- Header -->
<div class="container-fluid bg-primary py-5 mb-5" style="background: linear-gradient(135deg, #06A3DA, #0056b3) !important;">
    <div class="container py-3">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h1 class="display-4 text-white fw-bold mb-3">📘 {{ cour.titre }}</h1>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    {% if cour.niveau %}
                    <span class="badge bg-white text-primary fs-6 px-3 py-2">🎯 {{ cour.niveau }}</span>
                    {% endif %}
                    {% if cour.formateur %}
                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">👨‍🏫 {{ cour.formateur }}</span>
                    {% endif %}
                    <span class="badge bg-success text-white fs-6 px-3 py-2">📝 {{ lecons|length }} leçon(s)</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-3 mb-5">

    <!-- Bouton retour -->
    <a href="{{ path('app_enfant_cours') }}" class="btn btn-outline-primary rounded-pill px-4 mb-4">
        <i class="fa fa-arrow-left me-2"></i> Retour aux cours
    </a>

    <!-- Description courte -->
    {% if cour.description %}
    <div class="alert border-start border-primary border-4 bg-light mb-5">
        <p class="mb-0 text-muted">{{ cour.description }}</p>
    </div>
    {% endif %}

    <!-- Leçons -->
    <h4 class="mb-4 text-primary">📚 Leçons du cours</h4>

    {% if lecons is empty %}
    <div class="text-center py-5">
        <i class="fa fa-book fa-4x text-muted mb-3"></i>
        <h5 class="text-muted">Aucune leçon disponible pour ce cours.</h5>
        <a href="{{ path('app_enfant_cours') }}" class="btn btn-primary rounded-pill px-4 mt-3">
            Retour aux cours
        </a>
    </div>
    {% else %}

    <div class="row g-3">
        {% for lecon in lecons %}
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 p-4" style="border-left: 6px solid #06A3DA !important;">
                <div class="d-flex align-items-start gap-3">
                    <!-- Numéro -->
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold"
                         style="width: 48px; height: 48px; font-size: 18px; flex-shrink: 0;">
                        {{ loop.index }}
                    </div>
                    <!-- Contenu -->
                    <div class="flex-grow-1">
                        <h5 class="text-primary fw-bold mb-2">{{ lecon.titreLecon }}</h5>
                        {% if lecon.contenu %}
                        <p class="text-dark mb-0">{{ lecon.contenu }}</p>
                        {% else %}
                        <p class="text-muted fst-italic mb-0">Aucun contenu disponible.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- Footer -->
    <div class="text-center mt-5 py-4 bg-light rounded-4">
        <h5 class="text-primary mb-3">🎉 {{ lecons|length }} leçon(s) dans ce cours !</h5>
        <a href="{{ path('app_enfant_cours') }}" class="btn btn-primary rounded-pill px-5 py-2">
            <i class="fa fa-arrow-left me-2"></i> Retour aux cours
        </a>
    </div>

    {% endif %}
</div>

{% endblock %}