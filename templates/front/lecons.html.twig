{% extends 'base-front.html.twig' %}

{% block title %}{{ cour.titre }} - Leçons{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Fredoka+One&display=swap" rel="stylesheet">
<style>
    body { font-family: 'Nunito', sans-serif; background: #f4f9fc; }

    /* Hero */
    .tdah-hero {
        background: linear-gradient(135deg, #06A3DA 0%, #0056b3 100%);
        padding: 44px 24px 60px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .tdah-hero::before {
        content: '';
        position: absolute; top: -50px; right: -50px;
        width: 220px; height: 220px;
        background: rgba(255,255,255,0.08); border-radius: 50%;
    }
    .tdah-hero::after {
        content: '';
        position: absolute; bottom: -70px; left: -40px;
        width: 260px; height: 260px;
        background: rgba(255,255,255,0.06); border-radius: 50%;
    }
    .tdah-hero-emoji {
        font-size: 64px; display: block; margin-bottom: 14px;
        animation: tdah-bounce 2s infinite;
    }
    .tdah-hero-title {
        font-family: 'Fredoka One', cursive;
        font-size: clamp(26px, 5vw, 38px);
        color: white; margin-bottom: 18px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.25);
    }
    .tdah-badges { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
    .tdah-badge {
        padding: 8px 18px; border-radius: 999px;
        font-size: 15px; font-weight: 700;
    }
    .tdah-badge-white  { background: white; color: #06A3DA; }
    .tdah-badge-yellow { background: #ffc107; color: #5a3e00; }
    .tdah-badge-green  { background: #28a745; color: white; }
    .tdah-badge-active { outline: 3px solid white; outline-offset: 2px; }

    /* Langue */
    .tdah-lang-selector {
        display: flex; justify-content: center;
        gap: 10px; flex-wrap: wrap;
        margin-top: 16px;
    }

    /* Progression */
    .tdah-progress-wrap {
        background: rgba(255,255,255,0.25);
        border-radius: 999px; height: 18px;
        margin: 24px 32px 0; overflow: hidden;
    }
    .tdah-progress-fill {
        background: #ffc107; height: 100%;
        border-radius: 999px; width: 0%;
        transition: width 1s ease;
    }
    .tdah-progress-label {
        color: rgba(255,255,255,0.9);
        font-size: 14px; text-align: center; margin-top: 8px;
        font-weight: 600;
    }

    /* Conteneur */
    .tdah-container { max-width: 860px; margin: 0 auto; padding: 32px 20px 70px; }

    .tdah-back-btn {
        display: inline-flex; align-items: center; gap: 8px;
        background: white; color: #06A3DA;
        border: 2px solid #06A3DA; border-radius: 999px;
        padding: 12px 26px; font-size: 15px; font-weight: 700;
        cursor: pointer; text-decoration: none;
        box-shadow: 0 3px 12px rgba(6,163,218,0.15);
        margin-bottom: 26px; font-family: 'Nunito', sans-serif;
        transition: transform 0.15s, background 0.15s;
    }
    .tdah-back-btn:hover { background: #e8f7fd; transform: translateY(-2px); }

    /* Titre de section */
    .tdah-section-title {
        font-family: 'Fredoka One', cursive;
        font-size: 26px; color: #06A3DA;
        margin-bottom: 22px;
        display: flex; align-items: center; gap: 10px;
    }

    /* Cartes */
    .tdah-card {
        background: white;
        border-radius: 24px;
        padding: 28px 30px;
        margin-bottom: 28px;
        box-shadow: 0 6px 24px rgba(0,0,0,0.09);
        border-left: 8px solid #06A3DA;
        position: relative; overflow: hidden;
    }
    .tdah-card:nth-child(5n+1) { border-left-color: #FF6B6B; }
    .tdah-card:nth-child(5n+2) { border-left-color: #06A3DA; }
    .tdah-card:nth-child(5n+3) { border-left-color: #FF9F43; }
    .tdah-card:nth-child(5n+4) { border-left-color: #26de81; }
    .tdah-card:nth-child(5n+0) { border-left-color: #a55eea; }

    .tdah-card::before {
        content: '';
        position: absolute; top: -40px; right: -40px;
        width: 140px; height: 140px; border-radius: 50%;
        opacity: 0.06;
    }
    .tdah-card:nth-child(5n+1)::before { background: #FF6B6B; }
    .tdah-card:nth-child(5n+2)::before { background: #06A3DA; }
    .tdah-card:nth-child(5n+3)::before { background: #FF9F43; }
    .tdah-card:nth-child(5n+4)::before { background: #26de81; }
    .tdah-card:nth-child(5n+0)::before { background: #a55eea; }

    .tdah-card-header {
        display: flex; align-items: center; gap: 18px;
        margin-bottom: 20px;
    }
    .tdah-step-circle {
        width: 60px; height: 60px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-family: 'Fredoka One', cursive;
        font-size: 26px; color: white; flex-shrink: 0;
    }
    .tdah-card:nth-child(5n+1) .tdah-step-circle { background: #FF6B6B; }
    .tdah-card:nth-child(5n+2) .tdah-step-circle { background: #06A3DA; }
    .tdah-card:nth-child(5n+3) .tdah-step-circle { background: #FF9F43; }
    .tdah-card:nth-child(5n+4) .tdah-step-circle { background: #26de81; color: #0a4a25; }
    .tdah-card:nth-child(5n+0) .tdah-step-circle { background: #a55eea; }

    .tdah-card-title {
        font-family: 'Fredoka One', cursive;
        font-size: 22px; flex: 1; line-height: 1.3;
    }
    .tdah-card:nth-child(5n+1) .tdah-card-title { color: #cc3333; }
    .tdah-card:nth-child(5n+2) .tdah-card-title { color: #0580b0; }
    .tdah-card:nth-child(5n+3) .tdah-card-title { color: #b86b00; }
    .tdah-card:nth-child(5n+4) .tdah-card-title { color: #0e7a40; }
    .tdah-card:nth-child(5n+0) .tdah-card-title { color: #7b3ec4; }

    .tdah-check {
        width: 40px; height: 40px; border-radius: 50%;
        background: #28a745; color: white;
        display: none; align-items: center; justify-content: center;
        font-size: 20px; font-weight: 900; flex-shrink: 0;
        box-shadow: 0 3px 10px rgba(40,167,69,0.4);
    }
    .tdah-check.visible { display: flex; }

    .tdah-card-body {
        display: block;
        padding-top: 20px;
        border-top: 2px dashed #e0e0e0;
    }
    .tdah-contenu {
        font-size: 18px; color: #2d2d2d; line-height: 2.1;
        border-radius: 16px; padding: 22px 24px;
    }
    .tdah-card:nth-child(5n+1) .tdah-contenu { background: #fff5f5; }
    .tdah-card:nth-child(5n+2) .tdah-contenu { background: #f0f9fd; }
    .tdah-card:nth-child(5n+3) .tdah-contenu { background: #fff8ef; }
    .tdah-card:nth-child(5n+4) .tdah-contenu { background: #f0fff6; }
    .tdah-card:nth-child(5n+0) .tdah-contenu { background: #f8f2ff; }

    .tdah-stars { display: flex; gap: 10px; margin-top: 18px; }
    .tdah-stars span {
        font-size: 34px; opacity: 0.22;
        cursor: pointer; transition: opacity 0.25s, transform 0.2s;
        user-select: none;
    }
    .tdah-stars span.lit { opacity: 1; transform: scale(1.2); }

    .tdah-actions { display: flex; gap: 14px; margin-top: 20px; flex-wrap: wrap; }
    .tdah-btn {
        border: none; border-radius: 999px;
        padding: 14px 30px; font-size: 17px; font-weight: 700;
        cursor: pointer; font-family: 'Nunito', sans-serif;
        display: flex; align-items: center; gap: 8px;
        transition: transform 0.15s, box-shadow 0.15s;
    }
    .tdah-btn:hover { transform: scale(1.05); box-shadow: 0 5px 16px rgba(0,0,0,0.15); }
    .tdah-btn-audio { background: #fff3cd; color: #5a3e00; }
    .tdah-card:nth-child(5n+1) .tdah-btn-compris { background: #FF6B6B; color: white; }
    .tdah-card:nth-child(5n+2) .tdah-btn-compris { background: #06A3DA; color: white; }
    .tdah-card:nth-child(5n+3) .tdah-btn-compris { background: #FF9F43; color: white; }
    .tdah-card:nth-child(5n+4) .tdah-btn-compris { background: #26de81; color: #0a4a25; }
    .tdah-card:nth-child(5n+0) .tdah-btn-compris { background: #a55eea; color: white; }

    .tdah-empty {
        text-align: center; padding: 70px 20px;
        background: white; border-radius: 24px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.07);
    }
    .tdah-empty-icon { font-size: 72px; display: block; margin-bottom: 18px; }
    .tdah-empty p { font-size: 18px; color: #888; margin-bottom: 22px; }

    .tdah-footer {
        background: linear-gradient(135deg, #06A3DA, #0056b3);
        border-radius: 24px; padding: 40px 24px;
        text-align: center; margin-top: 40px; color: white;
    }
    .tdah-footer-trophy { font-size: 60px; animation: tdah-bounce 2s infinite; display: block; }
    .tdah-footer h3 {
        font-family: 'Fredoka One', cursive;
        font-size: 28px; margin: 16px 0 10px;
    }
    .tdah-footer p { font-size: 16px; opacity: 0.9; margin-bottom: 22px; }
    .tdah-footer-btn {
        background: #ffc107; color: #5a3e00;
        border: none; border-radius: 999px;
        padding: 14px 36px; font-size: 17px; font-weight: 800;
        cursor: pointer; font-family: 'Nunito', sans-serif;
        text-decoration: none; display: inline-block;
        transition: transform 0.15s;
    }
    .tdah-footer-btn:hover { transform: scale(1.05); }

    @keyframes tdah-bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }
</style>
{% endblock %}

{% block body %}
<div class="tdah-hero">
    <span class="tdah-hero-emoji">📘</span>
    <div class="tdah-hero-title">{{ cour.titre }}</div>
    <div class="tdah-badges">
        {% if cour.niveau %}
        <span class="tdah-badge tdah-badge-white">🎯 {{ cour.niveau }}</span>
        {% endif %}
        {% if cour.formateur %}
        <span class="tdah-badge tdah-badge-yellow">👨‍🏫 {{ cour.formateur }}</span>
        {% endif %}
        <span class="tdah-badge tdah-badge-green">📝 {{ lecons|length }} leçon(s)</span>
    </div>

    <div class="tdah-lang-selector">
        <a href="?lang=fr" class="tdah-badge tdah-badge-white {{ locale == 'fr' ? 'tdah-badge-active' : '' }}" style="text-decoration:none;">
            🇫🇷 Français
        </a>
        <a href="?lang=en" class="tdah-badge tdah-badge-white {{ locale == 'en' ? 'tdah-badge-active' : '' }}" style="text-decoration:none;">
            🇬🇧 English
        </a>
        <a href="?lang=ar" class="tdah-badge tdah-badge-white {{ locale == 'ar' ? 'tdah-badge-active' : '' }}" style="text-decoration:none;">
            🇹🇳 العربية
        </a>
    </div>

    <div class="tdah-progress-wrap">
        <div class="tdah-progress-fill" id="progressBar"></div>
    </div>
    <div class="tdah-progress-label" id="progressLabel">
        0 leçon terminée sur {{ lecons|length }}
    </div>
</div>

<div class="tdah-container">
    <a href="{{ path('app_enfant_cours') }}" class="tdah-back-btn">← Retour aux cours</a>

    <div class="tdah-section-title">📚 Tes leçons</div>

    {% if lecons is empty %}
    <div class="tdah-empty">
        <span class="tdah-empty-icon">📖</span>
        <p>Aucune leçon disponible pour ce cours.</p>
        <a href="{{ path('app_enfant_cours') }}" class="tdah-footer-btn">Retour aux cours</a>
    </div>
    {% else %}
    <div id="leconsList">
        {% for item in leconsTraduites %}
        <div class="tdah-card" {% if locale == 'ar' %}dir="rtl"{% endif %}>
            <div class="tdah-card-header">
                <div class="tdah-step-circle">{{ loop.index }}</div>
                <div class="tdah-card-title">{{ item.titre_lecon }}</div>
                <div class="tdah-check" id="check-{{ loop.index0 }}">✓</div>
            </div>
            <div class="tdah-card-body">
                {% if item.contenu %}
                <div class="tdah-contenu">{{ item.contenu }}</div>
                {% else %}
                <div class="tdah-contenu" style="color:#999; font-style:italic;">
                    Aucun contenu disponible pour cette leçon.
                </div>
                {% endif %}

                <div class="tdah-stars" id="stars-{{ loop.index0 }}">
                    <span onclick="tdahRate(event, {{ loop.index0 }}, 1)">⭐</span>
                    <span onclick="tdahRate(event, {{ loop.index0 }}, 2)">⭐</span>
                    <span onclick="tdahRate(event, {{ loop.index0 }}, 3)">⭐</span>
                </div>

                <div class="tdah-actions">
                    <button class="tdah-btn tdah-btn-audio"
                            onclick="tdahLire(event, {{ loop.index0 }}, '{{ item.contenu|default('')|e('js') }}', '{{ locale }}')">
                        🔊 Écouter
                    </button>
                    <button class="tdah-btn tdah-btn-compris"
                            onclick="tdahCompris(event, {{ loop.index0 }})">
                        ✅ J'ai compris !
                    </button>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="tdah-footer">
        <span class="tdah-footer-trophy">🏆</span>
        <h3>Tu avances super bien !</h3>
        <p>Lis chaque leçon et clique sur "J'ai compris" pour gagner des étoiles ⭐</p>
        <a href="{{ path('app_enfant_cours') }}" class="tdah-footer-btn">← Retour aux cours</a>
    </div>
    {% endif %}
</div>

<script>
var tdahTotal = {{ lecons|length }};
var tdahCompleted = new Array(tdahTotal).fill(false);

function tdahRate(e, idx, n) {
    e.stopPropagation();
    var stars = document.querySelectorAll('#stars-' + idx + ' span');
    stars.forEach(function(s, i) { s.classList.toggle('lit', i < n); });
}

function tdahCompris(e, idx) {
    e.stopPropagation();
    tdahCompleted[idx] = true;
    var check = document.getElementById('check-' + idx);
    if (check) check.classList.add('visible');
    tdahUpdateProgress();
}

function tdahUpdateProgress() {
    var count = tdahCompleted.filter(Boolean).length;
    var pct = tdahTotal > 0 ? Math.round((count / tdahTotal) * 100) : 0;
    var bar = document.getElementById('progressBar');
    var label = document.getElementById('progressLabel');

    if (bar) bar.style.width = pct + '%';
    if (label) label.textContent = count + ' leçon' + (count > 1 ? 's terminées' : ' terminée') + ' sur ' + tdahTotal;
}

function tdahLire(e, idx, texte, locale) {
    e.stopPropagation();
    if (!texte || !window.speechSynthesis) return;

    window.speechSynthesis.cancel();

    var utterance = new SpeechSynthesisUtterance(texte);

    if (locale === 'ar') {
        utterance.lang = 'ar-SA';
    } else if (locale === 'en') {
        utterance.lang = 'en-US';
    } else {
        utterance.lang = 'fr-FR';
    }

    utterance.rate = 0.9;
    window.speechSynthesis.speak(utterance);
}
</script>
{% endblock %}
