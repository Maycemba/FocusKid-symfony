{% extends 'base-front.html.twig' %}

{% block title %}FocusKid - Résultats{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            {# Carte de score #}
            <div class="card shadow-lg border-0 wow fadeInUp" data-wow-delay="0.1s">
                <div class="card-body text-center p-5">

                    {# Icône selon performance #}
                    {% if total > 0 %}
                        {% set pct = (score / total * 100)|round %}
                    {% else %}
                        {% set pct = 0 %}
                    {% endif %}

                    {% if pct >= 80 %}
                        <div class="mb-3" style="font-size:5rem;">🏆</div>
                        <h2 class="text-success mb-1">Excellent !</h2>
                    {% elseif pct >= 50 %}
                        <div class="mb-3" style="font-size:5rem;">👍</div>
                        <h2 class="text-primary mb-1">Bien joué !</h2>
                    {% else %}
                        <div class="mb-3" style="font-size:5rem;">💪</div>
                        <h2 class="text-warning mb-1">Continue à t'entraîner !</h2>
                    {% endif %}

                    <p class="text-muted mb-4">{{ jeu.titre }}</p>

                    {# Score principal #}
                    <div class="d-inline-block bg-light rounded-circle p-4 mb-4" style="width:160px;height:160px;">
                        <div class="d-flex flex-column align-items-center justify-content-center h-100">
                            <span class="display-4 fw-bold text-primary">{{ score }}</span>
                            <span class="text-muted">/ {{ total }}</span>
                        </div>
                    </div>

                    <p class="fs-5 mb-4">
                        Vous avez obtenu <strong class="text-primary">{{ score }} bonne{{ score > 1 ? 's' : '' }} réponse{{ score > 1 ? 's' : '' }}</strong>
                        sur <strong>{{ total }}</strong> question{{ total > 1 ? 's' : '' }}
                        <span class="badge bg-{% if pct >= 80 %}success{% elseif pct >= 50 %}primary{% else %}warning text-dark{% endif %} ms-2">
                            {{ pct }}%
                        </span>
                    </p>

                    {# Boutons d'action #}
                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        <a href="{{ path('app_front_jeu_play', {'id': jeu.id}) }}"
                           class="btn btn-primary rounded-pill py-2 px-4">
                            <i class="fa fa-redo me-2"></i>Rejouer
                        </a>
                        <a href="{{ path('app_front_jeu_list') }}"
                           class="btn btn-outline-secondary rounded-pill py-2 px-4">
                            <i class="fa fa-th-list me-2"></i>Tous les jeux
                        </a>
                    </div>
                </div>
            </div>

            {# Détail des réponses #}
            {% if details is defined and details|length > 0 %}
            <div class="mt-5 wow fadeInUp" data-wow-delay="0.3s">
                <h4 class="mb-4"><i class="fa fa-list-alt me-2 text-primary"></i>Détail des réponses</h4>

                {% for i, detail in details %}
                <div class="card mb-3 border-{% if detail.is_correct %}success{% else %}danger{% endif %}">
                    <div class="card-header bg-{% if detail.is_correct %}success{% else %}danger{% endif %} text-white d-flex align-items-center">
                        <span class="me-2">
                            {% if detail.is_correct %}
                                <i class="fa fa-check-circle"></i>
                            {% else %}
                                <i class="fa fa-times-circle"></i>
                            {% endif %}
                        </span>
                        <strong>Question {{ i + 1 }}</strong>
                        <span class="ms-auto badge bg-white text-{% if detail.is_correct %}success{% else %}danger{% endif %}">
                            {% if detail.is_correct %}Correct{% else %}Incorrect{% endif %}
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="fw-semibold mb-3">{{ detail.question }}</p>
                        <div class="row g-2">
                            <div class="col-sm-6">
                                <small class="text-muted d-block mb-1">Votre réponse :</small>
                                <span class="badge bg-{% if detail.is_correct %}success{% else %}danger{% endif %} px-3 py-2">
                                    {{ detail.chosen ?? '—' }}
                                </span>
                            </div>
                            {% if not detail.is_correct %}
                            <div class="col-sm-6">
                                <small class="text-muted d-block mb-1">Bonne réponse :</small>
                                <span class="badge bg-success px-3 py-2">
                                    {{ detail.bonne_reponse }}
                                </span>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% endif %}

        </div>
    </div>
</div>
{% endblock %}
