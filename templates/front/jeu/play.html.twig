{% extends 'base-front.html.twig' %}

{% block title %}FocusKid - Jouer : {{ jeu.titre }}{% endblock %}

{% block body %}
<div class="container py-5">

    {# Langue selector #}
    <div class="row justify-content-center mb-4">
        <div class="col-md-4 text-center">
            <label class="form-label fw-bold text-primary"><iconify-icon icon="solar:global-line-duotone"></iconify-icon> Choisir la langue du jeu</label>
            <select id="target-lang-selector" class="form-select border-primary text-primary fw-bold rounded-pill text-center">
                <option value="fr">Français 🇫🇷</option>
                <option value="en">Anglais 🇬🇧</option>
                <option value="ar">Arabe 🇸🇦</option>
            </select>
        </div>
    </div>

    {% if questions is empty %}
        <div class="alert alert-warning text-center">
            <i class="fa fa-exclamation-triangle me-2"></i>
            Ce jeu n'a pas encore de questions.
        </div>
        <div class="text-center mt-3">
            <a href="{{ path('app_front_jeu_list') }}" class="btn btn-secondary rounded-pill px-4">
                <i class="fa fa-arrow-left me-2"></i>Retour aux jeux
            </a>
        </div>
    {% else %}

        <form method="post" action="{{ path('app_front_jeu_play', {'id': jeu.id}) }}">

            {% for question in questions %}
            <div class="card shadow-sm mb-4 wow fadeInUp" data-wow-delay="{{ (loop.index0 * 0.1) }}s">
                <div class="card-header bg-primary text-white d-flex align-items-center">
                    <span class="badge bg-white text-primary me-3 fs-6">Q{{ loop.index }}</span>
                    <h5 class="mb-0 translatable" data-original="{{ question.questionText ?? question.question_text }}">
                        {{ question.questionText ?? question.question_text }}
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">

                        {% if question.optionA ?? question.option_a %}
                        <div class="col-12">
                            <div class="form-check option-card p-3 rounded border">
                                <input class="form-check-input"
                                       type="radio"
                                       name="answers[{{ question.id }}]"
                                       id="q{{ question.id }}_a"
                                       value="{{ question.optionA ?? question.option_a }}"
                                       required>
                                <label class="form-check-label w-100" for="q{{ question.id }}_a">
                                    <span class="badge bg-primary me-2">A</span>
                                    <span class="translatable" data-original="{{ question.optionA ?? question.option_a }}">
                                        {{ question.optionA ?? question.option_a }}
                                    </span>
                                </label>
                            </div>
                        </div>
                        {% endif %}

                        {% if question.optionB ?? question.option_b %}
                        <div class="col-12">
                            <div class="form-check option-card p-3 rounded border">
                                <input class="form-check-input"
                                       type="radio"
                                       name="answers[{{ question.id }}]"
                                       id="q{{ question.id }}_b"
                                       value="{{ question.optionB ?? question.option_b }}">
                                <label class="form-check-label w-100" for="q{{ question.id }}_b">
                                    <span class="badge bg-success me-2">B</span>
                                    <span class="translatable" data-original="{{ question.optionB ?? question.option_b }}">
                                        {{ question.optionB ?? question.option_b }}
                                    </span>
                                </label>
                            </div>
                        </div>
                        {% endif %}

                        {% if question.optionC ?? question.option_c %}
                        <div class="col-12">
                            <div class="form-check option-card p-3 rounded border">
                                <input class="form-check-input"
                                       type="radio"
                                       name="answers[{{ question.id }}]"
                                       id="q{{ question.id }}_c"
                                       value="{{ question.optionC ?? question.option_c }}">
                                <label class="form-check-label w-100" for="q{{ question.id }}_c">
                                    <span class="badge bg-warning text-dark me-2">C</span>
                                    <span class="translatable" data-original="{{ question.optionC ?? question.option_c }}">
                                        {{ question.optionC ?? question.option_c }}
                                    </span>
                                </label>
                            </div>
                        </div>
                        {% endif %}

                    </div>
                </div>
            </div>
            {% endfor %}

            {# Boutons #}
            <div class="d-flex justify-content-between mt-4">
                <a href="{{ path('app_front_jeu_list') }}" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="fa fa-arrow-left me-2"></i>Retour
                </a>
                <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fs-5">
                    <i class="fa fa-check-circle me-2"></i>Valider mes réponses
                </button>
            </div>

        </form>
    {% endif %}

    {# Script de traduction #}
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.8/dist/iconify-icon.min.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const langSelector = document.getElementById('target-lang-selector');
        const translatableElements = document.querySelectorAll('.translatable');
        let currentLang = 'fr';

        async function translateElement(el, targetLang) {
            const originalText = el.getAttribute('data-original');
            if (!originalText || targetLang === 'fr') {
                el.innerText = originalText;
                return;
            }

            // Afficher un petit indicateur de chargement
            const originalHTML = el.innerHTML;
            el.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';

            try {
                const response = await fetch('{{ path("api_translate_index") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        text: originalText,
                        sourceLang: 'fr',
                        targetLang: targetLang
                    })
                });

                const data = await response.json();
                if (data.translated) {
                    el.innerText = data.translated;
                } else {
                    el.innerHTML = originalText;
                }
            } catch (error) {
                console.error('Erreur traduction:', error);
                el.innerText = originalText;
            }
        }

        langSelector.addEventListener('change', async function() {
            const targetLang = this.value;

            const promises = Array.from(translatableElements).map(el => {
                return translateElement(el, targetLang);
            });

            await Promise.all(promises);
        });
    });
    </script>

</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .option-card {
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .option-card:hover {
        background-color: #f0f4ff;
        border-color: #0d6efd !important;
    }
    .option-card .form-check-input:checked ~ label {
        font-weight: 600;
    }
    .option-card:has(.form-check-input:checked) {
        background-color: #e7f0ff;
        border-color: #0d6efd !important;
    }
</style>
{% endblock %}
