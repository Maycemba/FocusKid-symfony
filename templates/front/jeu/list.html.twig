{% extends 'base-front.html.twig' %}

{% block title %}FocusKid - Jeux Disponibles{% endblock %}

{% block body %}
<div class="container-xxl py-5">
    <div class="container">

        {# En-tête #}
        <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
            <p class="d-inline-block bg-secondary text-primary py-1 px-4">Jouer</p>
            <h1 class="mb-3">Choisissez un Jeu 🎮</h1>
            <p>Sélectionnez un jeu et répondez aux questions. Vous verrez votre score à la fin !</p>
        </div>

        {# Barre de Recherche et Tri #}
        <div class="row g-3 mb-5 wow fadeInUp" data-wow-delay="0.3s">
            <div class="col-lg-8">
                <form action="{{ path('app_front_jeu_list') }}" method="GET" class="d-flex shadow-sm rounded overflow-hidden">
                    <input type="text" name="search" class="form-control border-0 py-3" 
                           placeholder="Rechercher un thème, un titre..." value="{{ current_search }}">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa fa-search"></i>
                    </button>
                    {% if current_search %}
                        <a href="{{ path('app_front_jeu_list') }}" class="btn btn-outline-secondary d-flex align-items-center px-3 border-0">
                            <i class="fa fa-times"></i>
                        </a>
                    {% endif %}
                </form>
            </div>
            <div class="col-lg-4">
                <div class="dropdown h-100">
                    <button class="btn btn-light w-100 h-100 shadow-sm dropdown-toggle d-flex align-items-center justify-content-between px-3" 
                            type="button" data-bs-toggle="dropdown">
                        <span>
                            <i class="fa fa-sort-amount-down me-2 text-primary"></i>
                            Trier par : 
                            <strong>
                                {% if current_sort == 'asc' %}A-Z
                                {% elseif current_sort == 'desc' %}Z-A
                                {% elseif current_sort == 'niveau' %}Niveau
                                {% endif %}
                            </strong>
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end w-100 shadow border-0 mt-2">
                        <li>
                            <a class="dropdown-item {{ current_sort == 'asc' ? 'active' : '' }}" 
                               href="{{ path('app_front_jeu_list', {search: current_search, sort: 'asc'}) }}">
                                <i class="fa fa-sort-alpha-down me-2"></i>Ordre alphabétique (A-Z)
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item {{ current_sort == 'desc' ? 'active' : '' }}" 
                               href="{{ path('app_front_jeu_list', {search: current_search, sort: 'desc'}) }}">
                                <i class="fa fa-sort-alpha-up me-2"></i>Ordre inverse (Z-A)
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item {{ current_sort == 'niveau' ? 'active' : '' }}" 
                               href="{{ path('app_front_jeu_list', {search: current_search, sort: 'niveau'}) }}">
                                <i class="fa fa-layer-group me-2"></i>Par Niveau d'apprentissage
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        {% if jeus is empty %}
            <div class="alert alert-warning text-center" role="alert">
                <i class="fa fa-exclamation-triangle me-2"></i>
                Aucun jeu n'est disponible pour le moment. Revenez bientôt !
            </div>
        {% else %}
            <div class="row g-4">
                {% for jeu in jeus %}
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="{{ (loop.index0 % 3) * 0.2 + 0.1 }}s">
                    <div class="classes-item h-100">
                        {# Icône selon le type de jeu #}
                        <div class="bg-light rounded p-4 d-flex flex-column h-100">
                            <div class="text-center mb-3">
                                <div class="bg-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width:70px;height:70px;">
                                    <i class="fa fa-gamepad fa-2x text-white"></i>
                                </div>
                            </div>

                            <h3 class="text-center mb-2">{{ jeu.titre ?? 'Jeu sans titre' }}</h3>

                            <div class="row g-2 mb-3">
                                {% if jeu.type %}
                                <div class="col-6">
                                    <div class="border-top border-3 border-primary pt-2">
                                        <h6 class="text-primary mb-1"><i class="fa fa-tag me-1"></i>Type :</h6>
                                        <small>{{ jeu.type }}</small>
                                    </div>
                                </div>
                                {% endif %}
                                {% if jeu.niveau %}
                                <div class="col-6">
                                    <div class="border-top border-3 border-success pt-2">
                                        <h6 class="text-success mb-1"><i class="fa fa-signal me-1"></i>Niveau :</h6>
                                        <small>{{ jeu.niveau }}</small>
                                    </div>
                                </div>
                                {% endif %}
                            </div>

                            <div class="text-center mt-2 mb-3">
                                {% set nb_questions = jeu.questions|length %}
                                <span class="badge bg-secondary px-3 py-2">
                                    <i class="fa fa-question-circle me-1"></i>
                                    {{ nb_questions }} question{{ nb_questions > 1 ? 's' : '' }}
                                </span>
                            </div>

                            <div class="mt-auto text-center">
                                {% if jeu.questions|length > 0 %}
                                    <a href="{{ path('app_front_jeu_play', {'id': jeu.id}) }}"
                                       class="btn btn-primary rounded-pill py-2 px-4">
                                        <i class="fa fa-play me-2"></i>Jouer
                                    </a>
                                {% else %}
                                    <button class="btn btn-secondary rounded-pill py-2 px-4" disabled>
                                        <i class="fa fa-times me-2"></i>Pas de questions
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>

            {# Affichage de la Pagination #}
            <div class="mt-5 d-flex justify-content-center">
                <div class="pagination-container shadow-sm p-3 bg-white rounded-pill">
                    {{ knp_pagination_render(jeus) }}
                </div>
            </div>
        {% endif %}

    </div>
</div>
{% endblock %}
