{% extends 'front/base-front.html.twig' %}

{% block title %}Jeu de mémoire - FocusKid{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .game-container {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 600px;
            border-radius: 20px;
            padding: 30px;
        }
        .memory-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 32px;
            min-height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .memory-card:hover { transform: scale(1.05); }
        .memory-card.flipped { background: #C8E6C9; }
        .memory-card.matched { background: #81C784; cursor: default; opacity: 0.6; }
        .score-board { background: white; border-radius: 15px; padding: 15px; margin-bottom: 20px; }
        .btn-game { background: #FF9800; color: white; border-radius: 25px; padding: 10px 25px; border: none; }
        .btn-game:hover { background: #F57C00; }
    </style>
{% endblock %}

{% block body %}
<div class="container-xxl py-5">
    <div class="container">
        <div class="game-container">
            <div class="score-board d-flex justify-content-between align-items-center">
                <h3>🎴 Jeu de Mémoire</h3>
                <div>
                    <span class="me-3">⭐ Score: <span id="score">0</span></span>
                    <span>⏱️ Temps: <span id="timer">00:00</span></span>
                </div>
            </div>
            
            <div class="text-center mb-4"><p id="message" class="text-white"></p></div>
            
            <div class="row" id="memoryGrid"></div>
            
            <div class="text-center mt-4">
                <a href="{{ path('app_front_exercice_index') }}" class="btn-game">⬅️ Retour aux exercices</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const exercice = {{ exercice|json_encode|raw }};
        const config = JSON.parse(exercice.contenu);
        
        let cards = [], flippedCards = [], matchedPairs = 0, score = 0, canFlip = true, timer = 0, timerInterval = null;
        
        function initGame() {
            const theme = config.theme || 'animaux';
            const taille = config.taille || '4x4';
            const images = { animaux: ['🐶','🐱','🐭','🐹','🐰','🦊','🐻','🐼'], fruits: ['🍎','🍐','🍊','🍋','🍌','🍉','🍇','🍓'], chiffres: ['1️⃣','2️⃣','3️⃣','4️⃣','5️⃣','6️⃣','7️⃣','8️⃣'] }[theme] || images.animaux;
            const totalPairs = taille === '4x4' ? 8 : 18;
            let cardsData = [];
            for (let i = 0; i < totalPairs; i++) { const img = images[i % images.length]; cardsData.push({ id: i*2, value: img, matched: false, flipped: false }); cardsData.push({ id: i*2+1, value: img, matched: false, flipped: false }); }
            cards = shuffle(cardsData);
            matchedPairs = 0; score = 0; updateScore();
            renderGrid();
            startTimer();
        }
        
        function shuffle(array) { for (let i = array.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [array[i], array[j]] = [array[j], array[i]]; } return array; }
        
        function renderGrid() {
            const grid = document.getElementById('memoryGrid');
            grid.innerHTML = '';
            const cols = config.taille === '4x4' ? 4 : 6;
            grid.style.display = 'grid';
            grid.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
            grid.style.gap = '15px';
            cards.forEach((card, index) => {
                const cardDiv = document.createElement('div');
                cardDiv.className = 'memory-card';
                if (card.flipped) cardDiv.classList.add('flipped');
                if (card.matched) cardDiv.classList.add('matched');
                cardDiv.textContent = card.flipped || card.matched ? card.value : '?';
                cardDiv.onclick = () => flipCard(index);
                grid.appendChild(cardDiv);
            });
        }
        
        function flipCard(index) {
            if (!canFlip || cards[index].matched || cards[index].flipped || flippedCards.length >= 2) return;
            cards[index].flipped = true;
            renderGrid();
            flippedCards.push(index);
            if (flippedCards.length === 2) checkMatch();
        }
        
        function checkMatch() {
            const card1 = cards[flippedCards[0]], card2 = cards[flippedCards[1]];
            if (card1.value === card2.value) {
                card1.matched = true; card2.matched = true;
                matchedPairs++; score += config.pointsParPaire || 10;
                updateScore();
                flippedCards = [];
                renderGrid();
                document.getElementById('message').innerHTML = '✅ Bravo ! Paire trouvée !';
                setTimeout(() => document.getElementById('message').innerHTML = '', 1000);
                if (matchedPairs === cards.length / 2) endGame(true);
            } else {
                canFlip = false;
                document.getElementById('message').innerHTML = '❌ Ce n\'est pas une paire...';
                setTimeout(() => {
                    cards[flippedCards[0]].flipped = false;
                    cards[flippedCards[1]].flipped = false;
                    flippedCards = [];
                    renderGrid();
                    canFlip = true;
                    document.getElementById('message').innerHTML = '';
                }, 1000);
            }
        }
        
        function updateScore() { document.getElementById('score').textContent = score; }
        
        function startTimer() {
            if (timerInterval) clearInterval(timerInterval);
            timer = 0;
            updateTimerDisplay();
            timerInterval = setInterval(() => { timer++; updateTimerDisplay(); }, 1000);
        }
        
        function updateTimerDisplay() { const m = Math.floor(timer / 60), s = timer % 60; document.getElementById('timer').textContent = `${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`; }
        
        function endGame(won) { if (timerInterval) clearInterval(timerInterval); if (won) document.getElementById('message').innerHTML = '🎉 Félicitations ! Tu as gagné ! 🎉'; }
        
        initGame();
    </script>
{% endblock %}