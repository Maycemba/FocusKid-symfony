{% extends 'base-front.html.twig' %}

{% block title %}Jeu de mémoire - FocusKid{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .game-container {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 600px;
            border-radius: 20px;
            padding: 30px;
        }
        .memory-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 32px;
            min-height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .memory-card:hover { transform: scale(1.05); }
        .memory-card.flipped { background: #C8E6C9; }
        .memory-card.matched { background: #81C784; cursor: default; opacity: 0.6; }
        .score-board { background: white; border-radius: 15px; padding: 15px; margin-bottom: 20px; }
        .btn-game { background: #FF9800; color: white; border-radius: 25px; padding: 10px 25px; border: none; text-decoration: none; display: inline-block; }
        .btn-game:hover { background: #F57C00; }
    </style>
{% endblock %}

{% block body %}
<div class="container-xxl py-5">
    <div class="container">
        <div class="game-container">
            <div class="score-board d-flex justify-content-between align-items-center">
                <h3>🎴 Jeu de Mémoire</h3>
                <div>
                    <span class="me-3">⭐ Score: <span id="score">0</span></span>
                    <span>⏱️ Temps: <span id="timer">00:00</span></span>
                </div>
            </div>
            
            <div class="text-center mb-4"><p id="message" class="text-white"></p></div>
            
            <div class="row" id="memoryGrid"></div>
            
            <div class="text-center mt-4">
                <a href="{{ path('app_front_exercice_index') }}" class="btn-game">⬅️ Retour aux exercices</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Récupérer les données depuis Twig
        const exerciceId = {{ exercice.id }};
        const questionsData = {{ questions|default([])|json_encode|raw }};
        
        let cards = [];
        let flippedCards = [];
        let matchedPairs = 0;
        let score = 0;
        let canFlip = true;
        let timer = 0;
        let timerInterval = null;
        let gameActive = true;
        let gameFinished = false;
        let reponsesDonnees = [];
        
        let pointsParPaire = 10;
        
        function initGame() {
            if (!questionsData || questionsData.length === 0) {
                console.log('❌ Aucune donnée pour le jeu Mémoire');
                return;
            }
            
            // Construire les cartes à partir des données
            let cardsData = [];
            for (let i = 0; i < questionsData.length; i++) {
                const valeur = questionsData[i].valeur || questionsData[i].image || '?';
                cardsData.push({ id: i*2, value: valeur, matched: false, flipped: false });
                cardsData.push({ id: i*2+1, value: valeur, matched: false, flipped: false });
            }
            
            cards = shuffle(cardsData);
            matchedPairs = 0;
            score = 0;
            gameActive = true;
            gameFinished = false;
            updateScore();
            renderGrid();
            startTimer();
        }
        
        function shuffle(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }
        
        function renderGrid() {
            const grid = document.getElementById('memoryGrid');
            if (!grid) return;
            grid.innerHTML = '';
            const cols = 4;
            grid.style.display = 'grid';
            grid.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
            grid.style.gap = '15px';
            
            cards.forEach((card, index) => {
                const cardDiv = document.createElement('div');
                cardDiv.className = 'memory-card';
                if (card.flipped) cardDiv.classList.add('flipped');
                if (card.matched) cardDiv.classList.add('matched');
                cardDiv.textContent = (card.flipped || card.matched) ? card.value : '?';
                cardDiv.onclick = () => flipCard(index);
                grid.appendChild(cardDiv);
            });
        }
        
        function flipCard(index) {
            if (!gameActive || gameFinished) return;
            if (!canFlip || cards[index].matched || cards[index].flipped || flippedCards.length >= 2) return;
            
            cards[index].flipped = true;
            renderGrid();
            flippedCards.push(index);
            if (flippedCards.length === 2) checkMatch();
        }
        
        function checkMatch() {
            const card1 = cards[flippedCards[0]];
            const card2 = cards[flippedCards[1]];
            
            if (card1.value === card2.value) {
                card1.matched = true;
                card2.matched = true;
                matchedPairs++;
                score += pointsParPaire;
                updateScore();
                
                reponsesDonnees.push({
                    paire: card1.value,
                    reussie: true
                });
                
                flippedCards = [];
                renderGrid();
                const msg = document.getElementById('message');
                if (msg) msg.innerHTML = '✅ Bravo ! Paire trouvée !';
                setTimeout(() => { if(msg) msg.innerHTML = ''; }, 1000);
                
                if (matchedPairs === cards.length / 2) {
                    finishGame(true);
                }
            } else {
                canFlip = false;
                
                reponsesDonnees.push({
                    paire1: card1.value,
                    paire2: card2.value,
                    reussie: false
                });
                
                const msg = document.getElementById('message');
                if (msg) msg.innerHTML = '❌ Ce n\'est pas une paire...';
                setTimeout(() => {
                    cards[flippedCards[0]].flipped = false;
                    cards[flippedCards[1]].flipped = false;
                    flippedCards = [];
                    renderGrid();
                    canFlip = true;
                    if(msg) msg.innerHTML = '';
                }, 1000);
            }
        }
        
        function updateScore() {
            const scoreSpan = document.getElementById('score');
            if (scoreSpan) scoreSpan.textContent = score;
        }
        
        function startTimer() {
            if (timerInterval) clearInterval(timerInterval);
            timer = 0;
            updateTimerDisplay();
            timerInterval = setInterval(() => {
                if (gameActive && !gameFinished) {
                    timer++;
                    updateTimerDisplay();
                }
            }, 1000);
        }
        
        function updateTimerDisplay() {
            const m = Math.floor(timer / 60), s = timer % 60;
            const timerSpan = document.getElementById('timer');
            if (timerSpan) timerSpan.textContent = `${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
        }
        
        function saveGameResult() {
            if (gameFinished) return Promise.resolve(false);
            gameFinished = true;
            
            const totalPairs = cards.length / 2;
            const reussite = (matchedPairs === totalPairs);
            
            const reponsesData = {
                type: 'memoire',
                total_paires: totalPairs,
                paires_trouvees: matchedPairs,
                temps_total: timer,
                score_final: score,
                details: reponsesDonnees
            };
            
            return fetch('/exercice/api/exercice-complete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    exercice_id: exerciceId,
                    enfant_id: 1,
                    score: score,
                    temps_passe: timer,
                    reponses: reponsesData,
                    reussite: reussite
                })
            })
            .then(response => response.json())
            .then(data => {
                console.log('✅ Enregistré:', data);
                return data.success;
            })
            .catch(error => {
                console.error('❌ Erreur:', error);
                return false;
            });
        }
        
        function finishGame(won) {
            if (!gameActive || gameFinished) return;
            
            gameActive = false;
            if (timerInterval) clearInterval(timerInterval);
            
            const msg = document.getElementById('message');
            if (msg) msg.innerHTML = '📝 Sauvegarde en cours...';
            
            saveGameResult().then(success => {
                if (success) {
                    alert('🎉 Jeu terminé et enregistré !');
                } else {
                    alert('⚠️ Jeu terminé mais erreur lors de l\'enregistrement.');
                }
                window.location.href = "{{ path('app_front_exercice_index') }}";
            });
        }
        
        // Démarrer le jeu
        if (document.getElementById('memoryGrid')) {
            initGame();
        }
    </script>
{% endblock %}