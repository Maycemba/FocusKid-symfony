{% extends 'base-front1.html.twig' %}

{% block title %}Jeu Chrono - FocusKid{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .game-container {
            background: linear-gradient(135deg, #F44336 0%, #D32F2F 100%);
            min-height: 600px;
            border-radius: 20px;
            padding: 30px;
        }
        .score-board {
            background: white;
            border-radius: 15px;
            padding: 15px;
            margin-bottom: 20px;
        }
        .defi-card {
            background: #E3F2FD;
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            font-size: 28px;
            font-weight: bold;
            color: #1565C0;
            margin-bottom: 30px;
        }
        .reponse-input {
            border-radius: 25px;
            padding: 15px 20px;
            font-size: 18px;
            border: 2px solid #E0E0E0;
            width: 100%;
            max-width: 400px;
            margin: 0 auto;
            display: block;
        }
        .reponse-input:focus {
            border-color: #FF9800;
            outline: none;
        }
        .btn-valider {
            background: #4CAF50;
            color: white;
            border-radius: 25px;
            padding: 12px 30px;
            border: none;
            font-size: 16px;
            margin-top: 15px;
            cursor: pointer;
            transition: transform 0.2s;
        }
        .btn-valider:hover {
            background: #45a049;
            transform: scale(1.05);
        }
        .btn-terminer {
            background: #2196F3;
            color: white;
            border-radius: 25px;
            padding: 10px 25px;
            border: none;
            margin-right: 10px;
            cursor: pointer;
        }
        .btn-terminer:hover {
            background: #1976D2;
        }
        .btn-game {
            background: #FF9800;
            color: white;
            border-radius: 25px;
            padding: 10px 25px;
            border: none;
            text-decoration: none;
            display: inline-block;
        }
        .btn-game:hover {
            background: #F57C00;
            color: white;
        }
        .chrono-warning {
            color: #F44336;
            font-weight: bold;
            font-size: 18px;
        }
        
        /* ========== STYLES VOIX ========== */
        .voice-controls {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .voice-toggle {
            background: #2196F3;
            color: white;
            border: none;
            border-radius: 25px;
            padding: 5px 15px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.3s;
        }
        .voice-toggle:hover {
            background: #1976D2;
            transform: scale(1.05);
        }
        .voice-active {
            background: #4CAF50;
        }
        .voice-active:hover {
            background: #45a049;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-xxl py-5">
    <div class="container">
        <div class="game-container">
            <div class="score-board d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <h3 class="mb-0 me-3">⏱️ Jeu Chrono</h3>
                    <div class="voice-controls">
                        <button id="voiceToggleBtn" class="voice-toggle" title="Activer/désactiver la voix">🔊 Voix ON</button>
                    </div>
                </div>
                <div>
                    <span class="me-3">⭐ Score: <span id="score">0</span></span>
                    <span id="chronoTimer" class="chrono-warning">⏱️ 00:00</span>
                </div>
            </div>
            
            <div class="defi-card" id="defiText">
                Chargement...
            </div>
            
            <div class="text-center">
                <input type="text" id="reponseInput" class="reponse-input" placeholder="Tape ta réponse ici...">
                <br>
                <button id="validerBtn" class="btn-valider">✅ Valider</button>
            </div>
            
            <div class="text-center mt-4">
                <p id="message" style="color: white;"></p>
            </div>
            
            <div class="text-center mt-4">
                <a href="{{ path('app_front_exercice_index') }}" class="btn-game">⬅️ Retour aux exercices</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Récupérer les données depuis Twig
        const exerciceId = {{ exercice.id }};
        const questionsData = {{ questions|default([])|json_encode|raw }};
        
        let questions = [];
        let currentQuestionIndex = 0;
        let score = 0;
        let timer = 0;
        let timerInterval = null;
        let gameActive = true;
        let reponsesDonnees = [];
        let gameFinished = false;
        
        // Paramètres
        let pointsParQuestion = 10;
        let penalite = 5;
        let tempsMax = 120;
        
        // ========== SYNTHÈSE VOCALE ==========
        let speechEnabled = true;
        let speechSynthesis = window.speechSynthesis;
        let currentUtterance = null;
        
        function initVoice() {
            if (!speechSynthesis) {
                speechEnabled = false;
                const btn = document.getElementById('voiceToggleBtn');
                if (btn) btn.style.opacity = '0.5';
                return;
            }
            const saved = localStorage.getItem('voice_enabled');
            if (saved !== null) speechEnabled = saved === 'true';
            updateVoiceButton();
        }
        
        function updateVoiceButton() {
            const btn = document.getElementById('voiceToggleBtn');
            if (!btn) return;
            if (speechEnabled) {
                btn.innerHTML = '🔊 Voix ON';
                btn.classList.add('voice-active');
            } else {
                btn.innerHTML = '🔇 Voix OFF';
                btn.classList.remove('voice-active');
            }
        }
        
        function speakText(text) {
            if (!speechEnabled) return;
            if (currentUtterance) speechSynthesis.cancel();
            currentUtterance = new SpeechSynthesisUtterance(text);
            currentUtterance.lang = 'fr-FR';
            currentUtterance.rate = 0.9;
            currentUtterance.pitch = 1.1;
            currentUtterance.volume = 1;
            speechSynthesis.speak(currentUtterance);
        }
        
        function speakQuestion(question) {
            let cleanQuestion = question
                .replace(/[?]/g, ' point d\'interrogation')
                .replace(/[+]/g, ' plus ')
                .replace(/[-]/g, ' moins ')
                .replace(/[*]/g, ' fois ')
                .replace(/[/]/g, ' divisé par ')
                .replace(/[=]/g, ' égale ');
            speakText(cleanQuestion);
        }
        
        function speakSuccess() {
            const messages = ['Bravo', 'Très bien', 'Excellent', 'Super', 'Bonne réponse'];
            speakText(messages[Math.floor(Math.random() * messages.length)]);
        }
        
        function speakError(correctAnswer) {
            const messages = ['Essaie encore', 'Réessaie', 'Concentre-toi'];
            speakText(messages[Math.floor(Math.random() * messages.length)] + '. La bonne réponse était ' + correctAnswer);
        }
        
        function speakStartGame() {
            speakText('Jeu chrono. Répondez aux questions le plus vite possible.');
        }
        
        // ========== FONCTIONS DU JEU ==========
        function loadQuestions() {
            if (questionsData && questionsData.length > 0) {
                questions = questionsData;
                console.log('✅ ' + questions.length + ' questions chargées');
                return true;
            }
            return false;
        }
        
        function loadQuestion() {
            if (!gameActive) return;
            
            if (currentQuestionIndex < questions.length) {
                const currentQ = questions[currentQuestionIndex];
                const questionTexte = currentQ.question || currentQ.texte || 'Question';
                
                const defiDiv = document.getElementById('defiText');
                if (defiDiv) defiDiv.innerHTML = questionTexte;
                
                const inputField = document.getElementById('reponseInput');
                if (inputField) {
                    inputField.value = '';
                    inputField.disabled = false;
                    inputField.focus();
                }
                
                const validerBtn = document.getElementById('validerBtn');
                if (validerBtn) validerBtn.disabled = false;
                
                const msgDiv = document.getElementById('message');
                if (msgDiv) msgDiv.innerHTML = `Question ${currentQuestionIndex + 1}/${questions.length}`;
                
                // Lire la question à voix haute
                setTimeout(() => {
                    speakQuestion(questionTexte);
                }, 300);
            } else {
                finishGame();
            }
        }
        
        function verifierReponse() {
            if (!gameActive || gameFinished) return;
            
            const reponseInput = document.getElementById('reponseInput');
            if (!reponseInput || reponseInput.disabled) return;
            
            const userReponse = reponseInput.value.trim();
            const currentQuestion = questions[currentQuestionIndex];
            
            if (!currentQuestion) return;
            
            const bonneReponse = currentQuestion.reponse || '';
            
            reponsesDonnees.push({
                question: currentQuestion.question,
                reponse_donnee: userReponse,
                reponse_attendue: bonneReponse,
                est_correcte: (userReponse === bonneReponse)
            });
            
            if (userReponse === bonneReponse) {
                const points = currentQuestion.points || pointsParQuestion;
                score += points;
                updateScore();
                const msgDiv = document.getElementById('message');
                if (msgDiv) msgDiv.innerHTML = '✅ Bonne réponse ! +' + points + ' points';
                speakSuccess();
                currentQuestionIndex++;
                loadQuestion();
            } else {
                score = Math.max(0, score - penalite);
                updateScore();
                const msgDiv = document.getElementById('message');
                if (msgDiv) msgDiv.innerHTML = `❌ Mauvaise réponse ! -${penalite} points`;
                speakError(bonneReponse);
                currentQuestionIndex++;
                loadQuestion();
            }
        }
        
        function updateScore() {
            const scoreSpan = document.getElementById('score');
            if (scoreSpan) scoreSpan.textContent = score;
        }
        
        function startTimer() {
            if (timerInterval) clearInterval(timerInterval);
            timer = 0;
            updateTimerDisplay();
            timerInterval = setInterval(() => {
                if (gameActive && !gameFinished) {
                    timer++;
                    updateTimerDisplay();
                    if (timer >= tempsMax) finishGame();
                }
            }, 1000);
        }
        
        function updateTimerDisplay() {
            const m = Math.floor(timer / 60);
            const s = timer % 60;
            const timerElement = document.getElementById('chronoTimer');
            if (timerElement) {
                timerElement.innerHTML = `⏱️ ${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
                if (timer >= tempsMax) timerElement.style.color = '#FF9800';
            }
        }
        
        function saveGameResult() {
            if (gameFinished) return Promise.resolve(false);
            gameFinished = true;
            
            const reponsesData = {
                type: 'chrono',
                total_questions: questions.length,
                questions_repondues: currentQuestionIndex,
                reponses_utilisateur: reponsesDonnees,
                temps_total: timer,
                score_final: score
            };
            
            return fetch('/exercice/api/exercice-complete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    exercice_id: exerciceId,
                    enfant_id: {{ app.user.id ?? 1 }},
                    score: score,
                    temps_passe: timer,
                    reponses: reponsesData,
                    reussite: (currentQuestionIndex >= questions.length)
                })
            })
            .then(response => response.json())
            .then(data => {
                console.log('✅ Enregistré:', data);
                return data.success;
            })
            .catch(error => {
                console.error('❌ Erreur:', error);
                return false;
            });
        }
        
        function finishGame() {
            if (!gameActive || gameFinished) return;
            
            gameActive = false;
            if (timerInterval) clearInterval(timerInterval);
            
            const inputField = document.getElementById('reponseInput');
            if (inputField) inputField.disabled = true;
            
            const validerBtn = document.getElementById('validerBtn');
            if (validerBtn) validerBtn.disabled = true;
            
            const defiDiv = document.getElementById('defiText');
            if (defiDiv) defiDiv.innerHTML = `🎉 Jeu terminé ! Score final : ${score} 🎉`;
            
            const msgDiv = document.getElementById('message');
            if (msgDiv) msgDiv.innerHTML = '📝 Sauvegarde en cours...';
            
            speakText('Jeu terminé. Votre score final est ' + score);
            
            saveGameResult().then(success => {
                if (success) {
                    alert('🎉 Exercice terminé et enregistré !');
                } else {
                    alert('⚠️ Exercice terminé mais erreur lors de l\'enregistrement.');
                }
                window.location.href = "{{ path('app_front_exercice_index') }}";
            });
        }
        
        // ========== INITIALISATION ==========
        document.addEventListener('DOMContentLoaded', function() {
            initVoice();
            
            const hasQuestions = loadQuestions();
            
            if (hasQuestions && questions.length > 0) {
                loadQuestion();
                startTimer();
                speakStartGame();
            } else {
                const defiDiv = document.getElementById('defiText');
                if (defiDiv) defiDiv.innerHTML = '❌ Aucune question trouvée pour cet exercice.';
                const inputField = document.getElementById('reponseInput');
                if (inputField) inputField.disabled = true;
                const validerBtn = document.getElementById('validerBtn');
                if (validerBtn) validerBtn.disabled = true;
            }
            
            const validerBtn = document.getElementById('validerBtn');
            if (validerBtn) validerBtn.addEventListener('click', verifierReponse);
            
            const inputField = document.getElementById('reponseInput');
            if (inputField) {
                inputField.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        verifierReponse();
                    }
                });
            }
            
            const voiceBtn = document.getElementById('voiceToggleBtn');
            if (voiceBtn) {
                voiceBtn.addEventListener('click', () => {
                    speechEnabled = !speechEnabled;
                    localStorage.setItem('voice_enabled', speechEnabled);
                    updateVoiceButton();
                    if (speechEnabled) speakText('Voix activée');
                    else if (currentUtterance) speechSynthesis.cancel();
                });
            }
        });
    </script>
{% endblock %}