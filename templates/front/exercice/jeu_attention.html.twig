{% extends 'base-front.html.twig' %}

{% block title %}Jeu d'Attention - Intrus - FocusKid{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .game-container {
            background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
            min-height: 600px;
            border-radius: 20px;
            padding: 30px;
        }
        .attention-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 32px;
            min-height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }
        .attention-card:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }
        .attention-card.selected {
            background: #C8E6C9;
            border: 3px solid #4CAF50;
        }
        .attention-card.wrong {
            background: #FFCDD2;
            border: 3px solid #F44336;
        }
        .score-board {
            background: white;
            border-radius: 15px;
            padding: 15px;
            margin-bottom: 20px;
        }
        .progress-bar-custom {
            height: 10px;
            background: #E0E0E0;
            border-radius: 5px;
            overflow: hidden;
            margin-top: 10px;
        }
        .progress-fill {
            height: 100%;
            background: #4CAF50;
            width: 100%;
            transition: width 0.3s;
        }
        .btn-game {
            background: #FF9800;
            color: white;
            border-radius: 25px;
            padding: 10px 25px;
            border: none;
            text-decoration: none;
            display: inline-block;
        }
        .btn-game:hover {
            background: #F57C00;
        }
        .question-text {
            font-size: 28px;
            margin-bottom: 20px;
            padding: 15px;
            background: rgba(255,255,255,0.2);
            border-radius: 15px;
        }
        .message-success { color: #4CAF50; font-weight: bold; }
        .message-error { color: #F44336; font-weight: bold; }
        
        .voice-controls {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .voice-toggle {
            background: #2196F3;
            color: white;
            border: none;
            border-radius: 25px;
            padding: 5px 15px;
            font-size: 12px;
            cursor: pointer;
        }
        .voice-active { background: #4CAF50; }
        
        .camera-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 220px;
            height: 165px;
            background: #1a1a2e;
            border-radius: 15px;
            z-index: 1000;
            overflow: hidden;
            border: 3px solid #00b894;
        }
        .camera-container.violation { border-color: #d63031; }
        .camera-container video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .violation-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            background: #d63031;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            display: none;
        }
        .face-status {
            position: absolute;
            bottom: 10px;
            left: 10px;
            right: 10px;
            text-align: center;
            background: rgba(0,0,0,0.7);
            color: white;
            font-size: 11px;
            padding: 5px;
            border-radius: 10px;
        }
        .face-status.success { background: #00b894; }
        .face-status.alert { background: #d63031; }
        
        .game-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.9);
            z-index: 2000;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .game-overlay-content {
            background: white;
            border-radius: 30px;
            padding: 40px;
            text-align: center;
            max-width: 400px;
        }
        .game-overlay-content h2 { color: #d63031; margin-bottom: 20px; }
        .game-overlay-content .spinner {
            width: 50px;
            height: 50px;
            border: 5px solid #f3f3f3;
            border-top: 5px solid #2196F3;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 20px auto;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-xxl py-5">
    <div class="container">
        <div class="game-container">
            <div class="score-board d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <h3 class="mb-0 me-3">🔍 Jeu d'Attention - Trouve l'intrus</h3>
                    <div class="voice-controls">
                        <button id="voiceToggleBtn" class="voice-toggle">🔊 Voix ON</button>
                    </div>
                </div>
                <div>
                    <span class="me-3">⭐ Score: <span id="score">0</span></span>
                    <span>⏱️ Question: <span id="questionNum">1</span>/<span id="totalQuestions">0</span></span>
                    <span class="ms-3">⏱️ Temps: <span id="timer">00:00</span></span>
                </div>
            </div>
            
            <div class="progress-bar-custom">
                <div class="progress-fill" id="progressFill"></div>
            </div>
            
            <div class="text-center mt-3 mb-4">
                <div class="question-text" id="questionText"></div>
                <p id="message" class="message-success"></p>
            </div>
            
            <div class="row" id="imagesGrid"></div>
            
            <div class="text-center mt-4">
                <a href="{{ path('app_front_exercice_index') }}" class="btn-game">⬅️ Retour aux exercices</a>
            </div>
        </div>
    </div>
</div>

<div id="cameraContainer" class="camera-container">
    <video id="surveillanceVideo" autoplay muted playsinline></video>
    <div id="violationBadge" class="violation-badge">⚠️ ALERTE</div>
    <div class="face-status">
        <span id="faceStatus">🔍 Vérification...</span>
    </div>
</div>

<div id="gameOverlay" class="game-overlay" style="display: flex;">
    <div class="game-overlay-content">
        <h2>🔒 Vérification requise</h2>
        <p>Veuillez vous placer face à la caméra pour démarrer le jeu.</p>
        <div class="spinner"></div>
        <div id="overlayStatus">🔍 Détection en cours...</div>
        <div id="detectedAge" style="margin-top: 15px; font-size: 14px; color: #666;"></div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
    <script>
        // ========== DONNÉES DEPUIS SYMFONY ==========
        const exerciceId = {{ exercice.id }};
        const questionsData = {{ questions|default([])|json_encode|raw }};
        
        console.log('📦 Données questions:', questionsData);
        
        // ========== VARIABLES JEU ==========
        let currentQuestionIndex = 0;
        let questions = [];
        let score = 0;
        let timer = 0;
        let timerInterval = null;
        let gameActive = true;
        let gameFinished = false;
        let reponsesDonnees = [];
        let pointsParQuestion = 10;
        let gameStarted = false;
        
        // ========== VARIABLES CAMÉRA ==========
        let video = null;
        let stream = null;
        let detectionInterval = null;
        let modelsLoaded = false;
        let isAdultVerified = false;
        
        // ========== SYNTHÈSE VOCALE ==========
        let speechEnabled = true;
        let speechSynthesis = window.speechSynthesis;
        let currentUtterance = null;
        
        function speakText(text) {
            if (!speechEnabled) return;
            if (currentUtterance) speechSynthesis.cancel();
            currentUtterance = new SpeechSynthesisUtterance(text);
            currentUtterance.lang = 'fr-FR';
            currentUtterance.rate = 0.9;
            speechSynthesis.speak(currentUtterance);
        }
        
        function speakSuccess() { speakText('Bravo, c\'est la bonne réponse !'); }
        function speakError() { speakText('Dommage, ce n\'est pas l\'intrus'); }
        function speakStartGame() { speakText('Trouve l\'image différente dans chaque grille'); }
        
        // ========== CAMÉRA ==========
        async function startCamera() {
            console.log('🎥 Démarrage caméra...');
            
            try {
                stream = await navigator.mediaDevices.getUserMedia({ video: true });
                video = document.getElementById('surveillanceVideo');
                video.srcObject = stream;
                await new Promise(r => { video.onloadedmetadata = () => { video.play(); r(); } });
                console.log('✅ Caméra active');
                document.getElementById('faceStatus').innerHTML = '📥 Chargement modèles...';
                await loadModels();
            } catch(err) {
                console.error('❌ Erreur caméra:', err);
                document.getElementById('faceStatus').innerHTML = '⚠️ Caméra indisponible';
                document.getElementById('overlayStatus').innerHTML = '❌ Caméra non détectée. Vérifiez votre webcam.';
            }
        }
        
        async function loadModels() {
            try {
                const modelUrl = '/models/face-api/';
                console.log('📥 Chargement depuis:', modelUrl);
                
                await faceapi.nets.tinyFaceDetector.loadFromUri(modelUrl);
                console.log('✅ tinyFaceDetector chargé');
                
                await faceapi.nets.ageGenderNet.loadFromUri(modelUrl);
                console.log('✅ ageGenderNet chargé');
                
                modelsLoaded = true;
                console.log('✅ TOUS LES MODÈLES CHARGÉS!');
                document.getElementById('faceStatus').innerHTML = '🔍 Recherche visage...';
                document.getElementById('overlayStatus').innerHTML = '🔍 Recherche d\'un visage adulte...';
                
                startDetection();
            } catch(err) {
                console.error('❌ Erreur chargement modèles:', err);
                document.getElementById('faceStatus').innerHTML = '⚠️ Détection indisponible';
                document.getElementById('overlayStatus').innerHTML = '❌ Erreur chargement des modèles. Actualisez la page.';
            }
        }
        
        async function startDetection() {
            if (detectionInterval) clearInterval(detectionInterval);
            
            detectionInterval = setInterval(async () => {
                if (!video || !video.videoWidth || !modelsLoaded) return;
                if (isAdultVerified) return;
                
                try {
                    const detection = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions())
                        .withAgeAndGender();
                    
                    if (detection) {
                        let age = Math.round(detection.age);
                        console.log(`👤 Âge détecté: ${age}`);
                        document.getElementById('faceStatus').innerHTML = `👤 Âge: ${age} ans`;
                        document.getElementById('overlayStatus').innerHTML = `🎯 Visage détecté - Âge estimé: ${age} ans`;
                        document.getElementById('detectedAge').innerHTML = `Âge détecté: ${age} ans`;
                        
                        if (age >= 18 && !isAdultVerified && !gameStarted) {
                            isAdultVerified = true;
                            console.log('✅ Adulte vérifié, démarrage du jeu!');
                            document.getElementById('faceStatus').innerHTML = `✅ Adulte (${age} ans) - Jeu démarré`;
                            document.getElementById('faceStatus').classList.add('success');
                            startGame();
                        } else if (age < 18) {
                            document.getElementById('overlayStatus').innerHTML = `👶 Enfant détecté (${age} ans). Un adulte est requis pour démarrer.`;
                            document.getElementById('detectedAge').innerHTML = `👶 Enfant détecté - ${age} ans`;
                        }
                    } else {
                        document.getElementById('overlayStatus').innerHTML = '🔍 Aucun visage détecté. Placez-vous face à la caméra.';
                        document.getElementById('detectedAge').innerHTML = '';
                    }
                } catch(e) {
                    console.log('Erreur détection:', e);
                }
            }, 1500);
        }
        
        function startGame() {
            gameStarted = true;
            
            // Fermer l'overlay avec animation
            const overlay = document.getElementById('gameOverlay');
            overlay.style.opacity = '0';
            setTimeout(() => {
                overlay.style.display = 'none';
            }, 500);
            
            if (detectionInterval) clearInterval(detectionInterval);
            
            // Démarrer le jeu
            initGame();
            startTimer();
            
            // Message vocal
            speakText('Vérification réussie. Bon jeu !');
        }
        
        // ========== JEU ==========
        function initGame() {
            console.log('🎮 Initialisation du jeu Attention - Intrus...');
            
            if (questionsData && questionsData.length > 0) {
                questions = questionsData;
            } else {
                console.error('❌ Aucune question trouvée');
                document.getElementById('imagesGrid').innerHTML = '<div class="alert alert-danger">Aucune donnée disponible</div>';
                return;
            }
            
            document.getElementById('totalQuestions').textContent = questions.length;
            
            score = 0;
            gameActive = true;
            gameFinished = false;
            reponsesDonnees = [];
            currentQuestionIndex = 0;
            updateScore();
            loadQuestion();
            
            setTimeout(() => {
                speakStartGame();
            }, 500);
        }
        
        function loadQuestion() {
            if (!gameActive || gameFinished) return;
            if (currentQuestionIndex >= questions.length) {
                finishGame();
                return;
            }
            
            const q = questions[currentQuestionIndex];
            document.getElementById('questionNum').textContent = currentQuestionIndex + 1;
            document.getElementById('questionText').innerHTML = `🔍 Trouve l'intrus dans cette grille :`;
            
            const imagesList = q.images.split(',');
            const intrus = q.intrus;
            const shuffledImages = shuffleArray([...imagesList]);
            
            renderGrid(shuffledImages, intrus);
            startQuestionTimer();
        }
        
        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }
        
        function renderGrid(imagesList, intrus) {
            const grid = document.getElementById('imagesGrid');
            if (!grid) return;
            
            grid.innerHTML = '';
            grid.style.display = 'grid';
            grid.style.gridTemplateColumns = 'repeat(4, 1fr)';
            grid.style.gap = '15px';
            
            imagesList.forEach((img, index) => {
                const card = document.createElement('div');
                card.className = 'attention-card';
                card.textContent = img.trim();
                card.style.fontSize = '48px';
                card.onclick = () => selectImage(img.trim(), intrus);
                grid.appendChild(card);
            });
        }
        
        let questionTimerInterval = null;
        
        function startQuestionTimer() {
            if (questionTimerInterval) clearInterval(questionTimerInterval);
            let timeLeft = 10;
            updateProgressBar(100);
            
            questionTimerInterval = setInterval(() => {
                if (!gameActive || gameFinished || !gameStarted) return;
                timeLeft--;
                const percent = (timeLeft / 10) * 100;
                updateProgressBar(percent);
                
                if (timeLeft <= 0) {
                    clearInterval(questionTimerInterval);
                    reponsesDonnees.push({
                        question: currentQuestionIndex + 1,
                        intrus: questions[currentQuestionIndex]?.intrus,
                        reponse: null,
                        reussite: false,
                        temps: 'timeout'
                    });
                    currentQuestionIndex++;
                    loadQuestion();
                }
            }, 1000);
        }
        
        function updateProgressBar(percent) {
            const fill = document.getElementById('progressFill');
            if (fill) {
                fill.style.width = Math.max(0, percent) + '%';
                fill.style.background = percent < 30 ? '#F44336' : percent < 60 ? '#FF9800' : '#4CAF50';
            }
        }
        
        function selectImage(selectedValue, intrus) {
            if (!gameActive || gameFinished || !gameStarted) return;
            if (questionTimerInterval) clearInterval(questionTimerInterval);
            
            const isCorrect = (selectedValue === intrus);
            
            reponsesDonnees.push({
                question: currentQuestionIndex + 1,
                intrus: intrus,
                reponse: selectedValue,
                reussite: isCorrect,
                temps: 'answered'
            });
            
            if (isCorrect) {
                score += pointsParQuestion;
                updateScore();
                document.getElementById('message').innerHTML = '✅ Bravo ! +' + pointsParQuestion + ' points';
                document.getElementById('message').className = 'message-success';
                speakSuccess();
            } else {
                document.getElementById('message').innerHTML = '❌ Ce n\'est pas l\'intrus ! L\'intrus était : ' + intrus;
                document.getElementById('message').className = 'message-error';
                speakError();
            }
            
            currentQuestionIndex++;
            
            setTimeout(() => {
                document.getElementById('message').innerHTML = '';
                loadQuestion();
            }, 1500);
        }
        
        function updateScore() {
            const span = document.getElementById('score');
            if (span) span.textContent = score;
        }
        
        function startTimer() {
            if (timerInterval) clearInterval(timerInterval);
            timer = 0;
            updateTimerDisplay();
            timerInterval = setInterval(() => {
                if (gameActive && !gameFinished && gameStarted) {
                    timer++;
                    updateTimerDisplay();
                }
            }, 1000);
        }
        
        function updateTimerDisplay() {
            const m = Math.floor(timer / 60);
            const s = timer % 60;
            const span = document.getElementById('timer');
            if (span) span.textContent = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
        }
        
        function saveGameResult() {
            if (gameFinished) return Promise.resolve(false);
            gameFinished = true;
            
            const totalQuestions = questions.length;
            const bonnesReponses = reponsesDonnees.filter(r => r.reussite === true).length;
            const reussite = (bonnesReponses >= totalQuestions / 2);
            
            const reponsesData = {
                type: 'attention_intrus',
                total_questions: totalQuestions,
                bonnes_reponses: bonnesReponses,
                temps_total: timer,
                score_final: score,
                details: reponsesDonnees
            };
            
            return fetch('/exercice/api/exercice-complete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    exercice_id: exerciceId,
                    enfant_id: {{ app.user.id ?? 1 }},
                    score: score,
                    temps_passe: timer,
                    reponses: reponsesData,
                    reussite: reussite
                })
            })
            .then(response => response.json())
            .then(data => {
                console.log('✅ Enregistré:', data);
                return data.success;
            })
            .catch(error => {
                console.error('❌ Erreur:', error);
                return false;
            });
        }
        
        function finishGame() {
            if (!gameActive || gameFinished) return;
            
            gameActive = false;
            if (timerInterval) clearInterval(timerInterval);
            if (questionTimerInterval) clearInterval(questionTimerInterval);
            if (detectionInterval) clearInterval(detectionInterval);
            if (stream) stream.getTracks().forEach(t => t.stop());
            
            document.getElementById('message').innerHTML = '📝 Sauvegarde en cours...';
            speakText('Jeu terminé. Votre score final est ' + score);
            
            saveGameResult().then(success => {
                if (success) {
                    alert('🎉 Jeu terminé et enregistré !');
                } else {
                    alert('⚠️ Jeu terminé mais erreur lors de l\'enregistrement.');
                }
                window.location.href = "{{ path('app_front_exercice_index') }}";
            });
        }
        
        // ========== INITIALISATION ==========
        document.addEventListener('DOMContentLoaded', function() {
            console.log('📄 DOM chargé');
            video = document.getElementById('surveillanceVideo');
            startCamera();
            
            // Bouton voix
            const btn = document.getElementById('voiceToggleBtn');
            if (btn) {
                btn.addEventListener('click', () => {
                    speechEnabled = !speechEnabled;
                    localStorage.setItem('voice_enabled', speechEnabled);
                    btn.innerHTML = speechEnabled ? '🔊 Voix ON' : '🔇 Voix OFF';
                    if (speechEnabled) speakText('Voix activée');
                });
            }
        });
    </script>
{% endblock %}