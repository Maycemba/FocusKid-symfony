{% extends 'base-front.html.twig' %}

{% block title %}Jeu d'Attention - FocusKid{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .game-container {
            background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
            min-height: 600px;
            border-radius: 20px;
            padding: 30px;
        }
        .attention-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 48px;
            min-height: 150px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .attention-card:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }
        .attention-card.selected {
            background: #C8E6C9;
            border: 3px solid #4CAF50;
        }
        .score-board {
            background: white;
            border-radius: 15px;
            padding: 15px;
            margin-bottom: 20px;
        }
        .progress-bar-custom {
            height: 10px;
            background: #E0E0E0;
            border-radius: 5px;
            overflow: hidden;
            margin-top: 10px;
        }
        .progress-fill {
            height: 100%;
            background: #4CAF50;
            width: 100%;
            transition: width 0.3s;
        }
        .btn-game {
            background: #FF9800;
            color: white;
            border-radius: 25px;
            padding: 10px 25px;
            border: none;
            text-decoration: none;
            display: inline-block;
        }
        .btn-game:hover {
            background: #F57C00;
        }
        .message-success {
            color: #4CAF50;
            font-weight: bold;
        }
        .message-error {
            color: #F44336;
            font-weight: bold;
        }
        
        /* Caméra et surveillance */
        .camera-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 200px;
            height: 150px;
            background: #000;
            border-radius: 10px;
            z-index: 1000;
            overflow: hidden;
            border: 2px solid #FF9800;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }
        .camera-container video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .violation-badge {
            position: absolute;
            top: 5px;
            left: 5px;
            background: rgba(0,0,0,0.7);
            color: white;
            padding: 2px 8px;
            border-radius: 15px;
            font-size: 10px;
            display: none;
        }
        .face-status {
            position: absolute;
            bottom: 5px;
            left: 0;
            right: 0;
            text-align: center;
            background: rgba(0,0,0,0.5);
            color: white;
            font-size: 9px;
            padding: 2px;
        }
        
        /* Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.9);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }
        .modal-content {
            background: white;
            border-radius: 20px;
            padding: 30px;
            max-width: 400px;
            margin: 100px auto;
            text-align: center;
        }
        .modal-content video {
            width: 100%;
            border-radius: 10px;
            margin: 15px 0;
        }
        .modal-btn {
            background: #4CAF50;
            color: white;
            border: none;
            padding: 10px 25px;
            border-radius: 25px;
            cursor: pointer;
        }
        .modal-btn-skip {
            background: #ccc;
            color: #333;
            border: none;
            padding: 10px 25px;
            border-radius: 25px;
            cursor: pointer;
            margin-left: 10px;
        }
        
        /* Alerte violation */
        .violation-alert {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: #F44336;
            color: white;
            padding: 20px 40px;
            border-radius: 20px;
            z-index: 3000;
            text-align: center;
            box-shadow: 0 5px 30px rgba(0,0,0,0.3);
        }
        .violation-alert h3 {
            margin: 0 0 10px 0;
        }
        .violation-alert button {
            background: white;
            color: #F44336;
            border: none;
            padding: 10px 25px;
            border-radius: 25px;
            margin-top: 15px;
            cursor: pointer;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-xxl py-5">
    <div class="container">
        <div class="game-container">
            <div class="score-board d-flex justify-content-between align-items-center">
                <h3>🎯 Jeu d'Attention</h3>
                <div>
                    <span class="me-3">⭐ Score: <span id="score">0</span></span>
                    <span>⏱️ Temps: <span id="timer">00:00</span></span>
                </div>
            </div>
            
            <div class="progress-bar-custom">
                <div class="progress-fill" id="progressFill"></div>
            </div>
            
            <div class="text-center mt-3 mb-4">
                <p id="message" class="message-success"></p>
            </div>
            
            <div class="row" id="attentionGrid"></div>
            
            <div class="text-center mt-4">
                <a href="{{ path('app_front_exercice_index') }}" class="btn-game">⬅️ Retour aux exercices</a>
            </div>
        </div>
    </div>
</div>

<!-- Caméra de surveillance -->
<div id="cameraContainer" class="camera-container" style="display: none;">
    <video id="surveillanceVideo" autoplay muted playsinline></video>
    <div id="violationBadge" class="violation-badge">⚠️</div>
    <div class="face-status">
        <span id="faceStatus">🔍 Vérification...</span>
    </div>
</div>

<!-- Modal d'enregistrement du visage -->
<div id="registerModal" class="modal-overlay">
    <div class="modal-content">
        <h2>📸 Enregistrement du visage</h2>
        <p>Placez-vous face à la caméra</p>
        <video id="registerVideo" autoplay muted></video>
        <button id="confirmRegisterBtn" class="modal-btn">✅ Enregistrer mon visage</button>
        <button id="skipRegisterBtn" class="modal-btn-skip">⏭️ Passer</button>
    </div>
</div>

<!-- Alerte violation -->
<div id="violationAlert" class="violation-alert">
    <h3>⚠️ Exercice interrompu !</h3>
    <p id="violationReason"></p>
    <button onclick="location.reload()">🔁 Recommencer</button>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Récupérer les données depuis Twig
        const exerciceId = {{ exercice.id }};
        const questionsData = {{ questions|default([])|json_encode|raw }};
        
        // Variables du jeu
        let images = [];
        let currentTarget = null;
        let score = 0;
        let timer = 0;
        let timerInterval = null;
        let gameActive = true;
        let progressTimer = null;
        let timeLeft = 100;
        let gameFinished = false;
        let reponsesDonnees = [];
        let gameStarted = false;
        
        // Paramètres
        let pointsParClick = 10;
        let penalite = 5;
        let tempsMax = 120;
        
        // Variables de surveillance
        let surveillanceActive = false;
        
        // ========== FONCTIONS DU JEU ==========
        function initGame() {
            if (!questionsData || questionsData.length === 0) {
                console.log('❌ Aucune donnée pour le jeu Attention');
                return;
            }
            
            images = [];
            for (let i = 0; i < questionsData.length; i++) {
                images.push({
                    id: i,
                    value: questionsData[i].image || questionsData[i].valeur || '?',
                    selected: false
                });
            }
            
            score = 0;
            timeLeft = tempsMax;
            gameActive = true;
            gameFinished = false;
            updateScore();
            updateProgressBar();
            setNewTarget();
            renderGrid();
        }
        
        function startGameTimer() {
            if (timerInterval) clearInterval(timerInterval);
            if (progressTimer) clearInterval(progressTimer);
            
            timer = 0;
            updateTimerDisplay();
            
            timerInterval = setInterval(() => {
                if (gameActive && !gameFinished && gameStarted) {
                    timer++;
                    updateTimerDisplay();
                }
            }, 1000);
            
            progressTimer = setInterval(() => {
                if (gameActive && !gameFinished && gameStarted && timeLeft > 0) {
                    timeLeft--;
                    updateProgressBar();
                    if (timeLeft <= 0) {
                        finishGame();
                    }
                }
            }, 1000);
        }
        
        function setNewTarget() {
            const randomIndex = Math.floor(Math.random() * images.length);
            currentTarget = images[randomIndex].value;
            const msgDiv = document.getElementById('message');
            if (msgDiv) msgDiv.innerHTML = `🎯 Trouve l'image : <strong>${currentTarget}</strong>`;
        }
        
        function renderGrid() {
            const grid = document.getElementById('attentionGrid');
            if (!grid) return;
            grid.innerHTML = '';
            grid.style.display = 'grid';
            grid.style.gridTemplateColumns = 'repeat(4, 1fr)';
            grid.style.gap = '15px';
            
            images.forEach((img, index) => {
                const cardDiv = document.createElement('div');
                cardDiv.className = 'attention-card';
                if (img.selected) cardDiv.classList.add('selected');
                cardDiv.textContent = img.value;
                cardDiv.onclick = () => selectImage(index);
                grid.appendChild(cardDiv);
            });
        }
        
        function selectImage(index) {
            if (!gameActive || gameFinished || !gameStarted) return;
            
            const selectedImage = images[index];
            
            reponsesDonnees.push({
                image: selectedImage.value,
                est_cible: (selectedImage.value === currentTarget)
            });
            
            if (selectedImage.value === currentTarget) {
                score += pointsParClick;
                updateScore();
                selectedImage.selected = true;
                renderGrid();
                const msgDiv = document.getElementById('message');
                if (msgDiv) {
                    msgDiv.innerHTML = '✅ Bravo ! +' + pointsParClick + ' points';
                    msgDiv.className = 'message-success';
                }
                
                setTimeout(() => {
                    setNewTarget();
                    setTimeout(() => renderGrid(), 100);
                }, 500);
            } else {
                score = Math.max(0, score - penalite);
                updateScore();
                const msgDiv = document.getElementById('message');
                if (msgDiv) {
                    msgDiv.innerHTML = '❌ Mauvaise image ! -' + penalite + ' points';
                    msgDiv.className = 'message-error';
                }
                
                setTimeout(() => {
                    if (msgDiv) {
                        msgDiv.innerHTML = `🎯 Trouve l'image : <strong>${currentTarget}</strong>`;
                        msgDiv.className = 'message-success';
                    }
                }, 800);
            }
        }
        
        function updateScore() {
            const scoreSpan = document.getElementById('score');
            if (scoreSpan) scoreSpan.textContent = score;
        }
        
        function updateProgressBar() {
            const fill = document.getElementById('progressFill');
            if (!fill) return;
            const percent = (timeLeft / tempsMax) * 100;
            fill.style.width = Math.max(0, percent) + '%';
            if (timeLeft < 30) {
                fill.style.background = '#F44336';
            } else if (timeLeft < 60) {
                fill.style.background = '#FF9800';
            } else {
                fill.style.background = '#4CAF50';
            }
        }
        
        function updateTimerDisplay() {
            const m = Math.floor(timer / 60);
            const s = timer % 60;
            const timerSpan = document.getElementById('timer');
            if (timerSpan) timerSpan.textContent = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
        }
        
        function saveGameResult() {
            if (gameFinished) return Promise.resolve(false);
            gameFinished = true;
            
            const reponsesData = {
                type: 'attention',
                total_images: images.length,
                bonnes_reponses: images.filter(i => i.selected).length,
                temps_total: timer,
                score_final: score,
                reponses: reponsesDonnees
            };
            
            return fetch('/exercice/api/exercice-complete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    exercice_id: exerciceId,
                    enfant_id: {{ app.user.id ?? 1 }},
                    score: score,
                    temps_passe: timer,
                    reponses: reponsesData,
                    reussite: (score > 50)
                })
            })
            .then(response => response.json())
            .then(data => {
                console.log('✅ Enregistré:', data);
                return data.success;
            })
            .catch(error => {
                console.error('❌ Erreur:', error);
                return false;
            });
        }
        
        function finishGame() {
            if (!gameActive || gameFinished) return;
            
            gameActive = false;
            gameStarted = false;
            if (timerInterval) clearInterval(timerInterval);
            if (progressTimer) clearInterval(progressTimer);
            
            // Arrêter la surveillance
            if (window.ExerciceGuardian) {
                window.ExerciceGuardian.stop();
            }
            
            const msgDiv = document.getElementById('message');
            if (msgDiv) msgDiv.innerHTML = '📝 Sauvegarde en cours...';
            
            saveGameResult().then(success => {
                if (success) {
                    alert('🎉 Jeu terminé et enregistré !');
                } else {
                    alert('⚠️ Jeu terminé mais erreur lors de l\'enregistrement.');
                }
                window.location.href = "{{ path('app_front_exercice_index') }}";
            });
        }
        
        // ========== SURVEILLANCE FACIALE ==========
        async function initSurveillance() {
            if (!window.FaceDetectionService || !window.ExerciceGuardian) {
                console.log('⏳ Attente des services...');
                setTimeout(initSurveillance, 500);
                return;
            }
            
            const status = await window.ExerciceGuardian.init();
            
            if (!status.faceLoaded) {
                showRegisterModal();
            } else {
                startSurveillance();
            }
        }
        
        function showRegisterModal() {
            const modal = document.getElementById('registerModal');
            const video = document.getElementById('registerVideo');
            
            modal.style.display = 'flex';
            window.FaceDetectionService.startCamera(video);
            
            document.getElementById('confirmRegisterBtn').onclick = async () => {
                const success = await window.ExerciceGuardian.registerFirstFace(video);
                if (success) {
                    modal.style.display = 'none';
                    window.FaceDetectionService.stopCamera();
                    startSurveillance();
                } else {
                    alert('❌ Placez-vous bien face à la caméra');
                }
            };
            
            document.getElementById('skipRegisterBtn').onclick = () => {
                modal.style.display = 'none';
                window.FaceDetectionService.stopCamera();
                startGameWithoutSurveillance();
            };
        }
        
        function startSurveillance() {
            const cameraDiv = document.getElementById('cameraContainer');
            const video = document.getElementById('surveillanceVideo');
            
            cameraDiv.style.display = 'block';
            
            window.ExerciceGuardian.start(
                video,
                (reason) => {
                    // Arrêt du jeu
                    gameActive = false;
                    gameStarted = false;
                    if (timerInterval) clearInterval(timerInterval);
                    if (progressTimer) clearInterval(progressTimer);
                    document.getElementById('violationReason').innerHTML = reason;
                    document.getElementById('violationAlert').style.display = 'flex';
                },
                (count) => {
                    const badge = document.getElementById('violationBadge');
                    const statusSpan = document.getElementById('faceStatus');
                    
                    if (count > 0) {
                        badge.style.display = 'block';
                        statusSpan.innerHTML = `⚠️ Alerte (${count}/3)`;
                        statusSpan.style.color = '#ff6b6b';
                    } else {
                        badge.style.display = 'none';
                        statusSpan.innerHTML = '✅ Enfant vérifié';
                        statusSpan.style.color = '#4CAF50';
                    }
                }
            );
            
            // Démarrer le jeu après 1 seconde
            setTimeout(() => {
                gameStarted = true;
                startGameTimer();
            }, 1000);
        }
        
        function startGameWithoutSurveillance() {
            gameStarted = true;
            startGameTimer();
            console.log('Jeu démarré sans surveillance');
        }
        
        // ========== INITIALISATION ==========
        if (document.getElementById('attentionGrid')) {
            initGame();
            initSurveillance();
        }
    </script>
{% endblock %}