{% extends 'base-front.html.twig' %}

{% block title %}Mes Cours - FocusKid{% endblock %}

{% block body %}

<!-- Header -->
<div class="container-fluid py-5 mb-5" style="background: linear-gradient(135deg, #06A3DA, #0056b3);">
    <div class="container py-3">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h1 class="display-4 text-white fw-bold mb-2">📚 Mes Cours</h1>
                <p class="text-white fs-5">Découvre tous tes cours et commence à apprendre !</p>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">

    <!-- Barre de recherche et filtres -->
    <div class="bg-light rounded-4 p-4 mb-5 shadow-sm">
        <div class="row g-3 align-items-center">

            <div class="col-lg-5 col-md-12">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fa fa-search text-primary"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control border-start-0"
                           placeholder="Rechercher un cours, formateur...">
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <select id="filterNiveau" class="form-select">
                    <option value="">🎯 Tous les niveaux</option>
                    <option value="1">Niveau 1</option>
                    <option value="2">Niveau 2</option>
                    <option value="3">Niveau 3</option>
                    <option value="4">Niveau 4</option>
                </select>
            </div>

            <div class="col-lg-3 col-md-6">
                <select id="sortAlpha" class="form-select">
                    <option value="az">🔤 A → Z</option>
                    <option value="za">Z → A</option>
                </select>
            </div>

            <div class="col-lg-1 col-md-12 text-center">
                <button id="resetBtn" class="btn btn-outline-secondary rounded-pill px-3" title="Réinitialiser">
                    <i class="fa fa-times"></i>
                </button>
            </div>

        </div>
    </div>

    <div class="mb-3">
        <span id="resultCount" class="text-muted"></span>
    </div>

    <div class="row g-4" id="coursList">
        <div class="col-12 text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
            <p class="text-muted mt-3">Chargement des cours...</p>
        </div>
    </div>

    <div class="d-flex justify-content-center mt-5" id="paginationContainer"></div>

    <div id="noResult" class="text-center py-5 d-none">
        <i class="fa fa-search fa-4x text-muted mb-3"></i>
        <h4 class="text-muted">Aucun cours trouvé.</h4>
        <button id="resetBtn2" class="btn btn-primary rounded-pill px-4 mt-3">
            Réinitialiser la recherche
        </button>
    </div>

</div>

{% endblock %}

{% block javascripts %}
<script>
    // Éléments DOM
    const searchInput = document.getElementById('searchInput');
    const filterNiveau = document.getElementById('filterNiveau');
    const sortAlpha = document.getElementById('sortAlpha');
    const resetBtn = document.getElementById('resetBtn');
    const resetBtn2 = document.getElementById('resetBtn2');
    const coursList = document.getElementById('coursList');
    const noResult = document.getElementById('noResult');
    const resultCount = document.getElementById('resultCount');
    const paginationContainer = document.getElementById('paginationContainer');
    
    let debounceTimer = null;
    let currentPage = 1;

    // URL de base (sans les paramètres)
    const baseUrl = '{{ path('app_enfant_cours') }}';

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function buildCoursCard(cour) {
        // Badge niveau
        const niveauBadge = cour.niveau 
            ? `<span class="badge bg-primary rounded-pill px-3 py-2 mb-3">🎯 Niveau ${escapeHtml(cour.niveau)}</span>`
            : `<span class="badge bg-secondary rounded-pill px-3 py-2 mb-3">Niveau non défini</span>`;
        
        // Description (tronquée)
        const description = cour.description 
            ? `<p class="text-muted mb-3">${escapeHtml(cour.description.length > 100 ? cour.description.substring(0, 100) + '...' : cour.description)}</p>`
            : '<p class="text-muted mb-3"><em>Aucune description</em></p>';
        
        // Formateur
        const formateurHtml = cour.formateur ? `
            <div class="d-flex align-items-center mb-3">
                <img class="rounded-circle flex-shrink-0"
                     src="/base-front/img/user.jpg"
                     alt="${escapeHtml(cour.formateur)}" 
                     style="width: 38px; height: 38px;">
                <div class="ms-2">
                    <h6 class="text-primary mb-0">${escapeHtml(cour.formateur)}</h6>
                    <small class="text-muted">Formateur</small>
                </div>
            </div>
        ` : '';
        
        // Leçons
        const leconsText = cour.lecons === 0 ? 'Aucune leçon' : (cour.lecons === 1 ? '1 leçon' : `${cour.lecons} leçons`);
        
        // URL des leçons (gestion des locales)
        let urlLecons = cour.urlLecons;
        if (urlLecons && !urlLecons.includes('/fr') && !urlLecons.includes('/en') && !urlLecons.includes('/ar')) {
            // Ajouter la locale par défaut si nécessaire
            const locale = document.documentElement.lang || 'fr';
            urlLecons = urlLecons + '/' + locale;
        }
        
        return `
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 transition-all hover-shadow">
                    <div class="card-body p-4">
                        ${niveauBadge}
                        <h4 class="text-primary fw-bold mb-3 cours-titre">${escapeHtml(cour.titre)}</h4>
                        ${description}
                        ${formateurHtml}
                        <div class="d-flex align-items-center mb-4">
                            <i class="fa fa-book-open text-primary me-2"></i>
                            <span class="text-muted">${leconsText}</span>
                        </div>
                        <a href="${escapeHtml(urlLecons)}"
                           class="btn btn-primary rounded-pill py-2 px-4 w-100">
                            📖 Voir les leçons <i class="fa fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        `;
    }

    function buildPagination(currentPage, totalPages) {
        if (!totalPages || totalPages <= 1) {
            return '';
        }
        
        let html = '<nav><ul class="pagination justify-content-center">';
        
        // Précédent
        html += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
            <a class="page-link" href="#" data-page="${currentPage - 1}">« Précédent</a>
        </li>`;
        
        // Pages
        const maxVisible = 5;
        let start = Math.max(1, currentPage - Math.floor(maxVisible / 2));
        let end = Math.min(totalPages, start + maxVisible - 1);
        
        if (end - start + 1 < maxVisible) {
            start = Math.max(1, end - maxVisible + 1);
        }
        
        if (start > 1) {
            html += `<li class="page-item"><a class="page-link" href="#" data-page="1">1</a></li>`;
            if (start > 2) html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
        }
        
        for (let i = start; i <= end; i++) {
            html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                <a class="page-link" href="#" data-page="${i}">${i}</a>
            </li>`;
        }
        
        if (end < totalPages) {
            if (end < totalPages - 1) html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            html += `<li class="page-item"><a class="page-link" href="#" data-page="${totalPages}">${totalPages}</a></li>`;
        }
        
        // Suivant
        html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
            <a class="page-link" href="#" data-page="${currentPage + 1}">Suivant »</a>
        </li>`;
        
        html += '</ul></nav>';
        return html;
    }

    async function loadCours(page = 1) {
        currentPage = page;
        
        // Construire l'URL avec les paramètres
        const params = new URLSearchParams();
        const search = searchInput.value.trim();
        const niveau = filterNiveau.value;
        const sort = sortAlpha.value;
        
        if (search) params.append('search', search);
        if (niveau) params.append('niveau', niveau);
        if (sort && sort !== 'az') params.append('sort', sort);
        params.append('page', page);
        
        const url = `${baseUrl}?${params.toString()}`;
        
        // Afficher le chargement
        coursList.innerHTML = `
            <div class="col-12 text-center py-5">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">Chargement...</span>
                </div>
                <p class="text-muted mt-3">Chargement des cours...</p>
            </div>
        `;
        paginationContainer.innerHTML = '';
        noResult.classList.add('d-none');
        resultCount.textContent = 'Recherche en cours...';
        
        try {
            const response = await fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            });
            
            if (!response.ok) {
                throw new Error(`Erreur HTTP ${response.status}`);
            }
            
            const data = await response.json();
            console.log('Données reçues:', data);
            
            // Vérifier si on a des cours
            if (!data.cours || data.cours.length === 0) {
                coursList.innerHTML = '';
                noResult.classList.remove('d-none');
                resultCount.textContent = '0 cours trouvé';
                paginationContainer.innerHTML = '';
                return;
            }
            
            // Afficher les cours
            coursList.innerHTML = data.cours.map(cour => buildCoursCard(cour)).join('');
            resultCount.textContent = `${data.total} cours trouvé${data.total > 1 ? 's' : ''}`;
            
            // Afficher la pagination
            if (data.pages && data.pages > 1) {
                paginationContainer.innerHTML = buildPagination(data.page, data.pages);
                
                // Attacher les événements de pagination
                document.querySelectorAll('.page-link[data-page]').forEach(link => {
                    link.addEventListener('click', (e) => {
                        e.preventDefault();
                        const targetPage = parseInt(link.dataset.page);
                        if (!isNaN(targetPage) && targetPage !== currentPage) {
                            window.scrollTo({ top: 0, behavior: 'smooth' });
                            loadCours(targetPage);
                        }
                    });
                });
            } else {
                paginationContainer.innerHTML = '';
            }
            
        } catch (error) {
            console.error('Erreur:', error);
            coursList.innerHTML = `
                <div class="col-12 text-center py-5">
                    <i class="fa fa-exclamation-triangle fa-4x text-danger mb-3"></i>
                    <h4 class="text-danger">Erreur de chargement</h4>
                    <p class="text-muted">${escapeHtml(error.message)}</p>
                    <button class="btn btn-primary rounded-pill mt-3" onclick="location.reload()">
                        <i class="fa fa-refresh me-2"></i>Réessayer
                    </button>
                </div>
            `;
            resultCount.textContent = '';
        }
    }
    
    function resetAndLoad() {
        searchInput.value = '';
        filterNiveau.value = '';
        sortAlpha.value = 'az';
        loadCours(1);
    }
    
    function debounceLoad() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => loadCours(1), 400);
    }
    
    // Événements
    searchInput.addEventListener('input', debounceLoad);
    filterNiveau.addEventListener('change', () => loadCours(1));
    sortAlpha.addEventListener('change', () => loadCours(1));
    resetBtn.addEventListener('click', resetAndLoad);
    if (resetBtn2) resetBtn2.addEventListener('click', resetAndLoad);
    
    // Chargement initial
    loadCours(1);
    
    // Ajout des styles CSS
    const style = document.createElement('style');
    style.textContent = `
        .hover-shadow {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .hover-shadow:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
        }
        .cours-titre {
            min-height: 3.5rem;
            font-size: 1.25rem;
        }
        .card {
            transition: all 0.3s ease;
        }
    `;
    document.head.appendChild(style);
</script>
{% endblock %}