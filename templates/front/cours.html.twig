{% extends 'base-front.html.twig' %}

{% block title %}Mes Cours - FocusKid{% endblock %}

{% block body %}

<!-- Header -->
<div class="container-fluid py-5 mb-5" style="background: linear-gradient(135deg, #06A3DA, #0056b3);">
    <div class="container py-3">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h1 class="display-4 text-white fw-bold mb-2">📚 Mes Cours</h1>
                <p class="text-white fs-5">Découvre tous tes cours et commence à apprendre !</p>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">

    <!-- Barre de recherche et filtres -->
    <div class="bg-light rounded-4 p-4 mb-5 shadow-sm">
        <div class="row g-3 align-items-center">

            <!-- Recherche -->
            <div class="col-lg-5 col-md-12">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fa fa-search text-primary"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control border-start-0"
                           placeholder="Rechercher un cours, formateur...">
                </div>
            </div>

            <!-- Tri par niveau -->
            <div class="col-lg-3 col-md-6">
                <select id="filterNiveau" class="form-select">
                    <option value="">🎯 Tous les niveaux</option>
                    <option value="1">Niveau 1</option>
                    <option value="2">Niveau 2</option>
                    <option value="3">Niveau 3</option>
                    <option value="4">Niveau 4</option>
                </select>
            </div>

            <!-- Tri alphabétique -->
            <div class="col-lg-3 col-md-6">
                <select id="sortAlpha" class="form-select">
                    <option value="">🔤 Trier par...</option>
                    <option value="az">A → Z</option>
                    <option value="za">Z → A</option>
                </select>
            </div>

            <!-- Bouton reset -->
            <div class="col-lg-1 col-md-12 text-center">
                <button id="resetBtn" class="btn btn-outline-secondary rounded-pill px-3" title="Réinitialiser">
                    <i class="fa fa-times"></i>
                </button>
            </div>

        </div>
    </div>

    <!-- Compteur résultats -->
    <div class="mb-3">
        <span id="resultCount" class="text-muted"></span>
    </div>

    <!-- Liste des cours -->
    <div class="row g-4" id="coursList">
        {% for cour in cours %}
        <div class="col-lg-4 col-md-6 cours-item"
             data-titre="{{ cour.titre|lower }}"
             data-formateur="{{ cour.formateur|lower|default('') }}"
             data-description="{{ cour.description|lower|default('') }}"
             data-niveau="{{ cour.niveau|lower|default('') }}">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    {% if cour.niveau %}
                    <span class="badge bg-primary rounded-pill px-3 py-2 mb-3">
                        🎯 Niveau {{ cour.niveau }}
                    </span>
                    {% else %}
                    <span class="badge bg-secondary rounded-pill px-3 py-2 mb-3">
                        Niveau non défini
                    </span>
                    {% endif %}

                    <!-- Titre -->
                    <h4 class="text-primary fw-bold mb-3 cours-titre">{{ cour.titre }}</h4>

                    <!-- Description -->
                    {% if cour.description %}
                    <p class="text-muted mb-3">
                        {{ cour.description|length > 100 ? cour.description|slice(0, 100) ~ '...' : cour.description }}
                    </p>
                    {% endif %}

                    <!-- Formateur -->
                    {% if cour.formateur %}
                    <div class="d-flex align-items-center mb-3">
                        <img class="rounded-circle flex-shrink-0"
                             src="{{ asset('base-front/img/user.jpg') }}"
                             alt="" style="width: 38px; height: 38px;">
                        <div class="ms-2">
                            <h6 class="text-primary mb-0">{{ cour.formateur }}</h6>
                            <small class="text-muted">Formateur</small>
                        </div>
                    </div>
                    {% endif %}

                    <!-- Nombre leçons -->
                    <div class="d-flex align-items-center mb-4">
                        <i class="fa fa-book-open text-primary me-2"></i>
                        <span class="text-muted">{{ cour.lecons|length }} leçon(s)</span>
                    </div>

                    <!-- Bouton -->
                    <a href="{{ path('app_enfant_lecons', {'id_cours': cour.idCours}) }}"
                       class="btn btn-primary rounded-pill py-2 px-4 w-100">
                        📖 Voir les leçons <i class="fa fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12 text-center py-5">
            <i class="fa fa-book fa-5x text-muted mb-4"></i>
            <h4 class="text-muted">Aucun cours disponible.</h4>
        </div>
        {% endfor %}
    </div>

    <!-- Pagination -->
    <div class="d-flex justify-content-center mt-5">
        {{ knp_pagination_render(cours) }}
    </div>

    <!-- Message aucun résultat -->
    <div id="noResult" class="text-center py-5 d-none">
        <i class="fa fa-search fa-4x text-muted mb-3"></i>
        <h4 class="text-muted">Aucun cours trouvé.</h4>
        <button id="resetBtn2" class="btn btn-primary rounded-pill px-4 mt-3">
            Réinitialiser la recherche
        </button>
    </div>

</div>

{% endblock %}

{% block javascripts %}
<script>
    const searchInput = document.getElementById('searchInput');
    const filterNiveau = document.getElementById('filterNiveau');
    const sortAlpha = document.getElementById('sortAlpha');
    const resetBtn = document.getElementById('resetBtn');
    const resetBtn2 = document.getElementById('resetBtn2');
    const coursList = document.getElementById('coursList');
    const noResult = document.getElementById('noResult');
    const resultCount = document.getElementById('resultCount');

    function filterAndSort() {
        const search = searchInput.value.toLowerCase().trim();
        const niveau = filterNiveau.value.toLowerCase();
        const sort = sortAlpha.value;

        let items = Array.from(document.querySelectorAll('.cours-item'));
        let visible = [];

        items.forEach(item => {
            const titre = item.dataset.titre || '';
            const formateur = item.dataset.formateur || '';
            const description = item.dataset.description || '';
            const niveauItem = item.dataset.niveau || '';

            const matchSearch = !search ||
                titre.includes(search) ||
                formateur.includes(search) ||
                description.includes(search);

            const matchNiveau = !niveau || niveauItem.includes(niveau);

            if (matchSearch && matchNiveau) {
                item.classList.remove('d-none');
                visible.push(item);
            } else {
                item.classList.add('d-none');
            }
        });

        // Tri alphabétique
        if (sort === 'az' || sort === 'za') {
            visible.sort((a, b) => {
                const ta = a.dataset.titre;
                const tb = b.dataset.titre;
                return sort === 'az' ? ta.localeCompare(tb) : tb.localeCompare(ta);
            });
            visible.forEach(item => coursList.appendChild(item));
        }

        // Résultats
        resultCount.textContent = visible.length + ' cours trouvé(s)';

        // Aucun résultat
        if (visible.length === 0) {
            noResult.classList.remove('d-none');
        } else {
            noResult.classList.add('d-none');
        }
    }

    function reset() {
        searchInput.value = '';
        filterNiveau.value = '';
        sortAlpha.value = '';
        filterAndSort();
    }

    searchInput.addEventListener('input', filterAndSort);
    filterNiveau.addEventListener('change', filterAndSort);
    sortAlpha.addEventListener('change', filterAndSort);
    resetBtn.addEventListener('click', reset);
    resetBtn2.addEventListener('click', reset);

    filterAndSort();
</script>
{% endblock %}