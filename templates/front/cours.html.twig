{% extends 'base-front.html.twig' %}

{% block title %}Mes Cours - FocusKid{% endblock %}

{% block body %}

<!-- Header -->
<div class="container-fluid py-5 mb-5" style="background: linear-gradient(135deg, #06A3DA, #0056b3);">
    <div class="container py-3">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h1 class="display-4 text-white fw-bold mb-2">📚 Mes Cours</h1>
                <p class="text-white fs-5">Découvre tous tes cours et commence à apprendre !</p>
            </div>
        </div>
    </div>
</div>

<div class="container mb-5">

    <!-- Barre de recherche et filtres -->
    <div class="bg-light rounded-4 p-4 mb-5 shadow-sm">
        <div class="row g-3 align-items-center">

            <!-- Recherche -->
            <div class="col-lg-5 col-md-12">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fa fa-search text-primary"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control border-start-0"
                           placeholder="Rechercher un cours, formateur..." value="{{ search|default('') }}">
                </div>
            </div>

            <!-- Tri par niveau -->
            <div class="col-lg-3 col-md-6">
                <select id="filterNiveau" class="form-select">
                    <option value="">🎯 Tous les niveaux</option>
                    <option value="1" {{ niveau|default('') == '1' ? 'selected' : '' }}>Niveau 1</option>
                    <option value="2" {{ niveau|default('') == '2' ? 'selected' : '' }}>Niveau 2</option>
                    <option value="3" {{ niveau|default('') == '3' ? 'selected' : '' }}>Niveau 3</option>
                    <option value="4" {{ niveau|default('') == '4' ? 'selected' : '' }}>Niveau 4</option>
                </select>
            </div>

            <!-- Tri alphabétique -->
            <div class="col-lg-3 col-md-6">
                <select id="sortAlpha" class="form-select">
                    <option value="">🔤 Trier par...</option>
                    <option value="az" {{ sort|default('') == 'az' ? 'selected' : '' }}>A → Z</option>
                    <option value="za" {{ sort|default('') == 'za' ? 'selected' : '' }}>Z → A</option>
                </select>
            </div>

            <!-- Bouton reset -->
            <div class="col-lg-1 col-md-12 text-center">
                <button id="resetBtn" class="btn btn-outline-secondary rounded-pill px-3" title="Réinitialiser">
                    <i class="fa fa-times"></i>
                </button>
            </div>

        </div>
    </div>

    <!-- Compteur résultats -->
    <div class="mb-3">
        <span id="resultCount" class="text-muted"></span>
    </div>

    <!-- Liste des cours -->
    <div class="row g-4" id="coursList">
        {% for cour in cours %}
        <div class="col-lg-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    {% if cour.niveau %}
                    <span class="badge bg-primary rounded-pill px-3 py-2 mb-3">
                        🎯 Niveau {{ cour.niveau }}
                    </span>
                    {% else %}
                    <span class="badge bg-secondary rounded-pill px-3 py-2 mb-3">
                        Niveau non défini
                    </span>
                    {% endif %}

                    <!-- Titre -->
                    <h4 class="text-primary fw-bold mb-3 cours-titre">{{ cour.titre }}</h4>

                    <!-- Description -->
                    {% if cour.description %}
                    <p class="text-muted mb-3">
                        {{ cour.description|length > 100 ? cour.description|slice(0, 100) ~ '...' : cour.description }}
                    </p>
                    {% endif %}

                    <!-- Formateur -->
                    {% if cour.formateur %}
                    <div class="d-flex align-items-center mb-3">
                        <img class="rounded-circle flex-shrink-0"
                             src="{{ asset('base-front/img/user.jpg') }}"
                             alt="" style="width: 38px; height: 38px;">
                        <div class="ms-2">
                            <h6 class="text-primary mb-0">{{ cour.formateur }}</h6>
                            <small class="text-muted">Formateur</small>
                        </div>
                    </div>
                    {% endif %}

                    <!-- Nombre leçons -->
                    <div class="d-flex align-items-center mb-4">
                        <i class="fa fa-book-open text-primary me-2"></i>
                        <span class="text-muted">{{ cour.lecons|length }} leçon(s)</span>
                    </div>

                    <!-- Bouton -->
                    <a href="{{ path('app_enfant_lecons', {'id_cours': cour.idCours}) }}"
                       class="btn btn-primary rounded-pill py-2 px-4 w-100">
                        📖 Voir les leçons <i class="fa fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12 text-center py-5">
            <i class="fa fa-book fa-5x text-muted mb-4"></i>
            <h4 class="text-muted">Aucun cours disponible.</h4>
        </div>
        {% endfor %}
    </div>

    <!-- Pagination -->
    <div class="d-flex justify-content-center mt-5" id="paginationContainer">
        {{ knp_pagination_render(cours) }}
    </div>

    <!-- Message aucun résultat -->
    <div id="noResult" class="text-center py-5 d-none">
        <i class="fa fa-search fa-4x text-muted mb-3"></i>
        <h4 class="text-muted">Aucun cours trouvé.</h4>
        <button id="resetBtn2" class="btn btn-primary rounded-pill px-4 mt-3">
            Réinitialiser la recherche
        </button>
    </div>

</div>

{% endblock %}

{% block javascripts %}
<script>
    const searchInput = document.getElementById('searchInput');
    const filterNiveau = document.getElementById('filterNiveau');
    const sortAlpha = document.getElementById('sortAlpha');
    const resetBtn = document.getElementById('resetBtn');
    const resetBtn2 = document.getElementById('resetBtn2');
    const coursList = document.getElementById('coursList');
    const noResult = document.getElementById('noResult');
    const resultCount = document.getElementById('resultCount');
    const paginationContainer = document.getElementById('paginationContainer');
    const coursUrl = '{{ path('app_enfant_cours') }}';

    let fetchTimer = null;

    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function buildCoursCard(cour) {
        const niveauBadge = cour.niveau
            ? `<span class="badge bg-primary rounded-pill px-3 py-2 mb-3">🎯 Niveau ${escapeHtml(cour.niveau)}</span>`
            : `<span class="badge bg-secondary rounded-pill px-3 py-2 mb-3">Niveau non défini</span>`;

        const description = cour.description
            ? `<p class="text-muted mb-3">${escapeHtml(cour.description.length > 100 ? cour.description.slice(0, 100) + '...' : cour.description)}</p>`
            : '';

        const formateur = cour.formateur
            ? `
                <div class="d-flex align-items-center mb-3">
                    <img class="rounded-circle flex-shrink-0"
                         src="{{ asset('base-front/img/user.jpg') }}"
                         alt="" style="width: 38px; height: 38px;">
                    <div class="ms-2">
                        <h6 class="text-primary mb-0">${escapeHtml(cour.formateur)}</h6>
                        <small class="text-muted">Formateur</small>
                    </div>
                </div>
            `
            : '';

        return `
            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        ${niveauBadge}
                        <h4 class="text-primary fw-bold mb-3 cours-titre">${escapeHtml(cour.titre)}</h4>
                        ${description}
                        ${formateur}
                        <div class="d-flex align-items-center mb-4">
                            <i class="fa fa-book-open text-primary me-2"></i>
                            <span class="text-muted">${cour.lecons} leçon(s)</span>
                        </div>
                        <a href="${escapeHtml(cour.urlLecons)}"
                           class="btn btn-primary rounded-pill py-2 px-4 w-100">
                            📖 Voir les leçons <i class="fa fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        `;
    }

    function buildPagination(page, pages) {
        if (!pages || pages <= 1) {
            return '';
        }

        let html = '<nav aria-label="Pagination cours"><ul class="pagination">';
        html += `
            <li class="page-item ${page <= 1 ? 'disabled' : ''}">
                <a class="page-link ajax-page" href="#" data-page="${page - 1}">Précédent</a>
            </li>
        `;

        for (let i = 1; i <= pages; i++) {
            html += `
                <li class="page-item ${i === page ? 'active' : ''}">
                    <a class="page-link ajax-page" href="#" data-page="${i}">${i}</a>
                </li>
            `;
        }

        html += `
            <li class="page-item ${page >= pages ? 'disabled' : ''}">
                <a class="page-link ajax-page" href="#" data-page="${page + 1}">Suivant</a>
            </li>
        `;
        html += '</ul></nav>';

        return html;
    }

    function getParams(page = 1) {
        return {
            search: searchInput.value.trim(),
            niveau: filterNiveau.value,
            sort: sortAlpha.value,
            page
        };
    }

    async function loadCours(page = 1) {
        const params = getParams(page);
        const url = new URL(coursUrl, window.location.origin);

        Object.entries(params).forEach(([key, value]) => {
            if (value !== '') {
                url.searchParams.set(key, value);
            }
        });

        coursList.innerHTML = `
            <div class="col-12 text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        `;
        paginationContainer.innerHTML = '';
        noResult.classList.add('d-none');

        try {
            const response = await fetch(url.toString(), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const data = await response.json();

            if (!response.ok) {
                throw new Error(data.error || 'Erreur lors du chargement');
            }

            if (!data.cours || data.cours.length === 0) {
                coursList.innerHTML = '';
                noResult.classList.remove('d-none');
                resultCount.textContent = '0 cours trouvé(s)';
                paginationContainer.innerHTML = '';
                return;
            }

            coursList.innerHTML = data.cours.map(buildCoursCard).join('');
            resultCount.textContent = `${data.total} cours trouvé(s)`;
            paginationContainer.innerHTML = buildPagination(data.page, data.pages);
            noResult.classList.add('d-none');

            paginationContainer.querySelectorAll('.ajax-page').forEach(link => {
                link.addEventListener('click', (event) => {
                    event.preventDefault();
                    const targetPage = parseInt(link.dataset.page, 10);
                    if (!Number.isNaN(targetPage) && targetPage > 0) {
                        loadCours(targetPage);
                    }
                });
            });
        } catch (error) {
            coursList.innerHTML = `
                <div class="col-12 text-center py-5">
                    <h4 class="text-danger">Impossible de charger les cours.</h4>
                    <p class="text-muted">${escapeHtml(error.message)}</p>
                </div>
            `;
        }
    }

    function filterAndSort() {
        const search = searchInput.value.toLowerCase().trim();
        const niveau = filterNiveau.value.toLowerCase();
        const sort = sortAlpha.value;

        let items = Array.from(document.querySelectorAll('.cours-item'));
        let visible = [];

        items.forEach(item => {
            const titre = item.dataset.titre || '';
            const formateur = item.dataset.formateur || '';
            const description = item.dataset.description || '';
            const niveauItem = item.dataset.niveau || '';

            const matchSearch = !search ||
                titre.includes(search) ||
                formateur.includes(search) ||
                description.includes(search);

            const matchNiveau = !niveau || niveauItem.includes(niveau);

            if (matchSearch && matchNiveau) {
                item.classList.remove('d-none');
                visible.push(item);
            } else {
                item.classList.add('d-none');
            }
        });

        // Tri alphabétique
        if (sort === 'az' || sort === 'za') {
            visible.sort((a, b) => {
                const ta = a.dataset.titre;
                const tb = b.dataset.titre;
                return sort === 'az' ? ta.localeCompare(tb) : tb.localeCompare(ta);
            });
            visible.forEach(item => coursList.appendChild(item));
        }

        // Résultats
        resultCount.textContent = visible.length + ' cours trouvé(s)';

        // Aucun résultat
        if (visible.length === 0) {
            noResult.classList.remove('d-none');
        } else {
            noResult.classList.add('d-none');
        }
    }

    function reset() {
        searchInput.value = '';
        filterNiveau.value = '';
        sortAlpha.value = '';
        loadCours(1);
    }

    function scheduleLoad() {
        clearTimeout(fetchTimer);
        fetchTimer = setTimeout(() => loadCours(1), 250);
    }

    searchInput.addEventListener('input', scheduleLoad);
    filterNiveau.addEventListener('change', () => loadCours(1));
    sortAlpha.addEventListener('change', () => loadCours(1));
    resetBtn.addEventListener('click', reset);
    resetBtn2.addEventListener('click', reset);

    loadCours({{ app.request.query.getInt('page', 1) }});
</script>
{% endblock %}
