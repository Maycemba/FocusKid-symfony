{% extends 'base-front1.html.twig' %}

{% block title %}FocusKid - Apprentissage ludique pour enfants{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    :root {
        --orange: #FF6B35;
        --blue: #4A90E2;
    }

    /* Hero Section */
    .hero-section {
        min-height: 85vh;
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        position: relative;
        overflow: hidden;
    }

    .hero-section::before {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="20" cy="20" r="3" fill="white" opacity="0.2"/><circle cx="80" cy="40" r="2" fill="white" opacity="0.15"/><circle cx="50" cy="80" r="4" fill="white" opacity="0.2"/><circle cx="90" cy="70" r="2" fill="white" opacity="0.15"/></svg>');
        background-size: 50px;
        pointer-events: none;
    }

    .floating-emoji {
        position: absolute;
        animation: float 6s ease-in-out infinite;
        font-size: 40px;
        opacity: 0.3;
        pointer-events: none;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
    }

    /* Modal Overlay pour les formulaires */
    .form-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(5px);
        z-index: 1000;
        justify-content: center;
        align-items: center;
    }

    .form-modal.active {
        display: flex;
        animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .form-card {
        background: white;
        border-radius: 28px;
        max-width: 450px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
        animation: slideUp 0.3s ease;
        box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
    }

    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-card-header {
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        padding: 25px;
        text-align: center;
        color: white;
        border-radius: 28px 28px 0 0;
    }

    .close-modal {
        position: absolute;
        right: 20px;
        top: 20px;
        background: rgba(255,255,255,0.2);
        border: none;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        color: white;
        cursor: pointer;
        transition: all 0.3s;
    }

    .close-modal:hover {
        background: rgba(255,255,255,0.3);
        transform: rotate(90deg);
    }

    .form-card-body {
        padding: 30px;
    }

    /* Inputs modernes */
    .input-modern {
        position: relative;
        margin-bottom: 20px;
    }

    .input-modern i {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--orange);
        font-size: 18px;
        z-index: 2;
    }

    .input-modern input {
        width: 100%;
        padding: 12px 16px 12px 48px;
        border: 2px solid #e5e7eb;
        border-radius: 16px;
        font-size: 15px;
        transition: all 0.3s;
        outline: none;
    }

    .input-modern input:focus {
        border-color: var(--orange);
        box-shadow: 0 0 0 3px rgba(255,107,53,0.1);
    }

    .btn-gradient {
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        border: none;
        padding: 14px;
        border-radius: 16px;
        font-weight: bold;
        font-size: 16px;
        transition: all 0.3s;
        width: 100%;
        color: white;
    }

    .btn-gradient:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(255,107,53,0.3);
    }

    .role-choice-group {
        background: #f8f9fa;
        border-radius: 16px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .role-choice-group .form-check {
        margin-bottom: 10px;
        padding-left: 30px;
    }

    .role-choice-group .form-check-input {
        margin-left: -25px;
        margin-top: 8px;
    }

    .role-choice-group .form-check-label {
        font-weight: 500;
        color: #333;
    }

    .role-choice-group .form-check-label small {
        display: block;
        font-size: 12px;
        color: #6c757d;
        font-weight: normal;
    }

    /* Password strength */
    .password-strength {
        margin-top: 8px;
        height: 4px;
        border-radius: 2px;
        transition: all 0.3s;
    }

    .strength-weak { width: 33%; background: #dc3545; }
    .strength-medium { width: 66%; background: #ffc107; }
    .strength-strong { width: 100%; background: #28a745; }

    /* Features Cards */
    .feature-card {
        background: white;
        border-radius: 20px;
        padding: 30px 20px;
        transition: all 0.4s ease;
        cursor: pointer;
        border: 1px solid rgba(0,0,0,0.05);
        height: 100%;
    }

    .feature-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }

    .feature-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        transition: transform 0.3s ease;
    }

    .feature-card:hover .feature-icon {
        transform: scale(1.1) rotate(5deg);
    }

    .feature-icon i {
        font-size: 30px;
        color: white;
    }

    /* Stats */
    .stat-number {
        font-size: 48px;
        font-weight: 800;
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* CTA Banner */
    .cta-banner {
        background: linear-gradient(135deg, #FF6B35, #4A90E2);
        border-radius: 30px;
        padding: 60px 40px;
        position: relative;
        overflow: hidden;
    }

    .cta-banner::before {
        content: '🎓';
        position: absolute;
        font-size: 150px;
        opacity: 0.1;
        bottom: -30px;
        right: -30px;
        transform: rotate(-15deg);
    }
</style>
{% endblock %}

