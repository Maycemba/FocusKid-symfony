<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8">
    <title>{% block title %}FocusKid - Apprentissage ludique pour enfants{% endblock %}</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta name="description" content="Plateforme éducative pour enfants TDAH - Exercices, jeux et activités pédagogiques adaptés">
    <meta name="theme-color" content="#FF7043">

    <link href="{{ asset('base-front/img/logo.png') }}" rel="icon">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;600;700;800&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">

    <!-- CSS Libs -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

    <link href="{{ asset('base-front/lib/animate/animate.min.css') }}" rel="stylesheet">
    <link href="{{ asset('base-front/lib/owlcarousel/assets/owl.carousel.min.css') }}" rel="stylesheet">
    <link href="{{ asset('base-front/css/style.css') }}" rel="stylesheet">

    <style>
        /* ====================================================
           FOCUSKID — BASE TEMPLATE TDAH-FRIENDLY
        ==================================================== */

        :root {
            --orange:       #FF7043;
            --orange-light: #FFB74D;
            --blue:         #42A5F5;
            --blue-light:   #90CAF9;
            --green:        #66BB6A;
            --purple:       #AB47BC;
            --pink:         #F06292;
            --yellow:       #FFD54F;
            --teal:         #26C6DA;
            --bg:           #FFF8F0;
            --bg-card:      #FFFFFF;
            --text:         #3D2B1F;
            --text-soft:    #7B5E52;
            --border:       rgba(255,112,67,0.15);
            --gradient-main:   linear-gradient(135deg, var(--orange) 0%, var(--orange-light) 100%);
            --gradient-cool:   linear-gradient(135deg, var(--blue) 0%, var(--teal) 100%);
            --radius-xl:   28px;
            --radius-lg:   20px;
            --radius-md:   14px;
            --radius-pill: 50px;
            --shadow-soft:  0 8px 30px rgba(255,112,67,0.12);
            --shadow-card:  0 4px 20px rgba(0,0,0,0.06);
            --shadow-hover: 0 16px 48px rgba(255,112,67,0.22);
            --font-title: 'Baloo 2', cursive;
            --font-body:  'Nunito', sans-serif;
            --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
            --transition:  0.28s ease;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }

        body {
            font-family: var(--font-body);
            background: var(--bg);
            color: var(--text);
            font-size: 16px;
            line-height: 1.65;
            background-image:
                radial-gradient(circle at 15% 20%, rgba(255,112,67,0.06) 0%, transparent 50%),
                radial-gradient(circle at 85% 80%, rgba(66,165,245,0.06) 0%, transparent 50%);
            min-height: 100vh;
        }

        #page-wrapper { display: flex; flex-direction: column; min-height: 100vh; }

        /* Skip link */
        .skip-link {
            position: absolute;
            top: -40px;
            left: 16px;
            background: var(--orange);
            color: white;
            padding: 8px 16px;
            border-radius: var(--radius-md);
            font-weight: 700;
            z-index: 9999;
            transition: top 0.2s;
            text-decoration: none;
        }
        .skip-link:focus { top: 12px; color: white; }

        /* Focus bar */
        #focus-bar {
            height: 5px;
            background: linear-gradient(90deg, var(--orange), var(--orange-light), var(--green), var(--blue));
            background-size: 300% 100%;
            animation: focusBarMove 4s linear infinite;
            transform-origin: left;
            transform: scaleX(0);
            transition: transform 0.5s ease;
        }
        @keyframes focusBarMove {
            0%   { background-position: 0% 50%; }
            100% { background-position: 300% 50%; }
        }

        /* Navbar */
        .navbar {
            background: var(--bg-card) !important;
            box-shadow: 0 3px 20px rgba(0,0,0,0.07);
            padding: 0 !important;
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 3px solid var(--orange-light);
        }
        .navbar-inner {
            display: flex;
            align-items: center;
            padding: 10px 24px;
            gap: 12px;
        }
        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }
        .navbar-brand img {
            height: 80px;
            width: auto;
        }
        .brand-name {
            font-family: var(--font-title);
            font-size: 40px;
            font-weight: 800;
            background: var(--gradient-main);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .navbar-nav-wrap {
            flex: 1;
            display: flex;
            justify-content: flex-end;
        }
        .btn-compte {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            border-radius: var(--radius-pill);
            background: var(--gradient-main);
            color: white !important;
            font-weight: 700;
            font-size: 18px;
            text-decoration: none;
            box-shadow: var(--shadow-soft);
            transition: all var(--transition);
            cursor: pointer;
            border: none;
        }
        .btn-compte:hover {
            transform: translateY(-2px) scale(1.03);
            box-shadow: var(--shadow-hover);
            color: white !important;
        }
        .navbar-toggle-btn {
            background: var(--bg);
            border: 2px solid var(--border);
            border-radius: var(--radius-md);
            width: 44px;
            height: 44px;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 5px;
            cursor: pointer;
        }
        .navbar-toggle-btn span {
            display: block;
            width: 22px;
            height: 2.5px;
            background: var(--orange);
            border-radius: 2px;
        }

        /* Dynamic content */
        #dynamic-content {
            flex: 1;
            min-height: 500px;
        }
        .page-fade-enter {
            animation: pageFadeIn 0.3s ease both;
        }
        @keyframes pageFadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Cards */
        .fk-card, .feature-card, .exercice-card {
            background: var(--bg-card);
            border-radius: var(--radius-xl);
            padding: 24px;
            box-shadow: var(--shadow-card);
            border: 2px solid var(--border);
            transition: all var(--transition);
        }
        .fk-card:hover, .feature-card:hover, .exercice-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }
        .feature-icon {
            width: 70px;
            height: 70px;
            background: var(--gradient-main);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }
        .feature-icon i { font-size: 30px; color: white; }
        .stat-number {
            font-size: 48px;
            font-weight: 800;
            background: var(--gradient-main);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Input modern */
        .input-modern {
            position: relative;
            margin-bottom: 1rem;
        }
        .input-modern i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--orange);
            font-size: 18px;
            z-index: 1;
        }
        .input-modern input, .input-modern select {
            width: 100%;
            padding: 12px 16px 12px 48px;
            border: 2px solid #e5e7eb;
            border-radius: 16px;
            font-size: 15px;
            transition: all 0.3s;
            outline: none;
        }
        .input-modern input:focus {
            border-color: var(--orange);
            box-shadow: 0 0 0 3px rgba(255,107,53,0.1);
        }

        /* Password strength */
        .password-strength {
            font-size: 12px;
            margin-top: -8px;
            margin-bottom: 12px;
            display: none;
        }
        .strength-weak { color: #e74c3c; display: block; }
        .strength-medium { color: #f39c12; display: block; }
        .strength-strong { color: #27ae60; display: block; }

        /* Footer */
        .fk-footer {
            background: linear-gradient(135deg, #2D1B10 0%, #1A0F08 100%);
            color: rgba(255,255,255,0.6);
            margin-top: auto;
        }
        .fk-footer h3 {
            font-family: var(--font-title);
            color: white;
            font-size: 18px;
            margin-bottom: 18px;
        }
        .footer-link {
            display: block;
            color: rgba(255,255,255,0.55);
            text-decoration: none;
            padding: 4px 0;
            font-size: 14px;
        }
        .footer-link:hover { color: var(--orange-light); }
        .social-btn {
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.08);
            border-radius: 50%;
            margin-right: 8px;
            transition: all 0.3s;
            color: white;
            text-decoration: none;
        }
        .social-btn:hover { background: var(--gradient-main); transform: translateY(-4px); }

        /* Back to top */
        #back-to-top {
            position: fixed;
            bottom: 28px;
            right: 28px;
            width: 50px;
            height: 50px;
            background: var(--gradient-main);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            opacity: 0;
            visibility: hidden;
            transition: all var(--transition);
            cursor: pointer;
            z-index: 998;
            text-decoration: none;
        }
        #back-to-top.show { opacity: 1; visibility: visible; }
        #back-to-top:hover { transform: translateY(-5px); }

        /* Responsive */
        @media (max-width: 992px) {
            .navbar-toggle-btn { display: flex; }
            .navbar-nav-wrap {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background: var(--bg-card);
                padding: 12px;
                z-index: 999;
                border-top: 2px solid var(--border);
            }
            .navbar-nav-wrap.open { display: flex; justify-content: center; }
            .brand-name { font-size: 22px; }
        }
        @media (max-width: 576px) {
            .btn-compte { display: none !important; }
        }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>
    <a href="#dynamic-content" class="skip-link">Aller au contenu principal</a>
    <div id="focus-bar" role="progressbar" aria-hidden="true"></div>

    <div id="page-wrapper">
        <nav class="navbar" role="navigation">
            <div class="navbar-inner container-fluid">
                <a href="#" id="homeLink" class="navbar-brand">
                    <img src="{{ asset('base-front/img/logo.png') }}" alt="Logo FocusKid">
                    <span class="brand-name">Focus<span style="color:var(--blue)">Kid</span></span>
                </a>
                <button class="navbar-toggle-btn" id="navToggle" aria-expanded="false" aria-label="Menu">
                    <span></span><span></span><span></span>
                </button>
                <div class="navbar-nav-wrap ms-auto" id="navMenu">
                    <div class="d-flex gap-2">
                        <button class="btn-compte" onclick="openRegisterModal(); return false;">
                            <span>👤</span> Sign in
                        </button>
                        <button class="btn-compte" onclick="openLoginModal(); return false;">
                            <span>👤</span> Log in
                        </button>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Modals (Bootstrap) -->
        <div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="border-radius: 28px;">
                    <div class="modal-header border-0">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body p-4" id="loginModalBody">
                        <div class="text-center"><div class="spinner-border text-primary"></div><p>Chargement...</p></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="registerModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content" style="border-radius: 28px;">
                    <div class="modal-header border-0">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body p-4" id="registerModalBody">
                        <div class="text-center"><div class="spinner-border text-primary"></div><p>Chargement...</p></div>
                    </div>
                </div>
            </div>
        </div>

        <main id="dynamic-content" role="main" tabindex="-1">
            {% block body %}{% endblock %}
        </main>

        <footer class="fk-footer pt-5">
            <div class="container py-4">
                <div class="row g-4">
                    <div class="col-lg-4 col-md-6">
                        <h3>Focus<span style="color:var(--orange-light)">Kid</span> 🚀</h3>
                        <p style="font-size:14px;">Plateforme éducative innovante pour aider les enfants à apprendre tout en s'amusant.</p>
                        <div>
                            <a href="#" class="social-btn"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" class="social-btn"><i class="fab fa-twitter"></i></a>
                            <a href="#" class="social-btn"><i class="fab fa-instagram"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <h3>Liens</h3>
                        <a href="#" class="footer-link">À propos</a>
                        <a href="#" class="footer-link">Contact</a>
                        <a href="#" class="footer-link">FAQ</a>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h3>Contact</h3>
                        <div class="footer-contact-item d-flex gap-2 mb-2">
                            <i class="fas fa-map-marker-alt"></i> 123 Rue de l'Éducation, Tunis
                        </div>
                        <div class="footer-contact-item d-flex gap-2 mb-2">
                            <i class="fas fa-phone-alt"></i> +216 12 345 678
                        </div>
                        <div class="footer-contact-item d-flex gap-2">
                            <i class="fas fa-envelope"></i> contact@focuskid.com
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h3>Newsletter</h3>
                        <p style="font-size:14px;">Recevez nos conseils pour accompagner les enfants TDAH !</p>
                        <div class="d-flex">
                            <input type="email" class="form-control" placeholder="Votre email">
                            <button class="btn btn-primary ms-2">OK</button>
                        </div>
                    </div>
                </div>
                <hr class="my-4" style="border-color: rgba(255,255,255,0.08);">
                <p class="text-center footer-copy">© 2024 FocusKid — Tous droits réservés 💛</p>
            </div>
        </footer>
    </div>

    <a href="#" id="back-to-top" aria-label="Retour en haut"><i class="fas fa-arrow-up"></i></a>

    <!-- JS Libs -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function() {
            'use strict';

            // Menu mobile
            const navToggle = document.getElementById('navToggle');
            const navMenu = document.getElementById('navMenu');
            if (navToggle && navMenu) {
                navToggle.addEventListener('click', () => {
                    navMenu.classList.toggle('open');
                    navToggle.setAttribute('aria-expanded', navMenu.classList.contains('open'));
                });
                document.addEventListener('click', (e) => {
                    if (!navMenu.contains(e.target) && !navToggle.contains(e.target)) {
                        navMenu.classList.remove('open');
                        navToggle.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            // Back to top
            const backBtn = document.getElementById('back-to-top');
            window.addEventListener('scroll', () => {
                if (backBtn) backBtn.classList.toggle('show', window.scrollY > 300);
            });
            if (backBtn) {
                backBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }

            // Focus bar
            const focusBar = document.getElementById('focus-bar');
            if (focusBar) {
                let progress = 0;
                const timer = setInterval(() => {
                    progress += Math.random() * 2.5 + 0.5;
                    if (progress >= 100) { progress = 100; clearInterval(timer); }
                    focusBar.style.transform = `scaleX(${progress / 100})`;
                }, 600);
            }

            // Navigation AJAX
            const contentDiv = document.getElementById('dynamic-content');
            function loadContent(url) {
                if (!url || url === '#') return;
                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(res => res.text())
                    .then(html => {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        const newMain = doc.getElementById('dynamic-content');
                        contentDiv.innerHTML = newMain ? newMain.innerHTML : html;
                        contentDiv.classList.remove('page-fade-enter');
                        void contentDiv.offsetWidth;
                        contentDiv.classList.add('page-fade-enter');
                        window.history.pushState({ url }, '', url);
                        const newTitle = doc.querySelector('title');
                        if (newTitle) document.title = newTitle.textContent;
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                        if (navMenu) navMenu.classList.remove('open');
                    })
                    .catch(() => window.location.href = url);
            }

            document.addEventListener('click', (e) => {
                const link = e.target.closest('.ajax-link');
                if (link) {
                    e.preventDefault();
                    const url = link.dataset.url;
                    if (url) loadContent(url);
                }
            });
            const homeLink = document.getElementById('homeLink');
            if (homeLink) {
                homeLink.addEventListener('click', (e) => {
                    e.preventDefault();
                    loadContent("{{ path('app_index') }}");
                });
            }
            window.addEventListener('popstate', (e) => {
                if (e.state && e.state.url) loadContent(e.state.url);
            });
        })();

        // --- Gestion des modals (connexion / inscription) ---
        window.openLoginModal = function() {
            const modalEl = document.getElementById('loginModal');
            const modal = new bootstrap.Modal(modalEl);
            const body = document.getElementById('loginModalBody');
            body.innerHTML = '<div class="text-center"><div class="spinner-border text-primary"></div><p>Chargement...</p></div>';
            modal.show();
            fetch('{{ path('app_login_form_ajax') }}')
                .then(res => res.text())
                .then(html => {
                    body.innerHTML = html;
                    attachLoginFormEvents();
                })
                .catch(() => {
                    body.innerHTML = '<div class="alert alert-danger">Erreur de chargement. Veuillez rafraîchir.</div>';
                });
        };

        window.openRegisterModal = function() {
            const modalEl = document.getElementById('registerModal');
            const modal = new bootstrap.Modal(modalEl);
            const body = document.getElementById('registerModalBody');
            body.innerHTML = '<div class="text-center"><div class="spinner-border text-primary"></div><p>Chargement...</p></div>';
            modal.show();
            fetch('{{ path('app_register_form_ajax') }}')
                .then(res => res.text())
                .then(html => {
                    body.innerHTML = html;
                    attachRegisterFormEvents();
                })
                .catch(() => {
                    body.innerHTML = '<div class="alert alert-danger">Erreur de chargement. Veuillez rafraîchir.</div>';
                });
        };

        function attachLoginFormEvents() {
            const form = document.getElementById('login-form-ajax');
            if (!form) return;
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                fetch(this.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = data.redirect;
                    } else {
                        // Recharger la modal avec l'erreur
                        openLoginModal();
                        setTimeout(() => {
                            const errDiv = document.querySelector('#loginModalBody .alert-danger');
                            if (errDiv) errDiv.innerHTML = data.error;
                        }, 100);
                    }
                })
                .catch(() => alert('Erreur réseau. Veuillez réessayer.'));
            });
            // Rafraîchissement CAPTCHA
            document.querySelectorAll('.captcha-refresh').forEach(btn => {
                btn.addEventListener('click', function() {
                    const img = this.closest('.bg-light')?.querySelector('img');
                    if (img) img.src = '{{ path('app_captcha_image') }}?t=' + Date.now();
                });
            });
            const captchaImg = document.getElementById('captcha-img');
            if (captchaImg) {
                captchaImg.addEventListener('click', () => {
                    captchaImg.src = '{{ path('app_captcha_image') }}?t=' + Date.now();
                });
            }
        }

        function attachRegisterFormEvents() {
            const form = document.getElementById('register-form-ajax');
            if (!form) return;
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                fetch(this.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        window.location.href = data.redirect;
                    } else {
                        const modalBody = document.getElementById('registerModalBody');
                        if (modalBody) {
                            modalBody.innerHTML = `<div class="alert alert-danger">${data.error}</div>
                                                    <button class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>`;
                        } else {
                            alert(data.error);
                        }
                    }
                })
                .catch(() => alert('Erreur réseau. Veuillez réessayer.'));
            });
            // Force du mot de passe
            const pwd = document.getElementById('register_password');
            const strengthDiv = document.getElementById('password-strength');
            if (pwd && strengthDiv) {
                pwd.addEventListener('input', function() {
                    let strength = 0;
                    if (this.value.length >= 4) strength++;
                    if (this.value.length >= 8) strength++;
                    if (/[a-z]/.test(this.value)) strength++;
                    if (/[A-Z]/.test(this.value)) strength++;
                    if (/[0-9]/.test(this.value)) strength++;
                    if (/[$@#&!]/.test(this.value)) strength++;
                    strengthDiv.className = 'password-strength mb-3';
                    if (this.value.length === 0) {
                        strengthDiv.style.display = 'none';
                    } else {
                        strengthDiv.style.display = 'block';
                        if (strength <= 2) strengthDiv.classList.add('strength-weak');
                        else if (strength <= 4) strengthDiv.classList.add('strength-medium');
                        else strengthDiv.classList.add('strength-strong');
                    }
                });
            }
        }
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>